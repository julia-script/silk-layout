import layout.lib { Size, Rect, Measure, MeasureRequest, Measured, NaturalDimensions, AvailableKind, WritingMode, Direction, ScrollbarWidth, ScrollbarGutter, ScrollbarRequest, ScrollbarMetrics, FontRequest, FontMetrics, BaselineSet }
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.json.value { Value }
import silk.num.f32
import protocol as P
import protocol { ProtocolError }
import layout.lib { TextMeasure, TextError, TextContext, TextBreak, TextAnalysis, TextShapeRequest, TextRun }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import text_profile as TextProfile

// Opaque fixture boxes plus a bounded ASCII/control-character text service.
pub struct Fixture {
  pub minWidth: f32, pub maxWidth: f32, pub height: f32,
  pub firstBaseline: f32, pub lastBaseline: f32, pub hasBaseline: bool,
  pub wrap: bool,
  pub hasLineBoxes: bool,
}
impl Copy for Fixture {}
pub struct Fixtures {
  pub values: List<Fixture>, pub objects: List<NaturalDimensions>,
  pub fonts: List<FontMetrics>,
  pub autoScrollbars: ScrollbarMetrics, pub thinScrollbars: ScrollbarMetrics,
  // Provider call counts, reported by benchmark mode.
  pub measureCalls: usize, pub analyzeCalls: usize, pub shapeCalls: usize,
}

pub effect fn parseFont(value: &Value) -> FontMetrics ! ProtocolError {
  run P.fields(value, &["fontSize", "ascent", "descent", "lineGap", "xHeight", "capHeight", "subscriptOffset", "superscriptOffset", "baselines"])
  let baselines = run P.required(value, "baselines")
  run P.fields(baselines, &["alphabetic", "ideographic", "central", "mathematical"])
  let ascent = run P.nonnegative(run P.required(value, "ascent"))
  let descent = run P.nonnegative(run P.required(value, "descent"))
  let xHeight = run P.nonnegative(run P.required(value, "xHeight"))
  let alphabetic = run P.finite(run P.required(baselines, "alphabetic"))
  let fontSize = run P.nonnegative(run P.required(value, "fontSize"))
  return FontMetrics {
    fontSize: fontSize,
    // The authored fixture font has half-em space and digit advances.
    spaceAdvance: fontSize / 2.0,
    zeroAdvance: fontSize / 2.0,
    ascent: ascent,
    descent: descent,
    lineGap: run P.finite(run P.required(value, "lineGap")),
    xHeight: xHeight,
    capHeight: run P.nonnegative(run P.required(value, "capHeight")),
    subscriptOffset: run P.finite(run P.required(value, "subscriptOffset")),
    superscriptOffset: run P.finite(run P.required(value, "superscriptOffset")),
    baselines: BaselineSet {
      alphabetic: alphabetic,
      ideographic: run P.finite(run P.required(baselines, "ideographic")),
      central: run P.finite(run P.required(baselines, "central")),
      mathematical: run P.finite(run P.required(baselines, "mathematical")),
      xMiddle: alphabetic - xHeight / 2.0,
      textOver: 0.0, textUnder: ascent + descent,
    },
  }
}

pub effect fn parseScrollbars(value: &Value) -> ScrollbarMetrics ! ProtocolError {
  run P.fields(value, &["horizontal", "vertical", "overlay", "horizontalOnTop", "verticalOnLeft"])
  let horizontal = run P.nonnegative(run P.required(value, "horizontal"))
  let vertical = run P.nonnegative(run P.required(value, "vertical"))
  if horizontal - horizontal != 0.0 || vertical - vertical != 0.0 {
    fail P.invalid("scrollbar thickness must be finite and nonnegative")
  }
  return ScrollbarMetrics {
    horizontal: horizontal, vertical: vertical,
    overlay: run P.boolean(run P.required(value, "overlay")),
    horizontalOnTop: run P.boolean(run P.required(value, "horizontalOnTop")),
    verticalOnLeft: run P.boolean(run P.required(value, "verticalOnLeft")),
  }
}

pub effect fn parse(value: &Value) -> Fixture ! ProtocolError {
  run P.fields(value, &["minWidth", "maxWidth", "height", "firstBaseline", "lastBaseline", "wrap", "hasLineBoxes"])
  let minimum = run P.nonnegative(run P.required(value, "minWidth"))
  let maximum = run P.nonnegative(run P.required(value, "maxWidth"))
  let height = run P.nonnegative(run P.required(value, "height"))
  if minimum > maximum { fail P.invalid("measure.minWidth exceeds maxWidth") }
  let firstPresent = P.has(value, "firstBaseline")
  let lastPresent = P.has(value, "lastBaseline")
  let mut first: f32 = 0.0
  let mut last: f32 = 0.0
  if firstPresent { first = run P.number(run P.required(value, "firstBaseline")) }
  if lastPresent { last = run P.number(run P.required(value, "lastBaseline")) }
  if firstPresent && !lastPresent { last = first }
  if lastPresent && !firstPresent { first = last }
  let mut wrap = false
  if P.has(value, "wrap") { wrap = run P.boolean(run P.required(value, "wrap")) }
  let mut hasLineBoxes = true
  if P.has(value, "hasLineBoxes") { hasLineBoxes = run P.boolean(run P.required(value, "hasLineBoxes")) }
  if !hasLineBoxes && (minimum != 0.0 || maximum != 0.0 || height != 0.0 || firstPresent || lastPresent) {
    fail P.invalid("a fixture without line boxes must have empty metrics and no baselines")
  }
  return Fixture { minWidth: minimum, maxWidth: maximum, height: height, firstBaseline: first, lastBaseline: last, hasBaseline: firstPresent || lastPresent, wrap: wrap, hasLineBoxes: hasLineBoxes }
}

pub effect fn parseNatural(value: &Value) -> NaturalDimensions ! ProtocolError {
  run P.fields(value, &["width", "height", "aspectRatio"])
  let mut natural = NaturalDimensions.none()
  if P.has(value, "width") {
    natural.size.width = run P.nonnegative(run P.required(value, "width"))
    natural.size.widthDefinite = true
  }
  if P.has(value, "height") {
    natural.size.height = run P.nonnegative(run P.required(value, "height"))
    natural.size.heightDefinite = true
  }
  if P.has(value, "aspectRatio") { natural.aspectRatio = run P.nonnegative(run P.required(value, "aspectRatio")) }
  return natural
}

struct LineFlow { blockSize: f32, firstOffset: f32, lastOffset: f32, bounds: Rect }
impl Copy for LineFlow {}
fn includeLines(result: &mut LineFlow, first: bool, left: f32, right: f32, blockEnd: f32) {
  if first {
    result.bounds = Rect { x: left, y: result.blockSize, width: right - left, height: blockEnd - result.blockSize }
  } else {
    let end = f32.max(result.bounds.x + result.bounds.width, right)
    result.bounds.x = f32.min(result.bounds.x, left)
    result.bounds.width = end - result.bounds.x
    result.bounds.height = f32.max(result.bounds.y + result.bounds.height, blockEnd) - result.bounds.y
  }
}
fn fixtureLines(request: &MeasureRequest, inlineSize: f32, contentInlineSize: f32, minimumInlineSize: f32, lineBlockSize: f32, overflowLineBlockSize: f32, wrap: bool) -> LineFlow {
  let mut result = LineFlow { blockSize: 0.0, firstOffset: 0.0, lastOffset: 0.0, bounds: Rect.zero() }
  let mut remaining = contentInlineSize
  let mut first = true
  let exclusionEnd = request.exclusionBlockEnd()
  while first || remaining > 0.0 {
    let mut minimum = remaining
    if wrap { minimum = f32.min(remaining, minimumInlineSize) }
    let mut available = inlineSize
    let mut left: f32 = 0.0
    let mut right = inlineSize
    if result.blockSize < exclusionEnd {
      let mut band = request.lineSpace(inlineSize, result.blockSize, lineBlockSize)
      while band.constrained && band.lineRight - band.lineLeft < minimum {
        result.blockSize = band.nextBlockOffset
        band = request.lineSpace(inlineSize, result.blockSize, lineBlockSize)
      }
      available = f32.max(0.0, band.lineRight - band.lineLeft)
      left = band.lineLeft
      right = band.lineRight
    }
    if first { result.firstOffset = result.blockSize }
    result.lastOffset = result.blockSize
    let isFirst = first
    first = false
    // After the last float, identical synthetic lines need no per-line loop.
    if !wrap || result.blockSize >= exclusionEnd || lineBlockSize == 0.0 {
      let mut lines: f32 = 1.0
      let capacity = f32.max(minimum, available)
      if wrap && capacity > 0.0 { lines = f32.max(1.0, f32.ceil(remaining / capacity)) }
      result.lastOffset = result.blockSize + (lines - 1.0) * lineBlockSize
      let mut content = remaining
      if wrap && lines > 1.0 { content = capacity }
      // Include both the whole line box and content extending past its edge.
      if request.direction == Direction.Rtl { left = f32.min(left, right - content) }
      else { right = f32.max(right, left + content) }
      let blockEnd = result.lastOffset + overflowLineBlockSize
      includeLines(&mut result, isFirst, left, right, blockEnd)
      result.blockSize = result.blockSize + lines * lineBlockSize
      return result
    }
    let mut consumed = f32.max(minimum, available)
    if consumed <= 0.0 { consumed = remaining }
    let content = f32.min(remaining, consumed)
    if request.direction == Direction.Rtl { left = f32.min(left, right - content) }
    else { right = f32.max(right, left + content) }
    let blockEnd = result.blockSize + overflowLineBlockSize
    includeLines(&mut result, isFirst, left, right, blockEnd)
    remaining = f32.max(0.0, remaining - consumed)
    result.blockSize = result.blockSize + lineBlockSize
  }
  return result
}

impl Measure for Fixtures {
  fn font(provider: &mut Self, request: FontRequest) -> FontMetrics {
    return provider.fonts.get(request.key)
  }
  fn scrollbars(provider: &mut Self, request: ScrollbarRequest) -> ScrollbarMetrics {
    if request.width == ScrollbarWidth.None { return ScrollbarMetrics.zero() }
    let mut metrics = provider.autoScrollbars
    if request.width == ScrollbarWidth.Thin { metrics = provider.thinScrollbars }
    // Synthetic host policy, not a CSS requirement: fit bars inside definite
    // allotted content; an inline mirrored pair shares that allocation equally.
    let mut width = request.available.width
    let mut height = request.available.height
    if request.gutter == ScrollbarGutter.StableBothEdges {
      if request.writingMode == WritingMode.HorizontalTb { width = width / 2.0 }
      else { height = height / 2.0 }
    }
    if request.available.widthDefinite { metrics.vertical = f32.min(metrics.vertical, f32.max(0.0, width)) }
    if request.available.heightDefinite { metrics.horizontal = f32.min(metrics.horizontal, f32.max(0.0, height)) }
    return metrics
  }
  fn natural(provider: &mut Self, key: usize) -> NaturalDimensions {
    return provider.objects.get(key)
  }
  fn measure(provider: &mut Self, key: usize, request: MeasureRequest) -> Measured {
    provider.measureCalls = provider.measureCalls + 1
    let fixture = provider.values.asSlice()[key]
    let mut width = fixture.maxWidth
    if request.width.kind == AvailableKind.MinContent { width = fixture.minWidth }
    if request.width.kind == AvailableKind.Definite {
      width = f32.max(fixture.minWidth, f32.min(fixture.maxWidth, request.width.value))
    }
    let intrinsicWidth = width
    if request.known.widthDefinite { width = request.known.width }
    let mut height = fixture.height
    let mut flow = LineFlow { blockSize: 0.0, firstOffset: 0.0, lastOffset: 0.0, bounds: Rect.zero() }
    if fixture.hasLineBoxes {
      if request.writingMode == WritingMode.HorizontalTb {
        flow = fixtureLines(&request, width, fixture.maxWidth, fixture.minWidth, fixture.height, fixture.height, fixture.wrap)
        height = flow.blockSize
      } else {
        let mut inlineSize = fixture.height
        if request.known.heightDefinite { inlineSize = request.known.height }
        flow = fixtureLines(&request, inlineSize, fixture.height, fixture.height, intrinsicWidth, fixture.maxWidth, false)
        width = flow.blockSize
        if request.known.widthDefinite { width = request.known.width }
      }
    }
    if request.known.heightDefinite { height = request.known.height }
    let mut overflow = flow.bounds
    if fixture.hasLineBoxes && request.writingMode != WritingMode.HorizontalTb {
      let mut x = flow.bounds.y
      let mut y = flow.bounds.x
      if request.writingMode == WritingMode.VerticalRl || request.writingMode == WritingMode.SidewaysRl {
        x = width - flow.bounds.y - flow.bounds.height
      }
      if request.writingMode == WritingMode.SidewaysLr {
        y = height - flow.bounds.x - flow.bounds.width
      }
      overflow = Rect { x: x, y: y, width: flow.bounds.height, height: flow.bounds.width }
    }
    return Measured {
      size: Size { width: width, height: height },
      scrollableOverflow: overflow,
      contentBlockSize: flow.blockSize,
      firstBaselines: BaselineSet.uniform(fixture.firstBaseline).translated(flow.firstOffset),
      lastBaselines: BaselineSet.uniform(fixture.lastBaseline).translated(flow.lastOffset),
      hasBaseline: fixture.hasBaseline,
      hasLineBoxes: fixture.hasLineBoxes,
    }
  }
}

impl TextMeasure for Fixtures {
  fn beginTextLayout(provider: &mut Self) {}

  effect fn analyze(provider: &mut Self, context: TextContext, output: &mut List<TextBreak>) -> TextAnalysis
    ! OutOfMemoryError | TextError ? &mut Allocator {
    provider.analyzeCalls = provider.analyzeCalls + 1
    return run TextProfile.analyze(context, provider.fonts.asSlice(), &mut output)
  }

  effect fn shape(provider: &mut Self, request: TextShapeRequest, output: &mut List<TextRun>)
    ! OutOfMemoryError | TextError ? &mut Allocator {
    provider.shapeCalls = provider.shapeCalls + 1
    run TextProfile.shape(request, provider.fonts.asSlice(), &mut output)
  }
}
