  let rootId = tree.root()
  let mut first = sized(20.0, 40.0)
  first.writingMode = WritingMode.VerticalLr
  first.margin.top = Dimension.auto()
  first.margin.bottom = Dimension.auto()
  let a = run tree.append(rootId, move first) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut second = sized(30.0, 120.0)
  second.writingMode = WritingMode.VerticalLr
  second.margin.top = Dimension.auto()
  second.margin.bottom = Dimension.px(7.0)
  let b = run tree.append(rootId, move second) |> Effect.provideMut<Allocator>(&mut allocator)
  let layouts = run arrangeVertical(&tree, 100.0) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(a.index)).location.y == 30.0, "top/bottom auto margins center vertical inline size")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(b.index)).location.y == -27.0, "RTL overflow discards physical top margin")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(b.index)).location.x == 20.0, "vertical-lr block progression is left-to-right")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(0)).size.width == 50.0, "auto block size is physical width")
}

