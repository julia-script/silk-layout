import fragmentation { FragmentationError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.num.usize
import text { TextMeasure, TextError, TextContext, TextBreak, TextAnalysis, TextShapeRequest, TextRun }
import silk.core.effect { Effect }
import silk.testing.testing { Testing, AssertionError }
import geometry { Measure, MeasureRequest, Measured, BaselineSet, NaturalDimensions, ScrollbarRequest, ScrollbarMetrics, FontRequest, FontMetrics, Size, Rect, OptionalSize, AvailableSpace, AvailableKind, max }
import style { Style, Display, DisplayOutside, DisplayInside, Dimension, DimensionKind, Direction, Float, Clear, Position, WritingMode, Align, Overflow, OverflowAlignment }
import tree { Tree, LayoutTree, InvalidNode }
import context { Input }
import engine { layoutNode, layoutNodeInPlace, probeNode }
import layout_pass { LayoutPass }
import box_tree as Boxes
import box_tree { BoxTree }

struct FixedMeasure {}
impl Measure for FixedMeasure {
  fn font(provider: &mut Self, request: FontRequest) -> FontMetrics {
    drop provider
    drop request
    return FontMetrics.zero()
  }
  fn scrollbars(provider: &mut Self, request: ScrollbarRequest) -> ScrollbarMetrics {
    drop provider
    drop request
    return ScrollbarMetrics.zero()
  }
  fn natural(provider: &mut Self, key: usize) -> NaturalDimensions {
    drop provider
    drop key
    return NaturalDimensions.none()
  }
  fn measure(provider: &mut Self, key: usize, request: MeasureRequest) -> Measured {
    drop provider
    drop key
    let mut width: f32 = 80.0
    if request.width.kind == AvailableKind.MinContent { width = 20.0 }
    if request.known.widthDefinite { width = request.known.width }
    let mut height: f32 = 12.0
    if request.known.heightDefinite { height = request.known.height }
    return Measured { size: Size { width: width, height: height }, scrollableOverflow: Rect { x: 0.0, y: 0.0, width: max(20.0, width), height: 12.0 }, contentBlockSize: 12.0, firstBaselines: BaselineSet.uniform(9.0), lastBaselines: BaselineSet.uniform(9.0), hasBaseline: true, hasLineBoxes: true }
  }
}
impl TextMeasure for FixedMeasure {
  fn beginTextLayout(provider: &mut Self) { drop provider }
  effect fn analyze(provider: &mut Self, context: TextContext, output: &mut List<TextBreak>) -> TextAnalysis ! OutOfMemoryError | TextError ? &mut Allocator {
    drop provider
    drop output
    let mut source = usize.MAX
    if context.tokens.length > 0 { source = context.tokens[0].source }
    fail TextError { source: source, message: "box-only fixture does not support text" }
  }
  effect fn shape(provider: &mut Self, request: TextShapeRequest, output: &mut List<TextRun>) ! OutOfMemoryError | TextError ? &mut Allocator {
    drop provider
    drop output
    let mut source = usize.MAX
    if request.start.unit < request.context.tokens.length { source = request.context.tokens[request.start.unit].source }
    fail TextError { source: source, message: "box-only fixture does not support text" }
  }
}
fn sized(width: f32, height: f32) -> Style {
  let mut style = Style.make()
  style.width = Dimension.px(width)
  style.height = Dimension.px(height)
  return move style
}
effect fn arrange(tree: &Tree, width: f32) -> LayoutTree ! OutOfMemoryError | TextError | FragmentationError ? &mut Allocator {
  let mut layouts = LayoutTree.make()
  let constructed = run Boxes.build(tree.nodes.asSlice(), tree.styles.asSlice(), tree.grids.asSlice(), tree.gridNames.asSlice(), WritingMode.HorizontalTb, Direction.Ltr)
  let rootBox = constructed.firstBySource.get(tree.root().index)
  run layouts.prepare(constructed.boxes.length())
  let mut measure = FixedMeasure {}
  let mut input = Input.make(OptionalSize.none())
  input.known.width = width
  input.known.widthDefinite = true
  input.availableWidth = AvailableSpace.definite(width)
  input.blockRoot = true
  let mut pass = run LayoutPass.make(layouts.boxes.asMutSlice(), &mut layouts.fragments, constructed.sources)
  let result = run layoutNode(&constructed, &mut pass, &mut measure, rootBox, &input)
  drop result
  drop pass
  layouts.fragments.resolveLocations()
  layouts.adopt(move constructed)
  return move layouts
}

test effect fn blockAutoMarginsAndRtlOverconstraint() -> () ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut root = Style.make()
  root.direction = Direction.Rtl
  let mut tree = run Tree.make(move root) |> Effect.provideMut<Allocator>(&mut allocator)
  let rootId = tree.root()
  let mut centered = sized(80.0, 10.0)
  centered.margin.left = Dimension.auto()
  centered.margin.right = Dimension.auto()
  let a = run tree.append(rootId, move centered) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut overflow = sized(240.0, 10.0)
  overflow.direction = Direction.Ltr
  overflow.margin.left = Dimension.auto()
  overflow.margin.right = Dimension.px(7.0)
  let b = run tree.append(rootId, move overflow) |> Effect.provideMut<Allocator>(&mut allocator)
  let layouts = run arrange(&tree, 200.0) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(a.index)).location.x == 60.0, "both auto margins divide positive free space")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(b.index)).location.x == -47.0, "RTL containing block discards left margin under overconstraint")
}

test effect fn blockEmptyChainRetainsNegativeMarginExtrema() -> () ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut tree = run Tree.make(Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let rootId = tree.root()
  let mut first = sized(10.0, 10.0)
  first.margin.bottom = Dimension.px(20.0)
  let a = run tree.append(rootId, move first) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut empty = Style.make()
  empty.margin.top = Dimension.px(30.0)
  empty.margin.bottom = Dimension.px(-15.0)
  let b = run tree.append(rootId, move empty) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut last = sized(10.0, 10.0)
  last.margin.top = Dimension.px(-25.0)
  let c = run tree.append(rootId, move last) |> Effect.provideMut<Allocator>(&mut allocator)
  let layouts = run arrange(&tree, 200.0) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(a.index)).location.y == 0.0, "first block begins at content top")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(b.index)).location.y == 40.0, "empty border edge excludes its own bottom margin")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(c.index)).location.y == 15.0, "adjoining set uses max positive plus most negative")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(0)).size.height == 25.0, "empty border edge does not inflate auto height")
}

test effect fn blockParentChildMarginsEscapeOnlyOpenBoundaries() -> () ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut tree = run Tree.make(Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let rootId = tree.root()
  let mut parent = Style.make()
  parent.margin.top = Dimension.px(10.0)
  parent.margin.bottom = Dimension.px(5.0)
  let a = run tree.append(rootId, move parent) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut inner = sized(10.0, 10.0)
  inner.margin.top = Dimension.px(30.0)
  inner.margin.bottom = Dimension.px(20.0)
  let b = run tree.append(a, move inner) |> Effect.provideMut<Allocator>(&mut allocator)
  let c = run tree.append(rootId, sized(10.0, 10.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  let layouts = run arrange(&tree, 200.0) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(a.index)).location.y == 30.0, "child top margin collapses outside parent")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(a.index)).size.height == 10.0, "escaped margins do not count toward parent height")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(b.index)).location.y == 0.0, "collapsed child shares parent border top")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(c.index)).location.y == 60.0, "child bottom margin joins parent bottom margin")
}

test effect fn blockPaddingAndFlowRootStopChildMarginCollapse() -> () ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut tree = run Tree.make(Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let rootId = tree.root()
  let mut parent = Style.make()
  parent.padding.top = Dimension.px(3.0)
  parent.border.bottom = Dimension.px(2.0)
  let a = run tree.append(rootId, move parent) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut inner = sized(10.0, 10.0)
  inner.margin.top = Dimension.px(11.0)
  inner.margin.bottom = Dimension.px(13.0)
  let b = run tree.append(a, move inner) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut flowRoot = Style.make()
  flowRoot.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.FlowRoot }
  let c = run tree.append(rootId, move flowRoot) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut nested = sized(10.0, 10.0)
  nested.margin.top = Dimension.px(7.0)
  nested.margin.bottom = Dimension.px(9.0)
  let d = run tree.append(c, move nested) |> Effect.provideMut<Allocator>(&mut allocator)
  let layouts = run arrange(&tree, 200.0) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(b.index)).location.y == 14.0, "padding blocks top margin collapse")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(a.index)).size.height == 39.0, "bottom border retains last child bottom margin")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(d.index)).location.y == 7.0, "flow root retains top margin without padding")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(c.index)).size.height == 26.0, "flow root retains bottom margin")
}

test effect fn blockMinimumHeightStopsEmptyMarginThrough() -> () ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut tree = run Tree.make(Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let rootId = tree.root()
  let mut parent = Style.make()
  parent.minHeight = Dimension.px(50.0)
  parent.margin.bottom = Dimension.px(7.0)
  let a = run tree.append(rootId, move parent) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut empty = Style.make()
  empty.margin.top = Dimension.px(20.0)
  empty.margin.bottom = Dimension.px(30.0)
  let b = run tree.append(a, move empty) |> Effect.provideMut<Allocator>(&mut allocator)
  let c = run tree.append(rootId, sized(10.0, 10.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  let layouts = run arrange(&tree, 200.0) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(a.index)).location.y == 30.0, "empty child margins join parent top")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(b.index)).location.y == 0.0, "empty child remains on collapsed top edge")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(c.index)).location.y == 87.0, "minimum height prevents top set escaping at bottom")
}

test effect fn blockFloatsPackWrapClearAndContributeToRootHeight() -> () ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut tree = run Tree.make(Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let rootId = tree.root()
  let mut left = sized(60.0, 30.0)
  left.float = Float.Left
  let a = run tree.append(rootId, move left) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut right = sized(50.0, 20.0)
  right.float = Float.Right
  let b = run tree.append(rootId, move right) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut wrap = sized(100.0, 15.0)
  wrap.float = Float.Left
  let c = run tree.append(rootId, move wrap) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut clear = sized(20.0, 5.0)
  clear.clear = Clear.Both
  clear.margin.top = Dimension.px(4.0)
  let d = run tree.append(rootId, move clear) |> Effect.provideMut<Allocator>(&mut allocator)
  let layouts = run arrange(&tree, 180.0) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(a.index)).location.x == 0.0, "left float uses left edge")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(b.index)).location.x == 130.0, "right float uses right edge")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(c.index)).location.y == 20.0, "float chooses earliest fitting band")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(c.index)).location.x == 60.0, "float avoids remaining left float")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(d.index)).location.y == 35.0, "clearance places border edge at float bottom")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(0)).size.height == 40.0, "root auto height includes cleared flow")
}

test effect fn blockFloatContainmentDiffersFromOrdinaryBlock() -> () ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut tree = run Tree.make(Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let rootId = tree.root()
  let a = run tree.append(rootId, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut floatA = sized(20.0, 30.0)
  floatA.float = Float.Left
  let childA = run tree.append(a, move floatA) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut parent = Style.make()
  parent.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.FlowRoot }
  let b = run tree.append(rootId, move parent) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut floatB = sized(20.0, 40.0)
  floatB.float = Float.Left
  let childB = run tree.append(b, move floatB) |> Effect.provideMut<Allocator>(&mut allocator)
  let layouts = run arrange(&tree, 200.0) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(childA.index)).size.height == 30.0, "ordinary block still lays out floated descendants")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(a.index)).size.height == 0.0, "ordinary block excludes its floats from auto height")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(childB.index)).size.height == 40.0, "flow root lays out floated descendants")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(b.index)).size.height == 40.0, "flow root contains its floats")
}

test effect fn blockFlowRootAvoidsFloatWithAutoWidth() -> () ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut tree = run Tree.make(Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let rootId = tree.root()
  let mut floated = sized(60.0, 30.0)
  floated.float = Float.Left
  let a = run tree.append(rootId, move floated) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut parent = Style.make()
  parent.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.FlowRoot }
  parent.height = Dimension.px(10.0)
  let b = run tree.append(rootId, move parent) |> Effect.provideMut<Allocator>(&mut allocator)
  let layouts = run arrange(&tree, 200.0) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(a.index)).location.y == 0.0, "float begins at root top")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(b.index)).location.x == 60.0, "flow root avoids float border area")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(b.index)).size.width == 140.0, "auto-width flow root occupies remaining strip")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(0)).size.height == 30.0, "root includes float extending below normal flow")
}

test effect fn blockContentsFlattensAndOutOfFlowDoesNotStack() -> () ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut tree = run Tree.make(Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let rootId = tree.root()
  let mut contents = Style.make()
  contents.display = Display.Contents
  let a = run tree.append(rootId, move contents) |> Effect.provideMut<Allocator>(&mut allocator)
  let b = run tree.append(a, sized(20.0, 10.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut absolute = sized(10.0, 100.0)
  absolute.position = Position.Absolute
  let c = run tree.append(a, move absolute) |> Effect.provideMut<Allocator>(&mut allocator)
  let d = run tree.append(rootId, sized(20.0, 15.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  let layouts = run arrange(&tree, 200.0) |> Effect.provideMut<Allocator>(&mut allocator)
  drop c
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(b.index)).location.y == 0.0, "contents child participates in root flow")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(d.index)).location.y == 10.0, "absolute child consumes no stack height")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(0)).size.height == 25.0, "contents wrapper contributes no extra box")
}

test effect fn blockIntrinsicWidthsUseMeasuredChildContributions() -> () ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut tree = run Tree.make(Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let rootId = tree.root()
  let mut child = Style.make()
  child.margin.left = Dimension.px(3.0)
  child.margin.right = Dimension.px(7.0)
  let a = run tree.append(rootId, move child) |> Effect.provideMut<Allocator>(&mut allocator)
  run tree.setMeasurement(a, 0)
  let mut layouts = LayoutTree.make()
  let constructed = run Boxes.build(tree.nodes.asSlice(), tree.styles.asSlice(), tree.grids.asSlice(), tree.gridNames.asSlice(), WritingMode.HorizontalTb, Direction.Ltr) |> Effect.provideMut<Allocator>(&mut allocator)
  let rootBox = constructed.firstBySource.get(rootId.index)
  run layouts.prepare(constructed.boxes.length()) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut measure = FixedMeasure {}
  let mut input = Input.make(OptionalSize.none())
  input.availableWidth = AvailableSpace.minContent()
  input.blockRoot = true
  let mut pass = run LayoutPass.make(layouts.boxes.asMutSlice(), &mut layouts.fragments, constructed.sources) |> Effect.provideMut<Allocator>(&mut allocator)
  let narrow = run layoutNode(&constructed, &mut pass, &mut measure, rootBox, &input) |> Effect.provideMut<Allocator>(&mut allocator)
  input.availableWidth = AvailableSpace.maxContent()
  pass.fragments.rollback(0)
  let wide = run layoutNode(&constructed, &mut pass, &mut measure, rootBox, &input) |> Effect.provideMut<Allocator>(&mut allocator)
  drop pass
  layouts.fragments.resolveLocations()
  layouts.adopt(move constructed)
  run Testing.expect(narrow.size.width == 30.0, "min-content width includes measured minimum and margins")
  run Testing.expect(wide.size.width == 90.0, "max-content width includes measured maximum and margins")
  run Testing.expect(wide.size.height == 12.0, "auto block height comes from measured child")
  run Testing.expect(wide.firstBaselines.alphabetic == 9.0 && wide.lastBaselines.alphabetic == 9.0, "block exports measured child baselines")
}

test effect fn blockClearanceCanBeNegativeWithoutAddingMarginsTwice() -> () ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut tree = run Tree.make(Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let rootId = tree.root()
  let mut first = sized(10.0, 10.0)
  first.margin.bottom = Dimension.px(40.0)
  let a = run tree.append(rootId, move first) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut floated = sized(10.0, 20.0)
  floated.float = Float.Left
  let b = run tree.append(rootId, move floated) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut last = sized(10.0, 10.0)
  last.clear = Clear.Left
  last.margin.top = Dimension.px(30.0)
  let c = run tree.append(rootId, move last) |> Effect.provideMut<Allocator>(&mut allocator)
  let layouts = run arrange(&tree, 200.0) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(a.index)).location.y == 0.0, "first block starts normally")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(b.index)).location.y == 50.0, "float starts after preceding collapsed-through margin")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(c.index)).location.y == 70.0, "negative clearance avoids adding both margins to float bottom")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(c.index)).hasClearance, "actual clearance is recorded independently of clear property")
}

test effect fn blockNegativeInlineMarginsAndMaximumWidthRebalance() -> () ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut tree = run Tree.make(Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let rootId = tree.root()
  let mut widened = Style.make()
  widened.height = Dimension.px(10.0)
  widened.margin.left = Dimension.px(-10.0)
  widened.margin.right = Dimension.px(-20.0)
  let a = run tree.append(rootId, move widened) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut capped = Style.make()
  capped.height = Dimension.px(10.0)
  capped.maxWidth = Dimension.px(100.0)
  capped.margin.left = Dimension.auto()
  capped.margin.right = Dimension.auto()
  let b = run tree.append(rootId, move capped) |> Effect.provideMut<Allocator>(&mut allocator)
  let layouts = run arrange(&tree, 200.0) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(a.index)).location.x == -10.0, "negative start margin shifts border box")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(a.index)).size.width == 230.0, "auto width absorbs negative margins")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(b.index)).size.width == 100.0, "maximum width clamps auto fill")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(b.index)).location.x == 50.0, "auto margins rebalance after maximum-width clamp")
}

test effect fn blockFlowRootMinimumWidthMovesBelowFloatAndRefills() -> () ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut tree = run Tree.make(Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let rootId = tree.root()
  let mut floated = sized(100.0, 30.0)
  floated.float = Float.Left
  let a = run tree.append(rootId, move floated) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut flowRoot = Style.make()
  flowRoot.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.FlowRoot }
  flowRoot.minWidth = Dimension.px(150.0)
  flowRoot.height = Dimension.px(10.0)
  let b = run tree.append(rootId, move flowRoot) |> Effect.provideMut<Allocator>(&mut allocator)
  let layouts = run arrange(&tree, 200.0) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(a.index)).location.y == 0.0, "float starts at content top")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(b.index)).location.y == 30.0, "minimum width cannot overlap float")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(b.index)).location.x == 0.0, "cleared band starts at content left")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(b.index)).size.width == 200.0, "auto width expands again below float")
}

effect fn arrangeVertical(tree: &Tree, inlineSize: f32) -> LayoutTree ! OutOfMemoryError | TextError | FragmentationError ? &mut Allocator {
  let mut layouts = LayoutTree.make()
  let constructed = run Boxes.build(tree.nodes.asSlice(), tree.styles.asSlice(), tree.grids.asSlice(), tree.gridNames.asSlice(), WritingMode.HorizontalTb, Direction.Ltr)
  let rootBox = constructed.firstBySource.get(tree.root().index)
  run layouts.prepare(constructed.boxes.length())
  let mut measure = FixedMeasure {}
  let mut input = Input.make(OptionalSize.none())
  input.parentWritingMode = tree.styles.asSlice()[tree.nodes.asSlice()[0].styleIndex].writingMode
  input.known.height = inlineSize
  input.known.heightDefinite = true
  input.availableHeight = AvailableSpace.definite(inlineSize)
  input.blockRoot = true
  let mut pass = run LayoutPass.make(layouts.boxes.asMutSlice(), &mut layouts.fragments, constructed.sources)
  let result = run layoutNode(&constructed, &mut pass, &mut measure, rootBox, &input)
  drop result
  drop pass
  layouts.fragments.resolveLocations()
  layouts.adopt(move constructed)
  return move layouts
}

test effect fn blockVerticalRlStacksFromRightAndCollapsesPhysicalSideMargins() -> () ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut root = Style.make()
  root.writingMode = WritingMode.VerticalRl
  root.padding.right = Dimension.px(3.0)
  root.padding.left = Dimension.px(2.0)
  let mut tree = run Tree.make(move root) |> Effect.provideMut<Allocator>(&mut allocator)
  let rootId = tree.root()
  let mut first = sized(20.0, 40.0)
  first.writingMode = WritingMode.VerticalRl
  first.margin.right = Dimension.px(10.0)
  first.margin.left = Dimension.px(30.0)
  let a = run tree.append(rootId, move first) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut second = sized(15.0, 40.0)
  second.writingMode = WritingMode.VerticalRl
  second.margin.right = Dimension.px(-5.0)
  let b = run tree.append(rootId, move second) |> Effect.provideMut<Allocator>(&mut allocator)
  let layouts = run arrangeVertical(&tree, 100.0) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(0)).size.width == 75.0, "auto physical width sums block-axis extents")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(a.index)).location.x == 42.0, "first vertical-rl block starts at right padding plus margin")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(b.index)).location.x == 2.0, "second block follows collapsed left/right margin set")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(a.index)).location.y == 0.0, "vertical ltr inline axis starts at top")
}

