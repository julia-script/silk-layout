  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(b.index)).location.y == 49.0, "content moves as a unit without introducing inter-child gaps")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(0)).firstBaselines.alphabetic == 38.0, "exported baseline follows aligned content")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(0)).size.height == 110.0, "alignment does not alter border-box size")
}

test effect fn blockAlignContentDistributionUsesSingleSubjectFallbacks() -> () ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let around = run alignedChild(Align.SpaceAround, OverflowAlignment.Default, Overflow.Visible, 100.0, 20.0) |> Effect.provideMut<Allocator>(&mut allocator)
  let evenly = run alignedChild(Align.SpaceEvenly, OverflowAlignment.Default, Overflow.Visible, 100.0, 20.0) |> Effect.provideMut<Allocator>(&mut allocator)
  let between = run alignedChild(Align.SpaceBetween, OverflowAlignment.Default, Overflow.Visible, 100.0, 20.0) |> Effect.provideMut<Allocator>(&mut allocator)
  let stretch = run alignedChild(Align.Stretch, OverflowAlignment.Default, Overflow.Visible, 100.0, 20.0) |> Effect.provideMut<Allocator>(&mut allocator)
  let last = run alignedChild(Align.LastBaseline, OverflowAlignment.Default, Overflow.Visible, 100.0, 20.0) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(around.boxes.get(around.firstBySource.get(1)).location.y == 40.0 && evenly.boxes.get(evenly.firstBySource.get(1)).location.y == 40.0, "space-around and space-evenly fall back to center")
  run Testing.expect(between.boxes.get(between.firstBySource.get(1)).location.y == 0.0 && stretch.boxes.get(stretch.firstBySource.get(1)).location.y == 0.0, "space-between and stretch fall back to start")
  run Testing.expect(stretch.boxes.get(stretch.firstBySource.get(1)).size.height == 20.0, "block content stretch does not stretch child boxes")
  run Testing.expect(last.boxes.get(last.firstBySource.get(1)).location.y == 80.0, "last baseline outside a shared group falls back to end")
}

test effect fn blockAlignContentOverflowDistinguishesDefaultSafeUnsafe() -> () ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let normal = run alignedChild(Align.Center, OverflowAlignment.Default, Overflow.Visible, 20.0, 60.0) |> Effect.provideMut<Allocator>(&mut allocator)
  let unsafeResult = run alignedChild(Align.Center, OverflowAlignment.Unsafe, Overflow.Visible, 20.0, 60.0) |> Effect.provideMut<Allocator>(&mut allocator)
  let scrolling = run alignedChild(Align.Center, OverflowAlignment.Default, Overflow.Scroll, 20.0, 60.0) |> Effect.provideMut<Allocator>(&mut allocator)
  let safeScroll = run alignedChild(Align.End, OverflowAlignment.Safe, Overflow.Scroll, 20.0, 60.0) |> Effect.provideMut<Allocator>(&mut allocator)
  let distribution = run alignedChild(Align.SpaceAround, OverflowAlignment.Default, Overflow.Scroll, 20.0, 60.0) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(normal.boxes.get(normal.firstBySource.get(1)).location.y == 0.0, "non-scroll block default overflow alignment is safe")
  run Testing.expect(unsafeResult.boxes.get(unsafeResult.firstBySource.get(1)).location.y == -20.0, "explicit unsafe preserves requested center during overflow")
  run Testing.expect(scrolling.boxes.get(scrolling.firstBySource.get(1)).location.y == -20.0, "scrollable block-axis default alignment is unsafe")
  run Testing.expect(safeScroll.boxes.get(safeScroll.firstBySource.get(1)).location.y == 0.0, "explicit safe overrides scroll-container default")
  run Testing.expect(distribution.boxes.get(distribution.firstBySource.get(1)).location.y == 0.0, "distribution fallback remains safe in a scroll container")
}

