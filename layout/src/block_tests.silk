  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(0)).size.width == 85.0, "escaped right/left margins remain in outer flow")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(a.index)).size.width == 20.0, "collapsed child side margins do not inflate parent width")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(a.index)).location.x == 35.0, "parent block-start uses child's larger right margin")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(b.index)).location.x == 0.0, "child shares parent's right border edge")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(c.index)).location.x == 0.0, "next sibling follows collapsed block-end margin")
}

