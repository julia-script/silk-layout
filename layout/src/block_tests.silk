// CSS 2.2 §§8.3.1, 9.4.1; Flexbox 1 §3. A flex container's own
// block margins still collapse with siblings, unlike its item margins.
test effect fn blockFlexAndReplacedSiblingMarginsKeepSignedExtrema() -> () ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut root = Style.make()
  root.padding.top = Dimension.px(8.0)
  root.padding.bottom = Dimension.px(8.0)
  let mut tree = run Tree.make(move root) |> Effect.provideMut<Allocator>(&mut allocator)
  let rootId = tree.root()
  let mut first = sized(80.0, 34.0)
  first.margin.top = Dimension.px(10.0)
  first.margin.bottom = Dimension.px(-3.0)
  let a = run tree.append(rootId, move first) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut flex = sized(33.0, 18.0)
  flex.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
  flex.padding.top = Dimension.px(2.0)
  flex.padding.bottom = Dimension.px(2.0)
  flex.margin.top = Dimension.px(4.0)
  flex.margin.bottom = Dimension.px(-3.0)
  let b = run tree.append(rootId, move flex) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut replaced = sized(20.0, 10.0)
  replaced.replaced = true
  replaced.margin.top = Dimension.px(-5.0)
  replaced.margin.bottom = Dimension.px(2.0)
  let c = run tree.append(rootId, move replaced) |> Effect.provideMut<Allocator>(&mut allocator)
  let layouts = run arrange(&tree, 200.0) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(a.index)).location.y == 18.0, "padding retains first block top margin")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(b.index)).location.y == 53.0, "positive flex top margin joins preceding negative bottom margin")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(c.index)).location.y == 70.0, "two negative margins use the more negative extremum")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(0)).size.height == 90.0, "last replaced margin remains inside bottom padding")
}

// CSS 2.2 §§8.3.1 and 10.6.3; Flexbox 1 §3. Empty flex containers
// remain formatting-context boundaries, including when their used height is zero.
test effect fn blockAutoHeightIncludesFlexMarginsAndEmptyFlexBoundary() -> () ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut tree = run Tree.make(Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let rootId = tree.root()
  let mut parent = Style.make()
  parent.padding.top = Dimension.px(12.0)
  parent.padding.bottom = Dimension.px(12.0)
  let a = run tree.append(rootId, move parent) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut flex = sized(40.0, 96.0)
  flex.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
  flex.padding.top = Dimension.px(3.0)
  flex.padding.bottom = Dimension.px(3.0)
  flex.margin.top = Dimension.px(11.0)
  flex.margin.bottom = Dimension.px(11.0)
  let b = run tree.append(a, move flex) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut empty = Style.make()
  empty.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
  empty.margin.top = Dimension.px(6.0)
  empty.margin.bottom = Dimension.px(6.0)
  let c = run tree.append(a, move empty) |> Effect.provideMut<Allocator>(&mut allocator)
  let layouts = run arrange(&tree, 200.0) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(b.index)).location.y == 23.0, "flex border top follows parent padding and own margin")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(c.index)).location.y == 136.0, "empty flex top uses collapsed sibling margin")
  run Testing.expect(!layouts.boxes.get(layouts.firstBySource.get(c.index)).collapsesThrough, "empty flex cannot join its own top and bottom margins")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(a.index)).size.height == 154.0, "auto height retains flex bottom margin behind padding")
}

// CSS 2.2 §8.3.1: an independent formatting context prevents inward
// collapse, not its own outer margins collapsing with an ordinary parent.
test effect fn blockParentExportsFlexOuterMarginsWithoutCollapsingItems() -> () ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut tree = run Tree.make(Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let rootId = tree.root()
  let mut wrapper = Style.make()
  wrapper.margin.top = Dimension.px(6.0)
  wrapper.margin.bottom = Dimension.px(2.0)
  let a = run tree.append(rootId, move wrapper) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut flex = sized(40.0, 10.0)
  flex.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
  flex.margin.top = Dimension.px(13.0)
  flex.margin.bottom = Dimension.px(7.0)
  let b = run tree.append(a, move flex) |> Effect.provideMut<Allocator>(&mut allocator)
  let c = run tree.append(rootId, sized(10.0, 10.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  let layouts = run arrange(&tree, 200.0) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(a.index)).location.y == 13.0, "flex outer top margin escapes through unpadded block")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(b.index)).location.y == 0.0, "escaped margin does not also offset flex inside parent")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(a.index)).size.height == 10.0, "escaped outer margins do not inflate wrapper")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(c.index)).location.y == 30.0, "flex outer bottom margin participates through wrapper")
}

// CSS 2.2 §§10.6.3 and 8.3.1: overflowing descendants do not enlarge
// a specified block height or change the following sibling's normal-flow origin.
test effect fn blockExplicitHeightKeepsNestedPaddingAndFollowingFlow() -> () ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut root = Style.make()
  root.padding.top = Dimension.px(11.0)
  let mut tree = run Tree.make(move root) |> Effect.provideMut<Allocator>(&mut allocator)
  let rootId = tree.root()
  let mut parent = sized(86.0, 11.0)
  parent.padding.top = Dimension.px(4.0)
  parent.padding.bottom = Dimension.px(4.0)
  parent.margin.top = Dimension.px(7.0)
  parent.margin.bottom = Dimension.px(-1.0)
  let a = run tree.append(rootId, move parent) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut child = Style.make()
  child.padding.top = Dimension.px(7.0)
  child.padding.bottom = Dimension.px(7.0)
  child.margin.top = Dimension.px(2.0)
  child.margin.bottom = Dimension.px(5.0)
  let b = run tree.append(a, move child) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut sibling = sized(70.0, 51.0)
  sibling.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
  sibling.margin.top = Dimension.px(2.0)
  let c = run tree.append(rootId, move sibling) |> Effect.provideMut<Allocator>(&mut allocator)
  let layouts = run arrange(&tree, 249.0) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(a.index)).location.y == 18.0, "specified-height parent follows root padding and margin")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(a.index)).size.height == 19.0, "specified content height plus padding controls border height")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(b.index)).location.y == 6.0, "nested child retains parent padding and own top margin")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(b.index)).size.height == 14.0, "empty auto-height child retains its padding")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(c.index)).location.y == 38.0, "following sibling uses parent border bottom, not descendant overflow")
}

// CSS 2.2 §9.5, https://www.w3.org/TR/CSS22/visuren.html#bfc-next-to-float:
// block-level replaced border boxes must avoid floats in their BFC.
test effect fn blockReplacedChildrenAvoidSiblingFloatMarginBoxes() -> () ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut tree = run Tree.make(Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let rootId = tree.root()
  let mut floated = sized(50.0, 25.0)
  floated.float = Float.Left
  floated.margin.right = Dimension.px(10.0)
  floated.margin.bottom = Dimension.px(5.0)
  let a = run tree.append(rootId, move floated) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut narrow = sized(100.0, 10.0)
  narrow.replaced = true
  let b = run tree.append(rootId, move narrow) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut wide = sized(160.0, 10.0)
  wide.replaced = true
  let c = run tree.append(rootId, move wide) |> Effect.provideMut<Allocator>(&mut allocator)
  let layouts = run arrange(&tree, 200.0) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(a.index)).location.y == 0.0, "float establishes first available exclusion band")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(b.index)).location.x == 60.0, "replaced border box avoids float including its right margin")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(b.index)).location.y == 0.0, "fitting replaced element remains beside the float")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(c.index)).location.x == 0.0, "wide replaced element returns to containing block edge")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(c.index)).location.y == 30.0, "nonfitting replaced element clears float bottom margin edge")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(0)).size.height == 40.0, "auto height includes the relocated in-flow replaced element")
}

// CSS 2.2 §§9.4.1, 9.5 and 9.5.2: ordinary descendants remain in
// their ancestor's BFC; padding changes coordinates, not exclusion ownership.
test effect fn blockInheritedFloatsReachNestedFlowRootsAndClearance() -> () ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut tree = run Tree.make(Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let rootId = tree.root()
  let mut floated = sized(60.0, 40.0)
  floated.float = Float.Left
  let a = run tree.append(rootId, move floated) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut wrapper = Style.make()
  wrapper.padding.left = Dimension.px(10.0)
  wrapper.padding.top = Dimension.px(5.0)
  let b = run tree.append(rootId, move wrapper) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut flowRoot = Style.make()
  flowRoot.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.FlowRoot }
  flowRoot.height = Dimension.px(10.0)
  let c = run tree.append(b, move flowRoot) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut cleared = sized(20.0, 10.0)
  cleared.clear = Clear.Both
  cleared.margin.top = Dimension.px(3.0)
  let d = run tree.append(b, move cleared) |> Effect.provideMut<Allocator>(&mut allocator)
  let layouts = run arrange(&tree, 200.0) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(a.index)).size.height == 40.0, "ancestor float supplies the shared exclusion")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(b.index)).location.x == 0.0, "ordinary block itself does not avoid ancestor float")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(c.index)).location.x == 60.0, "nested flow-root avoids float in root coordinates")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(c.index)).location.y == 5.0, "nested flow-root stays at padded content top")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(c.index)).size.width == 140.0, "nested flow-root uses remaining shared float band")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(d.index)).location.y == 40.0, "nested clear reaches the ancestor float bottom")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(b.index)).size.height == 50.0, "ordinary auto height includes its cleared in-flow child")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(0)).size.height == 50.0, "root contains resulting in-flow height")
}

// CSS 2.2 §9.5.1 source-order rules and §10.6.7 include floated
// descendants sharing the BFC even when their ordinary parent excludes them.
test effect fn blockNestedFloatsAffectLaterSiblingsAndRootAutoHeight() -> () ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut tree = run Tree.make(Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let rootId = tree.root()
  let mut wrapper = Style.make()
  wrapper.margin.left = Dimension.px(20.0)
  wrapper.padding.top = Dimension.px(7.0)
  let a = run tree.append(rootId, move wrapper) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut nested = sized(40.0, 30.0)
  nested.float = Float.Left
  nested.margin.bottom = Dimension.px(5.0)
  let b = run tree.append(a, move nested) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut sibling = sized(50.0, 20.0)
  sibling.float = Float.Left
  let c = run tree.append(rootId, move sibling) |> Effect.provideMut<Allocator>(&mut allocator)
  let layouts = run arrange(&tree, 200.0) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(a.index)).size.height == 7.0, "ordinary parent excludes descendant float from its auto height")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(b.index)).location.y == 7.0, "nested float starts at its containing block content top")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(c.index)).location.x == 60.0, "later sibling float packs beside nested float in same BFC")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(c.index)).location.y == 7.0, "later float respects nested earlier float source-order floor")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(0)).size.height == 42.0, "BFC root contains descendant float bottom margin edge")
}

// CSS 2.2 §§8.3.1 and 9.5.2: discovery of collapsed margins changes
// the shared-context origin before clearance is committed. Retries must not
// retain speculative floats or treat them as earlier source siblings.
test effect fn blockCollapsedOriginReplaysInheritedClearanceOnceCommitted() -> () ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut tree = run Tree.make(Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let rootId = tree.root()
  let mut floated = sized(60.0, 50.0)
  floated.float = Float.Left
  let a = run tree.append(rootId, move floated) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut wrapper = Style.make()
  wrapper.margin.top = Dimension.px(5.0)
  let b = run tree.append(rootId, move wrapper) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut first = sized(10.0, 10.0)
  first.margin.top = Dimension.px(20.0)
  let c = run tree.append(b, move first) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut clear = sized(10.0, 10.0)
  clear.clear = Clear.Both
  let d = run tree.append(b, move clear) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut nested = sized(20.0, 15.0)
  nested.float = Float.Left
  let e = run tree.append(b, move nested) |> Effect.provideMut<Allocator>(&mut allocator)
  let layouts = run arrange(&tree, 200.0) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(a.index)).location.y == 0.0, "earlier float origin is unaffected by descendant retries")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(b.index)).location.y == 20.0, "first descendant margin moves ordinary parent origin")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(c.index)).location.y == 0.0, "first margin is collapsed outside parent")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(d.index)).location.y == 30.0, "clearance is recomputed against final parent origin")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(b.index)).size.height == 40.0, "parent height reflects final clearance rather than trial origin")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(e.index)).location.x == 0.0, "speculative float is not retained as an exclusion")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(e.index)).location.y == 40.0, "committed nested float follows cleared block")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(0)).size.height == 75.0, "root contains only the committed descendant geometry")
}

// CSS 2.2 §§9.4.1 and 10.6.7: independent contexts isolate their floats,
// including floats overflowing a specified block height.
test effect fn blockIndependentContextDoesNotLeakOverflowingFloats() -> () ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut tree = run Tree.make(Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let rootId = tree.root()
  let mut flowRoot = sized(100.0, 10.0)
  flowRoot.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.FlowRoot }
  let a = run tree.append(rootId, move flowRoot) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut nested = sized(40.0, 60.0)
  nested.float = Float.Left
  let b = run tree.append(a, move nested) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut sibling = sized(20.0, 5.0)
  sibling.float = Float.Left
  let c = run tree.append(rootId, move sibling) |> Effect.provideMut<Allocator>(&mut allocator)
  let layouts = run arrange(&tree, 200.0) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(a.index)).size.height == 10.0, "specified height is not enlarged by internal float overflow")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(b.index)).size.height == 60.0, "independent context still lays out overflowing float")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(c.index)).location.x == 0.0, "outer float does not see independent descendant exclusion")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(c.index)).location.y == 10.0, "outer float starts after independent context border box")
  run Testing.expect(layouts.boxes.get(layouts.firstBySource.get(0)).size.height == 15.0, "root contains only floats participating in its own BFC")
}

// Flexbox 1 §4 and Display 3 §2.7: a flex item's float is inapplicable,
// and blockification is distinct from its independent formatting context.
test effect fn blockifiedItemIgnoresFloatButPreservesExplicitShrinkRequest() -> () ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut item = Style.make()
  item.display = Display.Box { outside: DisplayOutside.Inline, inside: DisplayInside.FlowRoot }
  item.float = Float.Left
  let mut tree = run Tree.make(move item) |> Effect.provideMut<Allocator>(&mut allocator)
  let rootId = tree.root()
  let mut child = sized(30.0, 10.0)
  child.margin.top = Dimension.px(10.0)
  let childId = run tree.append(rootId, move child) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut layouts = LayoutTree.make()
  let constructed = run Boxes.build(tree.nodes.asSlice(), tree.styles.asSlice(), tree.grids.asSlice(), tree.gridNames.asSlice(), WritingMode.HorizontalTb, Direction.Ltr) |> Effect.provideMut<Allocator>(&mut allocator)
  let rootBox = constructed.firstBySource.get(rootId.index)
  run layouts.prepare(constructed.boxes.length()) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut measure = FixedMeasure {}
  let mut input = Input.make(OptionalSize.none())
  input.blockify = true
  input.blockRoot = true
  input.availableWidth = AvailableSpace.definite(200.0)
  let mut pass = run LayoutPass.make(layouts.boxes.asMutSlice(), &mut layouts.fragments, constructed.sources) |> Effect.provideMut<Allocator>(&mut allocator)
  let filled = run layoutNode(&constructed, &mut pass, &mut measure, rootBox, &input) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(filled.size.width == 200.0, "inapplicable float does not force item shrink-to-fit")
  run Testing.expect(pass.boxes[constructed.firstBySource.get(childId.index)].location.y == 10.0, "blockified flow-root still has independent flex-item contents")
  input.shrinkToFit = true
  pass.fragments.rollback(0)
  let shrunk = run layoutNode(&constructed, &mut pass, &mut measure, rootBox, &input) |> Effect.provideMut<Allocator>(&mut allocator)
  drop pass
  layouts.fragments.resolveLocations()
  layouts.adopt(move constructed)
  run Testing.expect(shrunk.size.width == 30.0, "explicit hypothetical cross-size shrink-to-fit request remains effective")
}

effect fn expectMinimumProbe<'pass, 'source>(
  boxes: &BoxTree<'source>,
  pass: &mut LayoutPass<'pass, 'source>,
  measure: &mut FixedMeasure,
  id: usize,
  input: &Input,
  width: f32,
  height: f32,
)
  ! OutOfMemoryError | TextError | FragmentationError | AssertionError<'static>
  ? &mut Allocator {
  run probeNode(boxes, &mut pass, &mut measure, id, input)
  let actual = pass.boxes[id].size
  run Testing.expect(
    actual.width == width && actual.height == height,
    "request minima bound natural sizes and participate in effective probe keys",
  )
}

// Grid §6.6 supplies a used minimum, not a preferred size. Sizing §5.1
// intrinsic queries ignore the queried axis's min/max constraints, but a
// cross-axis constraint still applies. Changing only a floor must not reuse
// the previous bounded result.
effect fn checkMinimumProbeRequests(intrinsicMinima: bool)
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static>
  ? &mut Allocator {
  let mut style = Style.make()
  if intrinsicMinima {
    style.minWidth = Dimension.keyword(DimensionKind.MinContent)
    style.minHeight = Dimension.keyword(DimensionKind.MaxContent)
  }
  let mut tree = run Tree.make(move style)
  let root = tree.root()
  run tree.setMeasurement(root, 0)
  let boxes = run Boxes.build(
    tree.nodes.asSlice(),
    tree.styles.asSlice(),
    tree.grids.asSlice(),
    tree.gridNames.asSlice(),
    WritingMode.HorizontalTb,
    Direction.Ltr,
  )
  let id = boxes.firstBySource.get(root.index)
  let mut layouts = LayoutTree.make()
  run layouts.prepare(boxes.boxes.length())
  let mut pass = run LayoutPass.make(
    layouts.boxes.asMutSlice(),
    &mut layouts.fragments,
    boxes.sources,
  )
  let mut measure = FixedMeasure {}
  let mut input = Input.make(OptionalSize.none())
  input.blockRoot = true
  input.performLayout = false
  input.minimum = Size { width: 120.0, height: 30.0 }
  run expectMinimumProbe(&boxes, &mut pass, &mut measure, id, &input, 120.0, 30.0)
  if intrinsicMinima { return }

  input.minimum.height = 60.0
  run expectMinimumProbe(&boxes, &mut pass, &mut measure, id, &input, 120.0, 60.0)
  input.minimum.width = 40.0
  run expectMinimumProbe(&boxes, &mut pass, &mut measure, id, &input, 80.0, 60.0)

  input.minimum = Size { width: 40.0, height: 5.0 }
  run expectMinimumProbe(&boxes, &mut pass, &mut measure, id, &input, 80.0, 12.0)

  input.minimum = Size { width: 120.0, height: 30.0 }
  input.intrinsicWidth = true
  input.availableWidth = AvailableSpace.minContent()
  run expectMinimumProbe(&boxes, &mut pass, &mut measure, id, &input, 20.0, 30.0)

  input.intrinsicWidth = false
  input.availableWidth = AvailableSpace.maxContent()
  input.intrinsicHeight = true
  run expectMinimumProbe(&boxes, &mut pass, &mut measure, id, &input, 120.0, 12.0)

  input.intrinsicHeight = false
  input.known = OptionalSize.definite(50.0, 5.0)
  run expectMinimumProbe(&boxes, &mut pass, &mut measure, id, &input, 120.0, 30.0)
}

test effect fn blockRequestMinimumPreservesNaturalSizesAndProbeKeys()
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run checkMinimumProbeRequests(false) |> Effect.provideMut<Allocator>(&mut allocator)
}

// CSS2 §10.4: the minimum wins over a smaller maximum. CSS2 §10.5:
// a minimum height does not make an automatic height a definite percentage
// basis. The 120px parent makes the child's width 60px; its 50% height stays
// auto and follows its 6px child, rather than becoming 20px or inheriting 40px.
effect fn checkMinimumInheritance()
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static>
  ? &mut Allocator {
  let mut style = Style.make()
  style.width = Dimension.px(80.0)
  style.maxWidth = Dimension.px(90.0)
  let mut tree = run Tree.make(move style)
  let root = tree.root()
  let mut childStyle = Style.make()
  childStyle.width = Dimension.pct(0.5)
  childStyle.height = Dimension.pct(0.5)
  let child = run tree.append(root, move childStyle)
  let grandchild = run tree.append(child, sized(4.0, 6.0))
  let boxes = run Boxes.build(
    tree.nodes.asSlice(),
    tree.styles.asSlice(),
    tree.grids.asSlice(),
    tree.gridNames.asSlice(),
    WritingMode.HorizontalTb,
    Direction.Ltr,
  )
  let rootBox = boxes.firstBySource.get(root.index)
  let childBox = boxes.firstBySource.get(child.index)
  let grandchildBox = boxes.firstBySource.get(grandchild.index)
  let mut layouts = LayoutTree.make()
  run layouts.prepare(boxes.boxes.length())
  let mut pass = run LayoutPass.make(
    layouts.boxes.asMutSlice(),
    &mut layouts.fragments,
    boxes.sources,
  )
  let mut measure = FixedMeasure {}
  let mut input = Input.make(OptionalSize.none())
  input.blockRoot = true
  input.minimum = Size { width: 120.0, height: 40.0 }
  run layoutNodeInPlace(&boxes, &mut pass, &mut measure, rootBox, &input)
  run Testing.expect(
    pass.boxes[rootBox].size.width == 120.0 && pass.boxes[rootBox].size.height == 40.0
      && pass.boxes[childBox].size.width == 60.0
      && pass.boxes[childBox].size.height == 6.0
      && pass.boxes[grandchildBox].size.width == 4.0
      && pass.boxes[grandchildBox].size.height == 6.0,
    "request minima neither inherit nor establish an automatic-height percentage basis",
  )
}

test effect fn blockRequestMinimumDoesNotInheritOrMakePercentHeightDefinite()
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run checkMinimumInheritance() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Sizing §3.2 intrinsic min-size keywords are resolved after ordinary lengths.
// Resolving them must not erase the greater minimum supplied by the caller.
test effect fn blockRequestMinimumSurvivesIntrinsicAuthoredMinima()
  ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run checkMinimumProbeRequests(true) |> Effect.provideMut<Allocator>(&mut allocator)
}
