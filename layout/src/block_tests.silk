effect fn alignedChild(align: Align, safety: OverflowAlignment, overflow: Overflow, height: f32, childHeight: f32) -> LayoutTree ! OutOfMemoryError | TextError | FragmentationError | InvalidNode ? &mut Allocator {
  let mut root = Style.make()
  root.height = Dimension.px(height)
  root.alignContent = align
  root.alignContentSafety = safety
  root.overflowY = overflow
  let mut tree = run Tree.make(move root)
  let rootId = tree.root()
  let child = run tree.append(rootId, sized(10.0, childHeight))
  drop child
  let layouts = run arrange(&tree, 100.0)
  return move layouts
}

