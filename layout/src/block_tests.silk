  parent.margin.left = Dimension.px(5.0)
  let a = run tree.append(rootId, move parent) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut child = sized(20.0, 40.0)
  child.writingMode = WritingMode.VerticalRl
  child.margin.right = Dimension.px(30.0)
  child.margin.left = Dimension.px(25.0)
  let b = run tree.append(a, move child) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut sibling = sized(10.0, 40.0)
  sibling.writingMode = WritingMode.VerticalRl
  let c = run tree.append(rootId, move sibling) |> Effect.provideMut<Allocator>(&mut allocator)
