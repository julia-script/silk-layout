  let mut childStyle = Style.make()
  childStyle.width = Dimension.px(200.0)
  childStyle.height = Dimension.px(90.0)
  let root = tree.root()
  let child = run tree.append(root, move childStyle) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 0.0, maximum: 0.0, height: 0.0 }
