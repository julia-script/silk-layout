  let first = output.boxes.get(output.firstBySource.get(tree.root().index))
  run Testing.expect(first.size.width == 137.0 && first.location.x == 656.0, "CSS 2.1 10.3.3: root auto margin consumes space after max-width")
  let rootStyleIndex = tree.nodes.asSlice()[0].styleIndex
