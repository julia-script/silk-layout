test effect fn sourceBoundsUnionsLineExtentsButNotPointsWhenAreaExists() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.width = Dimension.px(40.0)
  style.height = Dimension.px(10.0)
  let tree = run Tree.make(move style) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 0.0, maximum: 0.0, height: 0.0 }
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(100.0, 100.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let box = output.firstBySource.get(root.index)
  let mut continuation = Fragment.make(box, root.index, FragmentKind.Box)
  continuation.location.x = 50.0
  continuation.location.y = 20.0
  continuation.size.height = 15.0
  drop run output.fragments.append(continuation) |> Effect.provideMut<Allocator>(&mut allocator)
  continuation.location.x = 200.0
  continuation.location.y = 100.0
  continuation.size.height = 0.0
  drop run output.fragments.append(continuation) |> Effect.provideMut<Allocator>(&mut allocator)
  output.fragments.resolveLocations()
  let bounds = run output.sourceBounds(root)
  run Testing.expect(bounds.x == 0.0 && bounds.y == 0.0 && bounds.width == 50.0 && bounds.height == 35.0, "CSSOM View bounding-box step 4 includes rectangles with nonzero height or width, not zero-by-zero points")
}

test effect fn blockInterruptionKeepsGeometryWithoutClonedPaintOrOverflow() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut rootStyle = Style.make()
  rootStyle.width = Dimension.px(100.0)
  let mut tree = run Tree.make(move rootStyle) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let mut inlineStyle = Style.make()
  inlineStyle.display = Display.Box { outside: DisplayOutside.Inline, inside: DisplayInside.Flow }
  inlineStyle.boxDecorationBreak = BoxDecorationBreak.Clone
  inlineStyle.border = Edges.all(Dimension.px(2.0))
  let inline = run tree.append(root, move inlineStyle) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut firstStyle = Style.make()
  firstStyle.width = Dimension.px(5.0)
  firstStyle.height = Dimension.px(15.0)
  drop run tree.append(inline, move firstStyle) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut lastStyle = Style.make()
  lastStyle.width = Dimension.px(10.0)
  lastStyle.height = Dimension.px(20.0)
  drop run tree.append(inline, move lastStyle) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 0.0, maximum: 0.0, height: 0.0 }
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(100.0, 100.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  let fragments = output.fragments.values.asSlice()
  let mut interruptions: usize = 0
  let mut painted: usize = 0
  let mut index: usize = 0
  while index < fragments.length {
    let fragment = &fragments[index]
    if fragment.source == inline.index && fragment.kind == FragmentKind.Inline {
      if fragment.nonpainting {
        interruptions = interruptions + 1
        run Testing.expect(fragment.size.width == 100.0 && fragment.size.height == 35.0, "interruption geometry spans consecutive blocks and the containing inline extent")
        run Testing.expect(fragment.decorationEdges == 0 && !fragment.first && !fragment.last, "clone must not paint interruption edges")
        run Testing.expect(fragment.layoutBounds.width == 0.0 && fragment.layoutBounds.height == 0.0 && fragment.scrollableOverflow.width == 0.0 && fragment.scrollableOverflow.height == 0.0, "nonpainting interruption geometry must not add layout or scrollable overflow")
      } else {
        painted = painted + 1
        run Testing.expect(fragment.decorationEdges != 0, "real surrounding inline fragments keep their decorations")
      }
    }
    index = index + 1
  }
  run Testing.expect(interruptions == 1 && painted == 2, "one nonpainting interruption separates the two real inline continuations")
}

test effect fn keptSizesSurviveUntilTheirSourcesChange() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
  style.width = Dimension.px(300.0)
  let mut tree = run Tree.make(move style) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let first = run tree.append(root, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run tree.append(root, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let third = run tree.append(root, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  run tree.setMeasurement(first, 0)
  run tree.setMeasurement(third, 0)
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 20.0, maximum: 60.0, height: 18.0 }
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  let probes = output.stats.sizeProbes
  run Testing.expect(probes > 0 && output.boxes.get(output.firstBySource.get(third.index)).location.x == 60.0, "flex items are sized by probes")
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(output.stats.sizeProbes == 0 && output.stats.fullLayouts == 0, "an unchanged tree reuses every kept result")
  let mut wide = Style.make()
  wide.width = Dimension.px(100.0)
  run tree.setStyle(second, move wide)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(output.stats.sizeProbes < probes && output.boxes.get(output.firstBySource.get(third.index)).location.x == 160.0, "a style change recomputes its box and ancestors and moves later siblings")
  content.maximum = 80.0
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(output.boxes.get(output.firstBySource.get(third.index)).location.x == 160.0, "provider changes are invisible until the caller reports them")
  output.invalidate()
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(output.boxes.get(output.firstBySource.get(third.index)).location.x == 180.0 && output.stats.cacheHits == 0, "invalidate discards every kept result")
  output.invalidate()
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(output.boxes.get(output.firstBySource.get(third.index)).location.x == 180.0 && output.stats.cacheHits == 0, "an invalidated unchanged tree lays out its kept boxes afresh")
  output.invalidate()
  let mut narrow = Style.make()
  narrow.width = Dimension.px(40.0)
  run tree.setStyle(second, move narrow)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(output.boxes.get(output.firstBySource.get(third.index)).location.x == 120.0 && output.stats.cacheHits == 0, "a change after invalidate rebuilds the boxes")
}

test effect fn cleanSubtreesAreCopiedNotLaidOut() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
  style.width = Dimension.px(300.0)
  let mut tree = run Tree.make(move style) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let mut panelStyle = Style.make()
  panelStyle.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
  let first = run tree.append(root, move panelStyle) |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run tree.append(root, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let leaf = run tree.append(first, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  run tree.setMeasurement(leaf, 0)
  run tree.setMeasurement(second, 0)
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 20.0, maximum: 60.0, height: 18.0 }
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  let fragments = output.fragments.values.length()
  let leafBounds = run output.sourceBounds(leaf)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  let copied = run output.sourceBounds(leaf)
  run Testing.expect(output.stats.passes == 0 && output.fragments.values.length() == fragments && copied.x == leafBounds.x && copied.width == leafBounds.width, "an unchanged tree keeps its previous output")
  run tree.markDirty(second)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(output.stats.fullLayouts > 0 && output.stats.reusedLayouts == 1 && output.fragments.values.length() == fragments, "a dirty leaf re-lays the root and copies the clean panel")
  let mut wide = Style.make()
  wide.width = Dimension.px(100.0)
  run tree.setStyle(second, move wide)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  let moved = run output.sourceBounds(second)
  run Testing.expect(moved.x == 60.0 && moved.width == 100.0, "a sibling change moves the sibling")
  run Testing.expect(output.stats.reusedLayouts == 1, "a sibling change re-lays the root and copies the clean panel")
  run Testing.expect(output.fragments.values.length() == fragments, "copied fragments replace, not add to, the panel")
}

test effect fn blockFlowChildrenBelowFloatsAreCopied() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.width = Dimension.px(300.0)
  let mut tree = run Tree.make(move style) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let mut floatStyle = Style.make()
  floatStyle.float = Float.Left
  floatStyle.width = Dimension.px(100.0)
  floatStyle.height = Dimension.px(50.0)
  drop run tree.append(root, move floatStyle) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut besideStyle = Style.make()
  besideStyle.height = Dimension.px(30.0)
  let beside = run tree.append(root, move besideStyle) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut belowStyle = Style.make()
  belowStyle.height = Dimension.px(40.0)
  let below = run tree.append(root, move belowStyle) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut liftedStyle = Style.make()
  liftedStyle.height = Dimension.px(10.0)
  liftedStyle.margin.top = Dimension.px(-30.0)
  let lifted = run tree.append(root, move liftedStyle) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 20.0, maximum: 60.0, height: 18.0 }
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut taller = Style.make()
  taller.height = Dimension.px(45.0)
  run tree.setStyle(beside, move taller)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  let moved = run output.sourceBounds(below)
  let raised = run output.sourceBounds(lifted)
  run Testing.expect(moved.y == 45.0 && moved.height == 40.0 && raised.y == 55.0, "siblings follow the taller block")
  // The float ends at 50, above the 40px block's new top; the negative
  // margin could lift the last block into it, so that one is laid out.
  run Testing.expect(output.stats.reusedLayouts == 1, "only the block clear of the float and without negative margins is copied")
}

test effect fn insertedNodesKeepTheirSiblingsLayouts() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.width = Dimension.px(300.0)
  let mut tree = run Tree.make(move style) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let mut panelStyle = Style.make()
  panelStyle.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
  let panel = run tree.append(root, move panelStyle) |> Effect.provideMut<Allocator>(&mut allocator)
  let leaf = run tree.append(panel, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  run tree.setMeasurement(leaf, 0)
  let list = run tree.append(root, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run tree.append(list, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  run tree.setMeasurement(first, 0)
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 20.0, maximum: 60.0, height: 18.0 }
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  let added = run tree.append(list, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  run tree.setMeasurement(added, 0)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(output.stats.reusedLayouts >= 1, "the untouched panel is copied after an insertion elsewhere")
  let mut fresh = LayoutTree.make()
  run compute(&tree, &mut fresh, &mut content, OptionalSize.definite(800.0, 600.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(fresh.fragments.values.length() == output.fragments.values.length(), "an insertion yields as many fragments as a fresh layout")
  let sources = [leaf, first, added, panel, list]
  let mut index: usize = 0
  while index < sources.length {
    let a = run output.sourceBounds(sources[index])
    let b = run fresh.sourceBounds(sources[index])
    run Testing.expect(a.x == b.x && a.y == b.y && a.width == b.width && a.height == b.height, "an insertion lays out like a fresh tree")
    index = index + 1
  }
}

test effect fn columnItemsShareTheirBlockAxisProbes() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
  style.flexDirection = FlexDirection.Column
  style.width = Dimension.px(300.0)
  let mut tree = run Tree.make(move style) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let item = run tree.append(root, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  run tree.setMeasurement(item, 0)
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 20.0, maximum: 60.0, height: 18.0 }
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  // Sizing §5.1: the item's min-content and max-content heights are equal, so
  // the automatic minimum reuses the flex base probe.
  run Testing.expect(output.stats.sizeProbes == 1 && output.stats.cacheHits == 1, "a column item's min-content height reuses its max-content probe")
  run Testing.expect(output.boxes.get(output.firstBySource.get(item.index)).size.height == 18.0, "the item keeps its content height")
}

test effect fn unreadComputesResolveLikeFreshOnes() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut tree = run Tree.make(Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let mut panelStyle = Style.make()
  panelStyle.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
  let panel = run tree.append(root, move panelStyle) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut changed = root
  let mut at: usize = 0
  while at < 6 {
    let mut nested = Style.make()
    nested.margin.left = Dimension.px(3.0)
    let inner = run tree.append(panel, move nested) |> Effect.provideMut<Allocator>(&mut allocator)
    let leaf = run tree.append(inner, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
    run tree.setMeasurement(leaf, 0)
    if at == 2 { changed = leaf }
    at = at + 1
  }
  let below = run tree.append(root, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  run tree.setMeasurement(below, 0)
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 20.0, maximum: 60.0, height: 18.0 }
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  output.fragments.resolveLocations()
  // Several computes nobody reads: a resize, a change inside the panel,
  // then one after it that keeps the panel's fragments where they are.
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(500.0, 600.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut tall = Style.make()
  tall.height = Dimension.px(70.0)
  tall.margin.top = Dimension.px(5.0)
  run tree.setStyle(changed, move tall)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(500.0, 600.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut short = Style.make()
  short.height = Dimension.px(9.0)
  run tree.setStyle(below, move short)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(500.0, 600.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  let bounds = run output.sourceBounds(below)
  let mut fresh = LayoutTree.make()
  run compute(&tree, &mut fresh, &mut content, OptionalSize.definite(500.0, 600.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  fresh.fragments.resolveLocations()
  let expected = run fresh.sourceBounds(below)
  run Testing.expect(bounds.x == expected.x && bounds.y == expected.y && bounds.y > 0.0, "source bounds before resolving match a fresh compute")
  output.fragments.resolveLocations()
  let values = output.fragments.values.asSlice()
  let freshValues = fresh.fragments.values.asSlice()
  run Testing.expect(values.length == freshValues.length, "the same fragments")
  let mut same = true
  let mut index: usize = 0
  while index < values.length {
    if values[index].worldLocation.x != freshValues[index].worldLocation.x || values[index].worldLocation.y != freshValues[index].worldLocation.y { same = false }
    index = index + 1
  }
  run Testing.expect(same, "world locations resolved after unread computes match a fresh compute")
}

test effect fn deferredContentMinimumsStillStopShrinking() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
  style.width = Dimension.px(30.0)
  let mut tree = run Tree.make(move style) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let first = run tree.append(root, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run tree.append(root, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  run tree.setMeasurement(first, 0)
  run tree.setMeasurement(second, 0)
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 20.0, maximum: 60.0, height: 18.0 }
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  // §4.5: the automatic minimum is the min-content width, measured only once
  // the line shrinks.
  let firstBox = output.boxes.get(output.firstBySource.get(first.index))
  let secondBox = output.boxes.get(output.firstBySource.get(second.index))
  run Testing.expect(firstBox.size.width == 20.0 && secondBox.size.width == 20.0 && secondBox.location.x == 20.0, "shrinking items stop at their min-content width")
  let mut wide = Style.make()
  wide.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
  wide.width = Dimension.px(300.0)
  run tree.setStyle(root, move wide)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  let grown = output.boxes.get(output.firstBySource.get(second.index))
  run Testing.expect(grown.size.width == 60.0 && grown.location.x == 60.0, "a line with room keeps max-content widths")
}

test effect fn repeatedResizesLayOutAfresh() ! OutOfMemoryError | TextError | FragmentationError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut tree = run Tree.make(Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let mut last = root
  let mut lastBlock = root
  let mut at: usize = 0
  while at < 8 {
    let mut style = Style.make()
    style.padding.left = Dimension.px(2.0)
    let block = run tree.append(root, move style) |> Effect.provideMut<Allocator>(&mut allocator)
    let leaf = run tree.append(block, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
    run tree.setMeasurement(leaf, 0)
    last = leaf
    lastBlock = block
    at = at + 1
  }
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 20.0, maximum: 300.0, height: 18.0 }
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(800.0, 600.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(250.0, 600.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(output.relaidMost, "a resize that reaches every box is noted")
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(120.0, 600.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  let bounds = run output.sourceBounds(last)
  let mut fresh = LayoutTree.make()
  run compute(&tree, &mut fresh, &mut content, OptionalSize.definite(120.0, 600.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  let expected = run fresh.sourceBounds(last)
  run Testing.expect(bounds.x == expected.x && bounds.y == expected.y && bounds.width == expected.width && bounds.height == expected.height && bounds.width == 118.0, "a resize laid out afresh matches a fresh compute")
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(120.0, 600.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(output.stats.passes == 0, "an unchanged tree after a fresh resize keeps its output")
  // An edit after a compute that laid out most boxes is laid out afresh too.
  let mut wide = Style.make()
  wide.padding.top = Dimension.px(9.0)
  run tree.setStyle(lastBlock, move wide)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(120.0, 600.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  let edited = run output.sourceBounds(last)
  let mut again = LayoutTree.make()
  run compute(&tree, &mut again, &mut content, OptionalSize.definite(120.0, 600.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  let expectedEdit = run again.sourceBounds(last)
  run Testing.expect(output.stats.fullLayouts > 1 && edited.x == expectedEdit.x && edited.y == expectedEdit.y && edited.width == expectedEdit.width, "an edit laid out afresh matches a fresh compute")
}

// Grid containers must not inherit the block-only cache normalization that
// erases available block size. Inspect both construction and restyling paths.
test effect fn gridExcludesBlockProbeHeightNormalization() ! OutOfMemoryError | InvalidNode | TextError | FragmentationError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut tree = run Tree.make(Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let child = run tree.append(root, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  drop child
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 0.0, maximum: 0.0, height: 0.0 }
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(100.0, 100.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  // KEY_BLOCK is the cache's block-height-normalization bit.
  run Testing.expect(output.facts.keyShapes.get(output.firstBySource.get(root.index)) & 16 != 0, "ordinary block enables block probe normalization")
  let mut grid = Style.make()
  grid.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Grid }
  run tree.setStyle(root, move grid)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(100.0, 100.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(output.facts.keyShapes.get(output.firstBySource.get(root.index)) & 16 == 0, "restyled grid excludes block probe normalization")
  let mut fresh = LayoutTree.make()
  run compute(&tree, &mut fresh, &mut content, OptionalSize.definite(100.0, 100.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(fresh.facts.keyShapes.get(fresh.firstBySource.get(root.index)) & 16 == 0, "fresh grid excludes block probe normalization")
}

// KEY_WIDTH_FREE_TREE lets width-only probes ignore height, so a descendant
// whose width can read height clears it on every ancestor, also on restyle.
test effect fn widthFreeTreeClearsAncestors() ! OutOfMemoryError | InvalidNode | TextError | FragmentationError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut tree = run Tree.make(Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let child = run tree.append(root, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let leaf = run tree.append(child, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 0.0, maximum: 0.0, height: 0.0 }
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(100.0, 100.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(output.facts.keyShapes.get(output.firstBySource.get(root.index)) & 2048 != 0, "plain blocks are width free")
  let mut ratio = Style.make()
  ratio.aspectRatio = 1.0
  run tree.setStyle(leaf, move ratio)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(100.0, 100.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(output.facts.keyShapes.get(output.firstBySource.get(root.index)) & 2048 == 0, "restyled aspect ratio clears the root")
  run Testing.expect(output.facts.keyShapes.get(output.firstBySource.get(child.index)) & 2048 == 0, "restyled aspect ratio clears the parent")
  run Testing.expect(output.facts.keyShapes.get(output.firstBySource.get(child.index)) & 1024 != 0, "the parent itself stays width free")
}

// KEY_CONTENT_FREE_TREE lets min-content probes share max-content entries, so
// a multi-line flex container clears it on itself and its ancestors.
test effect fn contentFreeTreeExcludesWrapping() ! OutOfMemoryError | InvalidNode | TextError | FragmentationError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut tree = run Tree.make(Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let mut wrapping = Style.make()
  wrapping.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
  wrapping.flexWrap = FlexWrap.Wrap
  let child = run tree.append(root, move wrapping) |> Effect.provideMut<Allocator>(&mut allocator)
  let leaf = run tree.append(child, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut output = LayoutTree.make()
  let mut content = Content { minimum: 0.0, maximum: 0.0, height: 0.0 }
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(100.0, 100.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(output.facts.keyShapes.get(output.firstBySource.get(leaf.index)) & 8192 != 0, "an empty leaf is content free")
  run Testing.expect(output.facts.keyShapes.get(output.firstBySource.get(child.index)) & 4096 == 0, "a wrapping flex container is not content free")
  run Testing.expect(output.facts.keyShapes.get(output.firstBySource.get(root.index)) & 8192 == 0, "its ancestors are not content free")
  let mut single = Style.make()
  single.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
  run tree.setStyle(child, move single)
  run compute(&tree, &mut output, &mut content, OptionalSize.definite(100.0, 100.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(output.facts.keyShapes.get(output.firstBySource.get(root.index)) & 8192 != 0, "a restyled single-line container frees its ancestors")
}
