import axes { Axes }
import box_tree { BoxTree, BoxKind }
import context { Input, ResolvedBox, outOfFlow, UNBOUNDED }
import fragmentation { ResumeState, FragmentInput }
import breaks { BreakBoundary, BreakRelaxation, FragmentainerKind }
import geometry { Layout, Size, ResolvedEdges, max, min, clamp }
import style { Style, BoxDecorationBreak, Float, WritingMode, MarginBreak }
import tree { NO_NODE }

// Ordinary block propagation can be resolved without laying out descendants.
// Flex line-dependent propagation is merged by the flex algorithm after sizing.
pub fn boundary(nodes: &BoxTree, id: usize, before: bool, kind: FragmentainerKind, rectoOnRight: bool) -> BreakBoundary {
  let node = nodes.node(id)
  let style = nodes.style(id)
  if outOfFlow(style) || node.kind == BoxKind.Inline || node.kind == BoxKind.Text || node.kind == BoxKind.InlineFormatting { return BreakBoundary.none() }
  let mut value = style.breakAfter
  if before { value = style.breakBefore }
  let mut result = BreakBoundary.make(value, kind, rectoOnRight)
  if node.kind != BoxKind.Block || node.fragmentMonolithic { return result }
  let mut child = node.firstChild
  let mut edge = NO_NODE
  while child != NO_NODE {
    if !outOfFlow(nodes.style(child)) && nodes.style(child).float == Float.None {
      edge = child
      if before { break }
    }
    child = nodes.node(child).nextSibling
  }
  if edge != NO_NODE { result.merge(boundary(nodes, edge, before, kind, rectoOnRight)) }
  return result
}

fn physical(axes: Axes, box: &ResolvedBox) -> ResolvedBox {
  let mut result = box.*
  result.padding = axes.physicalEdges(box.padding)
  result.border = axes.physicalEdges(box.border)
  result.margin = axes.physicalEdges(box.margin)
  result.inset = axes.physicalEdges(box.inset)
  result.gutter = axes.physicalEdges(box.gutter)
  result.size = axes.optional(box.size)
  result.min = axes.size(box.min)
  result.max = axes.size(box.max)
  return result
}

pub fn applies(style: &Style, frameMode: WritingMode) -> bool {
  return (style.writingMode == WritingMode.HorizontalTb) == (frameMode == WritingMode.HorizontalTb)
}
pub fn marginPolicy(style: &Style, frameMode: WritingMode) -> MarginBreak {
  // An orthogonal monolithic box's projected margins are its inline margins.
  if !applies(style, frameMode) { return MarginBreak.Keep }
  return style.marginBreak
}

pub fn startMargin(style: &Style, value: f32, state: ResumeState, input: FragmentInput, frameMode: WritingMode) -> f32 {
  if !applies(style, frameMode) { return value }
  if state.normalComplete { return 0.0 }
  // Slice has no continuation edge. Keep cannot create a missing margin.
  if state.started && style.boxDecorationBreak == BoxDecorationBreak.Slice { return 0.0 }
  let adjoining = input.marginStart || state.started || state.notBeforeFrame > 0
  if !adjoining { return value }
  if style.marginBreak == MarginBreak.Keep { return value }
  if style.marginBreak == MarginBreak.Discard || state.started { return 0.0 }
  if input.contextStart || input.forcedStart || state.requested.kinds.any() { return value }
  return 0.0
}

pub fn endMargin(style: &Style, value: f32, complete: bool, contextEnd: bool, frameMode: WritingMode) -> f32 {
  if !applies(style, frameMode) { return value }
  if !complete {
    if style.boxDecorationBreak == BoxDecorationBreak.Clone && style.marginBreak == MarginBreak.Keep { return value }
    return 0.0
  }
  if contextEnd && style.marginBreak == MarginBreak.Discard { return 0.0 }
  return value
}

// Preserve the FULL content sizes used for percentages and flex distribution.
// Only the current fragment's decorations differ from the resolved CSS box.
pub fn current(style: &Style, full: &ResolvedBox, state: &ResumeState, input: &FragmentInput, frameMode: WritingMode) -> ResolvedBox {
  let axes = Axes.make(frameMode)
  let mut box = axes.box(full.*)
  let old = box.inset
  if state.normalComplete {
    box.padding = ResolvedEdges.zero()
    box.border = ResolvedEdges.zero()
    box.gutter = ResolvedEdges.zero()
    box.margin = ResolvedEdges.zero()
  } else {
    if style.boxDecorationBreak == BoxDecorationBreak.Slice {
      if state.started { box.padding.top = 0.0
        box.border.top = 0.0
        box.gutter.top = 0.0 }
      box.padding.bottom = 0.0
      box.border.bottom = 0.0
      box.gutter.bottom = 0.0
    }
    box.margin.top = startMargin(style, box.margin.top, state.*, input.*, frameMode)
    if state.started && style.boxDecorationBreak == BoxDecorationBreak.Clone && style.marginBreak == MarginBreak.Auto { box.margin.bottom = 0.0 }
  }
  box.inset = ResolvedEdges {
    top: box.padding.top + box.border.top + box.gutter.top,
    right: box.padding.right + box.border.right + box.gutter.right,
    bottom: box.padding.bottom + box.border.bottom + box.gutter.bottom,
    left: box.padding.left + box.border.left + box.gutter.left,
  }
  let dx = box.inset.horizontal() - old.horizontal()
  let dy = box.inset.vertical() - old.vertical()
  if box.size.widthDefinite { box.size.width = max(box.inset.horizontal(), box.size.width + dx) }
  if box.size.heightDefinite { box.size.height = max(box.inset.vertical(), box.size.height + dy) }
  box.min = Size { width: max(box.inset.horizontal(), box.min.width + dx), height: max(box.inset.vertical(), box.min.height + dy) }
  box.max = Size { width: max(box.inset.horizontal(), box.max.width + dx), height: max(box.inset.vertical(), box.max.height + dy) }
  return physical(axes, &box)
}

// Algorithms report natural content actually placed in this frame. CSS size
// progress and descendant progress are independent, including overflow-only
// continuations and a pending ending slice decoration after content EOF.
pub fn finish(style: &Style, input: &Input, full: &ResolvedBox, current: &ResolvedBox, state: &mut ResumeState, result: &mut Layout, frameMode: WritingMode) -> ResolvedBox {
  if state.blocked || state.skipped { return current.* }
  let axes = Axes.make(frameMode)
  let original = axes.box(full.*)
  let mut box = axes.box(current.*)
  let natural = max(0.0, axes.size(result.size).height - box.inset.vertical())
  let available = max(0.0, input.fragmentation.limit - input.fragmentation.offset - box.inset.vertical())
  let fullSize = max(0.0, original.size.height - original.inset.vertical())
  let fullMin = max(0.0, original.min.height - original.inset.vertical())
  let fullMax = max(0.0, original.max.height - original.inset.vertical())
  let fixed = original.size.heightDefinite && !input.fragmentation.allocatedAutoExtent
  let allottedMinimum = original.size.heightDefinite && input.fragmentation.allocatedAutoExtent
  let hadNormalEnd = state.normalComplete
  let mut used: f32 = 0.0
  if !hadNormalEnd {
    let mut desired = natural
    if !state.normalContentComplete { desired = max(desired, available) }
    if fixed { desired = state.size.resolve(fullSize) }
    if allottedMinimum { desired = max(desired, state.size.resolve(fullSize)) }
    desired = clamp(desired, state.minimum.resolve(fullMin), state.maximum.resolve(fullMax))
    let avoid = input.fragmentation.avoidInside || input.fragmentation.avoidsInside(style.breakInside)
    let mut ending: f32 = 0.0
    if style.boxDecorationBreak == BoxDecorationBreak.Slice && !state.endDecorationDone { ending = original.inset.bottom }
    if input.fragmentation.canBreakBefore && avoid && input.fragmentation.relaxation != BreakRelaxation.Avoidance && desired + ending > available {
      state.blocked = true
      return current.*
    }
    if input.fragmentation.canBreakBefore && available == 0.0 && (desired > 0.0 || box.inset.top > 0.0 || !state.normalContentComplete) {
      state.blocked = true
      return current.*
    }
    used = min(desired, available)
    // A completed unfragmentable content piece may overflow its fragmentainer;
    // do not invent an extra empty page to slice that piece's already-used size.
    if !fixed && state.normalContentComplete && natural > available {
      used = min(max(natural, used), state.maximum.resolve(fullMax))
    }
    drop state.minimum.consume(fullMin, used)
    if fullMax < UNBOUNDED { drop state.maximum.consume(fullMax, used) }
    if original.size.heightDefinite { drop state.size.consume(fullSize, used) }
    let extentDone = (fixed && state.size.remaining == 0.0)
      || (!fixed && (state.normalContentComplete || (fullMax < UNBOUNDED && state.maximum.remaining == 0.0)))
    state.normalComplete = extentDone && state.minimum.remaining == 0.0 && (!allottedMinimum || state.size.remaining == 0.0)
    if state.normalComplete && !state.endDecorationDone {
      if style.boxDecorationBreak == BoxDecorationBreak.Clone {
        state.endDecorationDone = true
      } else {
        let end = original.inset.bottom
        let room = max(0.0, input.fragmentation.limit - input.fragmentation.offset - box.inset.top - used)
        if end <= room || (used == 0.0 && box.inset.top == 0.0 && !input.fragmentation.canBreakBefore) {
          box.padding.bottom = original.padding.bottom
          box.border.bottom = original.border.bottom
          box.gutter.bottom = original.gutter.bottom
          box.inset.bottom = end
          state.endDecorationDone = true
        } else {
          state.normalComplete = false
          if used == 0.0 && box.inset.top == 0.0 && !state.started { state.blocked = true }
        }
      }
    }
  }
  let logicalSize = axes.size(result.size)
  result.size = axes.size(Size { width: logicalSize.width, height: used + box.inset.vertical() })
  box.margin.bottom = endMargin(style, box.margin.bottom, state.normalComplete, input.fragmentation.marginEnd, frameMode)
  state.started = true
  state.contentComplete = state.normalComplete && state.descendantsComplete
  return physical(axes, &box)
}
