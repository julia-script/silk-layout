import silk.allocator { Allocator, OutOfMemoryError }
import silk.i32
import geometry { Layout, Size, Point, OptionalSize, AvailableSpace, Measure, max, clamp }
import style { Style, DimensionKind, Direction, Align }
import context { Input, ResolvedBox, childrenInput, resolveBox, resolve }
import box_tree { BoxTree }
import layout_pass { LayoutPass }
import engine { layoutNode, layoutNodeInPlace, probeNode }
import text { TextMeasure, TextError }
import fragmentation { FragmentationError }
import axes { Axes }
import grid_placement { collectItems }
import grid_tracks { initializeTracks, resolveFlexible, stretchAuto, positionTracks, spanSize }

fn selfAlignment(style: &Style, parent: &Style, inline: bool) -> Align {
  let mut value = style.alignSelf
  if inline {
    value = style.justifySelf
    if value == Align.Auto {
      value = parent.justifyItems
    }
  } else if value == Align.Auto {
    value = parent.alignItems
  }
  if value == Align.Normal {
    if !style.replaced && style.aspectRatio == 0.0 {
      return Align.Stretch
    }
    return Align.Start
  }
  return value
}

fn stretchContent(value: Align) -> bool {
  return value == Align.Normal || value == Align.Stretch
}

fn alignmentOffset(value: Align, free: f64) -> f64 {
  if value == Align.End || value == Align.FlexEnd {
    return free
  }
  if value == Align.Center {
    return free / 2.0
  }
  return 0.0
}

// Grid §6.2: the area supplies both available space and the percentage basis.
// Only stretch fixes an auto preferred size; other values use fit-content.
fn itemInput(
  base: &Input,
  style: &Style,
  parent: &Style,
  axis: &Axes,
  area: OptionalSize,
) -> Input {
  let mut request = base.*
  request.blockify = true
  request.blockRoot = true
  request.shrinkToFit = true
  request.known = OptionalSize.none()
  request.parent = axis.optional(area)
  request.availableWidth = AvailableSpace.maxContent()
  request.availableHeight = AvailableSpace.maxContent()
  if request.parent.widthDefinite {
    request.availableWidth = AvailableSpace.definite(request.parent.width)
  }
  if request.parent.heightDefinite {
    request.availableHeight = AvailableSpace.definite(request.parent.height)
  }
  let resolved = resolveBox(style, &request)
  let margin = axis.edges(resolved.margin)
  let mut known = OptionalSize.none()
  if area.widthDefinite && selfAlignment(style, parent, true) == Align.Stretch
    && axis.autoInline(style)
    && !axis.lowAuto(style)
    && !axis.highAuto(style) {
    known.width = max(0.0, area.width - margin.horizontal())
    known.widthDefinite = true
  }
  let mut autoBlock = style.height.kind == DimensionKind.Auto
  let mut autoBlockMargin = style.margin.top.kind == DimensionKind.Auto
    || style.margin.bottom.kind == DimensionKind.Auto
  if axis.vertical {
    autoBlock = style.width.kind == DimensionKind.Auto
    autoBlockMargin = style.margin.left.kind == DimensionKind.Auto
      || style.margin.right.kind == DimensionKind.Auto
  }
  if area.heightDefinite && selfAlignment(style, parent, false) == Align.Stretch && autoBlock
    && !autoBlockMargin {
    known.height = max(0.0, area.height - margin.vertical())
    known.heightDefinite = true
  }
  request.known = axis.optional(known)
  return request
}

pub effect fn layoutGrid<'pass, 'source, M: Measure + TextMeasure>(
  nodes: &BoxTree<'source>,
  output: &mut LayoutPass<'pass, 'source>,
  measurer: &mut M,
  id: usize,
  input: &Input,
  box: &ResolvedBox,
) -> Layout
  ! OutOfMemoryError | TextError | FragmentationError
  ? &mut Allocator {
  let style = nodes.style(id)
  let template = &nodes.grids[style.grid]
  let axis = Axes.make(style.writingMode)
  let logical = axis.box(box.*)
  let mut inlineSize = max(0.0, logical.size.width - logical.inset.horizontal())
  let mut blockSize = max(0.0, logical.size.height - logical.inset.vertical())
  let columnGap = max(
    0.0,
    resolve(style.columnGap, inlineSize, logical.size.widthDefinite, style.columnGap.value),
  )
  let rowGap = max(
    0.0,
    resolve(style.rowGap, blockSize, logical.size.heightDefinite, style.rowGap.value),
  )
  let mut base = childrenInput(input, style, box, OptionalSize.none())
  base.performLayout = false
  base.baselines = false
  let mut lease = run output.gridScratch.take(id, nodes.boxes.length())
  if lease.fresh {
    lease.value.bounds = run collectItems(nodes, id, &mut lease.value.items)
  }
  let bounds = lease.value.bounds
  run initializeTracks(
    template.columns.tracks.asSlice(),
    bounds.columnOrigin,
    bounds.columns,
    inlineSize,
    logical.size.widthDefinite,
    &mut lease.value.columns,
  )
  run initializeTracks(
    template.rows.tracks.asSlice(),
    bounds.rowOrigin,
    bounds.rows,
    blockSize,
    logical.size.heightDefinite,
    &mut lease.value.rows,
  )
  let items = lease.value.items.asSlice()
  let columns = lease.value.columns.asMutSlice()
  let rows = lease.value.rows.asMutSlice()

  // Preserve single-span intrinsic sizing for the initial auto column.
  // Full intrinsic functions and spanning contributions are handled separately.
  if !logical.size.widthDefinite || !stretchContent(style.justifyContent) {
    let mut index: usize = 0
    while index < items.length {
      let item = &items[index]
      let column = i32.toUsize(item.column.start)
      if item.column.end - item.column.start == 1
        && (columns[column].autoMinimum || columns[column].autoMaximum) {
        let mut request = itemInput(&base, nodes.style(item.id), style, &axis, OptionalSize.none())
        request.intrinsicWidth = input.intrinsicWidth
        request.intrinsicHeight = input.intrinsicHeight
        if !logical.size.widthDefinite {
          if axis.vertical {
            request.availableHeight = input.availableHeight
          } else {
            request.availableWidth = input.availableWidth
          }
        }
        run probeNode(nodes, &mut output, &mut measurer, item.id, &request)
        let size = axis.size(output.boxes[item.id].size)
        let margin = axis.edges(output.boxes[item.id].usedMargin)
        columns[column].base = max(columns[column].base, size.width + margin.horizontal())
      }
      index = index + 1
    }
  }
  if logical.size.widthDefinite {
    resolveFlexible(&mut columns, inlineSize, columnGap)
  } else {
    let naturalInline = positionTracks(&mut columns, columnGap)
    inlineSize = max(
      0.0,
      clamp(naturalInline + logical.inset.horizontal(), logical.min.width, logical.max.width)
        - logical.inset.horizontal(),
    )
  }
  if stretchContent(style.justifyContent) {
    stretchAuto(&mut columns, inlineSize, columnGap)
  }
  drop positionTracks(&mut columns, columnGap)

  // Grid §12.1 sizes rows using the already-sized column areas. Fixed rows
  // need no contribution probes; auto rows take the largest single-span item.
  let mut index: usize = 0
  while index < items.length {
    let item = &items[index]
    let row = i32.toUsize(item.row.start)
    if item.row.end - item.row.start == 1 && !rows[row].isFlexible
      && (rows[row].autoMinimum || rows[row].autoMaximum) {
      let areaWidth = spanSize(
        &columns,
        i32.toUsize(item.column.start),
        i32.toUsize(item.column.end),
      )
      let area = OptionalSize {
        width: areaWidth,
        height: 0.0,
        widthDefinite: true,
        heightDefinite: false,
      }
      let request = itemInput(&base, nodes.style(item.id), style, &axis, area)
      run probeNode(nodes, &mut output, &mut measurer, item.id, &request)
      let size = axis.size(output.boxes[item.id].size)
      let margin = axis.edges(output.boxes[item.id].usedMargin)
      rows[row].base = max(rows[row].base, size.height + margin.vertical())
    }
    index = index + 1
  }
  if logical.size.heightDefinite {
    resolveFlexible(&mut rows, blockSize, rowGap)
  } else {
    let naturalBlock = positionTracks(&mut rows, rowGap)
    blockSize = max(
      0.0,
      clamp(naturalBlock + logical.inset.vertical(), logical.min.height, logical.max.height)
        - logical.inset.vertical(),
    )
  }
  if stretchContent(style.alignContent) {
    stretchAuto(&mut rows, blockSize, rowGap)
  }
  drop positionTracks(&mut rows, rowGap)

  let mut result = Layout.zero()
  result.size = axis.size(
    Size {
      width: inlineSize + logical.inset.horizontal(),
      height: blockSize + logical.inset.vertical(),
    },
  )
  if box.size.widthDefinite {
    result.size.width = box.size.width
  }
  if box.size.heightDefinite {
    result.size.height = box.size.height
  }
  if !input.performLayout && !input.baselines {
    output.gridScratch.put(move lease)
    return result
  }
  let rtl = style.usedDirection() == Direction.Rtl
  index = 0
  while index < items.length {
    let item = &items[index]
    let column = i32.toUsize(item.column.start)
    let row = i32.toUsize(item.row.start)
    let areaWidth = spanSize(&columns, column, i32.toUsize(item.column.end))
    let areaHeight = spanSize(&rows, row, i32.toUsize(item.row.end))
    let itemStyle = nodes.style(item.id)
    let mut request = itemInput(
      &base,
      itemStyle,
      style,
      &axis,
      OptionalSize.definite(areaWidth, areaHeight),
    )
    request.performLayout = input.performLayout
    request.baselines = input.baselines
    if input.performLayout {
      run layoutNodeInPlace(nodes, &mut output, &mut measurer, item.id, &request)
    } else {
      run probeNode(nodes, &mut output, &mut measurer, item.id, &request)
    }
    let size = axis.size(output.boxes[item.id].size)
    let usedMargin = output.boxes[item.id].usedMargin
    let margin = axis.edges(usedMargin)
    let inlineShift = alignmentOffset(
      selfAlignment(itemStyle, style, true),
      areaWidth - size.width - margin.horizontal(),
    )
    let blockShift = alignmentOffset(
      selfAlignment(itemStyle, style, false),
      areaHeight - size.height - margin.vertical(),
    )
    let mut inlineOffset = logical.inset.left + columns[column].position + margin.left + inlineShift
    if rtl {
      inlineOffset = logical.inset.left + inlineSize - columns[column].position - margin.right
        - size.width
        - inlineShift
    }
    let location = axis.physicalPoint(
      Point {
        x: inlineOffset,
        y: logical.inset.top + rows[row].position + margin.top + blockShift,
      },
      output.boxes[item.id].size,
      result.size,
    )
    run output.place(item.id, location, usedMargin, false, input.performLayout)
    index = index + 1
  }
  output.gridScratch.put(move lease)
  return result
}
