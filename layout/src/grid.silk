fn needsBaselines(nodes: &BoxTree, items: &[GridItem], parent: &Style) -> bool {
  let mut index: usize = 0
  while index < items.length {
    let style = nodes.style(items[index].id)
    let inline = selfAlignment(style, parent, true)
    let block = selfAlignment(style, parent, false)
    if inline == Align.Baseline || inline == Align.LastBaseline || block == Align.Baseline
      || block == Align.LastBaseline {
      return true
    }
    let horizontal = parent.writingMode == WritingMode.HorizontalTb
    if (Subgrid.inherits(nodes, items[index].id, horizontal)
        && inheritedBaselines(nodes, items[index].id, horizontal))
      || (Subgrid.inherits(nodes, items[index].id, !horizontal)
        && inheritedBaselines(nodes, items[index].id, !horizontal)) { return true }
    index = index + 1
  }
  return false
}

fn inheritedBaselines(nodes: &BoxTree, id: usize, horizontal: bool) -> bool {
  let parent = nodes.style(id)
  let columns = horizontal == (parent.writingMode == WritingMode.HorizontalTb)
  let mut child = nodes.node(id).firstChild
  while child != NO_NODE {
    let style = nodes.style(child)
    if style.position != Position.Absolute && style.position != Position.Fixed {
      if Subgrid.inherits(nodes, child, horizontal) {
        if inheritedBaselines(nodes, child, horizontal) { return true }
      } else {
        let align = selfAlignment(style, parent, columns)
        if align == Align.Baseline || align == Align.LastBaseline { return true }
      }
    }
    child = nodes.node(child).nextSibling
  }
  return false
}

fn stretchContent(value: Align) -> bool {
  return value == Align.Normal || value == Align.Stretch
}

// Grid §6.2: the area supplies both available space and the percentage basis.
// Only stretch fixes an auto preferred size; other values use fit-content.
fn itemInput(
  output: &LayoutPass,
  id: usize,
  base: &Input,
  style: &Style,
  parent: &Style,
  axis: &Axes,
  area: OptionalSize,
  gridContext: usize,
) -> Input with Intrinsic.inlineAlways() {
  let mut request = base.*
  request.gridContext = gridContext
  request.blockify = true
  request.blockRoot = true
  request.shrinkToFit = true
  request.known = OptionalSize.none()
  request.parent = axis.optional(area)
  request.availableWidth = AvailableSpace.maxContent()
  request.availableHeight = AvailableSpace.maxContent()
  if request.parent.widthDefinite {
    request.availableWidth = AvailableSpace.definite(request.parent.width)
  }
  if request.parent.heightDefinite {
    request.availableHeight = AvailableSpace.definite(request.parent.height)
  }
  let resolved = shapedBox(output, style, id, &request)
  let margin = axis.edges(resolved.margin)
  let mut known = OptionalSize.none()
  let mut inlineBit: usize = 1
  let mut blockBit: usize = 2
  if axis.vertical { inlineBit = 2
    blockBit = 1 }
  if area.widthDefinite && ((gridContext & inlineBit) != 0
    || (selfAlignment(style, parent, true) == Align.Stretch
      && axis.autoInline(style) && !axis.lowAuto(style) && !axis.highAuto(style))) {
    known.width = max(0.0, area.width - margin.horizontal())
    known.widthDefinite = true
  }
  let mut autoBlock = style.height.kind == DimensionKind.Auto
  let mut autoBlockMargin = style.margin.top.kind == DimensionKind.Auto
    || style.margin.bottom.kind == DimensionKind.Auto
  if axis.vertical {
    autoBlock = style.width.kind == DimensionKind.Auto
    autoBlockMargin = style.margin.left.kind == DimensionKind.Auto
      || style.margin.right.kind == DimensionKind.Auto
  }
  if area.heightDefinite && ((gridContext & blockBit) != 0
    || (selfAlignment(style, parent, false) == Align.Stretch && autoBlock && !autoBlockMargin)) {
    known.height = max(0.0, area.height - margin.vertical())
    known.heightDefinite = true
  }
  request.known = axis.optional(known)
  return request
}

struct TrackPolicy {
  automatic: bool,
  fixed: bool,
  cap: f32,
  intrinsic: bool,
  needMin: bool,
  needMax: bool,
}

// Grid §12.5 only grows intrinsic bounds; §12.7's definite flex fraction
// uses available space, not item contributions. Indefinite fr still needs them.
fn needsContribution(
  track: &TrackState,
  constraint: AvailableKind,
) -> bool with Intrinsic.inlineAlways() {
  return track.minimum != GridBreadthKind.Length
    || (track.maximum != GridBreadthKind.Length
      && (track.maximum != GridBreadthKind.Flex || constraint != AvailableKind.Definite))
}

fn trackPolicy(
  tracks: &[TrackState],
  start: usize,
  end: usize,
  gap: f32,
  constraint: AvailableKind,
) -> TrackPolicy with Intrinsic.inlineAlways() {
  let mut result = TrackPolicy {
    automatic: false,
    fixed: true,
    cap: usize.toF32(end - start - 1) * gap,
    intrinsic: false,
    needMin: false,
    needMax: false,
  }
  let mut flexible = false
  let mut index = start
  while index < end {
    let track = &tracks[index]
    result.automatic = result.automatic || track.minimum == GridBreadthKind.Auto
    flexible = flexible || track.maximum == GridBreadthKind.Flex
    result.fixed = result.fixed && track.maximum == GridBreadthKind.Length
    result.cap = result.cap + track.cap
    result.intrinsic = result.intrinsic || needsContribution(track, constraint)
    result.needMin = result.needMin || track.minimum == GridBreadthKind.MinContent
      || track.minimum == GridBreadthKind.MaxContent
      || (track.minimum == GridBreadthKind.Auto && constraint != AvailableKind.Definite)
      || (track.maximum != GridBreadthKind.Length && track.maximum != GridBreadthKind.Flex)
    result.needMax = result.needMax || track.minimum == GridBreadthKind.MaxContent
      || track.maximum == GridBreadthKind.Auto
      || track.maximum == GridBreadthKind.MaxContent
      || (constraint == AvailableKind.MaxContent
        && (track.minimum == GridBreadthKind.Auto || track.maximum == GridBreadthKind.Flex))
    index = index + 1
  }
  result.automatic = result.automatic && (end - start == 1 || !flexible)
  if !result.fixed {
    result.cap = UNBOUNDED
  }
  return move result
}

struct AxisSizing {
  columns: bool,
  origin: i32,
  count: usize,
  definite: bool,
  baselineDefinite: bool,
  size: f32,
  minimum: f32,
  maximum: f32,
  available: AvailableSpace,
  gap: Dimension,
  usedGap: f32,
  stretch: bool,
  resolveCyclic: bool,
  resolvedCyclic: bool,
}

fn gridSpace(definite: bool, size: f32, available: AvailableSpace) -> AvailableSpace {
  if definite {
    return AvailableSpace.definite(size)
  }
  if available.kind == AvailableKind.MinContent {
    return AvailableSpace.minContent()
  }
  return AvailableSpace.maxContent()
}

fn usedSpace(sizing: &AxisSizing) -> AvailableSpace {
  if sizing.resolvedCyclic {
    return AvailableSpace.definite(sizing.size)
  }
  return sizing.available
}

fn cyclicTracks(tracks: &[GridTrack]) -> bool {
  let mut index: usize = 0
  while index < tracks.length {
    if tracks[index].min.percent != 0.0 || tracks[index].max.percent != 0.0 {
      return true
    }
    index = index + 1
  }
  return false
}

// Contributions stay in item order. Only the pure track solver groups spans.
// This also lets §12.1 compare the new min-content contributions in one walk.
// Checks need only minimum/min-content; a triggered sizing pass collects maxima.
// Baseline groups retain all three contribution kinds during either pass.
effect fn collectContributions<'pass, 'source, M: Measure + TextMeasure>(
  nodes: &BoxTree<'source>,
  output: &mut LayoutPass<'pass, 'source>,
  measurer: &mut M,
  items: &[GridItem],
  base: &Input,
  parent: &Style,
  inherited: &InheritanceSource,
  axis: &Axes,
  own: &mut GridAxisScratch,
  cross: &GridAxisScratch,
  sizing: &AxisSizing,
  crossSizing: &AxisSizing,
  crossFinal: bool,
  checkOnly: bool,
  baselines: &mut GridBaselines,
) -> bool
  ! OutOfMemoryError | TextError | FragmentationError
  ? &mut Allocator {
  let tracks = own.tracks.asSlice()
  let crossTracks = cross.tracks.asSlice()
  let constraint = usedSpace(sizing)
  let mut intrinsic = false
  let mut index: usize = 0
  while index < tracks.length {
    intrinsic = intrinsic || needsContribution(&tracks[index], constraint.kind)
    index = index + 1
  }
  if !intrinsic {
    own.contributions.clear()
    return false
  }
  Baselines.reset(&mut baselines, sizing.columns, own.contributions.asSlice())
  let mut changed = false
  let horizontal = sizing.columns != axis.vertical
  let mut descendants = false
  index = 0
  while index < items.length {
    let item = &items[index]
    let mut span = item.row
    let mut crossSpan = item.column
    if sizing.columns {
      span = item.column
      crossSpan = item.row
    }
    let start = i32.toUsize(span.start)
    let end = i32.toUsize(span.end)
    let crossStart = i32.toUsize(crossSpan.start)
    let crossEnd = i32.toUsize(crossSpan.end)
    let policy = trackPolicy(tracks, start, end, sizing.usedGap, constraint.kind)
    let crossPolicy = trackPolicy(
      crossTracks,
      crossStart,
      crossEnd,
      crossSizing.usedGap,
      AvailableKind.Definite,
    )
    let mut contribution = TrackContribution.make(start, end, 0.0, 0.0, 0.0)
    let nested = Subgrid.inherits(nodes, item.id, horizontal)
    descendants = descendants || (nested && (policy.intrinsic || inheritedBaselines(nodes, item.id, horizontal)))
    let aligned = !nested && Baselines.active(&baselines, index, sizing.columns)
    if policy.intrinsic || aligned {
      let mut crossSize = crossPolicy.cap
      let crossDefinite = crossFinal || crossPolicy.fixed
      if crossFinal {
        crossSize = spanSize(crossTracks, crossStart, crossEnd)
      }
      let mut area = OptionalSize.none()
      if crossDefinite {
        if sizing.columns {
          area.height = crossSize
          area.heightDefinite = true
        } else {
          area.width = crossSize
          area.widthDefinite = true
        }
      }
      let key = run sizingContext(nodes, &mut output, item, parent, inherited,
        &own, cross, sizing, crossSizing, crossFinal)
      let request = itemInput(&output, item.id, base, nodes.style(item.id), parent, axis, area, key)
      let mut measured = ItemContribution {
        minimum: 0.0,
        minContent: 0.0,
        maxContent: 0.0,
        usedMinimum: 0.0,
      }
      if policy.intrinsic {
        if nested {
          measured = emptyContribution(&shapedBox(&output, nodes.style(item.id), item.id, &request), horizontal)
        } else {
          measured = run measureContribution(
          nodes,
          &mut output,
          &mut measurer,
          item.id,
          &request,
          sizing.columns != axis.vertical,
          policy.automatic,
          policy.cap,
          crossPolicy.cap,
          policy.needMin,
          policy.needMax && (!checkOnly || aligned),
        )
        }
        contribution.minimum = measured.minimum
        contribution.minContent = measured.minContent
        contribution.maxContent = measured.maxContent
      }
      if aligned {
        // Members without track contributions still establish the group's
        // baseline for members whose spans include intrinsically sized tracks.
        run Baselines.captureContribution(
          nodes,
          &mut output,
          &mut measurer,
          &mut baselines,
          index,
          sizing.columns,
          item.id,
          &request,
          &measured,
          parent,
        )
      }
    }
    if index < own.contributions.length() && !aligned {
      let previous = &own.contributions.asSlice()[index]
      changed = changed || previous.minContent != contribution.minContent
        || previous.minimum != contribution.minimum
    }
    if index < own.contributions.length() {
      own.contributions.set(index, contribution)
    } else {
      run own.contributions.append(contribution)
    }
    index = index + 1
  }
  let mut next = items.length
  if descendants {
    let mut work = match move output.cache.gridMemos.subgridWork.pop() {
      Option<ContributionWork>.Some { value } => move value
      Option<ContributionWork>.None => ContributionWork.make()
    }
    index = 0
    while index < items.length {
      let item = &items[index]
      if Subgrid.inherits(nodes, item.id, horizontal) {
        let mut span = item.row
        let mut crossSpan = item.column
        if sizing.columns { span = item.column
          crossSpan = item.row }
        let start = i32.toUsize(span.start)
        let end = i32.toUsize(span.end)
        let policy = trackPolicy(tracks, start, end, sizing.usedGap, constraint.kind)
        if policy.intrinsic || inheritedBaselines(nodes, item.id, horizontal) {
          let crossStart = i32.toUsize(crossSpan.start)
          let crossEnd = i32.toUsize(crossSpan.end)
          let crossPolicy = trackPolicy(crossTracks, crossStart, crossEnd,
            crossSizing.usedGap, AvailableKind.Definite)
          let mut crossSize = crossPolicy.cap
          if crossFinal { crossSize = spanSize(crossTracks, crossStart, crossEnd) }
          let mut area = OptionalSize.none()
          if crossFinal || crossPolicy.fixed {
            if sizing.columns { area.height = crossSize
              area.heightDefinite = true }
            else { area.width = crossSize
              area.widthDefinite = true }
          }
          let key = run sizingContext(nodes, &mut output, item, parent, inherited,
            &own, cross, sizing, crossSizing, crossFinal)
          let request = itemInput(&output, item.id, base, nodes.style(item.id), parent, axis, area, key)
          next = run collectInherited(nodes, &mut output, &mut measurer, item.id, &request,
            tracks, sizing, parent, horizontal, Subgrid.reversed(parent, sizing.columns), start, end,
            crossFinal, checkOnly, &mut work, &mut own.contributions, next, &mut changed, &mut baselines)
        }
      }
      index = index + 1
    }
    run output.cache.gridMemos.subgridWork.append(move work)
  }
  if own.contributions.length() != next { changed = true }
  own.contributions.truncate(next)
  let shimChanged = Baselines.applyShims(&baselines, sizing.columns, own.contributions.asMutSlice())
  return changed || shimChanged
}

effect fn finishTracks(
  own: &mut GridAxisScratch,
  sizing: &AxisSizing,
  work: &mut List<usize>,
) -> f32
  ! OutOfMemoryError
  ? &mut Allocator {
  let tracks = own.tracks.asMutSlice()
  let contributions = own.contributions.asSlice()
  let available = usedSpace(sizing)
  run resolveIntrinsic(&mut tracks, contributions, available.kind, sizing.usedGap, &mut work)
  maximizeTracks(&mut tracks, available, sizing.usedGap, sizing.maximum)
  expandFlexible(
    &mut tracks,
    contributions,
    available,
    sizing.usedGap,
    sizing.minimum,
    sizing.maximum,
  )
  if sizing.stretch {
    let mut extent = sizing.minimum
    if available.kind == AvailableKind.Definite {
      extent = available.value
    }
    stretchAuto(&mut tracks, extent, sizing.usedGap)
  }
  return positionTracks(&mut tracks, sizing.usedGap)
}

// Cyclic percentages contribute zero/auto to the intrinsic size, then resolve
// against that size for layout. Their overflow must not enlarge the container.
effect fn sizeAxis<'pass, 'source, M: Measure + TextMeasure>(
  nodes: &BoxTree<'source>,
  output: &mut LayoutPass<'pass, 'source>,
  measurer: &mut M,
  items: &[GridItem],
  base: &Input,
  parent: &Style,
  inherited: &InheritanceSource,
  axis: &Axes,
  own: &mut GridAxisScratch,
  cross: &GridAxisScratch,
  sizing: &mut AxisSizing,
  crossSizing: &AxisSizing,
  template: &[GridTrack],
  automatic: &[GridTrack],
  collapsed: &[usize],
  crossFinal: bool,
  work: &mut List<usize>,
  baselines: &mut GridBaselines,
  prepareBaselines: bool,
)
  ! OutOfMemoryError | TextError | FragmentationError
  ? &mut Allocator {
  sizing.resolvedCyclic = false
  sizing.usedGap = max(0.0, resolve(sizing.gap, sizing.size, sizing.definite, sizing.gap.value))
  run initializeTracks(
    template,
    automatic,
    sizing.origin,
    sizing.count,
    sizing.size,
    sizing.definite,
    &mut own.tracks,
  )
  collapseTracks(own.tracks.asMutSlice(), collapsed)
  if prepareBaselines {
    if sizing.columns {
      run Baselines.prepare(nodes, &mut measurer, items, parent, own.tracks.asSlice(),
        cross.tracks.asSlice(), sizing.baselineDefinite, crossSizing.baselineDefinite, &mut baselines)
    } else {
      run Baselines.prepare(nodes, &mut measurer, items, parent, cross.tracks.asSlice(),
        own.tracks.asSlice(), crossSizing.baselineDefinite, sizing.baselineDefinite, &mut baselines)
    }
  }
  drop run collectContributions(
    nodes,
    &mut output,
    &mut measurer,
    items,
    base,
    parent,
    inherited,
    axis,
    &mut own,
    cross,
    &sizing,
    crossSizing,
    crossFinal,
    false,
    &mut baselines,
  )
  let mut natural = run finishTracks(&mut own, &sizing, &mut work)
  if !sizing.definite {
    sizing.size = clamp(natural, sizing.minimum, sizing.maximum)
  }
  if sizing.resolveCyclic && !sizing.definite
    && (sizing.gap.percent != 0.0 || cyclicTracks(template)
      || ((sizing.origin < 0 || sizing.count > template.length) && cyclicTracks(automatic))) {
    sizing.resolvedCyclic = true
    sizing.usedGap = max(0.0, resolve(sizing.gap, sizing.size, true, sizing.gap.value))
    run initializeTracks(
      template,
      automatic,
      sizing.origin,
      sizing.count,
      sizing.size,
      true,
      &mut own.tracks,
    )
    collapseTracks(own.tracks.asMutSlice(), collapsed)
    drop run collectContributions(
      nodes,
      &mut output,
      &mut measurer,
      items,
      base,
      parent,
      inherited,
      axis,
      &mut own,
      cross,
      &sizing,
      crossSizing,
      crossFinal,
      false,
      &mut baselines,
    )
    natural = run finishTracks(&mut own, &sizing, &mut work)
  }
  alignTracks(own.tracks.asMutSlice(), natural, sizing.size, parent, sizing.columns)
}

fn applyMinimum(request: &mut Input, horizontal: bool, minimum: f32) with Intrinsic.inlineAlways() {
  if minimum <= 0.0 {
    return
  }
  if horizontal {
    if request.known.widthDefinite {
      request.known.width = max(request.known.width, minimum)
    } else {
      request.minimum.width = minimum
    }
  } else {
    if request.known.heightDefinite {
      request.known.height = max(request.known.height, minimum)
    } else {
      request.minimum.height = minimum
    }
  }
}

// Continuous and fragmented placement use the same area and automatic-minimum
// constraints. A fragment changes the fitting budget, never the percentage basis.
pub effect fn requestItem<'pass, 'source, M: Measure + TextMeasure>(
  nodes: &BoxTree<'source>,
  output: &mut LayoutPass<'pass, 'source>,
  measurer: &mut M,
  item: &GridItem,
  base: &Input,
  parent: &Style,
  inherited: &InheritanceSource,
  axis: &Axes,
  columns: &[TrackState],
  rows: &[TrackState],
  columnGap: f32,
  rowGap: f32,
  area: OptionalSize,
) -> Input
  ! OutOfMemoryError | TextError | FragmentationError
  ? &mut Allocator with Intrinsic.inlineAlways() {
  let style = nodes.style(item.id)
  let mut gridContext: usize = 0
  if Subgrid.eligible(nodes, item.id) {
    gridContext = run Subgrid.bind(nodes, &mut output.cache.gridContexts, item, parent, inherited,
      columns, rows, columnGap, rowGap, true, true)
  }
  let mut request = itemInput(&output, item.id, base, style, parent, axis, area, gridContext)
  let columnPolicy = trackPolicy(
    columns,
    i32.toUsize(item.column.start),
    i32.toUsize(item.column.end),
    columnGap,
    AvailableKind.Definite,
  )
  let rowPolicy = trackPolicy(
    rows,
    i32.toUsize(item.row.start),
    i32.toUsize(item.row.end),
    rowGap,
    AvailableKind.Definite,
  )
  let mut inlineMinimum = style.minWidth
  let mut blockMinimum = style.minHeight
  if axis.vertical {
    inlineMinimum = style.minHeight
    blockMinimum = style.minWidth
  }
  if columnPolicy.automatic && inlineMinimum.kind == DimensionKind.Auto {
    let measured = run measureContribution(
      nodes,
      &mut output,
      &mut measurer,
      item.id,
      &request,
      !axis.vertical,
      true,
      columnPolicy.cap,
      rowPolicy.cap,
      false,
      false,
    )
    applyMinimum(&mut request, !axis.vertical, measured.usedMinimum)
  }
  if rowPolicy.automatic && blockMinimum.kind == DimensionKind.Auto {
    let measured = run measureContribution(
      nodes,
      &mut output,
      &mut measurer,
      item.id,
      &request,
      axis.vertical,
      true,
      rowPolicy.cap,
      columnPolicy.cap,
      false,
      false,
    )
    applyMinimum(&mut request, axis.vertical, measured.usedMinimum)
  }
  return request
}

pub effect fn layoutGrid<'pass, 'source, M: Measure + TextMeasure>(
  nodes: &BoxTree<'source>,
  output: &mut LayoutPass<'pass, 'source>,
  measurer: &mut M,
  id: usize,
  input: &Input,
  box: &ResolvedBox,
) -> Layout
  ! OutOfMemoryError | TextError | FragmentationError
  ? &mut Allocator {
  let fragmented = input.performLayout && input.fragmentation.active
  let mut allocationCheckpoint = Option<ResumeCheckpoint>.None
  if fragmented {
    allocationCheckpoint = Option<ResumeCheckpoint>.Some { value: output.resumes.checkpoint() }
  }
  let style = nodes.style(id)
  let template = &nodes.grids[style.grid]
  let axis = Axes.make(style.writingMode)
  let logical = axis.box(box.*)
  let mut limitsInput = input.*
  limitsInput.minimum = input.effectiveMinimum()
  limitsInput.intrinsicWidth = false
  limitsInput.intrinsicHeight = false
  let limits = axis.box(resolveBox(style, &limitsInput))
  let mut inlineAvailable = input.availableWidth
  let mut blockAvailable = input.availableHeight
  if axis.vertical {
    inlineAvailable = input.availableHeight
    blockAvailable = input.availableWidth
  }
  let mut base = childrenInput(input, style, box, OptionalSize.none())
  base.performLayout = false
  base.baselines = false
  let mut lease = run output.cache.gridMemos.take(id, nodes.boxes.length())
  let prepared = needsPreparation(template)
  if prepared {
    let mut columnOverride = usize.MAX
    let mut rowOverride = usize.MAX
    if output.frame != NO_NODE {
      let state = output.resumes.get(id)
      if state.started {
        match &state.cursor {
          FlowCursor.Grid {
            row,
            progress,
            gap,
            columnRepeat,
            rowRepeat,
            consumed,
            boundaryHandled
          } => {
            drop row
            drop progress
            drop gap
            drop consumed
            drop boundaryHandled
            columnOverride = columnRepeat
            rowOverride = rowRepeat
          }
          _ => {}
        }
      }
    }
    run prepareTemplate(
      nodes,
      id,
      lease.fresh,
      input,
      &output.cache.gridContexts,
      &logical,
      &limits,
      &axis,
      columnOverride,
      rowOverride,
      &mut lease.value,
    )
  } else if lease.fresh {
    let emptyNames = LineNames.make()
    lease.value.bounds = run collectItems(
      nodes,
      id,
      template.rows.tracks.length(),
      template.columns.tracks.length(),
      false,
      false,
      &emptyNames,
      &emptyNames,
      &mut lease.value.items,
      &mut lease.value.placement,
      false,
    )
  }
  let mut columnTemplate = template.columns.tracks.asSlice()
  let mut rowTemplate = template.rows.tracks.asSlice()
  let noCollapsed: [usize; 0] = []
  let mut collapsedColumns: &[usize] = &noCollapsed
  let mut collapsedRows: &[usize] = &noCollapsed
  if prepared {
    let value = &lease.value.template.asSlice()[0]
    columnTemplate = expandedTracks(&template.columns, &value.columns)
    rowTemplate = expandedTracks(&template.rows, &value.rows)
    collapsedColumns = value.collapsedColumns.asSlice()
    collapsedRows = value.collapsedRows.asSlice()
  }
  let bounds = lease.value.bounds
  let items = lease.value.items.asSlice()
  let noOffsets: [BaselineOffset; 0] = []
  let mut inheritance = Subgrid.source(template, lease.value.template.asSlice(), bounds, 0, true, &noOffsets)
  let baselineRequested = needsBaselines(nodes, items, style)
  let mut emptyBaselines = GridBaselines.make()
  let mut baselines = &mut emptyBaselines
  if baselineRequested {
    if lease.value.baselines.length() == 0 {
      run lease.value.baselines.append(GridBaselines.make())
    }
    baselines = &mut lease.value.baselines.asMutSlice()[0]
  }
  let inlineSize = max(0.0, logical.size.width - logical.inset.horizontal())
  let blockSize = max(0.0, logical.size.height - logical.inset.vertical())
  let mut columnSizing = AxisSizing {
    columns: true,
    origin: bounds.columnOrigin,
    count: bounds.columns,
    definite: logical.size.widthDefinite,
    baselineDefinite: false,
    size: inlineSize,
    minimum: max(0.0, limits.min.width - logical.inset.horizontal()),
    maximum: max(0.0, limits.max.width - logical.inset.horizontal()),
    available: gridSpace(logical.size.widthDefinite, inlineSize, inlineAvailable),
    gap: style.columnGap,
    usedGap: max(
      0.0,
      resolve(style.columnGap, inlineSize, logical.size.widthDefinite, style.columnGap.value),
    ),
    stretch: stretchContent(style.justifyContent),
    resolveCyclic: !input.intrinsicWidth && !input.intrinsicHeight,
    resolvedCyclic: false,
  }
  let mut rowSizing = AxisSizing {
    columns: false,
    origin: bounds.rowOrigin,
    count: bounds.rows,
    definite: logical.size.heightDefinite,
    baselineDefinite: false,
    size: blockSize,
    minimum: max(0.0, limits.min.height - logical.inset.vertical()),
    maximum: max(0.0, limits.max.height - logical.inset.vertical()),
    available: gridSpace(logical.size.heightDefinite, blockSize, blockAvailable),
    gap: style.rowGap,
    usedGap: max(
      0.0,
      resolve(style.rowGap, blockSize, logical.size.heightDefinite, style.rowGap.value),
    ),
    stretch: stretchContent(style.alignContent),
    resolveCyclic: !input.intrinsicWidth && !input.intrinsicHeight,
    resolvedCyclic: false,
  }
  columnSizing.maximum = max(columnSizing.minimum, columnSizing.maximum)
  rowSizing.maximum = max(rowSizing.minimum, rowSizing.maximum)
  if baselineRequested {
    // A content-derived used size does not turn indefinite fr tracks into
    // definite tracks for the frozen baseline-cycle decision (§11.3–11.4).
    let preferred = preferredSizes(style, input, &logical, &limits, &axis)
    columnSizing.baselineDefinite = preferred.widthDefinite
    rowSizing.baselineDefinite = preferred.heightDefinite
  }

  let mut inheritedColumns = false
  let mut inheritedRows = false
  let mut inheritedColumnsFinal = false
  let mut inheritedRowsFinal = false
  let mut phase: usize = 0
  let mut firstColumns = true
  match move output.cache.gridContexts.get(id, input.gridContext) {
    Option<&GridContext>.Some { value } => {
      phase = value.phase
      firstColumns = value.firstColumns
      inheritedColumns = value.columns.active
      inheritedRows = value.rows.active
      inheritedColumnsFinal = value.columns.definite
      inheritedRowsFinal = value.rows.definite
      if inheritedColumns {
        columnSizing.usedGap = run Subgrid.usedTracks(&value.columns, box, style, true,
          &mut lease.value.columns.tracks)
        columnSizing.size = max(0.0, value.columns.extent - logical.margin.horizontal()
          - logical.inset.horizontal())
        columnSizing.definite = value.columns.definite
        columnSizing.available = gridSpace(columnSizing.definite, columnSizing.size, inlineAvailable)
      }
      if inheritedRows {
        rowSizing.usedGap = run Subgrid.usedTracks(&value.rows, box, style, false,
          &mut lease.value.rows.tracks)
        rowSizing.size = max(0.0, value.rows.extent - logical.margin.vertical()
          - logical.inset.vertical())
        rowSizing.definite = value.rows.definite
        rowSizing.available = gridSpace(rowSizing.definite, rowSizing.size, blockAvailable)
      }
    }
    Option<&GridContext>.None => {}
  }
  inheritance.firstColumns = firstColumns
  // §12.1 estimates only the second axis before the first pass. Orthogonal
  // subgrids follow the owning grid's physical order, not their local columns.
  if firstColumns && !inheritedRows {
    run initializeTracks(rowTemplate, template.autoRows.asSlice(), bounds.rowOrigin,
      bounds.rows, blockSize, logical.size.heightDefinite, &mut lease.value.rows.tracks)
    collapseTracks(lease.value.rows.tracks.asMutSlice(), collapsedRows)
  }
  if !firstColumns && !inheritedColumns {
    run initializeTracks(columnTemplate, template.autoColumns.asSlice(), bounds.columnOrigin,
      bounds.columns, inlineSize, logical.size.widthDefinite, &mut lease.value.columns.tracks)
    collapseTracks(lease.value.columns.tracks.asMutSlice(), collapsedColumns)
  }
  if baselineRequested && ((firstColumns && inheritedColumns) || (!firstColumns && inheritedRows)) {
    run Baselines.prepare(nodes, &mut measurer, items, style,
      lease.value.columns.tracks.asSlice(), lease.value.rows.tracks.asSlice(),
      columnSizing.baselineDefinite, rowSizing.baselineDefinite, &mut baselines)
  }
  let mut lastPhase: usize = 4
  if phase != 0 { lastPhase = phase }
  let mut stage: usize = 1
  let mut adjusted = false
  while stage <= lastPhase {
    let columns = firstColumns == (stage == 1 || stage == 3)
    let mut needed = stage <= 2 || stage == 3 || adjusted
    if columns && inheritedColumns { needed = false }
    if !columns && inheritedRows { needed = false }
    inheritance.phase = stage
    if needed && columns {
      if stage > 2 {
        needed = run collectContributions(nodes, &mut output, &mut measurer, items, &base,
          style, &inheritance, &axis, &mut lease.value.columns, &lease.value.rows,
          &columnSizing, &rowSizing, true, true, &mut baselines)
      }
      if needed {
        run sizeAxis(nodes, &mut output, &mut measurer, items, &base, style, &inheritance,
          &axis, &mut lease.value.columns, &lease.value.rows, &mut columnSizing, &rowSizing,
          columnTemplate, template.autoColumns.asSlice(), collapsedColumns,
          stage != 1 || inheritedRowsFinal, &mut lease.value.trackWork, &mut baselines,
          baselineRequested && stage == 1)
      }
    } else if needed {
      if stage > 2 {
        needed = run collectContributions(nodes, &mut output, &mut measurer, items, &base,
          style, &inheritance, &axis, &mut lease.value.rows, &lease.value.columns,
          &rowSizing, &columnSizing, true, true, &mut baselines)
      }
      if needed {
        run sizeAxis(nodes, &mut output, &mut measurer, items, &base, style, &inheritance,
          &axis, &mut lease.value.rows, &lease.value.columns, &mut rowSizing, &columnSizing,
          rowTemplate, template.autoRows.asSlice(), collapsedRows,
          stage != 1 || inheritedColumnsFinal, &mut lease.value.trackWork, &mut baselines,
          baselineRequested && stage == 1)
      }
    }
    if stage == 3 { adjusted = needed }
    stage = stage + 1
  }
  inheritance.phase = phase
  if baselineRequested {
    baselines.inset = box.inset
    baselines.margin = box.margin
    baselines.columnGap = columnSizing.usedGap
    baselines.rowGap = rowSizing.usedGap
  }
  let mut result = Layout.zero()
  result.size = axis.size(
    Size {
      width: columnSizing.size + logical.inset.horizontal(),
      height: rowSizing.size + logical.inset.vertical(),
    },
  )
  if box.size.widthDefinite {
    result.size.width = box.size.width
  }
  if box.size.heightDefinite {
    result.size.height = box.size.height
  }
  let columns = lease.value.columns.tracks.asSlice()
  let rows = lease.value.rows.tracks.asSlice()
  let rtl = style.usedDirection() == Direction.Rtl
  let mut gridInline: f32 = 0.0
  let mut gridBlock: f32 = 0.0
  let mut gridWidth: f32 = 0.0
  let mut gridHeight: f32 = 0.0
  if columns.length > 0 {
    gridInline = columns[0].position
    gridWidth = columns[columns.length - 1].position + columns[columns.length - 1].base - gridInline
  }
  if rows.length > 0 {
    gridBlock = rows[0].position
    gridHeight = rows[rows.length - 1].position + rows[rows.length - 1].base - gridBlock
  }
  if rtl {
    gridInline = columnSizing.size - gridInline - gridWidth
  }
  let gridSize = axis.size(Size { width: gridWidth, height: gridHeight })
  let gridLocation = axis.physicalPoint(
    Point { x: logical.inset.left + gridInline, y: logical.inset.top + gridBlock },
    gridSize,
    result.size,
  )

  // Grid §5.3 includes the grid itself in the scrollable overflow area,
  // independently of whether any item fills its tracks.
  result.scrollableOverflow = Rect {
    x: gridLocation.x,
    y: gridLocation.y,
    width: gridSize.width,
    height: gridSize.height,
  }
  if !input.performLayout && !input.baselines {
    output.cache.gridMemos.put(move lease)
    return result
  }
  let mut subgridSharing = false
  if baselineRequested {
    let mut member: usize = 0
    while member < items.length && !subgridSharing {
      let child = items[member].id
      subgridSharing = (Subgrid.inherits(nodes, child, true) && inheritedBaselines(nodes, child, true))
        || (Subgrid.inherits(nodes, child, false) && inheritedBaselines(nodes, child, false))
      member = member + 1
    }
  }
  let sharing = baselines.any() || subgridSharing
  let mut baselineOffsets = List<BaselineOffset>.make()
  let mut passes: usize = 1
  match move allocationCheckpoint {
    Option<ResumeCheckpoint>.Some { value } => {
      let mut columnRepeat: usize = 0
      let mut rowRepeat: usize = 0
      if prepared {
        columnRepeat = lease.value.template.asSlice()[0].columnRepeat
        rowRepeat = lease.value.template.asSlice()[0].rowRepeat
      }
      let grid = FragmentGrid {
        items: items,
        columns: columns,
        rows: rows,
        axis: axis,
        inheritance: &inheritance,
        inlineSize: columnSizing.size,
        inlineExtent: axis.size(result.size).width,
        columnGap: columnSizing.usedGap,
        rowGap: rowSizing.usedGap,
        blockDefinite: rowSizing.definite,
        subgridBaselines: subgridSharing,
        columnBaselineDefinite: columnSizing.baselineDefinite,
        rowBaselineDefinite: rowSizing.baselineDefinite,
        columnRepeat: columnRepeat,
        rowRepeat: rowRepeat,
      }
      run Fragments.layoutGridFragment(
        nodes,
        &mut output,
        &mut measurer,
        id,
        input,
        box,
        &base,
        &grid,
        &mut baselines,
        &mut result,
        value,
      )
      passes = 0
    }
    Option<ResumeCheckpoint>.None => {
      if sharing {
        Baselines.resetFinal(&mut baselines)
        passes = 2
      }
    }
  }
  let mut pass: usize = 0
  while pass < passes {
    let mut finalInheritance = Subgrid.source(template, lease.value.template.asSlice(),
      bounds, phase, firstColumns, &noOffsets)
    if pass != 0 && baselineOffsets.length() != 0 {
      finalInheritance.baselineOffsets = baselineOffsets.asSlice()
    }
    let mut index: usize = 0
    while index < items.length {
      let item = &items[index]
      let column = i32.toUsize(item.column.start)
      let columnEnd = i32.toUsize(item.column.end)
      let row = i32.toUsize(item.row.start)
      let rowEnd = i32.toUsize(item.row.end)
      let areaWidth = spanSize(columns, column, columnEnd)
      let areaHeight = spanSize(rows, row, rowEnd)
      let itemStyle = nodes.style(item.id)
      if pass == 0 || subgridSharing {
        let mut request = run requestItem(
          nodes,
          &mut output,
          &mut measurer,
          item,
          &base,
          style,
          &finalInheritance,
          &axis,
          columns,
          rows,
          columnSizing.usedGap,
          rowSizing.usedGap,
          OptionalSize.definite(areaWidth, areaHeight),
        )
        request.performLayout = input.performLayout && (!subgridSharing || pass != 0)
        request.baselines = input.baselines || (sharing && Subgrid.eligible(nodes, item.id))
          || Baselines.active(&baselines, index, true) || Baselines.active(&baselines, index, false)
        if request.performLayout {
          run layoutNodeInPlace(nodes, &mut output, &mut measurer, item.id, &request)
        } else if subgridSharing && Subgrid.eligible(nodes, item.id) {
          // Ancestor sharing reads this subtree's placement and baseline
          // samples, not merely the root size held by the ordinary probe cache.
          let mut key = request
          normalizeKey(output.keyShape(item.id), &mut key, output.viewportFree(item.id))
          run probeFresh(nodes, &mut output, &mut measurer, item.id, &request, &key)
        } else {
          run probeNode(nodes, &mut output, &mut measurer, item.id, &request)
        }
      }
      if sharing && pass == 0 {
        let mut inlineInset = logical.inset.left
        if rtl {
          inlineInset = logical.inset.right
        }
        Baselines.captureFinal(
          &mut baselines,
          index,
          itemStyle,
          style,
          &output.boxes[item.id],
          Point {
            x: inlineInset + columns[column].position,
            y: logical.inset.top + rows[row].position,
          },
          Size { width: areaWidth, height: areaHeight },
        )
      }
      if !sharing || pass > 0 {
        let size = axis.size(output.boxes[item.id].size)
        let aligned = alignItem(
          itemStyle,
          style,
          &axis,
          Size { width: areaWidth, height: areaHeight },
          size,
          output.boxes[item.id].usedMargin,
        )
        let margin = axis.edges(aligned.margin)
        let mut inlineShift = aligned.inlineShift
        let mut blockShift = aligned.blockShift
        if sharing {
          inlineShift = Baselines.shift(&baselines, index, true, inlineShift)
          blockShift = Baselines.shift(&baselines, index, false, blockShift)
        }
        if Subgrid.inherits(nodes, item.id, !axis.vertical) { inlineShift = 0.0 }
        if Subgrid.inherits(nodes, item.id, axis.vertical) { blockShift = 0.0 }
        inlineShift = Subgrid.baselineShift(finalInheritance.baselineOffsets, item.id, !axis.vertical, inlineShift)
        blockShift = Subgrid.baselineShift(finalInheritance.baselineOffsets, item.id, axis.vertical, blockShift)
        let mut inlineOffset = logical.inset.left + columns[column].position + margin.left
          + inlineShift
        if rtl {
          inlineOffset = logical.inset.left + columnSizing.size - columns[column].position
            - margin.right
            - size.width
            - inlineShift
        }
        let location = axis.physicalPoint(
          Point {
            x: inlineOffset,
            y: logical.inset.top + rows[row].position + margin.top + blockShift,
          },
          output.boxes[item.id].size,
          result.size,
        )
        run output.place(item.id, location, aligned.margin, false, input.performLayout)
      }
      index = index + 1
    }
    if subgridSharing && pass == 0 {
      run collectFinalSubgridBaselines(nodes, &mut output, &mut measurer, items, style,
        columns, rows, columnSizing.usedGap, rowSizing.usedGap,
        columnSizing.baselineDefinite, rowSizing.baselineDefinite, &logical, &mut baselines)
      match move output.cache.gridMemos.baselineOffsets.pop() {
        Option<List<BaselineOffset>>.Some { value } => { baselineOffsets = move value }
        Option<List<BaselineOffset>>.None => {}
      }
      baselineOffsets.clear()
      run Baselines.descendantOffsets(nodes, &output, style, columns, true, &baselines,
        inheritance.baselineOffsets, &mut baselineOffsets)
      run Baselines.descendantOffsets(nodes, &output, style, rows, false, &baselines,
        inheritance.baselineOffsets, &mut baselineOffsets)
      // Incoming groups own the outermost applicable axis. Keep offsets for
      // direct children as well as those forwarded through another subgrid.
      let mut offset: usize = 0
      while offset < inheritance.baselineOffsets.length {
        run baselineOffsets.append(inheritance.baselineOffsets[offset])
        offset = offset + 1
      }
    }
    pass = pass + 1
  }
  if input.baselines && !fragmented {
    Baselines.containerBaselines(
      nodes,
      &output,
      &mut measurer,
      items,
      style,
      &baselines,
      &mut result,
      false,
    )
  }
  if input.performLayout && input.fragmentation.boundaryProbe == BoundaryProbe.After
    && nodes.node(id).dynamicAfter {
    let mut state = output.resumes.get(id)
    state.after = FragmentBox.boundary(
      nodes,
      id,
      false,
      input.fragmentation.kind,
      input.fragmentation.rectoOnRight,
    )
    state.after.merge(
      Fragments.outerBoundary(
        nodes,
        &output,
        items,
        rows.length,
        axis.reverseBlock != Axes.make(output.frames.writingMode).reverseBlock,
        false,
        input.fragmentation.rectoOnRight,
      ),
    )
    run output.resumes.set(id, state)
  }
  if input.performLayout && style.position != Position.Static {
    let emptyNames = LineNames.make()
    let mut columnNames = &emptyNames
    let mut rowNames = &emptyNames
    let mut columnExplicit = template.columns.tracks.length()
    let mut rowExplicit = template.rows.tracks.length()
    if prepared {
      let value = &lease.value.template.asSlice()[0]
      columnNames = &value.columnNames
      rowNames = &value.rowNames
      columnExplicit = value.columns.explicitTracks
      rowExplicit = value.rows.explicitTracks
    }
    run output.cache.gridGeometry.capture(
      id,
      columns,
      bounds.columnOrigin,
      columnExplicit,
      columnNames,
      rows,
      bounds.rowOrigin,
      rowExplicit,
      rowNames,
    )
    if output.frame != NO_NODE {
      let fragment = output.publication(id)
      run output.cache.gridGeometry.setFragment(
        id,
        fragment,
        result.contentRect(),
        result.paddingRect(),
      )
    }
    if fragmented {
      let scratch = &output.cache.gridMemos.fragmentScratch.asSlice()[output.cache.gridMemos.fragmentScratch.length()
        - 1]
      output.cache.gridGeometry.captureRows(id, scratch)
    }
  }
  if subgridSharing { run output.cache.gridMemos.baselineOffsets.append(move baselineOffsets) }
  output.cache.gridMemos.put(move lease)
  return result
}

fn axisSizing(columns: bool, bounds: GridBounds, logical: &ResolvedBox,
  limits: &ResolvedBox, style: &Style, input: &Input, axis: &Axes) -> AxisSizing {
  let mut size = max(0.0, logical.size.height - logical.inset.vertical())
  let mut definite = logical.size.heightDefinite
  let mut minimum = max(0.0, limits.min.height - logical.inset.vertical())
  let mut maximum = max(0.0, limits.max.height - logical.inset.vertical())
  let mut available = input.availableHeight
  if axis.vertical { available = input.availableWidth }
  let mut gap = style.rowGap
  let mut stretch = stretchContent(style.alignContent)
  let mut origin = bounds.rowOrigin
  let mut count = bounds.rows
  if columns {
    size = max(0.0, logical.size.width - logical.inset.horizontal())
    definite = logical.size.widthDefinite
    minimum = max(0.0, limits.min.width - logical.inset.horizontal())
    maximum = max(0.0, limits.max.width - logical.inset.horizontal())
    available = input.availableWidth
    if axis.vertical { available = input.availableHeight }
    gap = style.columnGap
    stretch = stretchContent(style.justifyContent)
    origin = bounds.columnOrigin
    count = bounds.columns
  }
  return AxisSizing { columns: columns, origin: origin, count: count, definite: definite,
    baselineDefinite: false, size: size, minimum: minimum, maximum: max(minimum, maximum),
    available: gridSpace(definite, size, available), gap: gap,
    usedGap: max(0.0, resolve(gap, size, definite, gap.value)), stretch: stretch,
    resolveCyclic: !input.intrinsicWidth && !input.intrinsicHeight, resolvedCyclic: false }
}

effect fn sizingContext(nodes: &BoxTree, output: &mut LayoutPass, item: &GridItem,
  parent: &Style, inherited: &InheritanceSource, own: &GridAxisScratch,
  cross: &GridAxisScratch, sizing: &AxisSizing, crossSizing: &AxisSizing, crossFinal: bool,
) -> usize ! OutOfMemoryError ? &mut Allocator {
  if !Subgrid.eligible(nodes, item.id) { return 0 }
  if sizing.columns {
    return run Subgrid.bind(nodes, &mut output.cache.gridContexts, item, parent, inherited,
      own.tracks.asSlice(), cross.tracks.asSlice(), sizing.usedGap, crossSizing.usedGap,
      inherited.phase >= 3, crossFinal)
  }
  return run Subgrid.bind(nodes, &mut output.cache.gridContexts, item, parent, inherited,
    cross.tracks.asSlice(), own.tracks.asSlice(), crossSizing.usedGap, sizing.usedGap,
    crossFinal, inherited.phase >= 3)
}

fn emptyContribution(box: &ResolvedBox, horizontal: bool) -> ItemContribution {
  let mut outer = box.inset.vertical() + box.margin.vertical()
  if horizontal { outer = box.inset.horizontal() + box.margin.horizontal() }
  return ItemContribution { minimum: outer, minContent: outer, maxContent: outer, usedMinimum: 0.0 }
}

// The direct item list is never flattened: it still owns placement, order and
// publication. Only this axis's contribution stream introspects subgrid items.
effect fn collectInherited<'pass, 'source, M: Measure + TextMeasure>(
  nodes: &BoxTree<'source>, output: &mut LayoutPass<'pass, 'source>, measurer: &mut M,
  id: usize, input: &Input, rootTracks: &[TrackState], rootSizing: &AxisSizing, root: &Style,
  rootHorizontal: bool, rootReversed: bool, rootStart: usize, rootEnd: usize,
  crossFinal: bool, checkOnly: bool, work: &mut ContributionWork,
  result: &mut List<TrackContribution>, cursor: usize, changed: &mut bool, rootBaselines: &mut GridBaselines,
) -> usize ! OutOfMemoryError | TextError | FragmentationError ? &mut Allocator {
  let style = nodes.style(id)
  let template = &nodes.grids[style.grid]
  let axis = Axes.make(style.writingMode)
  let ownColumns = rootHorizontal != axis.vertical
  let reverse = rootReversed != Subgrid.reversed(style, ownColumns)
  let box = shapedBox(&output, style, id, input)
  let logical = axis.box(box)
  let mut limitsInput = input.*
  limitsInput.minimum = input.effectiveMinimum()
  limitsInput.intrinsicWidth = false
  limitsInput.intrinsicHeight = false
  let limits = axis.box(resolveBox(style, &limitsInput))
  let mut lease = run output.cache.gridMemos.take(id, nodes.boxes.length())
  run prepareTemplate(nodes, id, lease.fresh, input, &output.cache.gridContexts,
    &logical, &limits, &axis, usize.MAX, usize.MAX, &mut lease.value)
  let bounds = lease.value.bounds
  let items = lease.value.items.asSlice()
  let prepared = &lease.value.template.asSlice()[0]
  let columnTemplate = expandedTracks(&template.columns, &prepared.columns)
  let rowTemplate = expandedTracks(&template.rows, &prepared.rows)
  let mut columns = axisSizing(true, bounds, &logical, &limits, style, input, &axis)
  let mut rows = axisSizing(false, bounds, &logical, &limits, style, input, &axis)
  let mut inheritedColumns = false
  let mut inheritedRows = false
  let mut phase: usize = 0
  let mut firstColumns = true
  let mut parentGap: f32 = 0.0
  match move output.cache.gridContexts.get(id, input.gridContext) {
    Option<&GridContext>.Some { value } => {
      phase = value.phase
      firstColumns = value.firstColumns
      inheritedColumns = value.columns.active
      inheritedRows = value.rows.active
      if inheritedColumns {
        columns.usedGap = run Subgrid.usedTracks(&value.columns, &box, style, true,
          &mut lease.value.columns.tracks)
        columns.size = max(0.0, value.columns.extent - logical.margin.horizontal() - logical.inset.horizontal())
        columns.definite = value.columns.definite
      }
      if inheritedRows {
        rows.usedGap = run Subgrid.usedTracks(&value.rows, &box, style, false,
          &mut lease.value.rows.tracks)
        rows.size = max(0.0, value.rows.extent - logical.margin.vertical() - logical.inset.vertical())
        rows.definite = value.rows.definite
      }
      if ownColumns { parentGap = value.columns.gap }
      else { parentGap = value.rows.gap }
    }
    Option<&GridContext>.None => {}
  }
  let mut base = childrenInput(input, style, &box, OptionalSize.none())
  base.performLayout = false
  base.baselines = false
  let noOffsets: [BaselineOffset; 0] = []
  let local = Subgrid.source(template, lease.value.template.asSlice(), bounds, phase, firstColumns, &noOffsets)
  let mut baselines = GridBaselines.make()
  if ownColumns && !inheritedRows {
    if crossFinal {
      run sizeAxis(nodes, &mut output, &mut measurer, items, &base, style, &local, &axis,
        &mut lease.value.rows, &lease.value.columns, &mut rows, &columns, rowTemplate,
        template.autoRows.asSlice(), prepared.collapsedRows.asSlice(), columns.definite,
        &mut lease.value.trackWork, &mut baselines, false)
    } else {
      run initializeTracks(rowTemplate, template.autoRows.asSlice(), bounds.rowOrigin,
        bounds.rows, rows.size, rows.definite, &mut lease.value.rows.tracks)
      collapseTracks(lease.value.rows.tracks.asMutSlice(), prepared.collapsedRows.asSlice())
    }
  }
  if !ownColumns && !inheritedColumns {
    if crossFinal {
      run sizeAxis(nodes, &mut output, &mut measurer, items, &base, style, &local, &axis,
        &mut lease.value.columns, &lease.value.rows, &mut columns, &rows, columnTemplate,
        template.autoColumns.asSlice(), prepared.collapsedColumns.asSlice(), rows.definite,
        &mut lease.value.trackWork, &mut baselines, false)
    } else {
      run initializeTracks(columnTemplate, template.autoColumns.asSlice(), bounds.columnOrigin,
        bounds.columns, columns.size, columns.definite, &mut lease.value.columns.tracks)
      collapseTracks(lease.value.columns.tracks.asMutSlice(), prepared.collapsedColumns.asSlice())
    }
  }
  let mut own = &lease.value.rows
  let mut cross = &lease.value.columns
  let mut ownSizing = &rows
  let mut crossSizing = &columns
  let mut low = logical.inset.top + logical.margin.top
  let mut high = logical.inset.bottom + logical.margin.bottom
  if ownColumns {
    own = &lease.value.columns
    cross = &lease.value.rows
    ownSizing = &columns
    crossSizing = &rows
    low = logical.inset.left + logical.margin.left
    high = logical.inset.right + logical.margin.right
    if style.usedDirection() == Direction.Rtl {
      low = logical.inset.right + logical.margin.right
      high = logical.inset.left + logical.margin.left
    }
  }
  if reverse { let saved = low
    low = high
    high = saved }
  let layer = ContributionLayer { start: rootStart, end: rootEnd, low: low, high: high,
    gap: (ownSizing.usedGap - parentGap) * 0.5 }
  run work.layers.append(layer)
  let hypothesisMarker = work.hypotheses.length()
  let mut occupiedStart = rootEnd
  let mut occupiedEnd = rootStart
  let mut index: usize = 0
  while index < items.length {
    let mut span = items[index].row
    if ownColumns { span = items[index].column }
    let mut start = rootStart + i32.toUsize(span.start)
    let mut end = rootStart + i32.toUsize(span.end)
    if reverse { start = rootEnd - i32.toUsize(span.end)
      end = rootEnd - i32.toUsize(span.start) }
    if start < occupiedStart { occupiedStart = start }
    if end > occupiedEnd { occupiedEnd = end }
    index = index + 1
  }
  let constraint = usedSpace(rootSizing)
  let mut next = cursor
  index = 0
  while index < items.length {
    let item = &items[index]
    let mut span = item.row
    let mut crossSpan = item.column
    if ownColumns { span = item.column
      crossSpan = item.row }
    let mut start = rootStart + i32.toUsize(span.start)
    let mut end = rootStart + i32.toUsize(span.end)
    if reverse { start = rootEnd - i32.toUsize(span.end)
      end = rootEnd - i32.toUsize(span.start) }
    let policy = trackPolicy(rootTracks, start, end, rootSizing.usedGap, constraint.kind)
    let crossPolicy = trackPolicy(cross.tracks.asSlice(), i32.toUsize(crossSpan.start),
      i32.toUsize(crossSpan.end), crossSizing.usedGap, AvailableKind.Definite)
    let mut area = OptionalSize.none()
    let mut crossSize = crossPolicy.cap
    if crossFinal { crossSize = spanSize(cross.tracks.asSlice(), i32.toUsize(crossSpan.start), i32.toUsize(crossSpan.end)) }
    if crossFinal || crossPolicy.fixed {
      if ownColumns { area.height = crossSize
        area.heightDefinite = true }
      else { area.width = crossSize
        area.widthDefinite = true }
    }
    let key = run sizingContext(nodes, &mut output, item, style, &local, own, cross,
      ownSizing, crossSizing, crossFinal)
    let request = itemInput(&output, item.id, &base, nodes.style(item.id), style, &axis, area, key)
    let nested = Subgrid.inherits(nodes, item.id, rootHorizontal)
    let before = SubgridContributions.edge(work.layers.asSlice(), start, true)
    let after = SubgridContributions.edge(work.layers.asSlice(), end, false)
    let entry = run Baselines.registerDescendant(nodes, &mut measurer, root, style,
      item.id, start, end, before, after, rootTracks, rootSizing.baselineDefinite,
      rootSizing.columns, next, &mut rootBaselines)
    let mut measured = ItemContribution { minimum: 0.0, minContent: 0.0, maxContent: 0.0, usedMinimum: 0.0 }
    if nested {
      measured = emptyContribution(&shapedBox(&output, nodes.style(item.id), item.id, &request), rootHorizontal)
    } else if policy.intrinsic {
      measured = run measureContribution(nodes, &mut output, &mut measurer, item.id, &request,
        rootHorizontal, policy.automatic, policy.cap, crossPolicy.cap, policy.needMin,
        policy.needMax && (!checkOnly || entry != NO_NODE))
    }
    if entry != NO_NODE {
      run Baselines.captureContribution(nodes, &mut output, &mut measurer, &mut rootBaselines,
        entry, rootSizing.columns, item.id, &request, &measured, root)
    }
    let extra = SubgridContributions.extra(work.layers.asSlice(), start, end)
    let value = TrackContribution.make(start, end, measured.minimum + extra,
      measured.minContent + extra, measured.maxContent + extra)
    let itemChanged = run SubgridContributions.store(&mut result, next, value)
    if entry == NO_NODE { changed.* = changed.* || itemChanged }
    next = next + 1
    if start == occupiedStart && occupiedStart > rootStart {
      let adjustment = SubgridContributions.extra(work.layers.asSlice(), rootStart, end)
      run SubgridContributions.hypothesis(&mut work, hypothesisMarker,
        TrackContribution.make(rootStart, end, measured.minimum + adjustment,
          measured.minContent + adjustment, measured.maxContent + adjustment))
    }
    if end == occupiedEnd && occupiedEnd < rootEnd {
      let adjustment = SubgridContributions.extra(work.layers.asSlice(), start, rootEnd)
      run SubgridContributions.hypothesis(&mut work, hypothesisMarker,
        TrackContribution.make(start, rootEnd, measured.minimum + adjustment,
          measured.minContent + adjustment, measured.maxContent + adjustment))
    }
    if nested {
      next = run collectInherited(nodes, &mut output, &mut measurer, item.id, &request,
        rootTracks, rootSizing, root, rootHorizontal, rootReversed, start, end, crossFinal,
        checkOnly, &mut work, &mut result, next, &mut changed, &mut rootBaselines)
    }
    index = index + 1
  }
  index = hypothesisMarker
  while index < work.hypotheses.length() {
    let itemChanged = run SubgridContributions.store(&mut result, next, work.hypotheses.get(index))
    changed.* = changed.* || itemChanged
    next = next + 1
    index = index + 1
  }
  work.hypotheses.truncate(hypothesisMarker)
  let layerCount = work.layers.length() - 1
  work.layers.truncate(layerCount)
  output.cache.gridMemos.put(move lease)
  return next
}

pub effect fn collectFinalSubgridBaselines<M: Measure>(
  nodes: &BoxTree, output: &mut LayoutPass, measurer: &mut M, items: &[GridItem],
  root: &Style, columns: &[TrackState], rows: &[TrackState],
  columnGap: f32, rowGap: f32, columnDefinite: bool, rowDefinite: bool, logical: &ResolvedBox,
  baselines: &mut GridBaselines,
) ! OutOfMemoryError ? &mut Allocator {
  let mut work = ContributionWork.make()
  let mut acquired = false
  let mut pass: usize = 0
  while pass < 2 {
    let isColumn = pass == 0
    let horizontal = isColumn == (root.writingMode == WritingMode.HorizontalTb)
    let mut tracks = rows
    let mut gap = rowGap
    let mut definite = rowDefinite
    let mut origin = logical.inset.top
    if isColumn {
      tracks = columns
      gap = columnGap
      definite = columnDefinite
      origin = logical.inset.left
      if root.usedDirection() == Direction.Rtl { origin = logical.inset.right }
    }
    let mut index: usize = 0
    while index < items.length {
      let item = &items[index]
      if Subgrid.inherits(nodes, item.id, horizontal) && inheritedBaselines(nodes, item.id, horizontal) {
        if !acquired {
          match move output.cache.gridMemos.subgridWork.pop() {
            Option<ContributionWork>.Some { value } => { work = move value }
            Option<ContributionWork>.None => {}
          }
          acquired = true
        }
        let mut span = item.row
        if isColumn { span = item.column }
        run captureSubgridBaselines(nodes, &mut output, &mut measurer, item.id, root,
          tracks, isColumn, definite, origin, i32.toUsize(span.start), i32.toUsize(span.end),
          gap, &mut work, &mut baselines)
      }
      index = index + 1
    }
    pass = pass + 1
  }
  if acquired { run output.cache.gridMemos.subgridWork.append(move work) }
}

effect fn captureSubgridBaselines<M: Measure>(
  nodes: &BoxTree, output: &mut LayoutPass, measurer: &mut M, id: usize, root: &Style,
  tracks: &[TrackState], columns: bool, definite: bool, origin: f32, rootStart: usize, rootEnd: usize,
  parentGap: f32, work: &mut ContributionWork, baselines: &mut GridBaselines,
) ! OutOfMemoryError ? &mut Allocator {
  let style = nodes.style(id)
  let horizontal = columns == (root.writingMode == WritingMode.HorizontalTb)
  let localColumns = horizontal == (style.writingMode == WritingMode.HorizontalTb)
  let reversed = Subgrid.reversed(root, columns) != Subgrid.reversed(style, localColumns)
  let lease = run output.cache.gridMemos.take(id, nodes.boxes.length())
  let geometry = &lease.value.baselines.asSlice()[0]
  let mut low = geometry.inset.top + geometry.margin.top
  let mut high = geometry.inset.bottom + geometry.margin.bottom
  if horizontal {
    low = geometry.inset.left + geometry.margin.left
    high = geometry.inset.right + geometry.margin.right
  }
  if Subgrid.reversed(root, columns) { let saved = low
    low = high
    high = saved }
  let mut usedGap = geometry.rowGap
  if localColumns { usedGap = geometry.columnGap }
  run work.layers.append(ContributionLayer { start: rootStart, end: rootEnd,
    low: low, high: high, gap: (usedGap - parentGap) * 0.5 })
  let items = lease.value.items.asSlice()
  let mut index: usize = 0
  while index < items.length {
    let item = &items[index]
    let mut span = item.row
    if localColumns { span = item.column }
    let mut start = rootStart + i32.toUsize(span.start)
    let mut end = rootStart + i32.toUsize(span.end)
    if reversed { start = rootEnd - i32.toUsize(span.end)
      end = rootEnd - i32.toUsize(span.start) }
    if Subgrid.inherits(nodes, item.id, horizontal) && inheritedBaselines(nodes, item.id, horizontal) {
      run captureSubgridBaselines(nodes, &mut output, &mut measurer, item.id, root,
        tracks, columns, definite, origin, start, end, usedGap, &mut work, &mut baselines)
    } else {
      let before = SubgridContributions.edge(work.layers.asSlice(), start, true)
      let after = SubgridContributions.edge(work.layers.asSlice(), end, false)
      let entry = run Baselines.registerDescendant(nodes, &mut measurer, root, style,
        item.id, start, end, before, after, tracks, definite,
        columns, NO_NODE, &mut baselines)
      if entry != NO_NODE {
        Baselines.captureDescendant(&mut baselines, entry, columns, nodes.style(item.id),
          root, &output.boxes[item.id], origin + tracks[start].position, spanSize(tracks, start, end))
      }
    }
    index = index + 1
  }
  let count = work.layers.length() - 1
  work.layers.truncate(count)
  output.cache.gridMemos.put(move lease)
}
