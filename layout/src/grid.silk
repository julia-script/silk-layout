fn nestedBaselines(nodes: &BoxTree, id: usize) -> bool {
  let parent = nodes.style(id)
  let mut child = nodes.node(id).firstChild
  while child != NO_NODE {
    let style = nodes.style(child)
    let inline = selfAlignment(style, parent, true)
    let block = selfAlignment(style, parent, false)
    if inline == Align.Baseline || inline == Align.LastBaseline
      || block == Align.Baseline || block == Align.LastBaseline { return true }
    if Subgrid.eligible(nodes, child) && nestedBaselines(nodes, child) { return true }
    child = nodes.node(child).nextSibling
  }
  return false
}
pub fn needsBaselines(nodes: &BoxTree, items: &[GridItem], parent: &Style) -> bool {
  let mut index: usize = 0
  while index < items.length {
    let style = nodes.style(items[index].id)
    let inline = selfAlignment(style, parent, true)
    let block = selfAlignment(style, parent, false)
    if inline == Align.Baseline || inline == Align.LastBaseline || block == Align.Baseline
      || block == Align.LastBaseline {
      return true
    }
    if Subgrid.eligible(nodes, items[index].id) && nestedBaselines(nodes, items[index].id) {
      return true
    }
    index = index + 1
  }
  return false
}

fn stretchContent(value: Align) -> bool {
  return value == Align.Normal || value == Align.Stretch
}

// Grid §6.2: the area supplies both available space and the percentage basis.
// Only stretch fixes an auto preferred size; other values use fit-content.
pub fn itemInput(
  output: &LayoutPass,
  id: usize,
  base: &Input,
  style: &Style,
  parent: &Style,
  axis: &Axes,
  area: OptionalSize,
) -> Input with Intrinsic.inlineAlways() {
  let mut request = base.*
  request.gridContext = 0
  request.blockify = true
  request.blockRoot = true
  request.shrinkToFit = true
  request.known = OptionalSize.none()
  request.parent = axis.optional(area)
  request.availableWidth = AvailableSpace.maxContent()
  request.availableHeight = AvailableSpace.maxContent()
  if request.parent.widthDefinite {
    request.availableWidth = AvailableSpace.definite(request.parent.width)
  }
  if request.parent.heightDefinite {
    request.availableHeight = AvailableSpace.definite(request.parent.height)
  }
  let resolved = shapedBox(output, style, id, &request)
  let margin = axis.edges(resolved.margin)
  let mut known = OptionalSize.none()
  if area.widthDefinite && selfAlignment(style, parent, true) == Align.Stretch
    && axis.autoInline(style)
    && !axis.lowAuto(style)
    && !axis.highAuto(style) {
    known.width = max(0.0, area.width - margin.horizontal())
    known.widthDefinite = true
  }
  let mut autoBlock = style.height.kind == DimensionKind.Auto
  let mut autoBlockMargin = style.margin.top.kind == DimensionKind.Auto
    || style.margin.bottom.kind == DimensionKind.Auto
  if axis.vertical {
    autoBlock = style.width.kind == DimensionKind.Auto
    autoBlockMargin = style.margin.left.kind == DimensionKind.Auto
      || style.margin.right.kind == DimensionKind.Auto
  }
  if area.heightDefinite && selfAlignment(style, parent, false) == Align.Stretch && autoBlock
    && !autoBlockMargin {
    known.height = max(0.0, area.height - margin.vertical())
    known.heightDefinite = true
  }
  request.known = axis.optional(known)
  return request
}

pub struct TrackPolicy {
  pub automatic: bool,
  pub fixed: bool,
  pub cap: f32,
  pub intrinsic: bool,
  pub needMin: bool,
  pub needMax: bool,
}

// Grid §12.5 only grows intrinsic bounds; §12.7's definite flex fraction
// uses available space, not item contributions. Indefinite fr still needs them.
fn needsContribution(
  track: &TrackState,
  constraint: AvailableKind,
) -> bool with Intrinsic.inlineAlways() {
  return track.minimum != GridBreadthKind.Length
    || (track.maximum != GridBreadthKind.Length
      && (track.maximum != GridBreadthKind.Flex || constraint != AvailableKind.Definite))
}

pub fn trackPolicy(
  tracks: &[TrackState],
  start: usize,
  end: usize,
  gap: f32,
  constraint: AvailableKind,
) -> TrackPolicy with Intrinsic.inlineAlways() {
  let mut result = TrackPolicy {
    automatic: false,
    fixed: true,
    cap: usize.toF32(end - start - 1) * gap,
    intrinsic: false,
    needMin: false,
    needMax: false,
  }
  let mut flexible = false
  let mut index = start
  while index < end {
    let track = &tracks[index]
    result.automatic = result.automatic || track.minimum == GridBreadthKind.Auto
    flexible = flexible || track.maximum == GridBreadthKind.Flex
    result.fixed = result.fixed && track.maximum == GridBreadthKind.Length
    result.cap = result.cap + track.cap
    result.intrinsic = result.intrinsic || needsContribution(track, constraint)
    result.needMin = result.needMin || track.minimum == GridBreadthKind.MinContent
      || track.minimum == GridBreadthKind.MaxContent
      || (track.minimum == GridBreadthKind.Auto && constraint != AvailableKind.Definite)
      || (track.maximum != GridBreadthKind.Length && track.maximum != GridBreadthKind.Flex)
    result.needMax = result.needMax || track.minimum == GridBreadthKind.MaxContent
      || track.maximum == GridBreadthKind.Auto
      || track.maximum == GridBreadthKind.MaxContent
      || (constraint == AvailableKind.MaxContent
        && (track.minimum == GridBreadthKind.Auto || track.maximum == GridBreadthKind.Flex))
    index = index + 1
  }
  result.automatic = result.automatic && (end - start == 1 || !flexible)
  if !result.fixed {
    result.cap = UNBOUNDED
  }
  return move result
}

pub struct AxisSizing {
  pub columns: bool,
  pub origin: i32,
  pub count: usize,
  pub definite: bool,
  pub baselineDefinite: bool,
  pub size: f32,
  pub minimum: f32,
  pub maximum: f32,
  pub available: AvailableSpace,
  pub gap: Dimension,
  pub usedGap: f32,
  pub stretch: bool,
  pub resolveCyclic: bool,
  pub resolvedCyclic: bool,
  pub inherited: bool,
}

fn gridSpace(definite: bool, size: f32, available: AvailableSpace) -> AvailableSpace {
  if definite {
    return AvailableSpace.definite(size)
  }
  if available.kind == AvailableKind.MinContent {
    return AvailableSpace.minContent()
  }
  return AvailableSpace.maxContent()
}

fn usedSpace(sizing: &AxisSizing) -> AvailableSpace {
  if sizing.resolvedCyclic {
    return AvailableSpace.definite(sizing.size)
  }
  return sizing.available
}

fn cyclicTracks(tracks: &[GridTrack]) -> bool {
  let mut index: usize = 0
  while index < tracks.length {
    if tracks[index].min.percent != 0.0 || tracks[index].max.percent != 0.0 {
      return true
    }
    index = index + 1
  }
  return false
}

// Contributions stay in item order. Only the pure track solver groups spans.
// This also lets §12.1 compare the new min-content contributions in one walk.
// Checks need only minimum/min-content; a triggered sizing pass collects maxima.
// Baseline groups retain all three contribution kinds during either pass.
effect fn collectContributions<'pass, 'source, M: Measure + TextMeasure>(
  nodes: &BoxTree<'source>,
  output: &mut LayoutPass<'pass, 'source>,
  measurer: &mut M,
  items: &[GridItem],
  base: &Input,
  source: &GridSource,
  parent: &Style,
  axis: &Axes,
  own: &mut GridAxisScratch,
  cross: &GridAxisScratch,
  sizing: &AxisSizing,
  crossSizing: &AxisSizing,
  crossFinal: bool,
  checkOnly: bool,
  baselines: &mut GridBaselines,
) -> bool
  ! OutOfMemoryError | TextError | FragmentationError
  ? &mut Allocator {
  let tracks = own.tracks.asSlice()
  let crossTracks = cross.tracks.asSlice()
  let constraint = usedSpace(sizing)
  let mut intrinsic = false
  let mut index: usize = 0
  while index < tracks.length {
    intrinsic = intrinsic || needsContribution(&tracks[index], constraint.kind)
    index = index + 1
  }
  let mut descendants = false
  index = 0
  while source.subgridChildren && !descendants && index < items.length {
    descendants = descendants || Subgrid.inherits(nodes, items[index].id, parent, sizing.columns)
    index = index + 1
  }
  if !intrinsic && !descendants {
    own.contributions.clear()
    own.members.clear()
    return false
  }
  Baselines.truncateMembers(&mut baselines, sizing.columns, items.length)
  Baselines.reset(&mut baselines, sizing.columns, own.contributions.asSlice())
  let mut changed = false
  index = 0
  while index < items.length {
    let item = &items[index]
    let mut span = item.row
    let mut crossSpan = item.column
    if sizing.columns {
      span = item.column
      crossSpan = item.row
    }
    let start = i32.toUsize(span.start)
    let end = i32.toUsize(span.end)
    let crossStart = i32.toUsize(crossSpan.start)
    let crossEnd = i32.toUsize(crossSpan.end)
    let policy = trackPolicy(tracks, start, end, sizing.usedGap, constraint.kind)
    let crossPolicy = trackPolicy(
      crossTracks,
      crossStart,
      crossEnd,
      crossSizing.usedGap,
      AvailableKind.Definite,
    )
    let mut contribution = TrackContribution.make(start, end, 0.0, 0.0, 0.0)
    let aligned = Baselines.active(&baselines, index, sizing.columns)
    if (!descendants || !Subgrid.inherits(nodes, item.id, parent, sizing.columns)) && (policy.intrinsic || aligned) {
      let mut crossSize = crossPolicy.cap
      let crossDefinite = crossFinal || crossPolicy.fixed
      if crossFinal {
        crossSize = spanSize(crossTracks, crossStart, crossEnd)
      }
      let mut area = OptionalSize.none()
      if crossDefinite {
        if sizing.columns {
          area.height = crossSize
          area.heightDefinite = true
        } else {
          area.width = crossSize
          area.widthDefinite = true
        }
      }
      let mut request = itemInput(&output, item.id, base, nodes.style(item.id), parent, axis, area)
      if source.subgridChildren && Subgrid.eligible(nodes, item.id) {
        let mut inherited = output.cache.subgrids.takeBuilder()
        if sizing.columns {
          run Subgrid.makeContext(nodes, item, parent, source, tracks, crossTracks,
            sizing.usedGap, crossSizing.usedGap, &mut inherited)
        } else {
          run Subgrid.makeContext(nodes, item, parent, source, crossTracks, tracks,
            crossSizing.usedGap, sizing.usedGap, &mut inherited)
        }
        inherited.stage = 1
        if sizing.columns { inherited.stage = inherited.stage + 1 }
        if crossFinal { inherited.stage = inherited.stage + 2 }
        if checkOnly { inherited.stage = inherited.stage + 4 }
        request.gridContext = run output.cache.subgrids.intern(item.id, move inherited)
      }
      let mut measured = ItemContribution {
        minimum: 0.0,
        minContent: 0.0,
        maxContent: 0.0,
        usedMinimum: 0.0,
      }
      if policy.intrinsic {
        measured = run measureContribution(
          nodes,
          &mut output,
          &mut measurer,
          item.id,
          &request,
          sizing.columns != axis.vertical,
          policy.automatic,
          policy.cap,
          crossPolicy.cap,
          policy.needMin,
          policy.needMax && (!checkOnly || aligned),
        )
        contribution.minimum = measured.minimum
        contribution.minContent = measured.minContent
        contribution.maxContent = measured.maxContent
      }
      if aligned {
        // Members without track contributions still establish the group's
        // baseline for members whose spans include intrinsically sized tracks.
        run Baselines.captureContribution(
          nodes,
          &mut output,
          &mut measurer,
          &mut baselines,
          index,
          sizing.columns,
          item.id,
          &request,
          &measured,
          parent,
        )
      }
    }
    if index < own.contributions.length() && !aligned {
      let previous = &own.contributions.asSlice()[index]
      changed = changed || previous.minContent != contribution.minContent
        || previous.minimum != contribution.minimum
    }
    if index < own.contributions.length() {
      own.contributions.set(index, contribution)
    } else {
      run own.contributions.append(contribution)
    }
    if descendants {
      if index < own.members.length() { own.members.set(index, item.*) }
      else { run own.members.append(item.*) }
    }
    index = index + 1
  }
  if !descendants { own.members.clear() }
  let mut cursor = items.length
  index = 0
  while descendants && index < items.length {
    let item = &items[index]
    if Subgrid.inherits(nodes, item.id, parent, sizing.columns) {
      let mut span = item.row
      let mut columns = crossTracks
      let mut rows = tracks
      let mut columnGap = crossSizing.usedGap
      let mut rowGap = sizing.usedGap
      if sizing.columns {
        span = item.column
        columns = tracks
        rows = crossTracks
        columnGap = sizing.usedGap
        rowGap = crossSizing.usedGap
      }
      let nestedChanged = run SubgridSizing.collect(nodes, &mut output, &mut measurer,
        item, base, parent, source, columns, rows, columnGap, rowGap,
        parent, tracks, sizing, i32.toUsize(span.start), i32.toUsize(span.end),
        Subgrid.reversed(parent, nodes.style(item.id), sizing.columns), 0.0, 0.0,
        crossFinal, checkOnly, &mut own.contributions, &mut own.members, &mut cursor, &mut baselines)
      changed = changed || nestedChanged
    }
    index = index + 1
  }
  changed = changed || own.contributions.length() != cursor
  own.contributions.truncate(cursor)
  own.members.truncate(cursor)
  Baselines.truncateMembers(&mut baselines, sizing.columns, cursor)
  let shimChanged = Baselines.applyShims(&baselines, sizing.columns, own.contributions.asMutSlice())
  return changed || shimChanged
}

effect fn finishTracks(
  own: &mut GridAxisScratch,
  sizing: &AxisSizing,
  work: &mut List<usize>,
) -> f32
  ! OutOfMemoryError
  ? &mut Allocator {
  let tracks = own.tracks.asMutSlice()
  let contributions = own.contributions.asSlice()
  let available = usedSpace(sizing)
  run resolveIntrinsic(&mut tracks, contributions, available.kind, sizing.usedGap, &mut work)
  maximizeTracks(&mut tracks, available, sizing.usedGap, sizing.maximum)
  expandFlexible(
    &mut tracks,
    contributions,
    available,
    sizing.usedGap,
    sizing.minimum,
    sizing.maximum,
  )
  if sizing.stretch {
    let mut extent = sizing.minimum
    if available.kind == AvailableKind.Definite {
      extent = available.value
    }
    stretchAuto(&mut tracks, extent, sizing.usedGap)
  }
  return positionTracks(&mut tracks, sizing.usedGap)
}

// Cyclic percentages contribute zero/auto to the intrinsic size, then resolve
// against that size for layout. Their overflow must not enlarge the container.
pub effect fn sizeAxis<'pass, 'source, M: Measure + TextMeasure>(
  nodes: &BoxTree<'source>,
  output: &mut LayoutPass<'pass, 'source>,
  measurer: &mut M,
  items: &[GridItem],
  base: &Input,
  source: &GridSource,
  parent: &Style,
  axis: &Axes,
  own: &mut GridAxisScratch,
  cross: &GridAxisScratch,
  sizing: &mut AxisSizing,
  crossSizing: &AxisSizing,
  template: &[GridTrack],
  automatic: &[GridTrack],
  collapsed: &[usize],
  crossFinal: bool,
  work: &mut List<usize>,
  baselines: &mut GridBaselines,
  prepareBaselines: bool,
)
  ! OutOfMemoryError | TextError | FragmentationError
  ? &mut Allocator {
  if sizing.inherited {
    own.contributions.clear()
    own.members.clear()
    own.tracks.clear()
    let mut at: usize = 0
    while at < own.inherited.length() {
      run own.tracks.append(own.inherited.get(at))
      at = at + 1
    }
    if prepareBaselines {
      run Baselines.prepare(nodes, &mut measurer, items, parent, own.tracks.asSlice(),
        cross.tracks.asSlice(), sizing.baselineDefinite, crossSizing.baselineDefinite, &mut baselines)
    }
    return
  }
  sizing.resolvedCyclic = false
  sizing.usedGap = max(0.0, resolve(sizing.gap, sizing.size, sizing.definite, sizing.gap.value))
  run initializeTracks(
    template,
    automatic,
    sizing.origin,
    sizing.count,
    sizing.size,
    sizing.definite,
    &mut own.tracks,
  )
  collapseTracks(own.tracks.asMutSlice(), collapsed)
  drop positionTracks(own.tracks.asMutSlice(), sizing.usedGap)
  if prepareBaselines {
    run Baselines.prepare(
      nodes,
      &mut measurer,
      items,
      parent,
      own.tracks.asSlice(),
      cross.tracks.asSlice(),
      sizing.baselineDefinite,
      crossSizing.baselineDefinite,
      &mut baselines,
    )
  }
  drop run collectContributions(
    nodes,
    &mut output,
    &mut measurer,
    items,
    base,
    source,
    parent,
    axis,
    &mut own,
    cross,
    &sizing,
    crossSizing,
    crossFinal,
    false,
    &mut baselines,
  )
  let mut natural = run finishTracks(&mut own, &sizing, &mut work)
  if !sizing.definite {
    sizing.size = clamp(natural, sizing.minimum, sizing.maximum)
  }
  if sizing.resolveCyclic && !sizing.definite
    && (sizing.gap.percent != 0.0 || cyclicTracks(template)
      || ((sizing.origin < 0 || sizing.count > template.length) && cyclicTracks(automatic))) {
    sizing.resolvedCyclic = true
    sizing.usedGap = max(0.0, resolve(sizing.gap, sizing.size, true, sizing.gap.value))
    run initializeTracks(
      template,
      automatic,
      sizing.origin,
      sizing.count,
      sizing.size,
      true,
      &mut own.tracks,
    )
    collapseTracks(own.tracks.asMutSlice(), collapsed)
    drop run collectContributions(
      nodes,
      &mut output,
      &mut measurer,
      items,
      base,
      source,
      parent,
      axis,
      &mut own,
      cross,
      &sizing,
      crossSizing,
      crossFinal,
      false,
      &mut baselines,
    )
    natural = run finishTracks(&mut own, &sizing, &mut work)
  }
  alignTracks(own.tracks.asMutSlice(), natural, sizing.size, parent, sizing.columns)
}

fn applyMinimum(request: &mut Input, horizontal: bool, minimum: f32) with Intrinsic.inlineAlways() {
  if minimum <= 0.0 {
    return
  }
  if horizontal {
    if request.known.widthDefinite {
      request.known.width = max(request.known.width, minimum)
    } else {
      request.minimum.width = minimum
    }
  } else {
    if request.known.heightDefinite {
      request.known.height = max(request.known.height, minimum)
    } else {
      request.minimum.height = minimum
    }
  }
}

// Continuous and fragmented placement use the same area and automatic-minimum
// constraints. A fragment changes the fitting budget, never the percentage basis.
pub effect fn requestItem<'pass, 'source, M: Measure + TextMeasure>(
  nodes: &BoxTree<'source>,
  output: &mut LayoutPass<'pass, 'source>,
  measurer: &mut M,
  item: &GridItem,
  base: &Input,
  source: &GridSource,
  parent: &Style,
  axis: &Axes,
  columns: &[TrackState],
  rows: &[TrackState],
  columnGap: f32,
  rowGap: f32,
  area: OptionalSize,
) -> Input
  ! OutOfMemoryError | TextError | FragmentationError
  ? &mut Allocator with Intrinsic.inlineAlways() {
  let style = nodes.style(item.id)
  let mut request = itemInput(&output, item.id, base, style, parent, axis, area)
  let inheritColumns = source.subgridChildren && Subgrid.inherits(nodes, item.id, parent, true)
  let inheritRows = source.subgridChildren && Subgrid.inherits(nodes, item.id, parent, false)
  if inheritColumns || inheritRows {
    let mut inherited = output.cache.subgrids.takeBuilder()
    run Subgrid.makeContext(nodes, item, parent, source, columns, rows, columnGap, rowGap, &mut inherited)
    request.gridContext = run output.cache.subgrids.intern(item.id, move inherited)
    let edges = axis.edges(shapedBox(&output, style, item.id, &request).margin)
    if inheritColumns && area.widthDefinite {
      Subgrid.forceSize(&mut request, parent, true, max(0.0, area.width - edges.horizontal()))
    }
    if inheritRows && area.heightDefinite {
      Subgrid.forceSize(&mut request, parent, false, max(0.0, area.height - edges.vertical()))
    }
  }
  let columnPolicy = trackPolicy(
    columns,
    i32.toUsize(item.column.start),
    i32.toUsize(item.column.end),
    columnGap,
    AvailableKind.Definite,
  )
  let rowPolicy = trackPolicy(
    rows,
    i32.toUsize(item.row.start),
    i32.toUsize(item.row.end),
    rowGap,
    AvailableKind.Definite,
  )
  let mut inlineMinimum = style.minWidth
  let mut blockMinimum = style.minHeight
  if axis.vertical {
    inlineMinimum = style.minHeight
    blockMinimum = style.minWidth
  }
  if !inheritColumns && columnPolicy.automatic && inlineMinimum.kind == DimensionKind.Auto {
    let measured = run measureContribution(
      nodes,
      &mut output,
      &mut measurer,
      item.id,
      &request,
      !axis.vertical,
      true,
      columnPolicy.cap,
      rowPolicy.cap,
      false,
      false,
    )
    applyMinimum(&mut request, !axis.vertical, measured.usedMinimum)
  }
  if !inheritRows && rowPolicy.automatic && blockMinimum.kind == DimensionKind.Auto {
    let measured = run measureContribution(
      nodes,
      &mut output,
      &mut measurer,
      item.id,
      &request,
      axis.vertical,
      true,
      rowPolicy.cap,
      columnPolicy.cap,
      false,
      false,
    )
    applyMinimum(&mut request, axis.vertical, measured.usedMinimum)
  }
  return request
}

pub effect fn layoutGrid<'pass, 'source, M: Measure + TextMeasure>(
  nodes: &BoxTree<'source>,
  output: &mut LayoutPass<'pass, 'source>,
  measurer: &mut M,
  id: usize,
  input: &Input,
  box: &ResolvedBox,
) -> Layout
  ! OutOfMemoryError | TextError | FragmentationError
  ? &mut Allocator {
  let fragmented = input.performLayout && input.fragmentation.active
  let mut allocationCheckpoint = Option<ResumeCheckpoint>.None
  if fragmented {
    allocationCheckpoint = Option<ResumeCheckpoint>.Some { value: output.resumes.checkpoint() }
  }
  let style = nodes.style(id)
  let template = &nodes.grids[style.grid]
  let axis = Axes.make(style.writingMode)
  let logical = axis.box(box.*)
  let mut limitsInput = input.*
  limitsInput.minimum = input.effectiveMinimum()
  limitsInput.intrinsicWidth = false
  limitsInput.intrinsicHeight = false
  let limits = axis.box(shapedBox(&output, style, id, &limitsInput))
  let mut inlineAvailable = input.availableWidth
  let mut blockAvailable = input.availableHeight
  if axis.vertical {
    inlineAvailable = input.availableHeight
    blockAvailable = input.availableWidth
  }
  let mut base = childrenInput(input, style, box, OptionalSize.none())
  base.performLayout = false
  base.baselines = false
  let mut lease = run output.cache.gridMemos.take(id, nodes.boxes.length())
  let emptyInherited = SubgridContext.make()
  let mut inherited = &emptyInherited
  if input.gridContext != 0 { inherited = output.cache.subgrids.get(input.gridContext) }
  let inheritedColumns = inherited.columns.active
  let inheritedRows = inherited.rows.active
  let initialStage = inherited.stage == 1 || inherited.stage == 2
  let prepared = needsPreparation(template)
  if prepared {
    let mut columnOverride = usize.MAX
    let mut rowOverride = usize.MAX
    if output.frame != NO_NODE {
      let state = output.resumes.get(id)
      if state.started {
        match &state.cursor {
          FlowCursor.Grid {
            row,
            progress,
            gap,
            columnRepeat,
            rowRepeat,
            consumed,
            boundaryHandled
          } => {
            drop row
            drop progress
            drop gap
            drop consumed
            drop boundaryHandled
            columnOverride = columnRepeat
            rowOverride = rowRepeat
          }
          _ => {}
        }
      }
    }
    run prepareTemplate(
      nodes,
      id,
      lease.fresh,
      input,
      &logical,
      &limits,
      &axis,
      columnOverride,
      rowOverride,
      &mut lease.value,
      inherited,
    )
  } else if lease.fresh {
    let emptyNames = LineNames.make()
    lease.value.bounds = run collectItems(
      nodes,
      id,
      template.rows.tracks.length(),
      template.columns.tracks.length(),
      &emptyNames,
      &emptyNames,
      &mut lease.value.items,
      &mut lease.value.placement,
    )
  }
  let mut columnTemplate = template.columns.tracks.asSlice()
  let mut rowTemplate = template.rows.tracks.asSlice()
  let noCollapsed: [usize; 0] = []
  let mut collapsedColumns: &[usize] = &noCollapsed
  let mut collapsedRows: &[usize] = &noCollapsed
  if prepared {
    let value = &lease.value.template.asSlice()[0]
    columnTemplate = expandedTracks(&template.columns, &value.columns)
    rowTemplate = expandedTracks(&template.rows, &value.rows)
    collapsedColumns = value.collapsedColumns.asSlice()
    collapsedRows = value.collapsedRows.asSlice()
  }
  let mut columnLines = template.columns.lines.asSlice()
  let mut rowLines = template.rows.lines.asSlice()
  let mut areas = template.areas.asSlice()
  let noAreaMasks: [usize; 0] = []
  let mut areaMasks: &[usize] = &noAreaMasks
  if prepared {
    let value = &lease.value.template.asSlice()[0]
    columnLines = expandedLines(&template.columns, &value.columns)
    rowLines = expandedLines(&template.rows, &value.rows)
    areas = value.areas.asSlice()
    areaMasks = value.areaMasks.asSlice()
  }
  let items = lease.value.items.asSlice()
  let mut subgridChildren = false
  let mut childIndex: usize = 0
  while !subgridChildren && childIndex < items.length {
    subgridChildren = Subgrid.eligible(nodes, items[childIndex].id)
    childIndex = childIndex + 1
  }
  let source = GridSource {
    columns: columnLines, rows: rowLines, areas: areas,
    areaMasks: areaMasks,
    columnOrigin: lease.value.bounds.columnOrigin, rowOrigin: lease.value.bounds.rowOrigin,
    subgridChildren: subgridChildren,
  }
  let bounds = lease.value.bounds
  let baselineRequested = needsBaselines(nodes, items, style)
  let mut emptyBaselines = GridBaselines.make()
  let mut baselines = &mut emptyBaselines
  if baselineRequested {
    if lease.value.baselines.length() == 0 {
      run lease.value.baselines.append(GridBaselines.make())
    }
    baselines = &mut lease.value.baselines.asMutSlice()[0]
  }
  let mut inlineSize = max(0.0, logical.size.width - logical.inset.horizontal())
  let mut blockSize = max(0.0, logical.size.height - logical.inset.vertical())
  if inheritedColumns {
    inlineSize = max(0.0, spanSize(inherited.columns.tracks.asSlice(), 0, inherited.columns.tracks.length())
      - logical.margin.horizontal() - logical.inset.horizontal())
  }
  if inheritedRows {
    blockSize = max(0.0, spanSize(inherited.rows.tracks.asSlice(), 0, inherited.rows.tracks.length())
      - logical.margin.vertical() - logical.inset.vertical())
  }
  let mut columnSizing = AxisSizing {
    columns: true,
    origin: bounds.columnOrigin,
    count: bounds.columns,
    definite: logical.size.widthDefinite,
    baselineDefinite: false,
    size: inlineSize,
    minimum: max(0.0, limits.min.width - logical.inset.horizontal()),
    maximum: max(0.0, limits.max.width - logical.inset.horizontal()),
    available: gridSpace(logical.size.widthDefinite, inlineSize, inlineAvailable),
    gap: style.columnGap,
    usedGap: max(
      0.0,
      resolve(style.columnGap, inlineSize, logical.size.widthDefinite, style.columnGap.value),
    ),
    stretch: stretchContent(style.justifyContent),
    resolveCyclic: !input.intrinsicWidth && !input.intrinsicHeight,
    resolvedCyclic: false,
    inherited: inheritedColumns,
  }
  let mut rowSizing = AxisSizing {
    columns: false,
    origin: bounds.rowOrigin,
    count: bounds.rows,
    definite: logical.size.heightDefinite,
    baselineDefinite: false,
    size: blockSize,
    minimum: max(0.0, limits.min.height - logical.inset.vertical()),
    maximum: max(0.0, limits.max.height - logical.inset.vertical()),
    available: gridSpace(logical.size.heightDefinite, blockSize, blockAvailable),
    gap: style.rowGap,
    usedGap: max(
      0.0,
      resolve(style.rowGap, blockSize, logical.size.heightDefinite, style.rowGap.value),
    ),
    stretch: stretchContent(style.alignContent),
    resolveCyclic: !input.intrinsicWidth && !input.intrinsicHeight,
    resolvedCyclic: false,
    inherited: inheritedRows,
  }
  columnSizing.maximum = max(columnSizing.minimum, columnSizing.maximum)
  rowSizing.maximum = max(rowSizing.minimum, rowSizing.maximum)
  if inheritedColumns {
    if style.columnGap.kind == DimensionKind.Normal { columnSizing.usedGap = inherited.columns.gap }
    let mut low = logical.inset.left + logical.margin.left
    let mut high = logical.inset.right + logical.margin.right
    if style.usedDirection() == Direction.Rtl {
      low = logical.inset.right + logical.margin.right
      high = logical.inset.left + logical.margin.left
    }
    run Subgrid.installTracks(&inherited.columns, columnSizing.usedGap, style.columnGap.kind == DimensionKind.Normal,
      low, high, &mut lease.value.columns.inherited)
    columnSizing.definite = true
  }
  if inheritedRows {
    if style.rowGap.kind == DimensionKind.Normal { rowSizing.usedGap = inherited.rows.gap }
    run Subgrid.installTracks(&inherited.rows, rowSizing.usedGap, style.rowGap.kind == DimensionKind.Normal,
      logical.inset.top + logical.margin.top, logical.inset.bottom + logical.margin.bottom,
      &mut lease.value.rows.inherited)
    rowSizing.definite = true
  }
  if baselineRequested {
    // A content-derived used size does not turn indefinite fr tracks into
    // definite tracks for the frozen baseline-cycle decision (§11.3–11.4).
    let preferred = preferredSizes(style, input, &logical, &limits, &axis)
    columnSizing.baselineDefinite = preferred.widthDefinite
    rowSizing.baselineDefinite = preferred.heightDefinite
  }

  // §12.1's first column pass estimates rows using their definite maxima.
  run initializeTracks(
    rowTemplate,
    template.autoRows.asSlice(),
    bounds.rowOrigin,
    bounds.rows,
    blockSize,
    logical.size.heightDefinite,
    &mut lease.value.rows.tracks,
  )
  collapseTracks(lease.value.rows.tracks.asMutSlice(), collapsedRows)
  if subgridChildren && !inheritedRows {
    SubgridSizing.estimate(lease.value.rows.tracks.asMutSlice(), &rowSizing, style)
  }
  if inheritedRows {
    lease.value.rows.tracks.clear()
    let mut at: usize = 0
    while at < lease.value.rows.inherited.length() {
      run lease.value.rows.tracks.append(lease.value.rows.inherited.get(at))
      at = at + 1
    }
  }
  run sizeAxis(
    nodes,
    &mut output,
    &mut measurer,
    items,
    &base,
    &source,
    style,
    &axis,
    &mut lease.value.columns,
    &lease.value.rows,
    &mut columnSizing,
    &rowSizing,
    columnTemplate,
    template.autoColumns.asSlice(),
    collapsedColumns,
    false,
    &mut lease.value.trackWork,
    &mut baselines,
    baselineRequested,
  )
  run sizeAxis(
    nodes,
    &mut output,
    &mut measurer,
    items,
    &base,
    &source,
    style,
    &axis,
    &mut lease.value.rows,
    &lease.value.columns,
    &mut rowSizing,
    &columnSizing,
    rowTemplate,
    template.autoRows.asSlice(),
    collapsedRows,
    !initialStage,
    &mut lease.value.trackWork,
    &mut baselines,
    false,
  )
  let mut columnsChanged = false
  if !initialStage && !inheritedColumns {
    columnsChanged = run collectContributions(
    nodes,
    &mut output,
    &mut measurer,
    items,
    &base,
    &source,
    style,
    &axis,
    &mut lease.value.columns,
    &lease.value.rows,
    &columnSizing,
    &rowSizing,
    true,
    true,
    &mut baselines,
  )
  }
  if columnsChanged {
    run sizeAxis(
      nodes,
      &mut output,
      &mut measurer,
      items,
      &base,
      &source,
      style,
      &axis,
      &mut lease.value.columns,
      &lease.value.rows,
      &mut columnSizing,
      &rowSizing,
      columnTemplate,
      template.autoColumns.asSlice(),
      collapsedColumns,
      true,
      &mut lease.value.trackWork,
      &mut baselines,
      false,
    )
    let rowsChanged = run collectContributions(
      nodes,
      &mut output,
      &mut measurer,
      items,
      &base,
      &source,
      style,
      &axis,
      &mut lease.value.rows,
      &lease.value.columns,
      &rowSizing,
      &columnSizing,
      true,
      true,
      &mut baselines,
    )
    if rowsChanged && !inheritedRows {
      run sizeAxis(
        nodes,
        &mut output,
        &mut measurer,
        items,
        &base,
        &source,
        style,
        &axis,
        &mut lease.value.rows,
        &lease.value.columns,
        &mut rowSizing,
        &columnSizing,
        rowTemplate,
        template.autoRows.asSlice(),
        collapsedRows,
        true,
        &mut lease.value.trackWork,
        &mut baselines,
        false,
      )
    }
  }
  lease.value.columnGap = columnSizing.usedGap
  lease.value.rowGap = rowSizing.usedGap
  let mut result = Layout.zero()
  result.size = axis.size(
    Size {
      width: columnSizing.size + logical.inset.horizontal(),
      height: rowSizing.size + logical.inset.vertical(),
    },
  )
  if box.size.widthDefinite {
    result.size.width = box.size.width
  }
  if box.size.heightDefinite {
    result.size.height = box.size.height
  }
  let columns = lease.value.columns.tracks.asSlice()
  let rows = lease.value.rows.tracks.asSlice()
  let rtl = style.usedDirection() == Direction.Rtl
  let mut gridInline: f32 = 0.0
  let mut gridBlock: f32 = 0.0
  let mut gridWidth: f32 = 0.0
  let mut gridHeight: f32 = 0.0
  if columns.length > 0 {
    gridInline = columns[0].position
    gridWidth = columns[columns.length - 1].position + columns[columns.length - 1].base - gridInline
  }
  if rows.length > 0 {
    gridBlock = rows[0].position
    gridHeight = rows[rows.length - 1].position + rows[rows.length - 1].base - gridBlock
  }
  if rtl {
    gridInline = columnSizing.size - gridInline - gridWidth
  }
  let gridSize = axis.size(Size { width: gridWidth, height: gridHeight })
  let gridLocation = axis.physicalPoint(
    Point { x: logical.inset.left + gridInline, y: logical.inset.top + gridBlock },
    gridSize,
    result.size,
  )

  // Grid §5.3 includes the grid itself in the scrollable overflow area,
  // independently of whether any item fills its tracks.
  result.scrollableOverflow = Rect {
    x: gridLocation.x,
    y: gridLocation.y,
    width: gridSize.width,
    height: gridSize.height,
  }
  if !input.performLayout && !input.baselines {
    output.cache.gridMemos.put(move lease)
    return result
  }
  let sharing = baselines.any()
  let mut passes: usize = 1
  match move allocationCheckpoint {
    Option<ResumeCheckpoint>.Some { value } => {
      let mut columnRepeat: usize = 0
      let mut rowRepeat: usize = 0
      if prepared {
        columnRepeat = lease.value.template.asSlice()[0].columnRepeat
        rowRepeat = lease.value.template.asSlice()[0].rowRepeat
      }
      let grid = FragmentGrid {
        items: items,
        columns: columns,
        rows: rows,
        axis: axis,
        inlineSize: columnSizing.size,
        inlineExtent: axis.size(result.size).width,
        columnGap: columnSizing.usedGap,
        rowGap: rowSizing.usedGap,
        blockDefinite: rowSizing.definite,
        columnRepeat: columnRepeat,
        rowRepeat: rowRepeat,
        source: source,
        columnMembers: lease.value.columns.members.asSlice(),
        rowMembers: lease.value.rows.members.asSlice(),
      }
      run Fragments.layoutGridFragment(
        nodes,
        &mut output,
        &mut measurer,
        id,
        input,
        box,
        &base,
        &grid,
        &mut baselines,
        &mut result,
        value,
      )
      passes = 0
    }
    Option<ResumeCheckpoint>.None => {
      if sharing {
        Baselines.resetFinal(&mut baselines)
        passes = 2
      }
    }
  }
  let mut pass: usize = 0
  while pass < passes {
    let mut index: usize = 0
    while index < items.length {
      let item = &items[index]
      let column = i32.toUsize(item.column.start)
      let columnEnd = i32.toUsize(item.column.end)
      let row = i32.toUsize(item.row.start)
      let rowEnd = i32.toUsize(item.row.end)
      let areaWidth = spanSize(columns, column, columnEnd)
      let areaHeight = spanSize(rows, row, rowEnd)
      let itemStyle = nodes.style(item.id)
      if pass == 0 {
        let mut request = run requestItem(
          nodes,
          &mut output,
          &mut measurer,
          item,
          &base,
          &source,
          style,
          &axis,
          columns,
          rows,
          columnSizing.usedGap,
          rowSizing.usedGap,
          OptionalSize.definite(areaWidth, areaHeight),
        )
        request.performLayout = input.performLayout
        request.baselines = input.baselines || Baselines.active(&baselines, index, true)
          || Baselines.active(&baselines, index, false)
        if input.performLayout {
          run layoutNodeInPlace(nodes, &mut output, &mut measurer, item.id, &request)
        } else {
          run probeNode(nodes, &mut output, &mut measurer, item.id, &request)
        }
      }
      if sharing && pass == 0 {
        let mut inlineInset = logical.inset.left
        if rtl {
          inlineInset = logical.inset.right
        }
        Baselines.captureFinal(
          &mut baselines,
          index,
          itemStyle,
          style,
          &output.boxes[item.id],
          Point {
            x: inlineInset + columns[column].position,
            y: logical.inset.top + rows[row].position,
          },
          Size { width: areaWidth, height: areaHeight },
        )
      }
      if !sharing || pass > 0 || Subgrid.eligible(nodes, item.id) {
        let size = axis.size(output.boxes[item.id].size)
        let aligned = alignItem(
          itemStyle,
          style,
          &axis,
          Size { width: areaWidth, height: areaHeight },
          size,
          output.boxes[item.id].usedMargin,
        )
        let margin = axis.edges(aligned.margin)
        let mut inlineShift = aligned.inlineShift
        let mut blockShift = aligned.blockShift
        if sharing {
          inlineShift = Baselines.shift(&baselines, index, true, inlineShift)
          blockShift = Baselines.shift(&baselines, index, false, blockShift)
        }
        if subgridChildren && Subgrid.inherits(nodes, item.id, style, true) { inlineShift = 0.0 }
        if subgridChildren && Subgrid.inherits(nodes, item.id, style, false) { blockShift = 0.0 }
        let mut inlineOffset = logical.inset.left + columns[column].position + margin.left
          + inlineShift
        if rtl {
          inlineOffset = logical.inset.left + columnSizing.size - columns[column].position
            - margin.right
            - size.width
            - inlineShift
        }
        let location = axis.physicalPoint(
          Point {
            x: inlineOffset,
            y: logical.inset.top + rows[row].position + margin.top + blockShift,
          },
          output.boxes[item.id].size,
          result.size,
        )
        run output.place(item.id, location, aligned.margin, false, input.performLayout)
      }
      index = index + 1
    }
    if sharing && pass == 0 {
      SubgridSizing.captureFinal(nodes, &output, id, logical.inset, lease.value.columns.members.asSlice(),
        items.length, columns, true, &mut baselines)
      SubgridSizing.captureFinal(nodes, &output, id, logical.inset, lease.value.rows.members.asSlice(),
        items.length, rows, false, &mut baselines)
    }
    pass = pass + 1
  }
  if sharing && !fragmented {
    run SubgridSizing.placeFinal(nodes, &mut output, id, result.size, logical.inset, lease.value.columns.members.asSlice(),
      items.length, columns, true, &baselines, input.performLayout)
    run SubgridSizing.placeFinal(nodes, &mut output, id, result.size, logical.inset, lease.value.rows.members.asSlice(),
      items.length, rows, false, &baselines, input.performLayout)
  }
  if input.baselines && !fragmented {
    Baselines.containerBaselines(
      nodes,
      &output,
      &mut measurer,
      items,
      style,
      &baselines,
      &mut result,
      false,
    )
  }
  if input.performLayout && input.fragmentation.boundaryProbe == BoundaryProbe.After
    && nodes.node(id).dynamicAfter {
    let mut state = output.resumes.get(id)
    state.after = FragmentBox.boundary(
      nodes,
      id,
      false,
      input.fragmentation.kind,
      input.fragmentation.rectoOnRight,
    )
    state.after.merge(
      Fragments.outerBoundary(
        nodes,
        &output,
        items,
        rows.length,
        axis.reverseBlock != Axes.make(output.frames.writingMode).reverseBlock,
        false,
        input.fragmentation.rectoOnRight,
      ),
    )
    run output.resumes.set(id, state)
  }
  if input.performLayout && (style.position != Position.Static || input.gridContext != 0) {
    let emptyNames = LineNames.make()
    let mut columnNames = &emptyNames
    let mut rowNames = &emptyNames
    let mut columnExplicit = template.columns.tracks.length()
    let mut rowExplicit = template.rows.tracks.length()
    if prepared {
      let value = &lease.value.template.asSlice()[0]
      columnNames = &value.columnNames
      rowNames = &value.rowNames
      columnExplicit = value.columns.explicitTracks
      rowExplicit = value.rows.explicitTracks
    }
    run output.cache.gridGeometry.capture(
      id,
      columns,
      bounds.columnOrigin,
      columnExplicit,
      columnNames,
      rows,
      bounds.rowOrigin,
      rowExplicit,
      rowNames,
    )
    output.cache.gridGeometry.setContext(id, input.gridContext)
    if output.frame != NO_NODE {
      let fragment = output.publication(id)
      run output.cache.gridGeometry.setFragment(
        id,
        fragment,
        result.contentRect(),
        result.paddingRect(),
      )
    }
    if fragmented {
      let scratch = &output.cache.gridMemos.fragmentScratch.asSlice()[output.cache.gridMemos.fragmentScratch.length()
        - 1]
      output.cache.gridGeometry.captureRows(id, scratch)
    }
  }
  output.cache.gridMemos.put(move lease)
  return result
}

// A speculative containing-block replay owns its freshly sized memo until its
// checkpoint is restored. Reconstruct the child binding from that geometry,
// never from the most recently interned context of an unrelated probe.
pub effect fn shellContext(
  nodes: &BoxTree, output: &mut LayoutPass, parentBox: usize, child: usize,
) -> usize ! OutOfMemoryError ? &mut Allocator {
  if !Subgrid.eligible(nodes, child) { return 0 }
  let lease = run output.cache.gridMemos.take(parentBox, nodes.boxes.length())
  let parent = nodes.style(parentBox)
  let template = &nodes.grids[parent.grid]
  let mut columnLines = template.columns.lines.asSlice()
  let mut rowLines = template.rows.lines.asSlice()
  let mut areas = template.areas.asSlice()
  let noAreaMasks: [usize; 0] = []
  let mut areaMasks: &[usize] = &noAreaMasks
  if lease.value.template.length() != 0 {
    let prepared = &lease.value.template.asSlice()[0]
    columnLines = expandedLines(&template.columns, &prepared.columns)
    rowLines = expandedLines(&template.rows, &prepared.rows)
    areas = prepared.areas.asSlice()
    areaMasks = prepared.areaMasks.asSlice()
  }
  let source = GridSource {
    columns: columnLines, rows: rowLines, areas: areas,
    areaMasks: areaMasks,
    columnOrigin: lease.value.bounds.columnOrigin, rowOrigin: lease.value.bounds.rowOrigin,
    subgridChildren: true,
  }
  let mut result: usize = 0
  let mut at: usize = 0
  while at < lease.value.items.length() {
    let item = &lease.value.items.asSlice()[at]
    if item.id == child {
      let mut context = output.cache.subgrids.takeBuilder()
      run Subgrid.makeContext(nodes, item, parent, &source, lease.value.columns.tracks.asSlice(),
        lease.value.rows.tracks.asSlice(), lease.value.columnGap, lease.value.rowGap, &mut context)
      result = run output.cache.subgrids.intern(child, move context)
      break
    }
    at = at + 1
  }
  output.cache.gridMemos.put(move lease)
  return result
}
