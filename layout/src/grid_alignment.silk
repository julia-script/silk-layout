import silk.num.usize
import axes { Axes }
import geometry { Size, ResolvedEdges }
import style { Style, Align, OverflowAlignment, DimensionKind, Direction }
import grid_tracks { TrackState }

// CSS Grid 2 §§6.6, 11.3–11.4 and CSS Align 3 #justify-grid/#align-grid.
// Baseline preferences remain intact for the grid's sharing-group pass.
pub fn selfAlignment(style: &Style, parent: &Style, inline: bool) -> Align {
  let mut value = style.alignSelf
  if inline {
    value = style.justifySelf
    if value == Align.Auto {
      value = parent.justifyItems
    }
  } else if value == Align.Auto {
    value = parent.alignItems
  }
  if value == Align.Normal {
    if !style.replaced && style.aspectRatio == 0.0 {
      return Align.Stretch
    }
    return Align.Start
  }
  return value
}

fn selfSafety(style: &Style, parent: &Style, inline: bool) -> OverflowAlignment {
  if inline {
    if style.justifySelf == Align.Auto {
      return parent.justifyItemsSafety
    }
    return style.justifySelfSafety
  }
  if style.alignSelf == Align.Auto {
    return parent.alignItemsSafety
  }
  return style.alignSelfSafety
}

fn positionalOffset(value: Align, safety: OverflowAlignment, free: f32) -> f32 {
  if free < 0.0 && safety == OverflowAlignment.Safe {
    return 0.0
  }
  if value == Align.End || value == Align.FlexEnd {
    return free
  }
  if value == Align.Center {
    return free / 2.0
  }
  return 0.0
}

// Grid 2 §§11.1, 11.5; CSS Align 3 #distribution-values/#overflow-values.
// Positions enter unaligned, in logical start coordinates. Stretch has already
// changed bases in grid_tracks. A rerun must call positionTracks first.
pub fn alignTracks(
  tracks: &mut [TrackState],
  used: f32,
  extent: f32,
  parent: &Style,
  columns: bool,
) {
  let mut value = parent.alignContent
  let mut safety = parent.alignContentSafety
  if columns {
    value = parent.justifyContent
    safety = parent.justifyContentSafety
  }

  // The ordinary path neither counts subjects nor visits their positions.
  if value == Align.Normal || value == Align.Stretch || value == Align.Start
    || value == Align.FlexStart
    || value == Align.Auto {
    return
  }
  let free = extent - used
  if free == 0.0 || tracks.length == 0 {
    return
  }
  if value == Align.Left || value == Align.Right {
    // Justify's physical/line-left and line-right are relative to the
    // container's line axis, not its bidi inline progression.
    let mut end = value == Align.Right
    if columns && parent.usedDirection() == Direction.Rtl {
      end = !end
    }
    value = Align.Start
    if end {
      value = Align.End
    }
  }
  if value == Align.Baseline {
    value = Align.Start
    safety = OverflowAlignment.Safe
  } else if value == Align.LastBaseline {
    value = Align.End
    safety = OverflowAlignment.Safe
  }
  let distributed = value == Align.SpaceBetween || value == Align.SpaceAround
    || value == Align.SpaceEvenly
  let mut offset: f32 = 0.0
  let mut between: f32 = 0.0
  if distributed {
    // Negative free space always uses the distribution's safe fallback.
    if free < 0.0 {
      return
    }
    let mut count: usize = 0
    let mut index: usize = 0
    while index < tracks.length {
      if !tracks[index].collapsed {
        count = count + 1
      }
      index = index + 1
    }
    if count == 0 {
      return
    }
    if value == Align.SpaceBetween {
      if count == 1 {
        return
      }
      between = free / usize.toF32(count - 1)
    } else if value == Align.SpaceAround {
      between = free / usize.toF32(count)
      offset = between / 2.0
    } else {
      between = free / usize.toF32(count + 1)
      offset = between
    }
  } else {
    // CSS Align 3 #auto-safety-default explicitly permits unsafe here when
    // the optional nearest-scroll-container smart safety is not implemented.
    offset = positionalOffset(value, safety, free)
    if offset == 0.0 {
      return
    }
    let mut index: usize = 0
    while index < tracks.length {
      tracks[index].position = tracks[index].position + offset
      index = index + 1
    }
    return
  }
  let mut index: usize = 0
  let mut liveBefore: f32 = 0.0
  let mut shift = offset
  while index < tracks.length {
    let track = &mut tracks[index]
    if !track.collapsed {
      shift = offset + between * liveBefore
      liveBefore = liveBefore + 1.0
    }

    // A collapsed track remains at the preceding live track's end. Its
    // coincident gutters must not create another distribution interval.
    track.position = track.position + shift
    index = index + 1
  }
}

// Return whether the subject's start in the relevant physical axis is the
// container's logical end. Orthogonal subjects use their other logical axis.
pub fn oppositeSelfStart(style: &Style, parent: &Style, axis: &Axes, inline: bool) -> bool {
  let subject = Axes.make(style.writingMode)
  let subjectInlineHigh = subject.reverseLine != (style.usedDirection() == Direction.Rtl)
  let parentInlineHigh = axis.reverseLine != (parent.usedDirection() == Direction.Rtl)
  let parallel = subject.vertical == axis.vertical
  if inline {
    if parallel {
      return subjectInlineHigh != parentInlineHigh
    }
    return subject.reverseBlock != parentInlineHigh
  }
  if parallel {
    return subject.reverseBlock != axis.reverseBlock
  }
  return subjectInlineHigh != axis.reverseBlock
}

fn itemOffset(style: &Style, parent: &Style, axis: &Axes, inline: bool, free: f32) -> f32 {
  let mut value = selfAlignment(style, parent, inline)
  let mut safety = selfSafety(style, parent, inline)
  if value == Align.Baseline {
    value = Align.SelfStart
    safety = OverflowAlignment.Safe
  } else if value == Align.LastBaseline {
    value = Align.SelfEnd
    safety = OverflowAlignment.Safe
  }
  if value == Align.SelfStart || value == Align.SelfEnd {
    let mut end = oppositeSelfStart(style, parent, axis, inline)
    if value == Align.SelfEnd {
      end = !end
    }
    value = Align.Start
    if end {
      value = Align.End
    }
  } else if value == Align.Left || value == Align.Right {
    let mut end = value == Align.Right
    if inline && parent.usedDirection() == Direction.Rtl {
      end = !end
    }
    value = Align.Start
    if end {
      value = Align.End
    }
  }
  return positionalOffset(value, safety, free)
}

pub struct ItemAlignment {
  pub margin: ResolvedEdges,
  pub inlineShift: f32,
  pub blockShift: f32,
}

// Grid 2 §11.2: auto margins absorb positive space before self-alignment;
// overflow zeros only those margins, leaving self-alignment applicable.
// area/size and shifts are logical. Margins enter and leave physical. Shifts
// exclude margins and are measured from parent inline-start/block-start,
// unlike Axes' direction-independent line-left internal x coordinate.
pub fn alignItem(
  style: &Style,
  parent: &Style,
  axis: &Axes,
  area: Size,
  size: Size,
  usedMargin: ResolvedEdges,
) -> ItemAlignment with Intrinsic.inlineAlways() {
  let lowAuto = axis.lowAuto(style)
  let highAuto = axis.highAuto(style)
  let mut beforeAuto = style.margin.top.kind == DimensionKind.Auto
  let mut afterAuto = style.margin.bottom.kind == DimensionKind.Auto
  if axis.vertical {
    beforeAuto = style.margin.left.kind == DimensionKind.Auto
    afterAuto = style.margin.right.kind == DimensionKind.Auto
    if axis.reverseBlock {
      beforeAuto = style.margin.right.kind == DimensionKind.Auto
      afterAuto = style.margin.left.kind == DimensionKind.Auto
    }
  }
  let mut margin = axis.edges(usedMargin)

  // Child block layout may already have resolved auto margins against its
  // available width. Grid resolves them afresh against the actual grid area.
  if lowAuto {
    margin.left = 0.0
  }
  if highAuto {
    margin.right = 0.0
  }
  if beforeAuto {
    margin.top = 0.0
  }
  if afterAuto {
    margin.bottom = 0.0
  }
  let inlineFree = area.width - size.width - margin.horizontal()
  let blockFree = area.height - size.height - margin.vertical()
  let mut inlineShift: f32 = 0.0
  let mut blockShift: f32 = 0.0
  if inlineFree > 0.0 && (lowAuto || highAuto) {
    let mut share = inlineFree
    if lowAuto && highAuto {
      share = inlineFree / 2.0
    }
    if lowAuto {
      margin.left = share
    }
    if highAuto {
      margin.right = share
    }
  } else {
    inlineShift = itemOffset(style, parent, axis, true, inlineFree)
  }
  if blockFree > 0.0 && (beforeAuto || afterAuto) {
    let mut share = blockFree
    if beforeAuto && afterAuto {
      share = blockFree / 2.0
    }
    if beforeAuto {
      margin.top = share
    }
    if afterAuto {
      margin.bottom = share
    }
  } else {
    blockShift = itemOffset(style, parent, axis, false, blockFree)
  }
  return ItemAlignment {
    margin: axis.physicalEdges(margin),
    inlineShift: inlineShift,
    blockShift: blockShift,
  }
}
