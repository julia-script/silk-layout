    |> Effect.provideMut<Allocator>(&mut allocator)
}

// Grid 6.6 caps the border box at stretch-fit: margins consume the fixed area.
test effect fn gridFixedMaximumCapsContentSuggestionNotIntrinsicContribution()
  ! OutOfMemoryError | InvalidNode | TextError | FragmentationError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.padding.left = Dimension.px(6.0)
  style.margin.left = Dimension.px(3.0)
  style.margin.right = Dimension.px(5.0)
  run check(
    move style,
    Input.make(OptionalSize.none()),
    true,
    true,
    19.0,
    ItemContribution { minimum: 19.0, minContent: 37.0, maxContent: 105.0, usedMinimum: 11.0 },
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
}

