struct ContributionMeasure {
  calls: usize
}

impl Measure for ContributionMeasure {
  fn font(provider: &mut Self, request: FontRequest) -> FontMetrics {
    drop provider
    drop request
    return FontMetrics.zero()
  }

  fn scrollbars(provider: &mut Self, request: ScrollbarRequest) -> ScrollbarMetrics {
    drop provider
    drop request
    return ScrollbarMetrics.zero()
  }

  fn natural(provider: &mut Self, key: usize) -> NaturalDimensions {
    drop provider
    drop key
    return NaturalDimensions.none()
  }

  fn measure(provider: &mut Self, key: usize, request: MeasureRequest) -> Measured {
    provider.calls = provider.calls + 1
    let mut width: f32 = 91.0
    let mut height: f32 = 67.0
    if request.width.kind == AvailableKind.MinContent {
      width = 23.0
    }
    if request.height.kind == AvailableKind.MinContent {
      height = 17.0
    }

    // Keys 1/2 grow their maxima after rows resolve; only key 1 also changes
    // the triggering minimum. Key 3 adds a known-height-dependent width.
    if key != 0 {
      width = 20.0
      height = 30.0
      if request.height.kind == AvailableKind.Definite {
        width = 80.0
      }
      if request.width.kind == AvailableKind.MinContent {
        width = 10.0
        if key == 1 && request.height.kind == AvailableKind.Definite {
          width = 40.0
        }
      }
    }
    if key == 3 && request.known.heightDefinite {
      width = request.known.height * 2.0
    }
    if request.known.widthDefinite {
      width = request.known.width
    }
    if request.known.heightDefinite {
      height = request.known.height
    }
    return Measured {
      size: Size { width: width, height: height },
      scrollableOverflow: Rect { x: 0.0, y: 0.0, width: width, height: height },
      contentBlockSize: height,
      firstBaselines: BaselineSet.uniform(0.0),
      lastBaselines: BaselineSet.uniform(0.0),
      hasBaseline: false,
      hasLineBoxes: false,
    }
  }
}

impl TextMeasure for ContributionMeasure {
  fn beginTextLayout(provider: &mut Self) {
    drop provider
  }

  effect fn analyze(
    provider: &mut Self,
    context: TextContext,
    output: &mut List<TextBreak>,
  ) -> TextAnalysis
    ! OutOfMemoryError | TextError
    ? &mut Allocator {
    drop provider
    drop context
    drop output
    fail TextError { source: 0, message: "contribution fixture contains no text" }
  }

  effect fn shape(provider: &mut Self, request: TextShapeRequest, output: &mut List<TextRun>)
    ! OutOfMemoryError | TextError
    ? &mut Allocator {
    drop provider
    drop request
    drop output
    fail TextError { source: 0, message: "contribution fixture contains no text" }
  }
}

effect fn check(
  style: Style,
  input: Input,
  horizontal: bool,
  allowed: bool,
  cap: f32,
  expected: ItemContribution,
)
  ! OutOfMemoryError | InvalidNode | TextError | FragmentationError | AssertionError<'static>
  ? &mut Allocator {
  run checkWithOptions(move style, input, horizontal, allowed, cap, UNBOUNDED, false, expected)
}

effect fn checkWithOptions(
  style: Style,
  input: Input,
  horizontal: bool,
  allowed: bool,
  cap: f32,
  crossCap: f32,
  minimumOnly: bool,
  expected: ItemContribution,
)
  ! OutOfMemoryError | InvalidNode | TextError | FragmentationError | AssertionError<'static>
  ? &mut Allocator {
  let mut rootStyle = Style.make()
  rootStyle.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Grid }
  let mut tree = run Tree.make(move rootStyle)
  let root = tree.root()
  let item = run tree.append(root, move style)
  run tree.setMeasurement(item, 0)
  let boxes = run Boxes.build(
    tree.nodes.asSlice(),
    tree.styles.asSlice(),
    tree.grids.asSlice(),
    tree.gridNames.asSlice(),
    WritingMode.HorizontalTb,
    Direction.Ltr,
  )
  let mut output = LayoutTree.make()
  run output.prepare(boxes.boxes.length())
  let mut pass = run LayoutPass.make(
    output.boxes.asMutSlice(),
    &mut output.fragments,
    boxes.sources,
  )
  let mut measurer = ContributionMeasure { calls: 0 }
  let id = boxes.firstBySource.get(item.index)
  let result = run measureContribution(
    &boxes,
    &mut pass,
    &mut measurer,
    id,
    &input,
    horizontal,
    allowed,
    cap,
    crossCap,
    !minimumOnly,
    !minimumOnly,
  )
  run Testing.expect(
    abs(result.minimum - expected.minimum) < 0.00001,
    "minimum contribution follows Grid 12.5",
  )
  if !minimumOnly {
    run Testing.expect(
      abs(result.minContent - expected.minContent) < 0.00001,
      "min-content contribution includes sizing constraints",
    )
    run Testing.expect(
      abs(result.maxContent - expected.maxContent) < 0.00001,
      "max-content contribution includes sizing constraints",
    )
  } else {
    run Testing.expect(
      measurer.calls == 0,
      "a definite minimum-only request performs no content measurement",
    )
  }
  run Testing.expect(
    abs(result.usedMinimum - expected.usedMinimum) < 0.00001,
    "automatic minimum follows Grid 6.6",
  )
  let calls = measurer.calls
  let repeated = run measureContribution(
    &boxes,
    &mut pass,
    &mut measurer,
    id,
    &input,
    horizontal,
    allowed,
    cap,
    crossCap,
    !minimumOnly,
    !minimumOnly,
  )
  run Testing.expect(
    measurer.calls == calls && repeated.minimum == result.minimum
      && repeated.maxContent == result.maxContent,
    "repeat contributions reuse cached probes",
  )
}

// Grid 6.6 selects the specified suggestion, not min(content, specified).
test effect fn gridSpecifiedSuggestionCanExceedContent()
  ! OutOfMemoryError | InvalidNode | TextError | FragmentationError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.width = Dimension.px(73.0)
  run check(
    move style,
    Input.make(OptionalSize.none()),
    true,
    true,
    UNBOUNDED,
    ItemContribution { minimum: 73.0, minContent: 73.0, maxContent: 73.0, usedMinimum: 73.0 },
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
}

// Grid 6.6 does not apply Flexbox's max(content, transferred) to non-replaced items.
test effect fn gridNonReplacedMinimumIgnoresPreferredRatioTransfer()
  ! OutOfMemoryError | InvalidNode | TextError | FragmentationError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.height = Dimension.px(40.0)
  style.aspectRatio = 2.0
  run check(
    move style,
    Input.make(OptionalSize.none()),
    true,
    true,
    UNBOUNDED,
    ItemContribution { minimum: 23.0, minContent: 80.0, maxContent: 80.0, usedMinimum: 23.0 },
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
}

// Grid 6.6 selects a replaced transferred suggestion even above min-content.
test effect fn gridReplacedMinimumUsesPreferredRatioTransfer()
