// A stretched opposite size affects contributions, not the specified suggestion.
test effect fn gridStretchedKnownSizesDoNotBecomePreferredSuggestions()
  ! OutOfMemoryError | InvalidNode | TextError | FragmentationError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.aspectRatio = 2.0
  let mut input = Input.make(OptionalSize.definite(200.0, 100.0))
  input.known = OptionalSize.definite(200.0, 46.0)
  run check(
    move style,
    input,
    true,
    true,
    UNBOUNDED,
    ItemContribution { minimum: 23.0, minContent: 92.0, maxContent: 92.0, usedMinimum: 23.0 },
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
}

