// Grid 2 §12.1: changed min-content contributions trigger one column rerun,
// using the newly resolved row space for both minimum and maximum contributions.
// A changed maximum alone does not trigger it. The first track is initially
// minmax(10px, 20px); resolving the 30px row changes maxima to 80px in both
// cases, but only the first case changes the minimum to 40px.
effect fn checkCrossAxisRecheck()
  ! OutOfMemoryError
    | InvalidNode
    | GridError
    | TextError
    | FragmentationError
    | AssertionError<'static>
  ? &mut Allocator {
  let expectedWidths: [f32; 2] = [80.0, 20.0]
  let mut index: usize = 0
  while index < expectedWidths.length {
    let mut style = Style.make()
    style.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Grid }
    style.alignItems = Align.Start
    let mut tree = run Tree.make(move style)
    let root = tree.root()
    let mut template = GridTemplate.make()
    run template.columns.tracks.append(
      GridTrack.minmax(
        GridBreadth { kind: GridBreadthKind.MinContent, length: 0.0, percent: 0.0 },
        GridBreadth { kind: GridBreadthKind.MaxContent, length: 0.0, percent: 0.0 },
      ),
    )
    run template.columns.tracks.append(GridTrack.breadth(GridBreadth.fixed(10.0)))
    run tree.setGrid(root, move template)
    let item = run tree.append(root, Style.make())
    run tree.setMeasurement(item, index + 1)
    let mut markerStyle = Style.make()
    markerStyle.height = Dimension.px(10.0)
    let marker = run tree.append(root, move markerStyle)
    let mut output = LayoutTree.make()
    let mut provider = ContributionMeasure { calls: 0 }
    run compute(&tree, &mut output, &mut provider, OptionalSize.definite(300.0, 200.0))
    let itemBounds = run output.sourceBounds(item)
    let markerBounds = run output.sourceBounds(marker)
    let rootBounds = run output.sourceBounds(root)
    run Testing.expect(
      itemBounds.x == 0.0 && itemBounds.y == 0.0 && itemBounds.width == expectedWidths[index]
        && itemBounds.height == 30.0
        && markerBounds.x == expectedWidths[index]
        && markerBounds.y == 0.0
        && markerBounds.width == 10.0
        && markerBounds.height == 10.0
        && rootBounds.width == 300.0
        && rootBounds.height == 30.0,
      "only a changed min-content contribution reruns columns with the new maximum",
    )
    index = index + 1
  }
}

test effect fn gridCrossAxisRecheckRefreshesMaximaOnlyAfterMinimumChanges()
  ! OutOfMemoryError
    | InvalidNode
    | GridError
    | TextError
    | FragmentationError
    | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run checkCrossAxisRecheck() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Grid §12.1 resolves container limits while sizing tracks. A caller's floor
// ignored by an intrinsic query must not be revived by that authored-limit
// projection. The explicit tracks total 20px by 5px.
effect fn checkGridIntrinsicRequestMinimum()
  ! OutOfMemoryError
    | InvalidNode
    | GridError
    | TextError
    | FragmentationError
    | AssertionError<'static>
  ? &mut Allocator {
  let mut style = Style.make()
  style.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Grid }
  let mut tree = run Tree.make(move style)
  let root = tree.root()
  let mut template = GridTemplate.make()
  run template.columns.tracks.append(GridTrack.breadth(GridBreadth.fixed(10.0)))
  run template.columns.tracks.append(GridTrack.breadth(GridBreadth.fixed(10.0)))
  run template.rows.tracks.append(GridTrack.breadth(GridBreadth.fixed(5.0)))
  run tree.setGrid(root, move template)
  let boxes = run Boxes.build(
    tree.nodes.asSlice(),
    tree.styles.asSlice(),
    tree.grids.asSlice(),
    tree.gridNames.asSlice(),
    WritingMode.HorizontalTb,
    Direction.Ltr,
  )
  let id = boxes.firstBySource.get(root.index)
  let mut output = LayoutTree.make()
  run output.prepare(boxes.boxes.length())
  let mut pass = run LayoutPass.make(
    output.boxes.asMutSlice(),
    &mut output.fragments,
    boxes.sources,
  )
  let mut provider = ContributionMeasure { calls: 0 }
  let mut input = Input.make(OptionalSize.none())
  input.blockRoot = true
  input.performLayout = false
  input.minimum = Size { width: 120.0, height: 30.0 }
  input.intrinsicWidth = true
  input.availableWidth = AvailableSpace.minContent()
  run probeNode(&boxes, &mut pass, &mut provider, id, &input)
  run Testing.expect(
    pass.boxes[id].size.width == 20.0 && pass.boxes[id].size.height == 30.0,
    "intrinsic Grid width ignores its own floor but retains the height floor",
  )
  input.intrinsicWidth = false
  input.availableWidth = AvailableSpace.maxContent()
  input.intrinsicHeight = true
  input.availableHeight = AvailableSpace.minContent()
  run probeNode(&boxes, &mut pass, &mut provider, id, &input)
  run Testing.expect(
    pass.boxes[id].size.width == 120.0 && pass.boxes[id].size.height == 5.0,
    "intrinsic Grid height ignores its own floor but retains the width floor",
  )
}

test effect fn gridIntrinsicRequestDoesNotReviveItsIgnoredMinimum()
  ! OutOfMemoryError
    | InvalidNode
    | GridError
    | TextError
    | FragmentationError
    | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run checkGridIntrinsicRequestMinimum() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Sizing §5.1: an intrinsic query removes constraints in its queried axis,
// not the opposite axis. The provider's width becomes twice its known height
// after the height floor is enforced; width-only cache keys must distinguish it.
effect fn checkMeasuredCrossMinimum()
  ! OutOfMemoryError | InvalidNode | TextError | FragmentationError | AssertionError<'static>
  ? &mut Allocator {
  let mut tree = run Tree.make(Style.make())
  let root = tree.root()
  run tree.setMeasurement(root, 3)
  let boxes = run Boxes.build(
    tree.nodes.asSlice(),
    tree.styles.asSlice(),
    tree.grids.asSlice(),
    tree.gridNames.asSlice(),
    WritingMode.HorizontalTb,
    Direction.Ltr,
  )
  let id = boxes.firstBySource.get(root.index)
  let mut output = LayoutTree.make()
  run output.prepare(boxes.boxes.length())
  let mut pass = run LayoutPass.make(
    output.boxes.asMutSlice(),
    &mut output.fragments,
    boxes.sources,
  )
  let mut provider = ContributionMeasure { calls: 0 }
  let mut input = Input.make(OptionalSize.none())
  input.blockRoot = true
  input.performLayout = false
  input.baselines = false
  input.fullSize = false
  input.intrinsicWidth = true
  input.availableWidth = AvailableSpace.minContent()
  input.minimum = Size { width: 0.0, height: 40.0 }
  run probeNode(&boxes, &mut pass, &mut provider, id, &input)
  run Testing.expect(
    pass.boxes[id].size.width == 80.0,
    "height floor participates in measured intrinsic width",
  )
  input.minimum.height = 60.0
  run probeNode(&boxes, &mut pass, &mut provider, id, &input)
  run Testing.expect(
    pass.boxes[id].size.width == 120.0,
    "a changed cross floor cannot reuse the old measured width",
  )

  // The same cross constraint must reach the scalar intrinsic queries used
  // by fit-content sizing, not just the top-level width-only probe.
  input.intrinsicWidth = false
  input.fullSize = true
  input.shrinkToFit = true
  input.availableWidth = AvailableSpace.definite(200.0)
  input.minimum.height = 40.0
  run probeNode(&boxes, &mut pass, &mut provider, id, &input)
  run Testing.expect(
    pass.boxes[id].size.width == 80.0 && pass.boxes[id].size.height == 40.0,
    "fit-content sizing includes the effective cross minimum in its intrinsic queries",
  )
}

test effect fn gridWidthProbeKeepsMeasuredCrossMinimumDependencies()
  ! OutOfMemoryError | InvalidNode | TextError | FragmentationError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run checkMeasuredCrossMinimum() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Grid §6.6 / §12.5: resolving authored constraints for a contribution must
// not reactivate a request floor ignored by the incoming intrinsic query.
test effect fn gridContributionPropertiesDoNotReviveIgnoredRequestMinimum()
  ! OutOfMemoryError | InvalidNode | TextError | FragmentationError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut input = Input.make(OptionalSize.none())
  input.intrinsicWidth = true
  input.minimum = Size { width: 120.0, height: 30.0 }
  run check(
    Style.make(),
    input,
    true,
    false,
    UNBOUNDED,
    ItemContribution { minimum: 0.0, minContent: 23.0, maxContent: 91.0, usedMinimum: 0.0 },
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
}

// Grid §6.6: an automatic minimum is a floor, not a preferred size.
// Both items span an auto-min track capped at 100px, giving a 23px content
// minimum. The first keeps its natural 91px width. The second's 2:1 ratio
// suggests 20px from its definite 10px height, so the 23px minimum wins.
effect fn checkGridItemMinimumBounds()
  ! OutOfMemoryError
    | InvalidNode
    | GridError
    | TextError
    | FragmentationError
    | AssertionError<'static>
  ? &mut Allocator {
  let mut style = Style.make()
  style.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Grid }
  style.width = Dimension.px(100.0)
  style.justifyItems = Align.Start
  style.alignItems = Align.Start
  let mut tree = run Tree.make(move style)
  let root = tree.root()
  let mut template = GridTemplate.make()
  run template.columns.tracks.append(
    GridTrack.minmax(
      GridBreadth { kind: GridBreadthKind.Auto, length: 0.0, percent: 0.0 },
      GridBreadth.fixed(100.0),
    ),
  )
  run tree.setGrid(root, move template)
  let natural = run tree.append(root, Style.make())
  run tree.setMeasurement(natural, 0)
  let mut ratioStyle = Style.make()
  ratioStyle.height = Dimension.px(10.0)
  ratioStyle.aspectRatio = 2.0
  let ratio = run tree.append(root, move ratioStyle)
  run tree.setMeasurement(ratio, 0)
  let mut output = LayoutTree.make()
  let mut provider = ContributionMeasure { calls: 0 }
  run compute(&tree, &mut output, &mut provider, OptionalSize.definite(100.0, 100.0))
  let naturalBounds = run output.sourceBounds(natural)
  let ratioBounds = run output.sourceBounds(ratio)
  run Testing.expect(
    naturalBounds.x == 0.0 && naturalBounds.y == 0.0 && naturalBounds.width == 91.0
      && naturalBounds.height == 67.0,
    "a nonbinding automatic minimum preserves the larger natural size",
  )
  run Testing.expect(
    ratioBounds.x == 0.0 && ratioBounds.y == 67.0 && ratioBounds.width == 23.0
      && ratioBounds.height == 10.0,
    "a binding automatic minimum beats a smaller ratio-derived width",
  )
}

test effect fn gridItemMinimumBoundsPreserveNaturalAndRatioSizing()
  ! OutOfMemoryError
    | InvalidNode
    | GridError
    | TextError
    | FragmentationError
    | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run checkGridItemMinimumBounds() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Grid §12.5 / Sizing §5.1: the queried intrinsic width ignores its own
// request floor, then the contribution's effective minimum clamps it.
// Insets add 8px to 23/91px content widths; -2px net margins are added once.
// Neither a known stretch width nor an inapplicable automatic-minimum cap
// replaces the independent 40px border-box lower bound.
test effect fn gridAutoContributionsKeepExplicitBoundsAndNegativeMargins()
  ! OutOfMemoryError | InvalidNode | TextError | FragmentationError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.padding.left = Dimension.px(6.0)
  style.border.right = Dimension.px(2.0)
  style.margin.left = Dimension.px(-5.0)
  style.margin.right = Dimension.px(3.0)
  let mut input = Input.make(OptionalSize.none())
  input.known = OptionalSize.definite(200.0, 60.0)
  input.minimum = Size { width: 40.0, height: 0.0 }
  run check(
    move style,
    input,
    true,
    false,
    19.0,
    ItemContribution { minimum: 38.0, minContent: 38.0, maxContent: 97.0, usedMinimum: 40.0 },
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
}

// Grid §§12.5, 12.8 first measure the auto row, then stretch it to 100px.
// Flexbox §9.2 must prepare again under that final cross constraint. Provider
// key 3 returns 80px for definite available height, or twice a known height:
// start alignment therefore gives 80x30, while stretch gives 200x100.
effect fn checkGridFlexCrossConstraints()
  ! OutOfMemoryError
    | InvalidNode
    | GridError
    | TextError
    | FragmentationError
    | AssertionError<'static>
  ? &mut Allocator {
  let mut mode: usize = 0
  while mode < 2 {
    let mut rootStyle = Style.make()
    rootStyle.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Grid }
    rootStyle.width = Dimension.px(200.0)
    rootStyle.height = Dimension.px(100.0)
    let mut tree = run Tree.make(move rootStyle)
    let root = tree.root()
    let mut template = GridTemplate.make()
    run template.columns.tracks.append(GridTrack.breadth(GridBreadth.fixed(200.0)))
    run tree.setGrid(root, move template)
    let mut flexStyle = Style.make()
    flexStyle.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Flex }
    flexStyle.alignSelf = Align.Start
    if mode == 1 {
      flexStyle.alignSelf = Align.Stretch
    }
    let flex = run tree.append(root, move flexStyle)
    let mut itemStyle = Style.make()
    itemStyle.minWidth = Dimension.px(0.0)
    itemStyle.flexShrink = 0.0
    let item = run tree.append(flex, move itemStyle)
    run tree.setMeasurement(item, 3)
    let mut output = LayoutTree.make()
    let mut provider = ContributionMeasure { calls: 0 }
    run compute(&tree, &mut output, &mut provider, OptionalSize.definite(200.0, 100.0))
    let bounds = run output.sourceBounds(item)
    let container = run output.sourceBounds(flex)
    let mut width: f32 = 80.0
    let mut height: f32 = 30.0
    if mode == 1 {
      width = 200.0
      height = 100.0
    }
    run Testing.expect(
      bounds.x == 0.0 && bounds.y == 0.0 && bounds.width == width && bounds.height == height,
      "final Flex preparation preserves both available and known cross constraints",
    )
    run Testing.expect(
      container.width == 200.0 && container.height == height,
      "start keeps the natural cross size while stretch takes the final grid row",
    )
    mode = mode + 1
  }
}

test effect fn gridFlexPreparationsKeepFinalCrossConstraints()
  ! OutOfMemoryError
    | InvalidNode
    | GridError
    | TextError
    | FragmentationError
    | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run checkGridFlexCrossConstraints() |> Effect.provideMut<Allocator>(&mut allocator)
}
