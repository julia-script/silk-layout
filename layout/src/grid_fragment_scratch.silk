import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.num.i32
import geometry { Size, Point, OptionalSize, ResolvedEdges }
import grid_placement { GridItem }
import grid_tracks { TrackState }
import tree { NO_NODE }

// Cursor/adjacency rows are frame-traversal ordinals; placement and tracks
// remain in Grid logical order. This reversal is its own inverse.
pub fn logicalRow(ordinal: usize, rowCount: usize, reversed: bool) -> usize {
  if reversed {
    return rowCount - ordinal - 1
  }
  return ordinal
}

pub fn startRow(item: &GridItem, rowCount: usize, reversed: bool) -> usize {
  if reversed {
    return rowCount - i32.toUsize(item.row.end)
  }
  return i32.toUsize(item.row.start)
}

pub fn endRow(item: &GridItem, rowCount: usize, reversed: bool) -> usize {
  if reversed {
    return rowCount - i32.toUsize(item.row.start)
  }
  return i32.toUsize(item.row.end)
}

// Full item allocations are temporary sizing results, not continuation state.
// Only the existing ResumeStore journal owns consumed content and size progress.
pub struct FragmentItem {
  pub size: Size,
  pub offset: Point,
  pub margin: ResolvedEdges,
  pub known: OptionalSize,
  pub minimum: Size,
  // Immutable inherited geometry shared by boundary probes and accepted retries.
  pub gridContext: usize,
  pub nextStart: usize,
  pub nextEnd: usize,
}

impl FragmentItem {
  pub fn make() -> FragmentItem {
    return FragmentItem {
      size: Size { width: 0.0, height: 0.0 },
      offset: Point { x: 0.0, y: 0.0 },
      margin: ResolvedEdges.zero(),
      known: OptionalSize.none(),
      minimum: Size { width: 0.0, height: 0.0 },
      gridContext: 0,
      nextStart: NO_NODE,
      nextEnd: NO_NODE,
    }
  }
}

pub struct FragmentRow {
  pub firstStart: usize,
  pub firstEnd: usize,
  pub consumedStart: f32,
  pub consumedEnd: f32,
  pub accepted: bool,
  pub starts: bool,
  pub ends: bool,
}

impl Copy for FragmentRow {}

pub struct GridFragmentScratch {
  pub items: List<FragmentItem>,
  pub rows: List<FragmentRow>,
  pub baselineRows: List<TrackState>,
  pub reversed: bool,
}

impl GridFragmentScratch {
  pub fn make() -> GridFragmentScratch {
    return GridFragmentScratch {
      items: List<FragmentItem>.make(),
      rows: List<FragmentRow>.make(),
      baselineRows: List<TrackState>.make(),
      reversed: false,
    }
  }

  pub effect fn prepare(self: &mut Self, items: &[GridItem], rowCount: usize, reversed: bool)
    ! OutOfMemoryError
    ? &mut Allocator {
    self.items.clear()
    self.rows.clear()
    self.baselineRows.clear()
    self.reversed = reversed
    run self.items.reserve(items.length)
    let mut index: usize = 0
    while index < items.length {
      run self.items.append(FragmentItem.make())
      index = index + 1
    }
    run self.rows.appendRepeated(
      FragmentRow {
        firstStart: NO_NODE,
        firstEnd: NO_NODE,
        consumedStart: 0.0,
        consumedEnd: 0.0,
        accepted: false,
        starts: false,
        ends: false,
      },
      rowCount,
    )

    // Prepending in reverse preserves order-modified document order at each
    // boundary, including the precedence of competing page-side requirements.
    while index > 0 {
      index = index - 1
      let start = startRow(&items[index], rowCount, reversed)
      let end = endRow(&items[index], rowCount, reversed) - 1
      let entry = &mut self.items.asMutSlice()[index]
      let rows = self.rows.asMutSlice()
      entry.nextStart = rows[start].firstStart
      rows[start].firstStart = index
      entry.nextEnd = rows[end].firstEnd
      rows[end].firstEnd = index
    }
  }
}
