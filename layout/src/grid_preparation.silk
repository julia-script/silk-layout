import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.num.i32
import silk.num.usize
import silk.core.option { Option }
import axes { Axes }
import box_tree { BoxTree }
import context { Input, ResolvedBox, resolves, effectiveDisplay, blockJustification, outOfFlow }
import geometry { OptionalSize, AvailableKind, max, clamp }
import style { Style, DimensionKind, DisplayOutside, Float, Align, WritingMode }
import grid_style { GridTemplate }
import grid_lines { prepareLineNames }
import grid_template { RepeatSizing, repeatCount, expandAxis, expandedLines }
import grid_placement { GridItem, collectItems }
import grid_scratch { GridScratch, GridTemplateScratch }
import grid_context { GridContext, GridContextStore }
import grid_subgrid as Subgrid

pub fn needsPreparation(template: &GridTemplate) -> bool with Intrinsic.inlineAlways() {
  return template.rows.subgridded || template.columns.subgridded
    || template.rows.repeats.length() != 0 || template.columns.repeats.length() != 0
    || template.rows.lines.length() != 0
    || template.columns.lines.length() != 0
    || template.areaRows != 0
}

// A shrink-to-fit or min/max relayout gives the engine a used size, not a new
// definite preferred size for repeat counting. Preserve author/parent constraints
// and distinguish fill-available sizing from content-derived sizing.
pub fn preferredSizes(
  style: &Style,
  input: &Input,
  logical: &ResolvedBox,
  limits: &ResolvedBox,
  axis: &Axes,
) -> OptionalSize {
  let mut result = axis.optional(limits.size)
  let used = axis.optional(logical.size)
  let minimum = axis.size(limits.min)
  let maximum = axis.size(limits.max)
  result.widthDefinite = resolves(style.width, input.parent.widthDefinite)
    || (input.known.widthDefinite && !input.indefiniteWidth)
  result.heightDefinite = resolves(style.height, input.parent.heightDefinite)
    || (input.known.heightDefinite && !input.indefiniteHeight)
  if result.widthDefinite {
    result.width = clamp(result.width, minimum.width, max(minimum.width, maximum.width))
  }
  if result.heightDefinite {
    result.height = clamp(result.height, minimum.height, max(minimum.height, maximum.height))
  }

  let horizontal = style.writingMode == WritingMode.HorizontalTb
  let parentHorizontal = input.parentWritingMode == WritingMode.HorizontalTb
  let justification = blockJustification(style, input)
  let mut autoMargin = style.margin.left.kind == DimensionKind.Auto
    || style.margin.right.kind == DimensionKind.Auto
  if !parentHorizontal {
    autoMargin = style.margin.top.kind == DimensionKind.Auto
      || style.margin.bottom.kind == DimensionKind.Auto
  }
  let stretch = justification == Align.Stretch && !autoMargin
  let fit = justification != Align.Normal && !stretch
  let floating = style.float != Float.None && !input.blockify
  let ordinary = effectiveDisplay(style, input).outsideIs(DisplayOutside.Block) && !floating
    && !outOfFlow(style)
  let fill = horizontal == parentHorizontal && (ordinary || stretch)
    && ((!input.shrinkToFit && !fit) || stretch)
  if fill && horizontal && !result.widthDefinite && !input.intrinsicWidth && !input.indefiniteWidth
    && style.width.kind == DimensionKind.Auto
    && input.availableWidth.kind == AvailableKind.Definite
    && used.widthDefinite {
    result.width = used.width
    result.widthDefinite = true
  }
  if fill && !horizontal && !result.heightDefinite && !input.intrinsicHeight
    && !input.indefiniteHeight
    && style.height.kind == DimensionKind.Auto
    && input.availableHeight.kind == AvailableKind.Definite
    && used.heightDefinite {
    result.height = used.height
    result.heightDefinite = true
  }

  // The engine has already performed aspect-ratio transfer and min/max clamping.
  // Only a definite opposite axis can make this a content-independent size.
  if style.aspectRatio > 0.0 {
    if result.heightDefinite && !result.widthDefinite && used.widthDefinite
      && !input.indefiniteWidth {
      result.width = used.width
      result.widthDefinite = true
    }
    if result.widthDefinite && !result.heightDefinite && used.heightDefinite
      && !input.indefiniteHeight {
      result.height = used.height
      result.heightDefinite = true
    }
  }
  return axis.optional(result)
}

// A maximum end at each span start plus a prefix maximum marks occupancy in
// O(items + repeated tracks), including spans that start outside the fit range.
effect fn collectCollapsed(
  items: &[GridItem],
  columns: bool,
  origin: i32,
  first: usize,
  last: usize,
  work: &mut List<usize>,
  result: &mut List<usize>,
)
  ! OutOfMemoryError
  ? &mut Allocator {
  result.clear()
  if first == last {
    return
  }
  let start = usize.toI32(first) - origin
  let end = usize.toI32(last) - origin
  let count = last - first
  work.clear()
  run work.appendRepeated(0, count)
  let mut index: usize = 0
  while index < items.length {
    let mut span = items[index].row
    if columns {
      span = items[index].column
    }
    if span.start < start {
      span.start = start
    }
    if span.end > end {
      span.end = end
    }
    if span.start < span.end {
      let at = i32.toUsize(span.start - start)
      let past = i32.toUsize(span.end - start)
      if past > work.get(at) {
        work.set(at, past)
      }
    }
    index = index + 1
  }
  let mut past: usize = 0
  index = 0
  while index < count {
    if work.get(index) > past {
      past = work.get(index)
    }
    if index >= past {
      run result.append(i32.toUsize(start) + index)
    }
    index = index + 1
  }
}

pub effect fn prepareTemplate<'source>(
  nodes: &BoxTree<'source>,
  id: usize,
  fresh: bool,
  input: &Input,
  contexts: &GridContextStore,
  logical: &ResolvedBox,
  limits: &ResolvedBox,
  axis: &Axes,
  columnOverride: usize,
  rowOverride: usize,
  scratch: &mut GridScratch,
)
  ! OutOfMemoryError
  ? &mut Allocator {
  let style = nodes.style(id)
  let template = &nodes.grids[style.grid]
  let mut columnRepeat: usize = 0
  let mut rowRepeat: usize = 0
  if columnOverride == usize.MAX
    && (template.columns.repeats.length() != 0 || template.rows.repeats.length() != 0) {
    let preferred = preferredSizes(style, input, logical, limits, axis)
    let mut columns = RepeatSizing {
      size: max(0.0, preferred.width - logical.inset.horizontal()),
      minimum: max(0.0, limits.min.width - logical.inset.horizontal()),
      maximum: max(0.0, limits.max.width - logical.inset.horizontal()),
      definite: preferred.widthDefinite,
      gap: style.columnGap,
    }
    let mut rows = RepeatSizing {
      size: max(0.0, preferred.height - logical.inset.vertical()),
      minimum: max(0.0, limits.min.height - logical.inset.vertical()),
      maximum: max(0.0, limits.max.height - logical.inset.vertical()),
      definite: preferred.heightDefinite,
      gap: style.rowGap,
    }
    columns.maximum = max(columns.minimum, columns.maximum)
    rows.maximum = max(rows.minimum, rows.maximum)
    columnRepeat = repeatCount(&template.columns, &columns)
    rowRepeat = repeatCount(&template.rows, &rows)
  }
  if columnOverride != usize.MAX {
    columnRepeat = columnOverride
    rowRepeat = rowOverride
  }
  if scratch.template.length() == 0 {
    run scratch.template.append(GridTemplateScratch.make())
  }
  let prepared = &mut scratch.template.asMutSlice()[0]
  if !fresh && columnRepeat == prepared.columnRepeat && rowRepeat == prepared.rowRepeat
    && prepared.gridContext == input.gridContext {
    return
  }
  run expandAxis(&template.columns, columnRepeat, template.areaColumns, &mut prepared.columns)
  run expandAxis(&template.rows, rowRepeat, template.areaRows, &mut prepared.rows)
  prepared.areas.clear()
  prepared.baselineOffsets.clear()
  let mut boundedRows = false
  let mut boundedColumns = false
  match move contexts.get(id, input.gridContext) {
    Option<&GridContext>.Some { value } => {
      boundedRows = value.rows.active
      boundedColumns = value.columns.active
      if boundedRows { run Subgrid.prepareAxis(&template.rows, &value.rows, &mut prepared.rows) }
      if boundedColumns { run Subgrid.prepareAxis(&template.columns, &value.columns, &mut prepared.columns) }
      let mut at: usize = 0
      while at < value.areas.length() {
        run prepared.areas.append(value.areas.get(at))
        at = at + 1
      }
      at = 0
      while at < value.baselineOffsets.length() {
        run prepared.baselineOffsets.append(value.baselineOffsets.get(at))
        at = at + 1
      }
    }
    Option<&GridContext>.None => {}
  }
  let mut at: usize = 0
  while at < template.areas.length() {
    run prepared.areas.append(template.areas.get(at))
    at = at + 1
  }
  let mut columnAreas = template.areas.asSlice()
  let mut rowAreas = template.areas.asSlice()
  if boundedColumns { columnAreas = prepared.areas.asSlice() }
  if boundedRows { rowAreas = prepared.areas.asSlice() }
  run prepareLineNames(
    expandedLines(&template.columns, &prepared.columns),
    columnAreas,
    nodes.gridNames,
    true,
    &mut prepared.columnNames,
  )
  run prepareLineNames(
    expandedLines(&template.rows, &prepared.rows),
    rowAreas,
    nodes.gridNames,
    false,
    &mut prepared.rowNames,
  )
  if boundedRows || boundedColumns {
    scratch.bounds = run collectItems(
      nodes, id, prepared.rows.explicitTracks, prepared.columns.explicitTracks,
      boundedRows, boundedColumns, &prepared.rowNames, &prepared.columnNames,
      &mut scratch.items, &mut scratch.placement, true,
    )
  } else {
    scratch.bounds = run collectItems(
      nodes, id, prepared.rows.explicitTracks, prepared.columns.explicitTracks,
      false, false, &prepared.rowNames, &prepared.columnNames,
      &mut scratch.items, &mut scratch.placement, false,
    )
  }
  prepared.gridContext = input.gridContext
  run collectCollapsed(
    scratch.items.asSlice(),
    true,
    scratch.bounds.columnOrigin,
    prepared.columns.autoFitStart,
    prepared.columns.autoFitEnd,
    &mut scratch.trackWork,
    &mut prepared.collapsedColumns,
  )
  run collectCollapsed(
    scratch.items.asSlice(),
    false,
    scratch.bounds.rowOrigin,
    prepared.rows.autoFitStart,
    prepared.rows.autoFitEnd,
    &mut scratch.trackWork,
    &mut prepared.collapsedRows,
  )
  prepared.columnRepeat = columnRepeat
  prepared.rowRepeat = rowRepeat
}
