// Grid §6.1 blockifies grid items and suppresses their float behavior.
test effect fn gridItemsEstablishIndependentBlockifiedBoxes()
  ! OutOfMemoryError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Grid }
  let mut tree = run Tree.make(move style) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let mut itemStyle = Style.make()
  itemStyle.display = Display.Box { outside: DisplayOutside.Inline, inside: DisplayInside.Flow }
  itemStyle.float = Float.Left
  let item = run tree.append(root, move itemStyle) |> Effect.provideMut<Allocator>(&mut allocator)
  let boxes = run Boxes.build(
    tree.nodes.asSlice(),
    tree.styles.asSlice(),
    tree.grids.asSlice(),
    tree.gridNames.asSlice(),
    WritingMode.HorizontalTb,
    Direction.Ltr,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let parent = boxes.firstBySource.get(root.index)
  let child = boxes.firstBySource.get(item.index)
  run Testing.expect(
    boxes.node(parent).kind == BoxKind.Grid && boxes.node(parent).independentRoot,
    "grid establishes an independent formatting context",
  )
  run Testing.expect(
    boxes.node(child).kind == BoxKind.Block && boxes.node(child).blockify
      && boxes.node(child).independentRoot,
    "inline floating grid item is blockified and independent",
  )
  run Testing.expect(boxes.node(child).parent == parent, "grid item belongs directly to the grid")
}

// Grid §6.1: whitespace-only runs vanish; contiguous text forms an anonymous item.
test effect fn gridTextRunsBecomeAnonymousItems()
  ! OutOfMemoryError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Grid }
  let mut tree = run Tree.make(move style) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let blank = run String.copy(" \n ") |> Effect.provideMut<Allocator>(&mut allocator)
  let whitespace = run tree.appendText(root, move blank)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let item = run tree.append(root, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let firstText = run String.copy("one") |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run tree.appendText(root, move firstText)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let secondText = run String.copy("two") |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run tree.appendText(root, move secondText)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let boxes = run Boxes.build(
    tree.nodes.asSlice(),
    tree.styles.asSlice(),
    tree.grids.asSlice(),
    tree.gridNames.asSlice(),
    WritingMode.HorizontalTb,
    Direction.Ltr,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    boxes.firstBySource.get(whitespace.index) == NO_NODE,
    "whitespace-only text does not generate a grid item",
  )
  let parent = boxes.firstBySource.get(root.index)
  let child = boxes.firstBySource.get(item.index)
  let anonymous = boxes.node(child).nextSibling
  run Testing.expect(
    anonymous != NO_NODE && boxes.node(anonymous).anonymousBlock
      && boxes.node(anonymous).parent == parent,
    "text run has one anonymous grid item",
  )
  let firstRun = boxes.node(boxes.firstBySource.get(first.index)).parent
  let secondRun = boxes.node(boxes.firstBySource.get(second.index)).parent
  run Testing.expect(
    firstRun == secondRun && boxes.node(firstRun).parent == anonymous,
    "contiguous text shares the anonymous item inline formatting context",
  )
}

// Grid §8.3.1 swaps reversed lines and discards an end equal to the start.
test effect fn gridNumericLinesRepairReversedAndEqualEndpoints()
  ! AssertionError<'static> {
  let start = GridLine { kind: GridLineKind.Line, number: 4, name: 0 }
  let end = GridLine { kind: GridLineKind.Line, number: 2, name: 0 }
  let reversed = numericSpan(&start, &end, 4)
  run Testing.expect(
    reversed.definite && reversed.start == 1 && reversed.end == 3,
    "reversed numeric endpoints swap",
  )
  let equal = numericSpan(&start, &start, 4)
  run Testing.expect(
    equal.definite && equal.start == 3 && equal.end == 4,
    "equal endpoints give the default one-track span",
  )
}

// Grid §8.3: negative lines count from the explicit end; §8.3.1 drops a second span.
test effect fn gridNumericSpansUseExplicitEndAndDiscardDoubleSpan()
  ! AssertionError<'static> {
  let span = GridLine { kind: GridLineKind.Span, number: 2, name: 0 }
  let end = GridLine { kind: GridLineKind.Line, number: -1, name: 0 }
  let anchored = numericSpan(&span, &end, 5)
  run Testing.expect(
    anchored.definite && anchored.start == 3 && anchored.end == 5,
    "end-anchored span uses the explicit grid end",
  )
  let second = GridLine { kind: GridLineKind.Span, number: 7, name: 0 }
  let automatic = numericSpan(&span, &second, 5)
  run Testing.expect(
    !automatic.definite && automatic.end - automatic.start == 2,
    "two spans keep the start span without fixing a position",
  )
}

// Grid §12.7.1 repeats the flex-fraction search after each newly inflexible track.
test effect fn gridFlexFractionRestartsUntilEveryBaseFits()
  ! AssertionError<'static> {
  let mut tracks: [TrackState; 3] = [
    TrackState.flexible(80.0, 1.0),
    TrackState.flexible(20.0, 1.0),
    TrackState.flexible(0.0, 1.0),
  ]
  resolveFlexible(&mut tracks, 110.0, 0.0)
  run Testing.expect(
    tracks[0].base == 80.0 && tracks[1].base == 20.0 && tracks[2].base == 10.0,
    "successive frozen bases leave ten units for the last track",
  )
}

// Grid §12.7.1 never shrinks bases, including zero-fr tracks and negative free space.
test effect fn gridFlexFractionPreservesBasesWhenOverconstrained()
  ! AssertionError<'static> {
  let mut tracks: [TrackState; 3] = [
    TrackState.flexible(12.0, 0.0),
    TrackState.flexible(15.0, 1.0),
    TrackState.fixed(8.0),
  ]
  resolveFlexible(&mut tracks, 20.0, 2.0)
  run Testing.expect(
    tracks[0].base == 12.0 && tracks[1].base == 15.0 && tracks[2].base == 8.0,
    "fixed and flexible minima overflow rather than becoming negative",
  )
}

struct FixedMinimumFlexMeasure {}

impl Measure for FixedMinimumFlexMeasure {
  fn font(provider: &mut Self, request: FontRequest) -> FontMetrics {
    drop provider
    drop request
    return FontMetrics.zero()
  }

  fn scrollbars(provider: &mut Self, request: ScrollbarRequest) -> ScrollbarMetrics {
    drop provider
    drop request
    return ScrollbarMetrics.zero()
  }

  fn natural(provider: &mut Self, key: usize) -> NaturalDimensions {
    drop provider
    drop key
    return NaturalDimensions.none()
  }

  fn measure(provider: &mut Self, key: usize, request: MeasureRequest) -> Measured {
    drop provider
    drop key
    let mut width: f32 = 40.0
    let mut height: f32 = 120.0
    if request.known.widthDefinite {
      width = request.known.width
    }
    if request.known.heightDefinite {
      height = request.known.height
    }
    return Measured {
      size: Size { width: width, height: height },
      scrollableOverflow: Rect { x: 0.0, y: 0.0, width: width, height: height },
      contentBlockSize: height,
      firstBaselines: BaselineSet.uniform(0.0),
      lastBaselines: BaselineSet.uniform(0.0),
      hasBaseline: false,
      hasLineBoxes: false,
    }
  }
}

impl TextMeasure for FixedMinimumFlexMeasure {
  fn beginTextLayout(provider: &mut Self) {
    drop provider
  }

  effect fn analyze(
    provider: &mut Self,
    context: TextContext,
    output: &mut List<TextBreak>,
  ) -> TextAnalysis
    ! OutOfMemoryError | TextError
    ? &mut Allocator {
    drop provider
    drop context
    drop output
    fail TextError { source: 0, message: "fixed-minimum flex fixture contains no text" }
  }

  effect fn shape(provider: &mut Self, request: TextShapeRequest, output: &mut List<TextRun>)
    ! OutOfMemoryError | TextError
    ? &mut Allocator {
    drop provider
    drop request
    drop output
    fail TextError { source: 0, message: "fixed-minimum flex fixture contains no text" }
  }
}

// https://drafts.csswg.org/css-grid-2/#algo-flex-tracks
// https://drafts.csswg.org/css-grid-2/#gutters
// https://drafts.csswg.org/css-sizing-3/#min-size-properties
// Definite 100px: the 10% gap is 10px; fixed 20px leaves 70px for 1fr,
// even though the measured item has a 120px minimum. Indefinite height:
// max-content makes 1fr 120px, giving a 140px intrinsic height with zero
// cyclic gap. Resolving its 14px gap then leaves 106px for 1fr, not 120px;
// the container stays 140px and the item's 120px minimum still overflows.
effect fn checkFixedMinimumFlexPercentageGap()
  ! OutOfMemoryError
    | InvalidNode
    | GridError
    | TextError
    | FragmentationError
    | AssertionError<'static>
  ? &mut Allocator {
  let heights: [f32; 2] = [100.0, 140.0]
  let markerOffsets: [f32; 2] = [80.0, 120.0]
  let mut index: usize = 0
  while index < heights.length {
    let mut style = Style.make()
    style.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Grid }
    style.width = Dimension.px(40.0)
    style.rowGap = Dimension.pct(0.1)
    if index == 0 {
      style.height = Dimension.px(100.0)
    }
    let mut tree = run Tree.make(move style)
    let root = tree.root()
    let mut template = GridTemplate.make()
    run template.columns.tracks.append(GridTrack.breadth(GridBreadth.fixed(40.0)))
    run template.rows.tracks.append(
      GridTrack.minmax(GridBreadth.fixed(10.0), GridBreadth.flex(1.0)),
    )
    run template.rows.tracks.append(GridTrack.breadth(GridBreadth.fixed(20.0)))
    run tree.setGrid(root, move template)
    let mut itemStyle = Style.make()
    itemStyle.minHeight = Dimension.px(120.0)
    itemStyle.alignSelf = Align.Start
    let item = run tree.append(root, move itemStyle)
    run tree.setMeasurement(item, 0)
    let marker = run tree.append(root, Style.make())
    let mut output = LayoutTree.make()
    let mut provider = FixedMinimumFlexMeasure {}
    run compute(&tree, &mut output, &mut provider, OptionalSize.definite(300.0, 200.0))
    let rootBounds = run output.sourceBounds(root)
    let itemBounds = run output.sourceBounds(item)
    let markerBounds = run output.sourceBounds(marker)
    run Testing.expect(
      rootBounds.width == 40.0 && rootBounds.height == heights[index] && itemBounds.x == 0.0
        && itemBounds.y == 0.0
        && itemBounds.width == 40.0
        && itemBounds.height == 120.0
        && markerBounds.x == 0.0
        && markerBounds.y == markerOffsets[index]
        && markerBounds.width == 40.0
        && markerBounds.height == 20.0,
      "fixed-minimum fr uses definite space only after intrinsic height and cyclic gap resolution",
    )
    index = index + 1
  }
}

test effect fn gridFixedMinimumFlexPreservesOverflowAcrossPercentageGapResolution()
  ! OutOfMemoryError
    | InvalidNode
    | GridError
    | TextError
    | FragmentationError
    | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run checkFixedMinimumFlexPercentageGap() |> Effect.provideMut<Allocator>(&mut allocator)
}
