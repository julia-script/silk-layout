import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.string { String }
import silk.testing { Testing, AssertionError }
import style { Style, Display, DisplayOutside, DisplayInside, Direction, WritingMode, Float }
import tree { Tree, InvalidNode, NO_NODE }
import box_tree as Boxes
import box_tree { BoxKind }

// Grid §6.1 blockifies grid items and suppresses their float behavior.
test effect fn gridItemsEstablishIndependentBlockifiedBoxes()
  ! OutOfMemoryError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Grid }
  let mut tree = run Tree.make(move style) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let mut itemStyle = Style.make()
  itemStyle.display = Display.Box { outside: DisplayOutside.Inline, inside: DisplayInside.Flow }
  itemStyle.float = Float.Left
  let item = run tree.append(root, move itemStyle) |> Effect.provideMut<Allocator>(&mut allocator)
  let boxes = run Boxes.build(
    tree.nodes.asSlice(),
    tree.styles.asSlice(),
    tree.grids.asSlice(),
    tree.gridNames.asSlice(),
    WritingMode.HorizontalTb,
    Direction.Ltr,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let parent = boxes.firstBySource.get(root.index)
  let child = boxes.firstBySource.get(item.index)
  run Testing.expect(
    boxes.node(parent).kind == BoxKind.Grid && boxes.node(parent).independentRoot,
    "grid establishes an independent formatting context",
  )
  run Testing.expect(
    boxes.node(child).kind == BoxKind.Block && boxes.node(child).blockify
      && boxes.node(child).independentRoot,
    "inline floating grid item is blockified and independent",
  )
  run Testing.expect(boxes.node(child).parent == parent, "grid item belongs directly to the grid")
}

// Grid §6.1: whitespace-only runs vanish; contiguous text forms an anonymous item.
test effect fn gridTextRunsBecomeAnonymousItems()
  ! OutOfMemoryError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Grid }
  let mut tree = run Tree.make(move style) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let blank = run String.copy(" \n ") |> Effect.provideMut<Allocator>(&mut allocator)
  let whitespace = run tree.appendText(root, move blank)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let item = run tree.append(root, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let firstText = run String.copy("one") |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run tree.appendText(root, move firstText)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let secondText = run String.copy("two") |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run tree.appendText(root, move secondText)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let boxes = run Boxes.build(
    tree.nodes.asSlice(),
    tree.styles.asSlice(),
    tree.grids.asSlice(),
    tree.gridNames.asSlice(),
    WritingMode.HorizontalTb,
    Direction.Ltr,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    boxes.firstBySource.get(whitespace.index) == NO_NODE,
    "whitespace-only text does not generate a grid item",
  )
  let parent = boxes.firstBySource.get(root.index)
  let child = boxes.firstBySource.get(item.index)
  let anonymous = boxes.node(child).nextSibling
  run Testing.expect(
    anonymous != NO_NODE && boxes.node(anonymous).anonymousBlock
      && boxes.node(anonymous).parent == parent,
    "text run has one anonymous grid item",
  )
  let firstRun = boxes.node(boxes.firstBySource.get(first.index)).parent
  let secondRun = boxes.node(boxes.firstBySource.get(second.index)).parent
  run Testing.expect(
    firstRun == secondRun && boxes.node(firstRun).parent == anonymous,
    "contiguous text shares the anonymous item inline formatting context",
  )
}
