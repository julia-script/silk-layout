import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.string { String }
import silk.testing { Testing, AssertionError }
import style { Style, Display, DisplayOutside, DisplayInside, Direction, WritingMode, Float }
import tree { Tree, InvalidNode, NO_NODE }
import box_tree as Boxes
import box_tree { BoxKind }
import grid_style { GridLine, GridLineKind }
import grid_placement { numericSpan }
import grid_tracks { TrackState, resolveFlexible }

// Grid §6.1 blockifies grid items and suppresses their float behavior.
test effect fn gridItemsEstablishIndependentBlockifiedBoxes()
  ! OutOfMemoryError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Grid }
  let mut tree = run Tree.make(move style) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let mut itemStyle = Style.make()
  itemStyle.display = Display.Box { outside: DisplayOutside.Inline, inside: DisplayInside.Flow }
  itemStyle.float = Float.Left
  let item = run tree.append(root, move itemStyle) |> Effect.provideMut<Allocator>(&mut allocator)
  let boxes = run Boxes.build(
    tree.nodes.asSlice(),
    tree.styles.asSlice(),
    tree.grids.asSlice(),
    tree.gridNames.asSlice(),
    WritingMode.HorizontalTb,
    Direction.Ltr,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let parent = boxes.firstBySource.get(root.index)
  let child = boxes.firstBySource.get(item.index)
  run Testing.expect(
    boxes.node(parent).kind == BoxKind.Grid && boxes.node(parent).independentRoot,
    "grid establishes an independent formatting context",
  )
  run Testing.expect(
    boxes.node(child).kind == BoxKind.Block && boxes.node(child).blockify
      && boxes.node(child).independentRoot,
    "inline floating grid item is blockified and independent",
  )
  run Testing.expect(boxes.node(child).parent == parent, "grid item belongs directly to the grid")
}

// Grid §6.1: whitespace-only runs vanish; contiguous text forms an anonymous item.
test effect fn gridTextRunsBecomeAnonymousItems()
  ! OutOfMemoryError | InvalidNode | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut style = Style.make()
  style.display = Display.Box { outside: DisplayOutside.Block, inside: DisplayInside.Grid }
  let mut tree = run Tree.make(move style) |> Effect.provideMut<Allocator>(&mut allocator)
  let root = tree.root()
  let blank = run String.copy(" \n ") |> Effect.provideMut<Allocator>(&mut allocator)
  let whitespace = run tree.appendText(root, move blank)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let item = run tree.append(root, Style.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  let firstText = run String.copy("one") |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run tree.appendText(root, move firstText)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let secondText = run String.copy("two") |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run tree.appendText(root, move secondText)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let boxes = run Boxes.build(
    tree.nodes.asSlice(),
    tree.styles.asSlice(),
    tree.grids.asSlice(),
    tree.gridNames.asSlice(),
    WritingMode.HorizontalTb,
    Direction.Ltr,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    boxes.firstBySource.get(whitespace.index) == NO_NODE,
    "whitespace-only text does not generate a grid item",
  )
  let parent = boxes.firstBySource.get(root.index)
  let child = boxes.firstBySource.get(item.index)
  let anonymous = boxes.node(child).nextSibling
  run Testing.expect(
    anonymous != NO_NODE && boxes.node(anonymous).anonymousBlock
      && boxes.node(anonymous).parent == parent,
    "text run has one anonymous grid item",
  )
  let firstRun = boxes.node(boxes.firstBySource.get(first.index)).parent
  let secondRun = boxes.node(boxes.firstBySource.get(second.index)).parent
  run Testing.expect(
    firstRun == secondRun && boxes.node(firstRun).parent == anonymous,
    "contiguous text shares the anonymous item inline formatting context",
  )
}

// Grid §8.3.1 swaps reversed lines and discards an end equal to the start.
test effect fn gridNumericLinesRepairReversedAndEqualEndpoints()
  ! AssertionError<'static> {
  let start = GridLine { kind: GridLineKind.Line, number: 4, name: 0 }
  let end = GridLine { kind: GridLineKind.Line, number: 2, name: 0 }
  let reversed = numericSpan(&start, &end, 4)
  run Testing.expect(
    reversed.definite && reversed.start == 1 && reversed.end == 3,
    "reversed numeric endpoints swap",
  )
  let equal = numericSpan(&start, &start, 4)
  run Testing.expect(
    equal.definite && equal.start == 3 && equal.end == 4,
    "equal endpoints give the default one-track span",
  )
}

// Grid §8.3: negative lines count from the explicit end; §8.3.1 drops a second span.
test effect fn gridNumericSpansUseExplicitEndAndDiscardDoubleSpan()
  ! AssertionError<'static> {
  let span = GridLine { kind: GridLineKind.Span, number: 2, name: 0 }
  let end = GridLine { kind: GridLineKind.Line, number: -1, name: 0 }
  let anchored = numericSpan(&span, &end, 5)
  run Testing.expect(
    anchored.definite && anchored.start == 3 && anchored.end == 5,
    "end-anchored span uses the explicit grid end",
  )
  let second = GridLine { kind: GridLineKind.Span, number: 7, name: 0 }
  let automatic = numericSpan(&span, &second, 5)
  run Testing.expect(
    !automatic.definite && automatic.end - automatic.start == 2,
    "two spans keep the start span without fixing a position",
  )
}

// Grid §12.7.1 repeats the flex-fraction search after each newly inflexible track.
test effect fn gridFlexFractionRestartsUntilEveryBaseFits()
  ! AssertionError<'static> {
  let mut tracks: [TrackState; 3] = [
    TrackState.flexible(80.0, 1.0),
    TrackState.flexible(20.0, 1.0),
    TrackState.flexible(0.0, 1.0),
  ]
  resolveFlexible(&mut tracks, 110.0, 0.0)
  run Testing.expect(
    tracks[0].base == 80.0 && tracks[1].base == 20.0 && tracks[2].base == 10.0,
    "successive frozen bases leave ten units for the last track",
  )
}

// Grid §12.7.1 never shrinks bases, including zero-fr tracks and negative free space.
test effect fn gridFlexFractionPreservesBasesWhenOverconstrained()
  ! AssertionError<'static> {
  let mut tracks: [TrackState; 3] = [
    TrackState.flexible(12.0, 0.0),
    TrackState.flexible(15.0, 1.0),
    TrackState.fixed(8.0),
  ]
  resolveFlexible(&mut tracks, 20.0, 2.0)
  run Testing.expect(
    tracks[0].base == 12.0 && tracks[1].base == 15.0 && tracks[2].base == 8.0,
    "fixed and flexible minima overflow rather than becoming negative",
  )
}
