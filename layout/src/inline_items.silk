import silk.core.ownership { Copy }
import geometry { FontMetrics, ResolvedEdges }
import text { TextCursor }
import style { TabSize }
import silk.num.f32

pub struct FontBox {
  pub metrics: FontMetrics,
  pub baseline: f32, pub height: f32, pub lineHeight: f32,
  pub before: f32, pub after: f32,
}
impl Copy for FontBox {}

pub struct Scope {
  pub id: usize, pub parent: usize, pub group: usize,
  pub font: FontBox, pub offset: f32,
  pub inset: ResolvedEdges, pub border: ResolvedEdges, pub margin: ResolvedEdges,
  pub phantomClone: bool,
}
impl Copy for Scope {}

pub enum ItemKind { Open, Close, Atomic, Float, Anchor, Text }
pub struct Item {
  pub kind: ItemKind, pub level: u8, pub id: usize, pub scope: usize, pub group: usize, pub leaf: usize,
  pub advance: f32, pub before: f32, pub after: f32, pub offset: f32,
  pub lineLeftSpacing: f32,
  pub start: TextCursor,
}
impl Copy for Item {}

pub fn tabAdvance(size: TabSize, spaceAdvance: f32, zeroAdvance: f32, position: f32) -> f32 {
  let mut spacing: f32 = 0.0
  match size {
    TabSize.Number { value } => { spacing = value * spaceAdvance }
    TabSize.Length { value } => { spacing = value }
  }
  if spacing == 0.0 { return 0.0 }
  let mut advance = f32.ceil(position / spacing) * spacing - position
  if advance <= 0.0 { advance = advance + spacing }
  // CSS Text uses the subsequent stop when the next is less than half a ch
  // away, not an arbitrary integer number of spaces from the current glyph.
  if advance < zeroAdvance * 0.5 { advance = advance + spacing }
  return advance
}
