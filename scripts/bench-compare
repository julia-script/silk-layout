#!/bin/sh
# Build the release CLI and the taffy and yoga harnesses, then compare layout time and geometry
# on the shared workloads in bench/compare/workloads.py. Extra arguments go to compare.py
# (for example --iterations 31 or --only deep-random-10k).
# Needs cargo, cmake and a C++20 compiler besides the Silk toolchain. Not part of PR CI.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
yoga_rev=6c79cca0eca9a688e3f8e16bb562016933f4e703
yoga="$root/.cache/yoga"
if [ ! -d "$yoga/.git" ] || [ "$(git -C "$yoga" rev-parse HEAD)" != "$yoga_rev" ]; then
  rm -rf "$yoga"
  git init -q "$yoga"
  git -C "$yoga" fetch -q --depth 1 https://github.com/facebook/yoga.git "$yoga_rev"
  git -C "$yoga" checkout -q FETCH_HEAD
fi
silk build --package silk_layout_cli --release
cargo build --quiet --release --manifest-path bench/compare/taffy/Cargo.toml
cmake -S bench/compare/yoga -B bench/compare/yoga/build -DYOGA_ROOT="$yoga" -DCMAKE_BUILD_TYPE=Release >/dev/null
cmake --build bench/compare/yoga/build --parallel >/dev/null
case "$(uname -s)-$(uname -m)" in
  Darwin-arm64) target=aarch64-apple-darwin ;;
  Linux-x86_64) target=x86_64-unknown-linux-gnu ;;
  Linux-aarch64) target=aarch64-unknown-linux-gnu ;;
  *) echo "Unsupported native host for this script" >&2; exit 1 ;;
esac
exec python3 bench/compare/compare.py \
  --silk "build/llvm/$target/release/silk_layout_cli" \
  --taffy bench/compare/taffy/target/release/taffy-harness \
  --yoga bench/compare/yoga/build/yoga-harness "$@"
