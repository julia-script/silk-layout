#!/bin/sh
set -eu
cd "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
silk check --workspace
(cd layout && silk test --root src/tests.silk)
silk build --package silk_layout_cli
case "$(uname -s)-$(uname -m)" in
  Darwin-arm64) target=aarch64-apple-darwin ;;
  Linux-x86_64) target=x86_64-unknown-linux-gnu ;;
  Linux-aarch64) target=aarch64-unknown-linux-gnu ;;
  *) echo "Unsupported native host for this script" >&2; exit 1 ;;
esac
cli="build/llvm/$target/debug/silk_layout_cli"
python3 scripts/smoke.py --cli "$cli"
python3 scripts/bench-updates.py --cli "$cli" --iterations 2 --small
python3 scripts/fixture-updates.py --cli "$cli"
python3 scripts/fuzz-updates.py --cli "$cli" --seeds 15
node scripts/chrome-diff.mjs --cli "$cli" --mode spec
