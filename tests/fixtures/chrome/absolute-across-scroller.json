{
  "name": "absolute-across-scroller-chrome",
  "kind": "chrome",
  "features": [
    "scroll-state",
    "position"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 300,
          "height": 200,
          "position": "relative"
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 100,
          "height": 100,
          "overflowX": "hidden",
          "overflowY": "hidden"
        },
        "scrollOffset": {
          "x": 20,
          "y": 30
        }
      },
      {
        "parent": 1,
        "style": {
          "width": 200,
          "height": 300
        }
      },
      {
        "parent": 1,
        "style": {
          "width": 10,
          "height": 10,
          "position": "absolute",
          "insetLeft": 50,
          "insetTop": 60
        }
      },
      {
        "parent": 1,
        "style": {
          "width": 10,
          "height": 10,
          "position": "absolute"
        }
      }
    ]
  }
}
