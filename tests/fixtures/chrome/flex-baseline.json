{
  "name": "flex-baseline",
  "kind": "chrome",
  "features": [
    "flex",
    "baseline",
    "intrinsic-measure"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "flex",
          "width": 200,
          "alignItems": "baseline"
        }
      },
      {
        "parent": 0,
        "style": {},
        "measure": {
          "minWidth": 30,
          "maxWidth": 30,
          "height": 20,
          "firstBaseline": 15,
          "lastBaseline": 15
        }
      },
      {
        "parent": 0,
        "style": {},
        "measure": {
          "minWidth": 40,
          "maxWidth": 40,
          "height": 30,
          "firstBaseline": 20,
          "lastBaseline": 20
        }
      }
    ]
  }
}
