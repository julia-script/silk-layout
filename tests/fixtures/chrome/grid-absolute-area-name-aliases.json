{
  "name": "grid-absolute-area-name-aliases-chrome",
  "kind": "chrome",
  "features": [
    "grid",
    "position"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#abspos-items",
    "https://drafts.csswg.org/css-grid-2/#static-position",
    "https://drafts.csswg.org/css-position-3/#static-position-rect"
  ],
  "derivation": "The bare area name resolves independently to body-start and body-end, not an equal-line conflict. The bottom-right area is the second 60px column and 50px row.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "position": "relative",
          "boxSizing": "border-box",
          "width": 160,
          "height": 180,
          "paddingLeft": 10,
          "paddingRight": 20,
          "paddingTop": 30,
          "paddingBottom": 10,
          "gridTemplateColumns": [
            40,
            60
          ],
          "gridTemplateRows": [
            30,
            50
          ],
          "columnGap": 10,
          "rowGap": 20,
          "gridTemplateAreas": [
            [
              "header",
              "header"
            ],
            [
              "left",
              "body"
            ]
          ]
        }
      },
      {
        "parent": 0,
        "style": {
          "position": "absolute",
          "inset": {
            "left": 0,
            "right": 0,
            "top": 0,
            "bottom": 0
          },
          "gridColumnStart": "body",
          "gridColumnEnd": "body",
          "gridRowStart": "body",
          "gridRowEnd": "body"
        }
      }
    ]
  }
}
