{
  "name": "grid-absolute-auto-fit-distributed-live-track-chrome",
  "kind": "chrome",
  "features": [
    "grid",
    "position"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#abspos-items",
    "https://drafts.csswg.org/css-grid-2/#static-position",
    "https://drafts.csswg.org/css-position-3/#static-position-rect"
  ],
  "derivation": "Three explicit auto-fit repetitions fit; the empty middle track collapses. Space-between puts the two live20px tracks at0 and80. Negative lines -2/-1 select the last explicit track after distribution.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "position": "relative",
          "width": 100,
          "height": 20,
          "gridTemplateColumns": [
            {
              "repeat": {
                "count": "auto-fit",
                "tracks": [
                  20
                ]
              }
            }
          ],
          "gridTemplateRows": [
            20
          ],
          "columnGap": 10,
          "justifyContent": "space-between"
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 1
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 3
        }
      },
      {
        "parent": 0,
        "style": {
          "position": "absolute",
          "inset": {
            "left": 0,
            "right": 0,
            "top": 0,
            "bottom": 0
          },
          "gridColumnStart": -2,
          "gridColumnEnd": -1
        }
      }
    ]
  }
}
