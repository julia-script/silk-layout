{
  "name": "grid-baseline-export-sharing-first-last",
  "kind": "chrome",
  "features": [
    "grid",
    "baseline",
    "intrinsic-measure"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#grid-baselines"
  ],
  "derivation": "The first row shares first baselines 8 and 14, placing items at 6 and 0 and exporting 14. The second row shares last baselines 5 and 12: descents 5 and 8 put the common baseline at 60-8=52. Both exports are generated from the grid font.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 80,
          "gridTemplateColumns": [
            40,
            40
          ],
          "gridTemplateRows": [
            30,
            30
          ]
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 20,
          "height": 10,
          "gridRowStart": 1,
          "gridColumnStart": 1,
          "alignSelf": "baseline"
        },
        "measure": {
          "minWidth": 20,
          "maxWidth": 20,
          "height": 10,
          "firstBaseline": 8,
          "lastBaseline": 8
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 20,
          "height": 20,
          "gridRowStart": 1,
          "gridColumnStart": 2,
          "alignSelf": "baseline"
        },
        "measure": {
          "minWidth": 20,
          "maxWidth": 20,
          "height": 20,
          "firstBaseline": 14,
          "lastBaseline": 14
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 20,
          "height": 10,
          "gridRowStart": 2,
          "gridColumnStart": 1,
          "alignSelf": "last baseline"
        },
        "measure": {
          "minWidth": 20,
          "maxWidth": 20,
          "height": 10,
          "firstBaseline": 5,
          "lastBaseline": 5
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 20,
          "height": 20,
          "gridRowStart": 2,
          "gridColumnStart": 2,
          "alignSelf": "last baseline"
        },
        "measure": {
          "minWidth": 20,
          "maxWidth": 20,
          "height": 20,
          "firstBaseline": 12,
          "lastBaseline": 12
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "firstBaseline": 14,
        "lastBaseline": 52
      },
      {
        "x": 0,
        "y": 6
      },
      {
        "x": 40,
        "y": 0
      },
      {
        "x": 0,
        "y": 47
      },
      {
        "x": 40,
        "y": 40
      }
    ]
  }
}
