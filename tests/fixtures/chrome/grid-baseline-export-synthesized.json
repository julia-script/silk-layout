{
  "name": "grid-baseline-export-synthesized",
  "kind": "chrome",
  "features": [
    "grid",
    "baseline",
    "intrinsic-measure"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#grid-baselines"
  ],
  "derivation": "With no child baseline tables and no sharing groups, step four synthesizes border-bottom baselines of the first and last grid-order items. Grid order picks column one first even though column two occurs first in source.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 80,
          "gridTemplateColumns": [
            40,
            40
          ],
          "gridTemplateRows": [
            30
          ],
          "alignItems": "start"
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 20,
          "height": 20,
          "gridColumnStart": 2,
          "gridRowStart": 1
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 20,
          "height": 10,
          "gridColumnStart": 1,
          "gridRowStart": 1
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "firstBaseline": 10,
        "lastBaseline": 20
      },
      {
        "x": 40,
        "y": 0
      },
      {
        "x": 0,
        "y": 0
      }
    ]
  }
}
