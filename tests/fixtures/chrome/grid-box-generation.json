{
  "name": "grid-box-generation",
  "kind": "chrome",
  "features": [
    "grid",
    "box-generation"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#grid-containers",
    "https://drafts.csswg.org/css-grid-2/#grid-item-display"
  ],
  "input": {
    "viewport": {
      "width": 200,
      "height": 150
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "block grid",
          "width": 80
        }
      },
      {
        "parent": 0,
        "style": {
          "display": "inline grid",
          "width": 30
        }
      },
      {
        "parent": 1,
        "style": {
          "width": 20,
          "height": 6
        }
      },
      {
        "parent": 1,
        "style": {
          "width": 25,
          "height": 8
        }
      },
      {
        "parent": 0,
        "style": {
          "display": "flow-root",
          "width": 40,
          "height": 5
        }
      }
    ]
  }
}
