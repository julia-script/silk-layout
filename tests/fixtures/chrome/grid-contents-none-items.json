{
  "name": "grid-contents-none-items",
  "kind": "chrome",
  "features": [
    "grid",
    "display-contents",
    "display-none",
    "box-generation"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#grid-items",
    "https://drafts.csswg.org/css-display-3/#box-generation"
  ],
  "input": {
    "viewport": {
      "width": 200,
      "height": 150
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 100
        }
      },
      {
        "parent": 0,
        "style": {
          "display": "contents",
          "padding": 30
        }
      },
      {
        "parent": 1,
        "style": {
          "width": 20,
          "height": 8
        }
      },
      {
        "parent": 0,
        "style": {
          "display": "none",
          "height": 90
        }
      },
      {
        "parent": 3,
        "style": {
          "width": 50,
          "height": 50
        }
      },
      {
        "parent": 1,
        "style": {
          "width": 30,
          "height": 12
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 40,
          "height": 5
        }
      }
    ]
  }
}
