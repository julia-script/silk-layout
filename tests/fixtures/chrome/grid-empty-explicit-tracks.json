{
  "name": "grid-empty-explicit-tracks-chrome",
  "kind": "chrome",
  "features": [
    "grid",
    "explicit-tracks"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#explicit-grids",
    "https://drafts.csswg.org/css-grid-2/#track-sizing",
    "https://drafts.csswg.org/css-grid-2/#gutters"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 105,
          "gridTemplateColumns": [
            40,
            60
          ],
          "gridTemplateRows": [
            20,
            30
          ],
          "columnGap": 5,
          "rowGap": 7
        }
      }
    ]
  }
}
