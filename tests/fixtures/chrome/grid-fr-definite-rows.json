{
  "name": "grid-fr-definite-rows-chrome",
  "kind": "chrome",
  "features": [
    "grid",
    "explicit-tracks"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#algo-find-fr-size",
    "https://drafts.csswg.org/css-grid-2/#gutters"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 110,
          "height": 100,
          "gridTemplateColumns": [
            50,
            50
          ],
          "gridTemplateRows": [
            {
              "fr": 1
            },
            {
              "fr": 3
            }
          ],
          "columnGap": 10,
          "rowGap": 20
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 1,
          "gridRowStart": 1
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 2,
          "gridRowStart": 2
        }
      }
    ]
  }
}
