{
  "name": "grid-fr-fixed-minimum-restart-chrome",
  "kind": "chrome",
  "features": [
    "grid",
    "explicit-tracks"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#algo-find-fr-size"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 300,
          "gridTemplateColumns": [
            {
              "minmax": [
                200,
                {
                  "fr": 1
                }
              ]
            },
            {
              "fr": 1
            }
          ],
          "gridTemplateRows": [
            20
          ],
          "columnGap": 10
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 1,
          "gridRowStart": 1,
          "minWidth": 0
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 2,
          "gridRowStart": 1,
          "minWidth": 0
        }
      }
    ]
  }
}
