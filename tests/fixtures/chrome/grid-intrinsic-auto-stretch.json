{
  "name": "grid-intrinsic-auto-stretch",
  "kind": "chrome",
  "features": [
    "grid",
    "intrinsic-tracks"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#algo-content",
    "https://drafts.csswg.org/css-grid-2/#algo-grow-tracks",
    "https://drafts.csswg.org/css-grid-2/#algo-stretch"
  ],
  "derivation": "Both auto tracks have 20px bases and 45px growth limits. Maximization reaches 45px; auto stretch distributes the remaining 100px equally.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "gridTemplateRows": [
            20
          ],
          "width": 200,
          "gridTemplateColumns": [
            "auto",
            "auto"
          ],
          "columnGap": 10,
          "fontKey": 1
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 1,
          "fontKey": 1,
          "gridRowStart": 1
        }
      },
      {
        "parent": 1,
        "text": "aaaa aaaa"
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 2,
          "fontKey": 1,
          "gridRowStart": 1
        }
      },
      {
        "parent": 3,
        "text": "aaaa aaaa"
      }
    ],
    "fonts": [
      {
        "fontSize": 10,
        "ascent": 8,
        "descent": 2,
        "lineGap": 0,
        "xHeight": 5,
        "capHeight": 7,
        "subscriptOffset": 2,
        "superscriptOffset": 3,
        "baselines": {
          "alphabetic": 8,
          "ideographic": 10,
          "central": 5,
          "mathematical": 5
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "width": 200,
        "height": 20
      },
      {
        "x": 0,
        "y": 0,
        "width": 95,
        "height": 20
      },
      {
        "height": 10
      },
      {
        "x": 105,
        "y": 0,
        "width": 95,
        "height": 20
      },
      {
        "height": 10
      }
    ]
  }
}
