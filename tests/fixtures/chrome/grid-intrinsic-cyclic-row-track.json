{
  "name": "grid-intrinsic-cyclic-row-track",
  "kind": "chrome",
  "features": [
    "grid",
    "intrinsic-tracks"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#track-sizing",
    "https://drafts.csswg.org/css-grid-2/#intrinsic-sizes"
  ],
  "derivation": "The percentage row behaves as auto during intrinsic sizing and contributes 30px, producing a 50px container. It then resolves to 25px; the fixed-height item overflows that row, and row 2 starts at 25px.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 100,
          "gridTemplateColumns": [
            100
          ],
          "gridTemplateRows": [
            {
              "percent": 0.5
            },
            20
          ]
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 1,
          "gridRowStart": 1,
          "height": 30
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 1,
          "gridRowStart": 2
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "width": 100,
        "height": 50
      },
      {
        "x": 0,
        "y": 0,
        "width": 100,
        "height": 30
      },
      {
        "x": 0,
        "y": 25,
        "width": 100,
        "height": 20
      }
    ]
  }
}
