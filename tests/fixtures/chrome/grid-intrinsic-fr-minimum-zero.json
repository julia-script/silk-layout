{
  "name": "grid-intrinsic-fr-minimum-zero",
  "kind": "chrome",
  "features": [
    "grid",
    "intrinsic-tracks"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#min-size-auto",
    "https://drafts.csswg.org/css-grid-2/#algo-spanning-flex-items",
    "https://drafts.csswg.org/css-grid-2/#algo-flex-tracks"
  ],
  "derivation": "The longest word is 20px. A single bare fr track has an auto minimum and retains 20px; a fixed zero track minimum or scrollable item overflow removes the content-based minimum.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "gridTemplateRows": [
            20
          ],
          "width": 10,
          "gridTemplateColumns": [
            {
              "minmax": [
                0,
                {
                  "fr": 1
                }
              ]
            }
          ],
          "fontKey": 1
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 1,
          "fontKey": 1,
          "gridRowStart": 1
        }
      },
      {
        "parent": 1,
        "text": "aaaa aaaa"
      }
    ],
    "fonts": [
      {
        "fontSize": 10,
        "ascent": 8,
        "descent": 2,
        "lineGap": 0,
        "xHeight": 5,
        "capHeight": 7,
        "subscriptOffset": 2,
        "superscriptOffset": 3,
        "baselines": {
          "alphabetic": 8,
          "ideographic": 10,
          "central": 5,
          "mathematical": 5
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "width": 10,
        "height": 20
      },
      {
        "x": 0,
        "y": 0,
        "width": 10,
        "height": 20
      },
      {
        "height": 20
      }
    ]
  }
}
