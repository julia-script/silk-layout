{
  "name": "grid-intrinsic-maximize-freeze",
  "kind": "chrome",
  "features": [
    "grid",
    "intrinsic-tracks"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#algo-grow-tracks"
  ],
  "derivation": "After the 10px gutter, 120px is available. Equal growth freezes the first track at 40px; the second receives the remaining 80px.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "gridTemplateRows": [
            20
          ],
          "width": 130,
          "columnGap": 10,
          "gridTemplateColumns": [
            {
              "minmax": [
                10,
                40
              ]
            },
            {
              "minmax": [
                20,
                100
              ]
            }
          ]
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 1,
          "gridRowStart": 1
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 2,
          "gridRowStart": 1
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "width": 130,
        "height": 20
      },
      {
        "x": 0,
        "y": 0,
        "width": 40,
        "height": 20
      },
      {
        "x": 50,
        "y": 0,
        "width": 80,
        "height": 20
      }
    ]
  }
}
