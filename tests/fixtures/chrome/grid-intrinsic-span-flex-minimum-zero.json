{
  "name": "grid-intrinsic-span-flex-minimum-zero",
  "kind": "chrome",
  "features": [
    "grid",
    "intrinsic-tracks"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#min-size-auto",
    "https://drafts.csswg.org/css-grid-2/#algo-spanning-flex-items",
    "https://drafts.csswg.org/css-grid-2/#algo-flex-tracks"
  ],
  "derivation": "The first auto track is 20px. The spanning item crosses a flexible track, so its automatic minimum is zero rather than its 40px longest word. The fr track gets 10px and the spanning area stays 30px.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 30,
          "gridTemplateColumns": [
            "auto",
            {
              "fr": 1
            }
          ],
          "gridTemplateRows": [
            20,
            20
          ]
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 1,
          "gridRowStart": 1,
          "width": 20
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 1,
          "gridColumnEnd": 3,
          "gridRowStart": 2,
          "fontKey": 1
        }
      },
      {
        "parent": 2,
        "text": "aaaaaaaa aaaaaaaa"
      }
    ],
    "fonts": [
      {
        "fontSize": 10,
        "ascent": 8,
        "descent": 2,
        "lineGap": 0,
        "xHeight": 5,
        "capHeight": 7,
        "subscriptOffset": 2,
        "superscriptOffset": 3,
        "baselines": {
          "alphabetic": 8,
          "ideographic": 10,
          "central": 5,
          "mathematical": 5
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "width": 30,
        "height": 40
      },
      {
        "x": 0,
        "y": 0,
        "width": 20,
        "height": 20
      },
      {
        "x": 0,
        "y": 20,
        "width": 30,
        "height": 20
      },
      {
        "height": 20
      }
    ]
  }
}
