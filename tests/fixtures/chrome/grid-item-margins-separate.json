{
  "name": "grid-item-margins-separate",
  "kind": "chrome",
  "features": [
    "grid",
    "margin-collapse"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#grid-items",
    "https://drafts.csswg.org/css-grid-2/#item-margins",
    "https://drafts.csswg.org/css-grid-2/#grid-containers"
  ],
  "input": {
    "viewport": {
      "width": 200,
      "height": 150
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 100
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 20,
          "height": 10,
          "marginTop": 7,
          "marginBottom": 11
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 30,
          "height": 20,
          "marginTop": 13,
          "marginBottom": 17
        }
      }
    ]
  }
}
