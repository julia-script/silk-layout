{
  "name": "grid-negative-lines-and-spans-chrome",
  "kind": "chrome",
  "features": [
    "grid",
    "explicit-tracks"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#line-placement",
    "https://drafts.csswg.org/css-grid-2/#grid-placement-errors",
    "https://drafts.csswg.org/css-grid-2/#gutters"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 240,
          "gridTemplateColumns": [
            40,
            50,
            60,
            70
          ],
          "gridTemplateRows": [
            20,
            30
          ],
          "columnGap": 5,
          "rowGap": 7
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": -3,
          "gridRowStart": 1,
          "gridColumnEnd": -1
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": {
            "span": 2
          },
          "gridRowStart": 2,
          "gridColumnEnd": 3
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 3,
          "gridRowStart": 1,
          "gridColumnEnd": 1
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 2,
          "gridRowStart": 2,
          "gridColumnEnd": 2
        }
      }
    ]
  }
}
