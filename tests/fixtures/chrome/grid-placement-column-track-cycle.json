{
  "name": "grid-placement-column-track-cycle",
  "kind": "chrome",
  "features": [
    "grid",
    "auto-placement",
    "implicit-tracks"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#auto-placement-algo",
    "https://drafts.csswg.org/css-grid-2/#auto-tracks"
  ],
  "derivation": "Column flow transposes placement: two rows per column, then implicit columns 15 and 25. Column gaps add 6 to the intrinsic width 80.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": "max-content",
          "height": 100,
          "gridAutoFlow": "column",
          "gridTemplateRows": [
            20,
            30
          ],
          "gridTemplateColumns": [
            40
          ],
          "gridAutoColumns": [
            15,
            25
          ],
          "columnGap": 3,
          "rowGap": 5
        }
      },
      {
        "parent": 0,
        "style": {}
      },
      {
        "parent": 0,
        "style": {}
      },
      {
        "parent": 0,
        "style": {}
      },
      {
        "parent": 0,
        "style": {}
      },
      {
        "parent": 0,
        "style": {}
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 86,
        "height": 100
      },
      {
        "x": 0,
        "y": 0,
        "width": 40,
        "height": 20
      },
      {
        "x": 0,
        "y": 25,
        "width": 40,
        "height": 30
      },
      {
        "x": 43,
        "y": 0,
        "width": 15,
        "height": 20
      },
      {
        "x": 43,
        "y": 25,
        "width": 15,
        "height": 30
      },
      {
        "x": 61,
        "y": 0,
        "width": 25,
        "height": 20
      }
    ]
  }
}
