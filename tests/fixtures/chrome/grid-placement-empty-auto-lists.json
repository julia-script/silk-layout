{
  "name": "grid-placement-empty-auto-lists",
  "kind": "chrome",
  "features": [
    "grid",
    "auto-placement",
    "implicit-tracks"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#auto-placement-algo",
    "https://drafts.csswg.org/css-grid-2/#auto-tracks"
  ],
  "derivation": "Auto track lists size implicit tracks but do not themselves generate tracks when the grid is empty.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": "max-content",
          "gridAutoColumns": [
            20,
            30
          ],
          "gridAutoRows": [
            10,
            15
          ]
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 0,
        "height": 0
      }
    ]
  }
}
