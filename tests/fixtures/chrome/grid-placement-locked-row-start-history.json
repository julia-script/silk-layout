{
  "name": "grid-placement-locked-row-start-history",
  "kind": "chrome",
  "features": [
    "grid",
    "auto-placement",
    "implicit-tracks"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#auto-placement-algo",
    "https://drafts.csswg.org/css-grid-2/#auto-tracks"
  ],
  "derivation": "Step-two sparse history belongs to the definite row-start position. The row-one spanning item reserves cells in all three rows, but does not advance the row-two cursor. A later item starting in row one must still follow its predecessor there; occupancy is checked over every spanned cell.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 60,
          "gridTemplateColumns": [
            20,
            20,
            20
          ],
          "gridTemplateRows": [
            10,
            10,
            10
          ]
        }
      },
      {
        "parent": 0,
        "style": {
          "gridRowStart": 3,
          "gridColumnStart": 1
        }
      },
      {
        "parent": 0,
        "style": {
          "gridRowStart": 1,
          "gridRowEnd": {
            "span": 3
          }
        }
      },
      {
        "parent": 0,
        "style": {
          "gridRowStart": 2
        }
      },
      {
        "parent": 0,
        "style": {
          "gridRowStart": 1
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 60,
        "height": 30
      },
      {
        "x": 0,
        "y": 20,
        "width": 20,
        "height": 10
      },
      {
        "x": 20,
        "y": 0,
        "width": 20,
        "height": 30
      },
      {
        "x": 0,
        "y": 10,
        "width": 20,
        "height": 10
      },
      {
        "x": 40,
        "y": 0,
        "width": 20,
        "height": 10
      }
    ]
  }
}
