{
  "name": "grid-placement-stable-order",
  "kind": "chrome",
  "features": [
    "grid",
    "auto-placement",
    "implicit-tracks"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#auto-placement-algo",
    "https://drafts.csswg.org/css-grid-2/#auto-tracks"
  ],
  "derivation": "Order -1 precedes 0, then the two order-2 items retain source order. A visibility:collapse grid item still occupies its cell.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 64,
          "gridTemplateColumns": [
            20,
            20,
            20
          ],
          "gridAutoRows": [
            10
          ],
          "columnGap": 2,
          "rowGap": 1
        }
      },
      {
        "parent": 0,
        "style": {
          "order": 2
        }
      },
      {
        "parent": 0,
        "style": {
          "order": -1
        }
      },
      {
        "parent": 0,
        "style": {
          "order": 2
        }
      },
      {
        "parent": 0,
        "style": {
          "order": 0,
          "visibility": "collapse"
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 64,
        "height": 21
      },
      {
        "x": 44,
        "y": 0,
        "width": 20,
        "height": 10
      },
      {
        "x": 0,
        "y": 0,
        "width": 20,
        "height": 10
      },
      {
        "x": 0,
        "y": 11,
        "width": 20,
        "height": 10
      },
      {
        "x": 22,
        "y": 0,
        "width": 20,
        "height": 10
      }
    ]
  }
}
