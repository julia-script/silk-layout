{
  "name": "grid-scroll-track-subject-beyond-small-item",
  "kind": "chrome",
  "features": [
    "grid",
    "alignment",
    "scroll-state"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#overflow",
    "https://drafts.csswg.org/css-grid-2/#grid-align",
    "https://drafts.csswg.org/css-align-3/#overflow-scroll-position"
  ],
  "derivation": "The grid itself contributes its 120px width, not just the 10px item. Against a 50px scrollport, requested x=100 clamps to 70 and moves the item to -70.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "position": "relative",
          "overflowX": "auto",
          "overflowY": "auto",
          "width": 50,
          "height": 20,
          "gridTemplateColumns": [
            120
          ],
          "gridTemplateRows": [
            20
          ]
        },
        "scrollOffset": {
          "x": 100,
          "y": 0
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 10,
          "height": 10
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 50,
        "height": 20,
        "scrollableOverflowX": 0,
        "scrollableOverflowWidth": 120
      },
      {
        "x": -70,
        "y": 0,
        "width": 10,
        "height": 10
      }
    ]
  }
}
