{
  "name": "grid-stretch-clamped-size-chrome",
  "kind": "chrome",
  "features": [
    "grid",
    "explicit-tracks"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#grid-item-sizing",
    "https://drafts.csswg.org/css-grid-2/#row-align",
    "https://drafts.csswg.org/css-grid-2/#column-align"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 200,
          "gridTemplateColumns": [
            200
          ],
          "gridTemplateRows": [
            100
          ]
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 1,
          "gridRowStart": 1,
          "minWidth": 80,
          "maxWidth": 120,
          "maxHeight": 40,
          "margin": 10
        }
      }
    ]
  }
}
