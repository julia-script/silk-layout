{
  "name": "grid-template-auto-fill-percentage-tracks-chrome",
  "kind": "chrome",
  "features": [
    "grid",
    "named-lines",
    "areas",
    "repeat"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#named-lines",
    "https://drafts.csswg.org/css-grid-2/#repeat-notation",
    "https://drafts.csswg.org/css-grid-2/#line-placement"
  ],
  "derivation": "A definite 100px basis resolves each 25% track to 25px; four fit and the fifth item enters a second row.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 100,
          "gridTemplateColumns": [
            {
              "repeat": {
                "count": "auto-fill",
                "tracks": [
                  {
                    "percent": 0.25
                  }
                ]
              }
            }
          ],
          "gridTemplateRows": [
            10
          ],
          "gridAutoRows": [
            10
          ]
        }
      },
      {
        "parent": 0,
        "style": {}
      },
      {
        "parent": 0,
        "style": {}
      },
      {
        "parent": 0,
        "style": {}
      },
      {
        "parent": 0,
        "style": {}
      },
      {
        "parent": 0,
        "style": {}
      }
    ]
  }
}
