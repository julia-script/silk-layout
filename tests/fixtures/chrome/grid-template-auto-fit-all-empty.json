{
  "name": "grid-template-auto-fit-all-empty-chrome",
  "kind": "chrome",
  "features": [
    "grid",
    "named-lines",
    "areas",
    "repeat"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#named-lines",
    "https://drafts.csswg.org/css-grid-2/#repeat-notation",
    "https://drafts.csswg.org/css-grid-2/#line-placement"
  ],
  "derivation": "The maximum admits four repetitions, but all repeated tracks are empty. Their tracks and outer gutters collapse, giving zero intrinsic inline extent.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": "max-content",
          "maxWidth": 100,
          "gridTemplateColumns": [
            {
              "repeat": {
                "count": "auto-fit",
                "tracks": [
                  20
                ]
              }
            }
          ],
          "gridTemplateRows": [
            10
          ],
          "columnGap": 5
        }
      }
    ]
  }
}
