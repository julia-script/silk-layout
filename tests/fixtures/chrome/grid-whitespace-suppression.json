{
  "name": "grid-whitespace-suppression",
  "kind": "chrome",
  "features": [
    "grid",
    "source-text",
    "box-generation"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#grid-items"
  ],
  "input": {
    "viewport": {
      "width": 200,
      "height": 150
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 60,
          "fontKey": 1
        }
      },
      {
        "parent": 0,
        "text": "  \n\t"
      },
      {
        "parent": 0,
        "style": {
          "width": 20,
          "height": 7
        }
      },
      {
        "parent": 0,
        "text": " \n "
      },
      {
        "parent": 0,
        "style": {
          "width": 30,
          "height": 9
        }
      },
      {
        "parent": 0,
        "text": "\t "
      }
    ],
    "fonts": [
      {
        "fontSize": 10,
        "ascent": 8,
        "descent": 2,
        "lineGap": 0,
        "xHeight": 5,
        "capHeight": 7,
        "subscriptOffset": 2,
        "superscriptOffset": 3,
        "baselines": {
          "alphabetic": 8,
          "ideographic": 10,
          "central": 5,
          "mathematical": 5
        }
      }
    ]
  }
}
