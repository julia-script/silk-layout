{
  "name": "inline-nested-nowrap",
  "kind": "chrome",
  "features": [
    "inline-fragments"
  ],
  "input": {
    "viewport": {
      "width": 200,
      "height": 200
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 100
        }
      },
      {
        "parent": 0,
        "style": {
