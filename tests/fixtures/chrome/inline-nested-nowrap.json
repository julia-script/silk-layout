          "width": 40,
          "height": 10
        }
      },
      {
        "parent": 0,
        "style": {
          "display": "inline",
          "textWrap": "nowrap"
        }
      },
      {
        "parent": 2,
        "style": {
          "display": "inline-block",
          "width": 40,
          "height": 10
        }
      },
      {
        "parent": 2,
        "style": {
          "display": "inline-block",
          "width": 40,
          "height": 10
        }
      }
    ]
  }
}
