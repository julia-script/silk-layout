{
  "name": "inline-phantom-anchor",
  "kind": "chrome",
  "features": [
    "inline-fragments"
  ],
  "input": {
    "viewport": {
      "width": 200,
      "height": 200
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 100
        }
      },
      {
        "parent": 0,
        "style": {
          "display": "inline",
          "position": "relative"
        }
      },
      {
        "parent": 1,
        "style": {
          "display": "inline-block",
          "width": 5,
          "height": 7,
          "position": "absolute"
        }
      }
    ]
  }
}
