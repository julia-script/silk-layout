{
  "name": "measured-content-alignment-chrome",
  "kind": "chrome",
  "features": [
    "block",
    "measurement",
    "align-content"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 100,
          "height": 50,
          "alignContent": "center"
        },
        "measure": {
          "minWidth": 20,
          "maxWidth": 20,
          "height": 10,
          "firstBaseline": 8
        }
      }
    ]
  }
}
