{
  "name": "reverse-flex-scroll-chrome",
  "kind": "chrome",
  "features": [
    "scroll-state",
    "position"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "flex",
          "flexDirection": "column-reverse",
          "direction": "rtl",
          "alignItems": "flex-start",
          "width": 100,
          "height": 100,
          "overflowX": "hidden",
          "overflowY": "hidden"
        },
        "scrollOffset": {
          "x": -30,
          "y": -40
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 200,
          "height": 200,
          "flexShrink": 0
        }
      }
    ]
  }
}
