{
  "name": "scroll-contents-origins-chrome",
  "kind": "chrome",
  "features": [
    "scroll-state",
    "position"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 200,
          "height": 100,
          "marginLeft": 15,
          "marginTop": 25,
          "overflowX": "hidden",
          "overflowY": "hidden"
        },
        "scrollOffset": {
          "x": 20,
          "y": 30
        }
      },
      {
        "parent": 0,
        "style": {
          "display": "contents"
        }
      },
      {
        "parent": 1,
        "style": {
          "width": 400,
          "height": 300
        }
      },
      {
        "parent": 2,
        "style": {
          "width": 20,
          "height": 10,
          "position": "relative",
          "insetLeft": 5,
          "insetTop": 7
        }
      }
    ]
  }
}
