{
  "name": "scroll-interleaved-order-chrome",
  "kind": "chrome",
  "features": [
    "scroll-state",
    "position"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 100,
          "height": 100,
          "position": "relative",
          "overflowX": "hidden",
          "overflowY": "hidden"
        },
        "scrollOffset": {
          "x": 0,
          "y": 40
        }
      },
      {
        "parent": 0,
        "style": {
          "display": "contents"
        }
      },
      {
        "parent": 0,
        "style": {
          "position": "absolute",
          "width": 10,
          "height": 10
        }
      },
      {
        "parent": 1,
        "style": {
          "position": "relative",
          "width": 100,
          "height": 10,
          "insetTop": 20
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 100,
          "height": 300
        }
      }
    ]
  }
}
