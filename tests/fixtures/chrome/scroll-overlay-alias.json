{
  "name": "scroll-overlay-alias-chrome",
  "kind": "chrome",
  "features": [
    "scroll-state",
    "position"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 100,
          "height": 100,
          "overflowX": "overlay",
          "overflowY": "hidden"
        },
        "scrollOffset": {
          "x": 20,
          "y": 0
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 200,
          "height": 100
        }
      }
    ]
  }
}
