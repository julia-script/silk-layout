{
  "name": "scrollbar-none-retains-scrolling-chrome",
  "kind": "chrome",
  "features": [
    "scrollbars",
    "scrollbar-gutter"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "scrollbars": {
      "auto": {
        "horizontal": 12,
        "vertical": 15,
        "overlay": false,
        "horizontalOnTop": false,
        "verticalOnLeft": false
      },
      "thin": {
        "horizontal": 6,
        "vertical": 8,
        "overlay": false,
        "horizontalOnTop": false,
        "verticalOnLeft": false
      }
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 100,
          "height": 100,
          "scrollbarWidth": "none",
          "scrollbarGutter": "stable both-edges",
          "overflowX": "scroll",
          "overflowY": "scroll"
        },
        "scrollOffset": {
          "x": 10,
          "y": 20
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 200,
          "height": 200
        }
      }
    ]
  }
}
