{
  "name": "scrollbar-positioned-containing-blocks-chrome",
  "kind": "chrome",
  "features": [
    "scrollbars",
    "scrollbar-gutter"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "scrollbars": {
      "auto": {
        "horizontal": 12,
        "vertical": 15,
        "overlay": false,
        "horizontalOnTop": false,
        "verticalOnLeft": false
      },
      "thin": {
        "horizontal": 6,
        "vertical": 8,
        "overlay": false,
        "horizontalOnTop": false,
        "verticalOnLeft": false
      }
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 100,
          "height": 100,
          "boxSizing": "border-box",
          "border": 2,
          "padding": 3,
          "position": "relative",
          "overflowX": "scroll",
          "overflowY": "scroll"
        }
      },
      {
        "parent": 0,
        "style": {
          "position": "absolute",
          "insetRight": 0,
          "insetBottom": 0,
          "width": {"percent": 0.5},
          "height": {"percent": 0.5}
        }
      },
      {
        "parent": 0,
        "style": {
          "position": "fixed",
          "insetRight": 0,
          "insetTop": 0,
          "width": {"percent": 0.5},
          "height": 10
        }
      }
    ]
  }
}
