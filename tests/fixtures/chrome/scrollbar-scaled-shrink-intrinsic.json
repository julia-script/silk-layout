{
  "name": "scrollbar-scaled-shrink-intrinsic-chrome",
  "kind": "chrome",
  "features": [
    "scrollbars",
    "flex-shrink",
    "intrinsic"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "scrollbars": {
      "auto": {
        "horizontal": 12,
        "vertical": 15,
        "overlay": false,
        "horizontalOnTop": false,
        "verticalOnLeft": false
      },
      "thin": {
        "horizontal": 6,
        "vertical": 8,
        "overlay": false,
        "horizontalOnTop": false,
        "verticalOnLeft": false
      }
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "flex",
          "width": 100,
          "height": 100
        }
      },
      {
        "parent": 0,
        "style": {
          "minWidth": 0,
          "height": 100,
          "overflowX": "hidden",
          "overflowY": "scroll"
        },
        "measure": {
          "minWidth": 50,
          "maxWidth": 50,
          "height": 10
        }
      },
      {
        "parent": 0,
        "style": {
          "minWidth": 0,
          "height": 100
        },
        "measure": {
          "minWidth": 50,
          "maxWidth": 50,
          "height": 10
        }
      }
    ]
  }
}
