{
  "name": "scrollbar-stable-intrinsic-max-constraint-chrome",
  "kind": "chrome",
  "features": [
    "scrollbars",
    "scrollbar-gutter"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "scrollbars": {
      "auto": {
        "horizontal": 12,
        "vertical": 15,
        "overlay": false,
        "horizontalOnTop": false,
        "verticalOnLeft": false
      },
      "thin": {
        "horizontal": 6,
        "vertical": 8,
        "overlay": false,
        "horizontalOnTop": false,
        "verticalOnLeft": false
      }
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": "max-content",
          "maxWidth": 60,
          "height": 100,
          "scrollbarGutter": "stable",
          "overflowX": "hidden",
          "overflowY": "hidden"
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 50,
          "height": 20
        }
      }
    ]
  }
}
