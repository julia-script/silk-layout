{
  "name": "scrollbar-sticky-scrollport-chrome",
  "kind": "chrome",
  "features": [
    "scrollbars",
    "sticky",
    "scroll-state"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "scrollbars": {
      "auto": {
        "horizontal": 12,
        "vertical": 15,
        "overlay": false,
        "horizontalOnTop": false,
        "verticalOnLeft": false
      },
      "thin": {
        "horizontal": 6,
        "vertical": 8,
        "overlay": false,
        "horizontalOnTop": false,
        "verticalOnLeft": false
      }
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 100,
          "height": 100,
          "overflowX": "scroll",
          "overflowY": "scroll"
        },
        "scrollOffset": {
          "x": 50,
          "y": 40
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 300,
          "height": 300
        }
      },
      {
        "parent": 1,
        "style": {
          "position": "sticky",
          "insetLeft": {
            "percent": 0.1
          },
          "insetTop": {
            "percent": 0.1
          },
          "width": 20,
          "height": 20
        }
      }
    ]
  }
}
