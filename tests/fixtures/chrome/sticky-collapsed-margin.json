{
  "name": "sticky-collapsed-margin-chrome",
  "kind": "chrome",
  "features": [
    "scroll-state",
    "position"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 100,
          "height": 100,
          "overflowX": "hidden",
          "overflowY": "hidden"
        },
        "scrollOffset": {
          "x": 0,
          "y": 50
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 100,
          "height": 300,
          "marginTop": 20
        }
      },
      {
        "parent": 1,
        "style": {
          "width": 100,
          "height": 20,
          "marginTop": 30,
          "marginBottom": 40,
          "position": "sticky",
          "insetTop": 0
        }
      }
    ]
  }
}
