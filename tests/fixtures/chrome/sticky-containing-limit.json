{
  "name": "sticky-containing-limit-chrome",
  "kind": "chrome",
  "features": [
    "scroll-state",
    "position"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 100,
          "height": 100,
          "overflowX": "hidden",
          "overflowY": "hidden"
        },
        "scrollOffset": {
          "x": 0,
          "y": 200
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 100,
          "height": 100
        }
      },
      {
        "parent": 1,
        "style": {
          "width": 100,
          "height": 20,
          "position": "sticky",
          "insetTop": 10
        }
      },
      {
        "parent": 0,
        "style": {
          "height": 300
        }
      }
    ]
  }
}
