{
  "name": "sticky-negative-margin-chrome",
  "kind": "chrome",
  "features": [
    "scroll-state",
    "position"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 100,
          "height": 100,
          "overflowX": "hidden",
          "overflowY": "hidden"
        }
      },
      {
        "parent": 0,
        "style": {
          "display": "flex",
          "width": 300,
          "height": 100,
          "marginLeft": 100
        }
      },
      {
        "parent": 1,
        "style": {
          "width": 120,
          "height": 20,
          "flexShrink": 0
        }
      },
      {
        "parent": 1,
        "style": {
          "width": 50,
          "height": 20,
          "flexShrink": 0,
          "marginLeft": -20,
          "position": "sticky",
          "insetRight": 0
        }
      }
    ]
  }
}
