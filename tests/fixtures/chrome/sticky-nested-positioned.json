{
  "name": "sticky-nested-positioned-chrome",
  "kind": "chrome",
  "features": [
    "scroll-state",
    "position"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 100,
          "height": 100,
          "overflowX": "hidden",
          "overflowY": "hidden"
        },
        "scrollOffset": {
          "x": 0,
          "y": 50
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 100,
          "height": 300
        }
      },
      {
        "parent": 1,
        "style": {
          "width": 100,
          "height": 100,
          "position": "sticky",
          "insetTop": 10
        }
      },
      {
        "parent": 2,
        "style": {
          "width": 100,
          "height": 20,
          "position": "sticky",
          "insetTop": 20
        }
      },
      {
        "parent": 2,
        "style": {
          "width": 10,
          "height": 10,
          "position": "absolute",
          "insetLeft": 5,
          "insetTop": 5
        }
      },
      {
        "parent": 2,
        "style": {
          "width": 10,
          "height": 10,
          "position": "fixed",
          "insetLeft": 7,
          "insetTop": 7
        }
      }
    ]
  }
}
