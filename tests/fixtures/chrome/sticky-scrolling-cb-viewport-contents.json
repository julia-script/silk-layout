{
  "name": "sticky-scrolling-cb-viewport-contents",
  "kind": "chrome",
  "features": [
    "scroll-state",
    "sticky-containing-block"
  ],
  "spec": [
    "https://drafts.csswg.org/css-position-3/#stickypos-insets",
    "https://github.com/w3c/csswg-drafts/issues/2609"
  ],
  "input": {
    "viewport": {
      "width": 100,
      "height": 100
    },
    "viewportScrollOffset": {
      "x": 0,
      "y": 150
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "contents"
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 100,
          "height": 100,
          "position": "sticky",
          "insetTop": 10
        }
      },
      {
        "parent": 1,
        "style": {
          "width": 100,
          "height": 300
        }
      }
    ]
  }
}
