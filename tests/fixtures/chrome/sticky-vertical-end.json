{
  "name": "sticky-vertical-end-chrome",
  "kind": "chrome",
  "features": [
    "scroll-state",
    "position"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 100,
          "height": 100,
          "writingMode": "vertical-rl",
          "overflowX": "hidden",
          "overflowY": "hidden"
        },
        "scrollOffset": {
          "x": -30,
          "y": 0
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 300,
          "height": 100,
          "writingMode": "vertical-rl"
        }
      },
      {
        "parent": 1,
        "style": {
          "width": 120,
          "height": 100,
          "writingMode": "horizontal-tb",
          "position": "sticky",
          "insetRight": 10,
          "insetLeft": 20
        }
      }
    ]
  }
}
