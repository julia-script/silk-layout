{
  "name": "viewport-scroll-positioning-chrome",
  "kind": "chrome",
  "features": [
    "scroll-state",
    "position"
  ],
  "input": {
    "viewport": {
      "width": 200,
      "height": 100
    },
    "viewportScrollOffset": {
      "x": 20,
      "y": 30
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 400,
          "height": 300,
          "position": "relative"
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 100,
          "height": 20,
          "position": "sticky",
          "insetLeft": 0,
          "insetTop": 10
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 100,
          "height": 100
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 20,
          "height": 20,
          "position": "fixed",
          "insetLeft": 10,
          "insetTop": 10
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 20,
          "height": 20,
          "position": "absolute",
          "insetLeft": 40,
          "insetTop": 50
        }
      }
    ]
  }
}
