{
  "name": "absolute-across-scroller",
  "kind": "spec",
  "features": [
    "scroll-state",
    "position"
  ],
  "spec": [
    "https://drafts.csswg.org/css-overflow-3/#scrolling",
    "https://drafts.csswg.org/css-position-3/#stickypos-insets",
    "https://drafts.csswg.org/css-position-3/#static-position"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 300,
          "height": 200,
          "position": "relative"
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 100,
          "height": 100,
          "overflowX": "hidden",
          "overflowY": "hidden"
        },
        "scrollOffset": {
          "x": 20,
          "y": 30
        }
      },
      {
        "parent": 1,
        "style": {
          "width": 200,
          "height": 300
        }
      },
      {
        "parent": 1,
        "style": {
          "width": 10,
          "height": 10,
          "position": "absolute",
          "insetLeft": 50,
          "insetTop": 60
        }
      },
      {
        "parent": 1,
        "style": {
          "width": 10,
          "height": 10,
          "position": "absolute"
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 300,
        "height": 200
      },
      {
        "x": 0,
        "y": 0,
        "width": 100,
        "height": 100
      },
      {
        "x": -20,
        "y": -30,
        "width": 200,
        "height": 300
      },
      {
        "x": 50,
        "y": 60,
        "width": 10,
        "height": 10
      },
      {
        "x": 0,
        "y": 300,
        "width": 10,
        "height": 10
      }
    ]
  }
}
