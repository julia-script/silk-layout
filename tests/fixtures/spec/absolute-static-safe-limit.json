{
  "name": "absolute-static-safe-limit",
  "kind": "spec",
  "features": [
    "static-position",
    "self-alignment",
    "overflow-safety"
  ],
  "input": {
    "viewport": {
      "width": 100,
      "height": 100
    },
    "fonts": [
      {
        "fontSize": 10,
        "ascent": 8,
        "descent": 2,
        "lineGap": 0,
        "xHeight": 5,
        "capHeight": 7,
        "subscriptOffset": 2,
        "superscriptOffset": 3,
        "baselines": {
          "alphabetic": 8,
          "ideographic": 10,
          "central": 5,
          "mathematical": 5
        }
      }
    ],
    "nodes": [
      {
        "parent": null,
        "style": {
          "position": "relative",
          "width": 100,
          "height": 20,
          "fontKey": 1
        }
      },
      {
        "parent": 0,
        "text": "aaaaaaaaaaaaaaaaaaa"
      },
      {
        "parent": 0,
        "style": {
          "display": "inline",
          "position": "absolute",
          "width": 30,
          "height": 6,
          "justifySelf": "center",
          "justifySelfSafety": "safe"
        }
      },
      {
        "parent": 0,
        "style": {
          "display": "inline",
          "position": "absolute",
          "width": 30,
          "height": 6,
          "justifySelf": "center",
          "justifySelfSafety": "unsafe"
        }
      }
    ]
  },
  "spec": [
    "https://drafts.csswg.org/css-align-3/#auto-safety-position",
    "https://drafts.csswg.org/css-position-3/#staticpos-rect"
  ],
  "expected": {
    "sources": [
      {
        "width": 100,
        "height": 20
      },
      {
        "x": 0,
        "y": 0,
        "width": 95,
        "height": 10
      },
      {
        "x": 70,
        "y": 0,
        "width": 30,
        "height": 6
      },
      {
        "x": 80,
        "y": 0,
        "width": 30,
        "height": 6
      }
    ]
  }
}
