{
  "name": "bidi-clone-fragment-line-fitting",
  "kind": "spec",
  "features": ["source-text", "bidi-ordering", "inline-fragments", "line-breaking", "box-decoration-break"],
  "spec": [
    "https://drafts.csswg.org/css-writing-modes-4/#bidi-fragmentation",
    "https://drafts.csswg.org/css-writing-modes-4/#bidi-fragment-boxes",
    "https://drafts.csswg.org/css-break-3/#break-decoration",
    "https://drafts.csswg.org/css-text-3/#white-space-phase-2"
  ],
  "input": {
    "viewport": {"width": 100, "height": 100},
    "fonts": [{
      "fontSize": 10, "ascent": 8, "descent": 2, "lineGap": 0,
      "xHeight": 5, "capHeight": 7, "subscriptOffset": 2, "superscriptOffset": 3,
      "baselines": {"alphabetic": 8, "ideographic": 10, "central": 5, "mathematical": 5}
    }],
    "nodes": [
      {"parent": null, "style": {"width": 45, "fontKey": 1, "direction": "rtl", "unicodeBidi": "bidi-override"}},
      {"parent": 0, "style": {"display": "inline", "fontKey": 1, "direction": "rtl", "boxDecorationBreak": "clone", "padding": {"left": 3, "right": 4}, "border": {"left": 1, "right": 2}}},
      {"parent": 1, "style": {"display": "inline", "fontKey": 1, "direction": "rtl"}},
      {"parent": 2, "text": "AB"},
      {"parent": 1, "style": {"display": "inline", "fontKey": 1, "direction": "ltr", "unicodeBidi": "embed"}},
      {"parent": 4, "text": "cd "},
      {"parent": 0, "style": {"display": "inline", "fontKey": 1, "direction": "ltr", "unicodeBidi": "embed"}},
      {"parent": 6, "text": "ef"}
    ]
  },
  "expected": {
    "sources": [
      {"width": 45, "height": 20},
      {"rects": [{"x": 25, "y": 0, "width": 20, "height": 10}, {"x": 5, "y": 0, "width": 20, "height": 10}]},
      {"rects": [{"x": 29, "y": 0, "width": 10, "height": 10}]},
      {"rects": [{"x": 29, "y": 0, "width": 10, "height": 10}]},
      {"rects": [{"x": 9, "y": 0, "width": 10, "height": 10}]},
      {"rects": [{"x": 9, "y": 0, "width": 10, "height": 10}]},
      {"rects": [{"x": 35, "y": 10, "width": 10, "height": 10}]},
      {"rects": [{"x": 35, "y": 10, "width": 10, "height": 10}]}
    ]
  }
}
