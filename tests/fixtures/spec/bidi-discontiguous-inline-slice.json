{
  "name": "bidi-discontiguous-inline-slice",
  "kind": "spec",
  "features": ["source-text", "bidi-ordering", "inline-fragments", "box-decoration-break"],
  "spec": [
    "https://www.unicode.org/reports/tr9/#L2",
    "https://drafts.csswg.org/css-writing-modes-4/#bidi-fragmentation",
    "https://drafts.csswg.org/css-writing-modes-4/#bidi-fragment-boxes",
    "https://drafts.csswg.org/css-break-3/#valdef-box-decoration-break-slice"
  ],
  "input": {
    "viewport": {"width": 100, "height": 100},
    "fonts": [{
      "fontSize": 10, "ascent": 8, "descent": 2, "lineGap": 0,
      "xHeight": 5, "capHeight": 7, "subscriptOffset": 2, "superscriptOffset": 3,
      "baselines": {"alphabetic": 8, "ideographic": 10, "central": 5, "mathematical": 5}
    }],
    "nodes": [
      {"parent": null, "style": {"width": 100, "fontKey": 1, "direction": "rtl", "unicodeBidi": "bidi-override"}},
      {"parent": 0, "style": {
        "display": "inline", "boxDecorationBreak": "slice", "fontKey": 1, "direction": "rtl",
        "padding": {"left": 3, "right": 4},
        "border": {"left": 1, "right": 2}
      }},
      {"parent": 1, "style": {"display": "inline", "fontKey": 1, "direction": "rtl"}},
      {"parent": 2, "text": "AB"},
      {"parent": 1, "style": {"display": "inline", "fontKey": 1, "direction": "ltr", "unicodeBidi": "embed"}},
      {"parent": 4, "text": "cd"},
      {"parent": 0, "style": {"display": "inline", "fontKey": 1, "direction": "ltr", "unicodeBidi": "embed"}},
      {"parent": 6, "text": "ef"}
    ]
  },
  "expected": {
    "sources": [
      {"width": 100, "height": 10},
      {"rects": [
        {"x": 84, "y": 0, "width": 16, "height": 10},
        {"x": 60, "y": 0, "width": 14, "height": 10}
      ]},
      {"rects": [{"x": 84, "y": 0, "width": 10, "height": 10}]},
      {"rects": [{"x": 84, "y": 0, "width": 10, "height": 10}]},
      {"rects": [{"x": 64, "y": 0, "width": 10, "height": 10}]},
      {"rects": [{"x": 64, "y": 0, "width": 10, "height": 10}]},
      {"rects": [{"x": 74, "y": 0, "width": 10, "height": 10}]},
      {"rects": [{"x": 74, "y": 0, "width": 10, "height": 10}]}
    ]
  }
}
