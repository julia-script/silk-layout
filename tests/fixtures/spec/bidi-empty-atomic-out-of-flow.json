{
  "name": "bidi-empty-atomic-out-of-flow",
  "kind": "spec",
  "features": ["source-text", "bidi-ordering", "empty-inline", "positioned"],
  "spec": [
    "https://drafts.csswg.org/css-writing-modes-4/#bidi-algo",
    "https://drafts.csswg.org/css-writing-modes-4/#bidi-atomic-inlines",
    "https://drafts.csswg.org/css-position-3/#position-property"
  ],
  "input": {
    "viewport": {"width": 100, "height": 100},
    "fonts": [{
      "fontSize": 10, "ascent": 8, "descent": 2, "lineGap": 0,
      "xHeight": 5, "capHeight": 7, "subscriptOffset": 2, "superscriptOffset": 3,
      "baselines": {"alphabetic": 8, "ideographic": 10, "central": 5, "mathematical": 5}
    }],
    "nodes": [
      {"parent": null, "style": {"width": 100, "fontKey": 1}},
      {"parent": 0, "style": {"fontKey": 1, "direction": "rtl"}},
      {"parent": 1, "text": "1"},
      {"parent": 1, "style": {"display": "inline", "fontKey": 1, "direction": "rtl", "padding": {"left": 3, "right": 3}}},
      {"parent": 1, "text": "\u200e2"},
      {"parent": 0, "style": {"fontKey": 1, "direction": "rtl"}},
      {"parent": 5, "text": "1"},
      {"parent": 5, "style": {"display": "inline-block", "fontKey": 1, "direction": "rtl", "width": 0, "height": 0}},
      {"parent": 5, "text": "\u200e2"},
      {"parent": 0, "style": {"fontKey": 1, "direction": "rtl", "position": "relative"}},
      {"parent": 9, "text": "1"},
      {"parent": 9, "style": {"display": "inline", "position": "absolute", "fontKey": 1, "direction": "rtl", "width": 0, "height": 0}},
      {"parent": 9, "text": "\u200e2"}
    ]
  },
  "expected": {
    "sources": [
      {"width": 100, "height": 30},
      {"rects": [{"x": 0, "y": 0, "width": 100, "height": 10}]},
      {"rects": [{"x": 84, "y": 0, "width": 5, "height": 10}]},
      {"rects": [{"x": 89, "y": 0, "width": 6, "height": 10}]},
      {"rects": [{"x": 95, "y": 0, "width": 5, "height": 10}]},
      {"rects": [{"x": 0, "y": 10, "width": 100, "height": 10}]},
      {"rects": [{"x": 95, "y": 10, "width": 5, "height": 10}]},
      {"rects": [{"x": 95, "y": 18, "width": 0, "height": 0}]},
      {"rects": [{"x": 90, "y": 10, "width": 5, "height": 10}]},
      {"rects": [{"x": 0, "y": 20, "width": 100, "height": 10}]},
      {"rects": [{"x": 90, "y": 20, "width": 5, "height": 10}]},
      {"rects": [{"x": 95, "y": 20, "width": 0, "height": 0}]},
      {"rects": [{"x": 95, "y": 20, "width": 5, "height": 10}]}
    ]
  }
}
