{
  "name": "bidi-rtl-level-two-text",
  "kind": "spec",
  "features": ["source-text", "bidi-ordering"],
  "spec": [
    "https://www.unicode.org/reports/tr9/#I2",
    "https://www.unicode.org/reports/tr9/#L2",
    "https://drafts.csswg.org/css-writing-modes-4/#bidi-algo"
  ],
  "input": {
    "viewport": {"width": 100, "height": 100},
    "fonts": [{
      "fontSize": 10, "ascent": 8, "descent": 2, "lineGap": 0,
      "xHeight": 5, "capHeight": 7, "subscriptOffset": 2, "superscriptOffset": 3,
      "baselines": {"alphabetic": 8, "ideographic": 10, "central": 5, "mathematical": 5}
    }],
    "nodes": [
      {"parent": null, "style": {"width": 100, "fontKey": 1, "direction": "rtl"}},
      {"parent": 0, "text": "1"},
      {"parent": 0, "text": "2"}
    ]
  },
  "expected": {
    "sources": [
      {"width": 100, "height": 10},
      {"x": 90, "y": 0, "width": 5, "height": 10, "rects": [{"x": 90, "y": 0, "width": 5, "height": 10}]},
      {"x": 95, "y": 0, "width": 5, "height": 10, "rects": [{"x": 95, "y": 0, "width": 5, "height": 10}]}
    ]
  }
}
