{
  "name": "bidi-static-hypothetical-order",
  "kind": "spec",
  "features": ["source-text", "bidi-ordering", "positioned"],
  "spec": [
    "https://drafts.csswg.org/css-position-3/#staticpos-rect",
    "https://www.w3.org/TR/2011/REC-CSS2-20110607/visudet.html#abs-non-replaced-width",
    "https://drafts.csswg.org/css-writing-modes-4/#bidi-atomic-inlines",
    "https://www.unicode.org/reports/tr9/tr9-52.html#N1",
    "https://www.unicode.org/reports/tr9/tr9-52.html#L2"
  ],
  "input": {
    "viewport": {"width": 100, "height": 100},
    "fonts": [{
      "fontSize": 10, "ascent": 8, "descent": 2, "lineGap": 0,
      "xHeight": 5, "capHeight": 7, "subscriptOffset": 2, "superscriptOffset": 3,
      "baselines": {"alphabetic": 8, "ideographic": 10, "central": 5, "mathematical": 5}
    }],
    "nodes": [
      {"parent": null, "style": {"width": 100, "fontKey": 1, "direction": "rtl", "position": "relative"}},
      {"parent": 0, "text": "123"},
      {"parent": 0, "style": {"display": "inline", "position": "absolute", "fontKey": 1, "direction": "rtl", "width": 5, "height": 5}},
      {"parent": 0, "text": "\u200e2"}
    ]
  },
  "expected": {
    "sources": [
      {"width": 100, "height": 10},
      {"rects": [{"x": 80, "y": 0, "width": 15, "height": 10}]},
      {"rects": [{"x": 80, "y": 0, "width": 5, "height": 5}]},
      {"rects": [{"x": 95, "y": 0, "width": 5, "height": 10}]}
    ]
  }
}
