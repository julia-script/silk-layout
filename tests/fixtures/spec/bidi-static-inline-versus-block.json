{
  "name": "bidi-static-inline-versus-block",
  "kind": "spec",
  "features": ["source-text", "bidi-ordering", "static-position", "fixed"],
  "spec": ["https://drafts.csswg.org/css-position-3/#staticpos-rect", "https://drafts.csswg.org/css-writing-modes-4/#bidi-algo", "https://drafts.csswg.org/css-align-3/#auto-safety-position"],
  "input": {
    "viewport": {"width": 100, "height": 100},
    "fonts": [{"fontSize": 10, "ascent": 8, "descent": 2, "lineGap": 0, "xHeight": 5, "capHeight": 7, "subscriptOffset": 2, "superscriptOffset": 3, "baselines": {"alphabetic": 8, "ideographic": 10, "central": 5, "mathematical": 5}}],
    "nodes": [
      {"parent": null, "style": {"width": 100, "fontKey": 1, "direction": "rtl", "unicodeBidi": "bidi-override"}},
      {"parent": 0, "text": "ab"},
      {"parent": 0, "style": {"display": "inline", "position": "absolute", "width": 12, "height": 6}},
      {"parent": 0, "style": {"display": "inline", "position": "fixed", "justifySelf": "end", "width": 12, "height": 6}},
      {"parent": 0, "style": {"display": "block", "position": "absolute", "width": 12, "height": 6}},
      {"parent": 0, "style": {"display": "block", "position": "fixed", "width": 12, "height": 6}}
    ]
  },
  "expected": {"sources": [
    {"width": 100, "height": 10},
    {"rects": [{"x": 90, "y": 0, "width": 10, "height": 10}]},
    {"rects": [{"x": 78, "y": 0, "width": 12, "height": 6}]},
    {"rects": [{"x": 88, "y": 0, "width": 12, "height": 6}]},
    {"rects": [{"x": 88, "y": 10, "width": 12, "height": 6}]},
    {"rects": [{"x": 88, "y": 10, "width": 12, "height": 6}]}
  ]}
}
