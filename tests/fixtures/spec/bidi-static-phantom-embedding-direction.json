{
  "name": "bidi-static-phantom-embedding-direction",
  "kind": "spec",
  "features": ["inline-fragments", "static-position", "bidi"],
  "spec": [
    "https://www.w3.org/TR/CSS22/visudet.html#abs-non-replaced-width",
    "https://drafts.csswg.org/css-position-3/#staticpos-rect"
  ],
  "input": {
    "viewport": {"width": 400, "height": 300},
    "nodes": [
      {"parent": null, "style": {"width": 100}},
      {"parent": 0, "style": {"display": "inline", "position": "relative", "boxDecorationBreak": "clone", "border": 2, "lineHeight": {"length": 10}, "direction": "rtl", "unicodeBidi": "embed"}},
      {"parent": 1, "style": {"width": 30, "height": 15}},
      {"parent": 1, "style": {"display": "inline", "position": "absolute", "width": 5, "height": 5}},
      {"parent": 1, "style": {"width": 40, "height": 20}}
    ]
  },
  "expected": {
    "sources": [
      {"rects": [{"x": 0, "y": 0, "width": 100, "height": 55}]},
      {"rects": [
        {"x": 0, "y": 3, "width": 4, "height": 4},
        {"x": 0, "y": 10, "width": 100, "height": 15},
        {"x": 0, "y": 25, "width": 4, "height": 0},
        {"x": 0, "y": 25, "width": 100, "height": 20},
        {"x": 0, "y": 48, "width": 4, "height": 4}
      ]},
      {"rects": [{"x": 0, "y": 10, "width": 30, "height": 15}]},
      {"rects": [{"x": 2, "y": 25, "width": 5, "height": 5}]},
      {"rects": [{"x": 0, "y": 25, "width": 40, "height": 20}]}
    ]
  }
}
