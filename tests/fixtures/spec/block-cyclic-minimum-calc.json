{
  "name": "block-cyclic-minimum-calc",
  "kind": "spec",
  "features": [
    "intrinsic-sizing",
    "cyclic-percentages"
  ],
  "input": {
    "viewport": {
      "width": 200,
      "height": 200
    },
    "fonts": [
      {
        "fontSize": 10,
        "ascent": 8,
        "descent": 2,
        "lineGap": 0,
        "xHeight": 5,
        "capHeight": 7,
        "subscriptOffset": 2,
        "superscriptOffset": 3,
        "baselines": {
          "alphabetic": 8,
          "ideographic": 10,
          "central": 5,
          "mathematical": 5
        }
      }
    ],
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": "max-content"
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 0,
          "minWidth": {
            "length": 20,
            "percent": 0.5
          },
          "height": 10
        }
      }
    ]
  },
  "spec": [
    "https://drafts.csswg.org/css-sizing-3/#cyclic-percentage-contribution"
  ],
  "expected": {
    "sources": [
      {
        "width": 20,
        "height": 10
      },
      {
        "x": 0,
        "y": 0,
        "width": 30,
        "height": 10
      }
    ]
  }
}
