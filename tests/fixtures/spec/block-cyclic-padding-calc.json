{
  "name": "block-cyclic-padding-calc",
  "kind": "spec",
  "features": [
    "intrinsic-sizing",
    "cyclic-percentages"
  ],
  "input": {
    "viewport": {
      "width": 200,
      "height": 200
    },
    "fonts": [
      {
        "fontSize": 10,
        "ascent": 8,
        "descent": 2,
        "lineGap": 0,
        "xHeight": 5,
        "capHeight": 7,
        "subscriptOffset": 2,
        "superscriptOffset": 3,
        "baselines": {
          "alphabetic": 8,
          "ideographic": 10,
          "central": 5,
          "mathematical": 5
        }
      }
    ],
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": "max-content"
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 100,
          "height": 10,
          "padding": {
            "left": {
              "length": 10,
              "percent": 0.1
            }
          }
        }
      }
    ]
  },
  "spec": [
    "https://drafts.csswg.org/css-sizing-3/#cyclic-percentage-contribution"
  ],
  "expected": {
    "sources": [
      {
        "width": 110,
        "height": 10
      },
      {
        "x": 0,
        "y": 0,
        "width": 121,
        "height": 10,
        "contentWidth": 100
      }
    ]
  }
}
