{
  "name": "break-controls-continuous",
  "kind": "spec",
  "features": ["fragmentation-controls"],
  "spec": ["https://www.w3.org/TR/css-break-3/#forced-breaks"],
  "input": {
    "viewport": {"width": 400, "height": 300},
    "nodes": [
      {"parent": null, "style": {"width": 100, "breakInside": "avoid-page", "orphans": 3, "widows": 4}},
      {"parent": 0, "style": {"height": 10, "breakBefore": "right", "breakAfter": "avoid-column"}},
      {"parent": 0, "style": {"height": 20, "breakBefore": "column", "breakAfter": "region", "breakInside": "avoid-region"}}
    ]
  },
  "expected": {
    "sources": [
      {"rects": [{"x": 0, "y": 0, "width": 100, "height": 30}]},
      {"rects": [{"x": 0, "y": 0, "width": 100, "height": 10}]},
      {"rects": [{"x": 0, "y": 10, "width": 100, "height": 20}]}
    ]
  }
}
