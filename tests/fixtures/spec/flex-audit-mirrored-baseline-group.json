{
  "name": "flex-audit-mirrored-baseline-group",
  "kind": "spec",
  "features": ["flex", "baseline", "writing-mode", "font-metrics"],
  "spec": [
    "https://drafts.csswg.org/css-align-3/#baseline-terms",
    "https://drafts.csswg.org/css-align-3/#align-by-baseline",
    "https://drafts.csswg.org/css-flexbox-1/#flex-baselines"
  ],
  "input": {
    "viewport": {"width": 400, "height": 300},
    "fonts": [
      {"fontSize": 10, "ascent": 8, "descent": 2, "lineGap": 0, "xHeight": 5, "capHeight": 7, "subscriptOffset": 2, "superscriptOffset": 3,
       "baselines": {"alphabetic": 8, "ideographic": 10, "central": 5, "mathematical": 5}}
    ],
    "nodes": [
      {"parent": null, "style": {"display": "flex", "writingMode": "sideways-rl", "height": 100, "alignItems": "baseline", "fontKey": 1}},
      {"parent": 0, "style": {"writingMode": "sideways-rl", "width": 20, "height": 20}},
      {"parent": 0, "style": {"writingMode": "sideways-lr", "width": 10, "height": 20, "alignSelf": "last baseline"}}
    ]
  },
  "expected": {
    "sources": [
      {"x": 0, "y": 0, "width": 24, "height": 100, "firstBaseline": 20, "lastBaseline": 20},
      {"x": 4, "y": 0, "width": 20, "height": 20},
      {"x": 0, "y": 20, "width": 10, "height": 20}
    ]
  }
}
