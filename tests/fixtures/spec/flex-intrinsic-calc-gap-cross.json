{
  "name": "flex-intrinsic-calc-gap-cross",
  "kind": "spec",
  "features": ["flex", "wrap", "intrinsic", "gap", "cyclic-percentage", "calc"],
  "spec": [
    "https://drafts.csswg.org/css-flexbox-1/#cross-sizing",
    "https://drafts.csswg.org/css-gaps-1/#gap-percent"
  ],
  "input": {
    "viewport": {"width": 800, "height": 600},
    "nodes": [
      {"parent": null, "style": {"display": "flex", "flexWrap": "wrap", "width": 100, "rowGap": {"length": 10, "percent": 0.2}}},
      {"parent": 0, "style": {"width": 70, "height": 20}},
      {"parent": 0, "style": {"width": 70, "height": 20}}
    ]
  },
  "expected": {
    "sources": [
      {"x": 0, "y": 0, "width": 100, "height": 50, "contentWidth": 100, "contentHeight": 50},
      {"x": 0, "y": 0, "width": 70, "height": 20, "contentWidth": 70, "contentHeight": 20},
      {"x": 0, "y": 30, "width": 70, "height": 20, "contentWidth": 70, "contentHeight": 20}
    ]
  }
}
