{
  "name": "flex-intrinsic-cyclic-edges-calc",
  "kind": "spec",
  "features": ["flex", "max-content", "cyclic-percentage", "calc", "margin", "padding"],
  "spec": [
    "https://drafts.csswg.org/css-flexbox-1/#intrinsic-main-sizes-compat",
    "https://drafts.csswg.org/css-flexbox-1/#intrinsic-item-contributions",
    "https://drafts.csswg.org/css-sizing-3/#cyclic-percentage-contribution"
  ],
  "input": {
    "viewport": {"width": 800, "height": 600},
    "nodes": [
      {"parent": null, "style": {"display": "flex", "width": "max-content", "height": 20}},
      {"parent": 0, "style": {"width": 80, "flexShrink": 0, "margin": {"left": {"length": 10, "percent": 0.1}}, "padding": {"left": {"length": 10, "percent": 0.1}}}}
    ]
  },
  "expected": {
    "sources": [
      {"x": 0, "y": 0, "width": 100, "height": 20, "contentWidth": 100, "contentHeight": 20},
      {"x": 20, "y": 0, "width": 100, "height": 20, "contentWidth": 80, "contentHeight": 20}
    ]
  }
}
