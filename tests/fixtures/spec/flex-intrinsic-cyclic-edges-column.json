{
  "name": "flex-intrinsic-cyclic-edges-column",
  "kind": "spec",
  "features": ["flex", "column", "max-content", "cyclic-percentage", "margin", "padding"],
  "spec": [
    "https://drafts.csswg.org/css-flexbox-1/#cross-sizing",
    "https://drafts.csswg.org/css-flexbox-1/#intrinsic-cross-sizes",
    "https://drafts.csswg.org/css-sizing-3/#cyclic-percentage-contribution"
  ],
  "input": {
    "viewport": {"width": 800, "height": 600},
    "nodes": [
      {"parent": null, "style": {"display": "flex", "flexDirection": "column", "width": "max-content"}},
      {"parent": 0, "style": {"width": 100, "height": 30, "flexShrink": 0, "margin": {"left": {"percent": 0.1}}, "padding": {"left": {"percent": 0.2}}}}
    ]
  },
  "expected": {
    "sources": [
      {"x": 0, "y": 0, "width": 100, "height": 30, "contentWidth": 100, "contentHeight": 30},
      {"x": 10, "y": 0, "width": 120, "height": 30, "contentWidth": 100, "contentHeight": 30}
