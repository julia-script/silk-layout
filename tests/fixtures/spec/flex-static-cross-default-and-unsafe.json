{
  "name": "flex-static-cross-default-and-unsafe",
  "kind": "spec",
  "features": [
    "flex",
    "static-position",
    "overflow-alignment"
  ],
  "spec": [
    "https://drafts.csswg.org/css-flexbox-1/#abspos-items",
    "https://drafts.csswg.org/css-align-3/#auto-safety-position",
    "https://drafts.csswg.org/css-align-3/"
  ],
  "input": {
    "viewport": {
      "width": 250,
      "height": 250
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "position": "relative",
          "width": 200,
          "height": 200
        }
      },
      {
        "parent": 0,
        "style": {
          "display": "flex",
          "width": 100,
          "height": 20
        }
      },
      {
        "parent": 1,
        "style": {
          "position": "absolute",
          "width": 10,
          "height": 40,
          "alignSelf": "center"
        }
      },
      {
        "parent": 1,
        "style": {
          "position": "absolute",
          "width": 10,
          "height": 40,
          "alignSelf": "center",
          "alignSelfSafety": "unsafe"
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "rects": [
          {
            "x": 0,
            "y": 0,
            "width": 200,
            "height": 200
          }
        ]
      },
      {
        "rects": [
          {
            "x": 0,
            "y": 0,
            "width": 100,
            "height": 20
          }
        ]
      },
      {
        "rects": [
          {
            "x": 0,
            "y": 0,
            "width": 10,
            "height": 40
          }
        ]
      },
      {
        "rects": [
          {
            "x": 0,
            "y": -10,
            "width": 10,
            "height": 40
          }
        ]
      }
    ]
  }
}
