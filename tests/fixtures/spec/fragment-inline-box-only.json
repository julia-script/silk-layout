    "fonts": [{"fontSize": 10, "ascent": 8, "descent": 2, "lineGap": 0, "xHeight": 5, "capHeight": 7, "subscriptOffset": 2, "superscriptOffset": 3, "baselines": {"alphabetic": 8, "ideographic": 10, "central": 5, "mathematical": 5}}],
    "nodes": [
      {"parent": null, "style": {"fontKey": 1}},
      {"parent": 0, "style": {"display": "inline-block", "width": 10, "height": 10, "verticalAlign": "top"}},
      {"parent": 0, "style": {"display": "inline-block", "width": 10, "height": 10, "verticalAlign": "top"}},
      {"parent": 0, "style": {"display": "inline-block", "width": 10, "height": 10, "verticalAlign": "top"}},
      {"parent": 0, "style": {"display": "inline-block", "width": 10, "height": 10, "verticalAlign": "top"}}
    ]
  },
  "expected": {"sources": [
    {"rects": [{"x": 0, "y": 0, "width": 10, "height": 35}, {"x": 30, "y": 0, "width": 10, "height": 20}]},
    {"rects": [{"x": 0, "y": 0, "width": 10, "height": 10}]},
    {"rects": [{"x": 0, "y": 10, "width": 10, "height": 10}]},
    {"rects": [{"x": 30, "y": 0, "width": 10, "height": 10}]},
    {"rects": [{"x": 30, "y": 10, "width": 10, "height": 10}]}
  ]}
}
