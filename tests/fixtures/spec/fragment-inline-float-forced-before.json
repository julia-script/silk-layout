{
  "name": "fragment-inline-float-forced-before",
  "kind": "spec",
  "features": ["fragmentation", "source-text", "inline-fragments", "floats"],
  "spec": ["https://drafts.csswg.org/css-break-3/#possible-breaks", "https://drafts.csswg.org/css-break-3/#break-propagation"],
  "input": {
    "viewport": {"width": 100, "height": 100},
    "fragmentation": {"kind": "column", "frames": [{"x": 0, "y": 0, "width": 30, "height": 35}, {"x": 40, "y": 0, "width": 30, "height": 35}]},
    "fonts": [{"fontSize": 10, "ascent": 8, "descent": 2, "lineGap": 0, "xHeight": 5, "capHeight": 7, "subscriptOffset": 2, "superscriptOffset": 3, "baselines": {"alphabetic": 8, "ideographic": 10, "central": 5, "mathematical": 5}}],
    "nodes": [
      {"parent": null, "style": {"fontKey": 1}},
      {"parent": 0, "style": {"display": "inline", "fontKey": 1}},
      {"parent": 1, "style": {"float": "left", "width": 10, "height": 10, "breakBefore": "column"}},
      {"parent": 1, "text": "aaaa"}
    ]
  },
  "expected": {"sources": [
    {"rects": [{"x": 0, "y": 0, "width": 30, "height": 10}]},
    {"rects": [{"x": 10, "y": 0, "width": 20, "height": 10}]},
    {"rects": [{"x": 0, "y": 0, "width": 10, "height": 10}]},
    {"rects": [{"x": 10, "y": 0, "width": 20, "height": 10}]}
  ]}
}
