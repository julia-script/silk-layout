    "break-controls"
  ],
  "spec": [
    "https://drafts.csswg.org/css-break-3/#possible-breaks",
    "https://drafts.csswg.org/css-break-3/#unforced-breaks"
  ],
  "input": {
    "viewport": {
      "width": 200,
      "height": 100
