{
  "name": "fragment-inline-plaintext-context",
  "kind": "spec",
  "features": ["fragmentation", "source-text", "bidi-ordering"],
  "spec": ["https://drafts.csswg.org/css-writing-modes-4/#bidi-algo", "https://drafts.csswg.org/css-writing-modes-4/#bidi-para-direction", "https://drafts.csswg.org/css-break-3/#varying-size-boxes", "https://drafts.csswg.org/css-break-3/#box-splitting"],
  "input": {
    "viewport": {"width": 100, "height": 100},
    "fragmentation": {"kind": "column", "frames": [{"x": 0, "y": 0, "width": 10, "height": 25}, {"x": 40, "y": 0, "width": 20, "height": 25}]},
    "fonts": [{"fontSize": 10, "ascent": 8, "descent": 2, "lineGap": 0, "xHeight": 5, "capHeight": 7, "subscriptOffset": 2, "superscriptOffset": 3, "baselines": {"alphabetic": 8, "ideographic": 10, "central": 5, "mathematical": 5}}],
    "nodes": [{"parent": null, "style": {"fontKey": 1, "unicodeBidi": "plaintext"}}, {"parent": 0, "text": "\u200faa bb "}, {"parent": 0, "text": "12 34"}]
  },
  "expected": {"sources": [
    {"rects": [{"x": 0, "y": 0, "width": 10, "height": 25}, {"x": 40, "y": 0, "width": 20, "height": 20}]},
    {"rects": [{"x": 0, "y": 0, "width": 10, "height": 10}, {"x": 10, "y": 0, "width": 0, "height": 10}, {"x": 0, "y": 10, "width": 10, "height": 10}]},
    {"rects": [{"x": 50, "y": 0, "width": 10, "height": 10}, {"x": 50, "y": 10, "width": 10, "height": 10}]}
  ]}
}
