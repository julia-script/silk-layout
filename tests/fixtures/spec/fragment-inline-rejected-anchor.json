{
  "name": "fragment-inline-rejected-anchor",
  "kind": "spec",
  "features": ["fragmentation", "source-text", "inline-fragments", "positioning"],
  "spec": ["https://drafts.csswg.org/css-break-3/#widows-orphans", "https://drafts.csswg.org/css-position-3/#staticpos-rect", "https://drafts.csswg.org/css-break-3/#box-splitting"],
  "input": {
    "viewport": {"width": 100, "height": 100},
    "fragmentation": {"kind": "column", "frames": [{"x": 0, "y": 0, "width": 10, "height": 35}, {"x": 30, "y": 0, "width": 10, "height": 35}]},
    "fonts": [{"fontSize": 10, "ascent": 8, "descent": 2, "lineGap": 0, "xHeight": 5, "capHeight": 7, "subscriptOffset": 2, "superscriptOffset": 3, "baselines": {"alphabetic": 8, "ideographic": 10, "central": 5, "mathematical": 5}}],
    "nodes": [
      {"parent": null, "style": {"fontKey": 1, "position": "relative"}},
      {"parent": 0, "text": "aa bb cc"},
      {"parent": 0, "style": {"display": "inline", "position": "absolute", "width": 2, "height": 2}},
      {"parent": 0, "text": " dd"}
    ]
  },
  "expected": {"sources": [
    {"rects": [{"x": 0, "y": 0, "width": 10, "height": 35}, {"x": 30, "y": 0, "width": 10, "height": 20}]},
    {"rects": [{"x": 0, "y": 0, "width": 10, "height": 10}, {"x": 0, "y": 10, "width": 10, "height": 10}, {"x": 30, "y": 0, "width": 10, "height": 10}]},
    {"rects": [{"x": 40, "y": 0, "width": 2, "height": 2}]},
    {"rects": [{"x": 30, "y": 10, "width": 10, "height": 10}]}
  ]}
}
