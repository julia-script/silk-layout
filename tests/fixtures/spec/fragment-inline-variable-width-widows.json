  "features": ["fragmentation", "source-text", "inline-fragments"],
  "spec": ["https://drafts.csswg.org/css-break-3/#widows-orphans", "https://drafts.csswg.org/css-break-3/#varying-size-boxes", "https://drafts.csswg.org/css-break-3/#box-splitting"],
  "input": {
