    {"rects": [{"x": 0, "y": 0, "width": 25, "height": 35}, {"x": 40, "y": 0, "width": 10, "height": 20}]},
    {"width": 25, "height": 30},
    {"rects": [{"x": 40, "y": 0, "width": 10, "height": 10}, {"x": 40, "y": 10, "width": 10, "height": 10}]}
  ]}
