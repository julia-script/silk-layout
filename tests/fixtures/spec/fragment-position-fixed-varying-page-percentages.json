    ]
  },
  "expected": {"sources": [
    {"rects": [{"x": 0, "y": 0, "width": 100, "height": 50}, {"x": 150, "y": 100, "width": 100, "height": 50}]},
    {"rects": [{"x": 0, "y": 0, "width": 20, "height": 50}, {"x": 150, "y": 100, "width": 20, "height": 80}]},
