  "input": {
    "viewport": {"width": 300, "height": 200},
    "fragmentation": {"kind": "page", "frames": [{"x": 0, "y": 0, "width": 100, "height": 50}, {"x": 150, "y": 100, "width": 100, "height": 80}]},
    "nodes": [
