{
  "name": "fragment-position-frame-local-scrollbars",
  "kind": "spec",
  "features": [
    "fragmentation",
    "position",
    "scrollbars"
  ],
  "spec": [
    "https://drafts.csswg.org/css-position-3/#fixed-pos",
    "https://drafts.csswg.org/css-overflow-3/#scrollbar-sizing"
  ],
  "input": {
    "viewport": {
      "width": 300,
      "height": 200
    },
    "fragmentation": {
      "kind": "page",
      "frames": [
        {
          "x": 0,
          "y": 0,
          "width": 100,
          "height": 50
        },
        {
          "x": 150,
          "y": 100,
          "width": 200,
          "height": 50
        }
      ]
    },
    "scrollbars": {
      "auto": {
        "horizontal": 12,
        "vertical": 15,
        "overlay": false,
        "horizontalOnTop": false,
        "verticalOnLeft": false
      },
      "thin": {
        "horizontal": 6,
        "vertical": 8,
        "overlay": false,
        "horizontalOnTop": false,
        "verticalOnLeft": false
      }
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "height": 100
        }
      },
      {
        "parent": 0,
        "style": {
          "position": "fixed",
          "insetTop": 0,
          "insetLeft": 0,
          "width": {
            "percent": 1
          },
          "height": 30,
          "overflowX": "auto",
          "overflowY": "auto"
        }
      },
      {
        "parent": 1,
        "style": {
          "width": 110,
          "height": 20
        }
      },
      {
        "parent": 1,
        "style": {
          "width": {
            "percent": 1
          },
          "height": 0
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "rects": [
          {
            "x": 0,
            "y": 0,
            "width": 100,
            "height": 50
          },
          {
            "x": 150,
            "y": 100,
            "width": 200,
            "height": 50
          }
        ]
      },
      {
        "rects": [
          {
            "x": 0,
            "y": 0,
            "width": 100,
            "height": 30
          },
          {
            "x": 150,
            "y": 100,
            "width": 200,
            "height": 30
          }
        ]
      },
      {
        "rects": [
          {
            "x": 0,
            "y": 0,
            "width": 110,
            "height": 20
          },
          {
            "x": 150,
            "y": 100,
            "width": 110,
            "height": 20
          }
        ]
      },
      {
        "rects": [
          {
            "x": 0,
            "y": 20,
            "width": 85,
            "height": 0
          },
          {
            "x": 150,
            "y": 120,
            "width": 200,
            "height": 0
          }
        ]
      }
    ]
  }
}
