        {
          "x": 10,
          "y": 20,
          "width": 50,
          "height": 100
        },
        {
          "x": 200,
          "y": 150,
          "width": 50,
          "height": 160
        },
        {
          "x": 400,
          "y": 300,
          "width": 50,
          "height": 120
        }
      ]
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "writingMode": "vertical-rl",
          "width": 1,
          "position": "relative"
        }
      },
      {
        "parent": 0,
        "style": {
          "writingMode": "vertical-rl",
          "width": 90
        }
      },
      {
        "parent": 0,
        "style": {
          "writingMode": "vertical-rl",
          "position": "absolute",
          "insetRight": 60,
          "insetTop": 4,
          "width": 10,
          "height": 10
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "rects": [
          {
            "x": 59,
            "y": 20,
            "width": 1,
            "height": 100
          },
          {
            "x": 250,
            "y": 150,
            "width": 0,
            "height": 160
          }
        ]
      },
      {
        "rects": [
          {
            "x": 10,
            "y": 20,
            "width": 50,
            "height": 100
          },
          {
            "x": 210,
            "y": 150,
            "width": 40,
            "height": 160
          }
        ]
      },
      {
        "rects": [
          {
            "x": 230,
            "y": 154,
            "width": 10,
            "height": 10
          }
        ]
      }
    ]
  }
}
