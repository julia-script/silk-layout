{
  "name": "fragment-position-genuine-overflow-vertical-rl",
  "kind": "spec",
  "features": [
    "fragmentation",
    "position",
    "writing-modes"
  ],
  "spec": [
    "https://drafts.csswg.org/css-position-3/#abspos-breaking",
    "https://drafts.csswg.org/css-break-3/#varying-size-boxes",
    "https://drafts.csswg.org/css-break-3/#transforms",
    "https://drafts.csswg.org/css-break-3/#parallel-flows",
    "https://drafts.csswg.org/cssom-view/#dom-element-getclientrects"
  ],
  "input": {
    "viewport": {
      "width": 400,
      "height": 400
    },
    "fragmentation": {
