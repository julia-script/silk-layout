{
  "name": "fragment-position-interrupted-relative-basis",
  "kind": "spec",
  "features": [
    "fragmentation",
    "position",
    "inline-fragments"
  ],
  "spec": [
    "https://drafts.csswg.org/css-position-3/#relative-position",
    "https://drafts.csswg.org/css-break-3/#varying-size-boxes"
  ],
  "input": {
    "viewport": {
      "width": 300,
      "height": 200
    },
    "fragmentation": {
      "kind": "page",
      "frames": [
        {
          "x": 0,
          "y": 0,
          "width": 100,
          "height": 50
        },
        {
          "x": 150,
          "y": 100,
          "width": 100,
          "height": 80
        }
      ]
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "height": {
            "percent": 2
          }
        }
      },
      {
        "parent": 0,
        "style": {
          "display": "inline",
          "position": "relative",
          "insetTop": {
            "percent": 0.5
          }
        }
      },
      {
        "parent": 1,
        "style": {
          "width": 20,
          "height": 100
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "rects": [
          {
            "x": 0,
            "y": 0,
            "width": 100,
            "height": 50
          },
          {
            "x": 150,
            "y": 100,
            "width": 100,
            "height": 80
          }
        ]
      },
      {
        "rects": [
          {
            "x": 0,
            "y": 50,
            "width": 0,
            "height": 0
          },
          {
            "x": 0,
            "y": 50,
            "width": 100,
            "height": 50
          },
          {
            "x": 150,
            "y": 180,
            "width": 100,
            "height": 50
          },
          {
            "x": 150,
            "y": 230,
            "width": 0,
            "height": 0
          }
        ]
      },
      {
        "rects": [
          {
            "x": 0,
            "y": 50,
            "width": 20,
            "height": 50
          },
          {
            "x": 150,
            "y": 180,
            "width": 20,
            "height": 50
          }
        ]
      }
    ]
  }
}
