{
  "name": "fragment-relative-overflow-horizontal",
  "kind": "spec",
  "features": [
    "fragmentation",
    "position",
    "scrollbars",
    "overflow"
  ],
  "spec": [
    "https://drafts.csswg.org/css-overflow-3/#scrollable",
    "https://drafts.csswg.org/css2/#blockwidth",
    "https://drafts.csswg.org/css-break-3/#transforms"
  ],
  "input": {
    "viewport": {
      "width": 200,
      "height": 200
    },
    "fragmentation": {
      "kind": "column",
      "frames": [
        {
          "x": 0,
          "y": 0,
          "width": 200,
          "height": 200
        }
      ]
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 80,
          "height": 80,
          "overflowX": "auto",
          "overflowY": "auto"
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 1,
          "height": 70
        }
      },
      {
        "parent": 0,
        "style": {
          "position": "relative",
          "width": 20,
          "height": 10,
          "insetLeft": {
            "percent": 0.1
          },
          "insetTop": {
            "percent": 0.1
          }
        }
      }
    ],
    "scrollbars": {
      "auto": {
        "horizontal": 10,
        "vertical": 10,
        "overlay": false,
        "horizontalOnTop": false,
        "verticalOnLeft": false
      },
      "thin": {
        "horizontal": 5,
        "vertical": 5,
        "overlay": false,
        "horizontalOnTop": false,
        "verticalOnLeft": false
      }
    }
  },
  "expected": {
    "sources": [
      {
        "rects": [
          {
            "x": 0,
            "y": 0,
            "width": 80,
            "height": 80
          }
        ],
        "contentWidth": 70,
        "contentHeight": 80,
        "horizontalScrollbar": false,
        "verticalScrollbar": true,
        "scrollbarGutterRight": 10,
        "scrollbarGutterBottom": 0,
        "scrollableOverflowWidth": 70,
        "scrollableOverflowHeight": 88
      },
      {
        "rects": [
          {
            "x": 0,
            "y": 0,
            "width": 1,
            "height": 70
          }
        ]
      },
      {
        "rects": [
          {
            "x": 7,
            "y": 78,
            "width": 20,
            "height": 10
          }
        ]
      }
    ]
  }
}
