{
  "name": "fragmentation-blockified-flex-positioned",
  "kind": "spec",
  "features": [
    "fragmentation",
    "flex",
    "display",
    "position"
  ],
  "spec": [
    "https://drafts.csswg.org/css-flexbox-1/#flex-items",
    "https://drafts.csswg.org/css-break-3/#parallel-flows",
    "https://drafts.csswg.org/css-break-3/#transforms"
  ],
  "input": {
    "viewport": {
      "width": 200,
      "height": 100
    },
    "fragmentation": {
      "kind": "column",
      "frames": [
        {
          "x": 0,
          "y": 0,
          "width": 100,
          "height": 50
        },
        {
          "x": 100,
          "y": 0,
          "width": 100,
          "height": 50
        }
      ]
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "flex",
          "height": 80,
          "alignItems": "flex-start"
        }
      },
      {
        "parent": 0,
        "style": {
          "display": "inline-flex",
          "position": "relative",
          "height": 80,
          "width": 50
        }
      },
      {
        "parent": 1,
        "style": {
          "position": "absolute",
          "width": 10,
          "height": 70,
          "insetLeft": 0,
          "insetTop": 0
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "rects": [
          {
            "x": 0,
            "y": 0,
            "width": 100,
            "height": 50
          },
          {
            "x": 100,
            "y": 0,
            "width": 100,
            "height": 30
          }
        ]
      },
      {
        "rects": [
          {
            "x": 0,
            "y": 0,
            "width": 50,
            "height": 50
          },
          {
            "x": 100,
            "y": 0,
            "width": 50,
            "height": 30
          }
        ]
      },
      {
        "rects": [
          {
            "x": 0,
            "y": 0,
            "width": 10,
            "height": 50
          },
          {
            "x": 100,
            "y": 0,
            "width": 10,
            "height": 20
          }
        ]
      }
    ]
  }
}
