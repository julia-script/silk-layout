{
  "name": "grid-absolute-area-sideways-lr-rtl",
  "kind": "spec",
  "features": [
    "grid",
    "position"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#abspos-items",
    "https://drafts.csswg.org/css-grid-2/#static-position",
    "https://drafts.csswg.org/css-position-3/#static-position-rect"
  ],
  "derivation": "Content bounds are (10,30), 130x140. Column 2 is logical [50,110], row 2 [50,100]. Project those intervals through the authored writing mode and direction; zero insets fill the resulting area.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "position": "relative",
          "boxSizing": "border-box",
          "width": 160,
          "height": 180,
          "paddingLeft": 10,
          "paddingRight": 20,
          "paddingTop": 30,
          "paddingBottom": 10,
          "gridTemplateColumns": [
            40,
            60
          ],
          "gridTemplateRows": [
            30,
            50
          ],
          "columnGap": 10,
          "rowGap": 20,
          "writingMode": "sideways-lr",
          "direction": "rtl"
        }
      },
      {
        "parent": 0,
        "style": {
          "position": "absolute",
          "inset": {
            "left": 0,
            "right": 0,
            "top": 0,
            "bottom": 0
          },
          "gridColumnStart": 2,
          "gridColumnEnd": 3,
          "gridRowStart": 2,
          "gridRowEnd": 3
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 160,
        "height": 180
      },
      {
        "x": 60,
        "y": 80,
        "width": 50,
        "height": 60
      }
    ]
  }
}
