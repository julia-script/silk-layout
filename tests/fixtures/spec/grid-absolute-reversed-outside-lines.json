{
  "name": "grid-absolute-reversed-outside-lines",
  "kind": "spec",
  "features": [
    "grid",
    "position"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#abspos-items",
    "https://drafts.csswg.org/css-grid-2/#grid-placement-errors",
    "https://drafts.csswg.org/css-grid-2/#grid-align"
  ],
  "derivation": "Grid \u00a78.3.1 swaps logical98 and1 first; \u00a710.1 then makes the absent end auto. The surviving start is10+20+5=35 and the padding end is120, leaving85px.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "position": "relative",
          "boxSizing": "border-box",
          "width": 120,
          "height": 100,
          "paddingLeft": 10,
          "paddingRight": 10,
          "paddingTop": 10,
          "paddingBottom": 10,
          "columnGap": 5,
          "rowGap": 5,
          "gridTemplateColumns": [
            20,
            30,
            40
          ],
          "gridTemplateRows": [
            20
          ]
        }
      },
      {
        "parent": 0,
        "style": {
          "position": "absolute",
          "inset": {
            "left": 0,
            "right": 0,
            "top": 0,
            "bottom": 0
          },
          "gridColumnStart": 99,
          "gridColumnEnd": 2
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 120,
        "height": 100
      },
      {
        "x": 35,
        "y": 0,
        "width": 85,
        "height": 100
      }
    ]
  }
}
