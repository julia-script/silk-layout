{
  "name": "grid-align-end-horizontal-tb-rtl",
  "kind": "spec",
  "features": [
    "grid",
    "alignment"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#row-align",
    "https://drafts.csswg.org/css-grid-2/#column-align",
    "https://drafts.csswg.org/css-align-3/#positional-values"
  ],
  "derivation": "Logical area 100x90 minus item 20x30 gives end shifts 80 and 60. Inline RTL reverses placement; writing-mode maps logical coordinates to physical axes, including sideways-lr bottom-to-top line progression.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 100,
          "height": 90,
          "writingMode": "horizontal-tb",
          "direction": "rtl",
          "gridTemplateColumns": [
            100
          ],
          "gridTemplateRows": [
            90
          ]
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 20,
          "height": 30,
          "justifySelf": "end",
          "alignSelf": "end"
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 100,
        "height": 90
      },
      {
        "x": 0,
        "y": 60,
        "width": 20,
        "height": 30
      }
    ]
  }
}
