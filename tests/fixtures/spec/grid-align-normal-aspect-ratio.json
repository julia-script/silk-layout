{
  "name": "grid-align-normal-aspect-ratio",
  "kind": "spec",
  "features": [
    "grid",
    "alignment"
  ],
  "spec": [
    "https://drafts.csswg.org/css-align-3/#justify-grid",
    "https://drafts.csswg.org/css-grid-2/#grid-item-sizing"
  ],
  "derivation": "Normal self-alignment behaves as start rather than stretch for a preferred aspect ratio. A 20px definite height and 2:1 ratio produce a 40px width, leaving the rest of the 100x90 area unused.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 100,
          "height": 90,
          "gridTemplateColumns": [
            100
          ],
          "gridTemplateRows": [
            90
          ]
        }
      },
      {
        "parent": 0,
        "style": {
          "height": 20,
          "aspectRatio": 2
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 100,
        "height": 90
      },
      {
        "x": 0,
        "y": 0,
        "width": 40,
        "height": 20
      }
    ]
  }
}
