{
  "name": "grid-align-space-evenly-single",
  "kind": "spec",
  "features": [
    "grid",
    "alignment"
  ],
  "spec": [
    "https://drafts.csswg.org/css-align-3/#distribution-values"
  ],
  "derivation": "One 40px track in 100px has 60px free. Between falls back to safe start; around and evenly center at 30px.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 100,
          "height": 100,
          "gridTemplateColumns": [
            40
          ],
          "gridTemplateRows": [
            40
          ],
          "justifyContent": "space-evenly",
          "alignContent": "space-evenly"
        }
      },
      {
        "parent": 0,
        "style": {}
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 100,
        "height": 100
      },
      {
        "x": 30,
        "y": 30,
        "width": 40,
        "height": 40
      }
    ]
  }
}
