{
  "name": "grid-baseline-auto-margin-exclusion",
  "kind": "spec",
  "features": [
    "grid",
    "baseline"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#grid-baselines",
    "https://drafts.csswg.org/css-grid-2/#algo-baseline-shims",
    "https://drafts.csswg.org/css-align-3/#align-by-baseline"
  ],
  "derivation": "Auto block-start margin excludes the first item from sharing and absorbs 40px. The second baseline group starts at zero.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 80,
          "gridTemplateColumns": [
            40,
            40
          ],
          "gridTemplateRows": [
            50
          ],
          "alignItems": "baseline"
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 20,
          "height": 10,
          "marginTop": "auto"
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 20,
          "height": 30
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 80,
        "height": 50
      },
      {
        "x": 0,
        "y": 40,
        "width": 20,
        "height": 10
      },
      {
        "x": 40,
        "y": 0,
        "width": 20,
        "height": 30
      }
    ]
  }
}
