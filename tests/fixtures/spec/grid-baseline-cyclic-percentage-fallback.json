{
  "name": "grid-baseline-cyclic-percentage-fallback",
  "kind": "spec",
  "features": [
    "grid",
    "baseline",
    "writing-mode"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#row-align",
    "https://drafts.csswg.org/css-align-3/#baseline-terms"
  ],
  "derivation": "A percentage block size depends on the auto row and is permanently excluded from baseline sharing. The fixed-height sibling establishes a 30px row. The percentage resolves to 15px but remains safe-start aligned at zero rather than joining the bottom baseline at 30.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 80,
          "gridTemplateColumns": [
            40,
            40
          ],
          "gridTemplateRows": [
            "auto"
          ],
          "alignItems": "baseline"
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 20,
          "height": {
            "percent": 0.5
          }
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 20,
          "height": 30
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "height": 30
      },
      {
        "x": 0,
        "y": 0,
        "height": 15
      },
      {
        "x": 40,
        "y": 0,
        "height": 30
      }
    ]
  }
}
