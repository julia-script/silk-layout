{
  "name": "grid-baseline-export-grid-order",
  "kind": "spec",
  "features": [
    "grid",
    "baseline",
    "intrinsic-measure"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#grid-baselines"
  ],
  "derivation": "The first non-empty row is row two. In that row column one precedes column two despite source order. Existing tables export first=4 from column one, last=15 from column two, each translated by the 10px empty first row.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 80,
          "gridTemplateColumns": [
            40,
            40
          ],
          "gridTemplateRows": [
            10,
            30
          ],
          "alignItems": "start"
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 20,
          "height": 20,
          "gridRowStart": 2,
          "gridColumnStart": 2
        },
        "measure": {
          "minWidth": 20,
          "maxWidth": 20,
          "height": 20,
          "firstBaseline": 8,
          "lastBaseline": 15
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 20,
          "height": 20,
          "gridRowStart": 2,
          "gridColumnStart": 1
        },
        "measure": {
          "minWidth": 20,
          "maxWidth": 20,
          "height": 20,
          "firstBaseline": 4,
          "lastBaseline": 12
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "firstBaseline": 14,
        "lastBaseline": 25,
        "hasFirstBaseline": true,
        "hasLastBaseline": true
      },
      {
        "x": 40,
        "y": 10
      },
      {
        "x": 0,
        "y": 10
      }
    ]
  }
}
