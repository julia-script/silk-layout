{
  "name": "grid-baseline-export-spanning-priorities",
  "kind": "spec",
  "features": [
    "grid",
    "baseline",
    "intrinsic-measure"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#grid-baselines"
  ],
  "derivation": "The last-baseline spanning item ends in row three, so first-row export excludes it from last sharing priority. First table is the nonsharing first-row item at 4. Last export uses the row-three sharing group baseline at 60.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 80,
          "gridTemplateColumns": [
            40,
            40
          ],
          "gridTemplateRows": [
            20,
            20,
            20
          ],
          "alignItems": "start"
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 20,
          "height": 20,
          "gridRowStart": 1,
          "gridRowEnd": 4,
          "gridColumnStart": 1,
          "alignSelf": "last baseline"
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 20,
          "height": 10,
          "gridRowStart": 1,
          "gridColumnStart": 2
        },
        "measure": {
          "minWidth": 20,
          "maxWidth": 20,
          "height": 10,
          "firstBaseline": 4,
          "lastBaseline": 7
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "firstBaseline": 4,
        "lastBaseline": 60,
        "hasFirstBaseline": true,
        "hasLastBaseline": true
      },
      {
        "x": 0,
        "y": 40
      },
      {
        "x": 40,
        "y": 0
      }
    ]
  }
}
