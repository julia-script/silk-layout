{
  "name": "grid-baseline-first-intrinsic-shim",
  "kind": "spec",
  "features": [
    "grid",
    "baseline"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#grid-baselines",
    "https://drafts.csswg.org/css-grid-2/#algo-baseline-shims",
    "https://drafts.csswg.org/css-align-3/#align-by-baseline"
  ],
  "derivation": "Border-edge synthesized alphabetic baselines are 10 and 30. The first item receives a 20px intrinsic shim; row height is 30 and both bottom baselines are at 30.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 80,
          "gridTemplateColumns": [
            40,
            40
          ],
          "gridTemplateRows": [
            "auto"
          ],
          "alignItems": "baseline"
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 20,
          "height": 10
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 20,
          "height": 30
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 80,
        "height": 30
      },
      {
        "x": 0,
        "y": 20,
        "width": 20,
        "height": 10
      },
      {
        "x": 40,
        "y": 0,
        "width": 20,
        "height": 30
      }
    ]
  }
}
