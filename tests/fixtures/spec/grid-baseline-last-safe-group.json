{
  "name": "grid-baseline-last-safe-group",
  "kind": "spec",
  "features": [
    "grid",
    "baseline"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#grid-baselines",
    "https://drafts.csswg.org/css-grid-2/#algo-baseline-shims",
    "https://drafts.csswg.org/css-align-3/#align-by-baseline"
  ],
  "derivation": "Synthesized last baselines lie on border bottoms. A 30px group overflows its 20px row; safe fallback starts the entire group at zero, preserving the shared baseline at 30.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 80,
          "gridTemplateColumns": [
            40,
            40
          ],
          "gridTemplateRows": [
            20
          ],
          "alignItems": "last baseline"
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 20,
          "height": 30
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 20,
          "height": 10
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 80,
        "height": 20
      },
      {
        "x": 0,
        "y": 0,
        "width": 20,
        "height": 30
      },
      {
        "x": 40,
        "y": 20,
        "width": 20,
        "height": 10
      }
    ]
  }
}
