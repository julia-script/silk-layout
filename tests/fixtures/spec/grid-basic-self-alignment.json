{
  "name": "grid-basic-self-alignment",
  "kind": "spec",
  "features": [
    "grid",
    "explicit-tracks"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#row-align",
    "https://drafts.csswg.org/css-grid-2/#column-align"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 210,
          "gridTemplateColumns": [
            100,
            100
          ],
          "gridTemplateRows": [
            60,
            60
          ],
          "columnGap": 10,
          "rowGap": 10
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 1,
          "gridRowStart": 1,
          "width": 20,
          "height": 10,
          "justifySelf": "start",
          "alignSelf": "start"
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 2,
          "gridRowStart": 1,
          "width": 20,
          "height": 10,
          "justifySelf": "end",
          "alignSelf": "end"
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 1,
          "gridRowStart": 2,
          "width": 20,
          "height": 10,
          "justifySelf": "center",
          "alignSelf": "center"
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 2,
          "gridRowStart": 2
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 210,
        "height": 130
      },
      {
        "x": 0,
        "y": 0,
        "width": 20,
        "height": 10
      },
      {
        "x": 190,
        "y": 50,
        "width": 20,
        "height": 10
      },
      {
        "x": 40,
        "y": 95,
        "width": 20,
        "height": 10
      },
      {
        "x": 110,
        "y": 70,
        "width": 100,
        "height": 60
      }
    ]
  }
}
