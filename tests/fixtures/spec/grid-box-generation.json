{
  "name": "grid-box-generation",
  "kind": "spec",
  "features": [
    "grid",
    "box-generation"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#grid-containers",
    "https://drafts.csswg.org/css-grid-2/#grid-item-display"
  ],
  "derivation": "With no explicit tracks, each grid has one implicit column. The inner inline grid is blockified without changing its grid inner display: its two rows total 6 + 8 = 14px. The outer rows total 14 + 5 = 19px.",
  "input": {
    "viewport": {
      "width": 200,
      "height": 150
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "block grid",
          "width": 80
        }
      },
      {
        "parent": 0,
        "style": {
          "display": "inline grid",
          "width": 30
        }
      },
      {
        "parent": 1,
        "style": {
          "width": 20,
          "height": 6
        }
      },
      {
        "parent": 1,
        "style": {
          "width": 25,
          "height": 8
        }
      },
      {
        "parent": 0,
        "style": {
          "display": "flow-root",
          "width": 40,
          "height": 5
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 80,
        "height": 19
      },
      {
        "x": 0,
        "y": 0,
        "width": 30,
        "height": 14
      },
      {
        "x": 0,
        "y": 0,
        "width": 20,
        "height": 6
      },
      {
        "x": 0,
        "y": 6,
        "width": 25,
        "height": 8
      },
      {
        "x": 0,
        "y": 14,
        "width": 40,
        "height": 5
      }
    ]
  }
}
