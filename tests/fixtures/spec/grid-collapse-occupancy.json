{
  "name": "grid-collapse-occupancy",
  "kind": "spec",
  "features": [
    "grid",
    "visibility-collapse"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#grid-items",
    "https://www.w3.org/TR/2011/REC-CSS2-20110607/visufx.html#visibility"
  ],
  "derivation": "Unlike flex collapse struts, visibility:collapse on a grid item behaves as hidden: its 13px row remains occupied. The following 9px item begins at y=13; total height is 22px.",
  "input": {
    "viewport": {
      "width": 200,
      "height": 150
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 100
        }
      },
      {
        "parent": 0,
        "style": {
          "visibility": "collapse",
          "width": 20,
          "height": 13
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 30,
          "height": 9
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 100,
        "height": 22
      },
      {
        "x": 0,
        "y": 0,
        "width": 20,
        "height": 13
      },
      {
        "x": 0,
        "y": 13,
        "width": 30,
        "height": 9
      }
    ]
  }
}
