{
  "name": "grid-contents-none-items",
  "kind": "spec",
  "features": [
    "grid",
    "display-contents",
    "display-none",
    "box-generation"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#grid-items",
    "https://drafts.csswg.org/css-display-3/#box-generation"
  ],
  "derivation": "The boxless contents parent contributes its two children in sibling order; its padding creates no box. The none subtree contributes no items. The three implicit rows have heights 8, 12 and 5, totaling 25px.",
  "input": {
    "viewport": {
      "width": 200,
      "height": 150
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 100
        }
      },
      {
        "parent": 0,
        "style": {
          "display": "contents",
          "padding": 30
        }
      },
      {
        "parent": 1,
        "style": {
          "width": 20,
          "height": 8
        }
      },
      {
        "parent": 0,
        "style": {
          "display": "none",
          "height": 90
        }
      },
      {
        "parent": 3,
        "style": {
          "width": 50,
          "height": 50
        }
      },
      {
        "parent": 1,
        "style": {
          "width": 30,
          "height": 12
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 40,
          "height": 5
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 100,
        "height": 25
      },
      {
        "width": 0,
        "height": 0
      },
      {
        "x": 0,
        "y": 0,
        "width": 20,
        "height": 8
      },
      {
        "width": 0,
        "height": 0
      },
      {
        "width": 0,
        "height": 0
      },
      {
        "x": 0,
        "y": 8,
        "width": 30,
        "height": 12
      },
      {
        "x": 0,
        "y": 20,
        "width": 40,
        "height": 5
      }
    ]
  }
}
