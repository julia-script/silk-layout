{
  "name": "grid-fixed-explicit-lines",
  "kind": "spec",
  "features": [
    "grid",
    "explicit-tracks"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#track-sizing",
    "https://drafts.csswg.org/css-grid-2/#line-placement",
    "https://drafts.csswg.org/css-grid-2/#gutters",
    "https://drafts.csswg.org/css-grid-2/#grid-item-sizing"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 200,
          "gridTemplateColumns": [
            80,
            100
          ],
          "gridTemplateRows": [
            30,
            50
          ],
          "columnGap": 10,
          "rowGap": 5
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 2,
          "gridRowStart": 1
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 1,
          "gridRowStart": 2
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 1,
          "gridRowStart": 1,
          "gridColumnEnd": 3,
          "gridRowEnd": 3
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 200,
        "height": 85
      },
      {
        "x": 90,
        "y": 0,
        "width": 100,
        "height": 30
      },
      {
        "x": 0,
        "y": 35,
        "width": 80,
        "height": 50
      },
      {
        "x": 0,
        "y": 0,
        "width": 190,
        "height": 85
      }
    ]
  }
}
