{
  "name": "grid-float-nonfloating",
  "kind": "spec",
  "features": [
    "grid",
    "float",
    "box-generation"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#grid-containers"
  ],
  "derivation": "Float and clear do not apply to grid items. The right-floated item remains at the inline-start edge of row one rather than x=80; row two starts at y=8 and the container height is 15px.",
  "input": {
    "viewport": {
      "width": 200,
      "height": 150
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 100
        }
      },
      {
        "parent": 0,
        "style": {
          "float": "right",
          "width": 20,
          "height": 8
        }
      },
      {
        "parent": 0,
        "style": {
          "clear": "both",
          "width": 30,
          "height": 7
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 100,
        "height": 15
      },
      {
        "x": 0,
        "y": 0,
        "width": 20,
        "height": 8
      },
      {
        "x": 0,
        "y": 8,
        "width": 30,
        "height": 7
      }
    ]
  }
}
