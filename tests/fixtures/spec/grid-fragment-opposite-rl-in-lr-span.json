{
  "name": "grid-fragment-opposite-rl-in-lr-span",
  "kind": "spec",
  "features": ["grid", "fragmentation", "writing-modes", "spanning-items", "forced-breaks"],
  "spec": ["https://drafts.csswg.org/css-grid-2/#pagination", "https://drafts.csswg.org/css-writing-modes-4/#logical-to-physical", "https://drafts.csswg.org/css-break-3/#box-splitting"],
  "derivation": "Pinned Grid section 13 is normative; 13.1 is only a nonnormative sample. A vertical-rl grid in vertical-lr frames consumes logical row 2 (31px) before logical row 1 (29px). The spanning allocation is 29+31=60px. Its frame-parallel child consumes 31px then 29px, exactly once per frame, even though the logical start row is visited last. Row 1's break-before applies at the second traversal boundary, not the outer grid start. Frame origins are x10/y20 and x100/y120; positive frame block flow means both row and spanning fragments start at those x coordinates. Columns remain physical y offsets 0 and 41, unaffected by reversal.",
  "input": {
    "viewport": {"width": 150, "height": 250},
    "fragmentation": {"kind": "page", "writingMode": "vertical-lr", "frames": [{"x": 10, "y": 20, "width": 31, "height": 123}, {"x": 100, "y": 120, "width": 29, "height": 123}]},
    "nodes": [
      {"parent": null, "style": {"display": "grid", "writingMode": "vertical-rl", "gridTemplateColumns": [41, 82], "gridTemplateRows": [29, 31]}},
      {"parent": 0, "style": {"writingMode": "vertical-lr", "gridColumnStart": 1, "gridRowStart": 1, "gridRowEnd": 3}},
      {"parent": 1, "style": {"writingMode": "vertical-lr", "width": 60}},
      {"parent": 0, "style": {"writingMode": "vertical-lr", "gridColumnStart": 2, "gridRowStart": 1, "breakBefore": "page"}},
      {"parent": 0, "style": {"writingMode": "vertical-lr", "gridColumnStart": 2, "gridRowStart": 2}}
    ]
  },
  "expected": {"sources": [
    {"rects": [{"x": 10, "y": 20, "width": 31, "height": 123}, {"x": 100, "y": 120, "width": 29, "height": 123}]},
    {"rects": [{"x": 10, "y": 20, "width": 31, "height": 41}, {"x": 100, "y": 120, "width": 29, "height": 41}]},
    {"rects": [{"x": 10, "y": 20, "width": 31, "height": 41}, {"x": 100, "y": 120, "width": 29, "height": 41}]},
    {"rects": [{"x": 100, "y": 161, "width": 29, "height": 82}]},
    {"rects": [{"x": 10, "y": 61, "width": 31, "height": 82}]}
  ]}
}
