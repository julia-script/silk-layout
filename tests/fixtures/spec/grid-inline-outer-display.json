{
  "name": "grid-inline-outer-display",
  "kind": "spec",
  "features": [
    "grid",
    "inline-grid",
    "box-generation"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#grid-containers"
  ],
  "derivation": "The inline grid is one atomic 40px-wide inline box, with two implicit rows totaling 18px. A top-aligned 7px atomic sibling fits beside it at x=40; the line height is 18px.",
  "input": {
    "viewport": {
      "width": 200,
      "height": 150
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "flow-root",
          "width": 100
        }
      },
      {
        "parent": 0,
        "style": {
          "display": "inline-grid",
          "width": 40,
          "verticalAlign": "top"
        }
      },
      {
        "parent": 1,
        "style": {
          "width": 20,
          "height": 8
        }
      },
      {
        "parent": 1,
        "style": {
          "width": 30,
          "height": 10
        }
      },
      {
        "parent": 0,
        "style": {
          "display": "inline-block",
          "width": 7,
          "height": 5,
          "verticalAlign": "top"
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 100,
        "height": 18
      },
      {
        "x": 0,
        "y": 0,
        "width": 40,
        "height": 18
      },
      {
        "x": 0,
        "y": 0,
        "width": 20,
        "height": 8
      },
      {
        "x": 0,
        "y": 8,
        "width": 30,
        "height": 10
      },
      {
        "x": 40,
        "y": 0,
        "width": 7,
        "height": 5
      }
    ]
  }
}
