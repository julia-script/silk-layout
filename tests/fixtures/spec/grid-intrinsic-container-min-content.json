{
  "name": "grid-intrinsic-container-min-content",
  "kind": "spec",
  "features": [
    "grid",
    "intrinsic-tracks"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#intrinsic-sizes",
    "https://drafts.csswg.org/css-grid-2/#algo-grow-tracks"
  ],
  "derivation": "Container intrinsic size is the sum of tracks and the 10px gutter. Under min-content no maximization occurs; under max-content both finite growth limits are reached.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "gridTemplateRows": [
            20
          ],
          "width": "min-content",
          "columnGap": 10,
          "gridTemplateColumns": [
            {
              "minmax": [
                10,
                40
              ]
            },
            {
              "minmax": [
                20,
                100
              ]
            }
          ]
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 1,
          "gridRowStart": 1
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 2,
          "gridRowStart": 1
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "width": 40,
        "height": 20
      },
      {
        "x": 0,
        "y": 0,
        "width": 10,
        "height": 20
      },
      {
        "x": 20,
        "y": 0,
        "width": 20,
        "height": 20
      }
    ]
  }
}
