{
  "name": "grid-intrinsic-cross-axis-ratio-repeat",
  "kind": "spec",
  "features": [
    "grid",
    "intrinsic-tracks"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#algo-grid-sizing",
    "https://drafts.csswg.org/css-grid-2/#min-size-auto",
    "https://drafts.csswg.org/css-grid-2/#intrinsic-sizes"
  ],
  "derivation": "Initially the auto row is indefinite. Its content minimum makes it 40px; the item percentage height then resolves to 40px and its 2:1 ratio changes the inline contribution to 80px. The single column adjustment uses that contribution.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": "max-content",
          "gridTemplateColumns": [
            "auto"
          ],
          "gridTemplateRows": [
            "auto"
          ]
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 1,
          "gridRowStart": 1,
          "aspectRatio": 2,
          "height": {
            "percent": 1
          }
        }
      },
      {
        "parent": 1,
        "style": {
          "width": 10,
          "height": 40
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "width": 80,
        "height": 40
      },
      {
        "x": 0,
        "y": 0,
        "width": 80,
        "height": 40
      },
      {
        "x": 0,
        "y": 0,
        "width": 10,
        "height": 40
      }
    ]
  }
}
