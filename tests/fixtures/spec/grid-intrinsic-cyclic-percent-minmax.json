{
  "name": "grid-intrinsic-cyclic-percent-minmax",
  "kind": "spec",
  "features": [
    "grid",
    "intrinsic-tracks"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#track-sizing",
    "https://drafts.csswg.org/css-grid-2/#algo-grow-tracks"
  ],
  "derivation": "The indefinite minmax percentages act as auto, giving 30px plus the fixed 10px row. Against the resulting 40px height, the first track has 8px base and 20px limit; maximization stops at 20px.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 100,
          "gridTemplateColumns": [
            100
          ],
          "gridTemplateRows": [
            {
              "minmax": [
                {
                  "percent": 0.2
                },
                {
                  "percent": 0.5
                }
              ]
            },
            10
          ]
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 1,
          "gridRowStart": 1,
          "height": 30
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 1,
          "gridRowStart": 2
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "width": 100,
        "height": 40
      },
      {
        "x": 0,
        "y": 0,
        "width": 100,
        "height": 30
      },
      {
        "x": 0,
        "y": 20,
        "width": 100,
        "height": 10
      }
    ]
  }
}
