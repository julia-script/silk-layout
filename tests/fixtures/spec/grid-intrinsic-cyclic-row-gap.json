{
  "name": "grid-intrinsic-cyclic-row-gap",
  "kind": "spec",
  "features": [
    "grid",
    "intrinsic-tracks"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#gutters",
    "https://drafts.csswg.org/css-grid-2/#intrinsic-sizes"
  ],
  "derivation": "The cyclic percentage gap contributes zero to the 50px automatic height, then resolves to 25px. The second row starts at 45px and overflows the unchanged 50px container.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 100,
          "gridTemplateColumns": [
            100
          ],
          "gridTemplateRows": [
            20,
            30
          ],
          "rowGap": {
            "percent": 0.5
          }
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 1,
          "gridRowStart": 1
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 1,
          "gridRowStart": 2
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "width": 100,
        "height": 50
      },
      {
        "x": 0,
        "y": 0,
        "width": 100,
        "height": 20
      },
      {
        "x": 0,
        "y": 45,
        "width": 100,
        "height": 30
      }
    ]
  }
}
