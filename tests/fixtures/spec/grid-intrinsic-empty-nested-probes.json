{
  "name": "grid-intrinsic-empty-nested-probes",
  "kind": "spec",
  "features": [
    "grid",
    "intrinsic-tracks"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#intrinsic-sizes",
    "https://drafts.csswg.org/css-grid-2/#algo-content",
    "https://drafts.csswg.org/css-grid-2/#algo-grow-tracks"
  ],
  "derivation": "The inner empty grid has min-content 10px and max-content 100px. The parent auto column probes both constraints and must retain the 100px maximum, not reuse the earlier 10px minimum.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": "max-content",
          "gridTemplateColumns": [
            "auto"
          ],
          "gridTemplateRows": [
            20
          ]
        }
      },
      {
        "parent": 0,
        "style": {
          "display": "grid",
          "gridColumnStart": 1,
          "gridRowStart": 1,
          "gridTemplateColumns": [
            {
              "minmax": [
                10,
                100
              ]
            }
          ],
          "gridTemplateRows": [
            20
          ]
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "width": 100,
        "height": 20
      },
      {
        "x": 0,
        "y": 0,
        "width": 100,
        "height": 20
      }
    ]
  }
}
