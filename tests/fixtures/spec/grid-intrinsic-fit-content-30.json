{
  "name": "grid-intrinsic-fit-content-30",
  "kind": "spec",
  "features": [
    "grid",
    "intrinsic-tracks"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#funcdef-grid-template-columns-fit-content",
    "https://drafts.csswg.org/css-grid-2/#algo-content"
  ],
  "derivation": "The content minimum is 20px and maximum is 45px. fit-content(30px) caps growth but cannot reduce the 20px automatic minimum.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "gridTemplateRows": [
            20
          ],
          "width": 200,
          "gridTemplateColumns": [
            {
              "fitContent": 30
            }
          ],
          "fontKey": 1
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 1,
          "fontKey": 1,
          "gridRowStart": 1
        }
      },
      {
        "parent": 1,
        "text": "aaaa aaaa"
      }
    ],
    "fonts": [
      {
        "fontSize": 10,
        "ascent": 8,
        "descent": 2,
        "lineGap": 0,
        "xHeight": 5,
        "capHeight": 7,
        "subscriptOffset": 2,
        "superscriptOffset": 3,
        "baselines": {
          "alphabetic": 8,
          "ideographic": 10,
          "central": 5,
          "mathematical": 5
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "width": 200,
        "height": 20
      },
      {
        "x": 0,
        "y": 0,
        "width": 30,
        "height": 20
      },
      { "height": 20 }
    ]
  }
}
