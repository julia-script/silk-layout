{
  "name": "grid-intrinsic-indefinite-fr",
  "kind": "spec",
  "features": [
    "grid",
    "intrinsic-tracks"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#intrinsic-sizes",
    "https://drafts.csswg.org/css-grid-2/#algo-flex-tracks",
    "https://drafts.csswg.org/css-grid-2/#algo-find-fr-size"
  ],
  "derivation": "Each item has 45px max-content contribution. The indefinite flex fraction is max(45/1,45/2)=45px. Tracks are 45px and 90px.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "gridTemplateRows": [
            20
          ],
          "width": "max-content",
          "gridTemplateColumns": [
            {
              "fr": 1
            },
            {
              "fr": 2
            }
          ],
          "fontKey": 1
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 1,
          "fontKey": 1,
          "gridRowStart": 1
        }
      },
      {
        "parent": 1,
        "text": "aaaa aaaa"
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 2,
          "fontKey": 1,
          "gridRowStart": 1
        }
      },
      {
        "parent": 3,
        "text": "aaaa aaaa"
      }
    ],
    "fonts": [
      {
        "fontSize": 10,
        "ascent": 8,
        "descent": 2,
        "lineGap": 0,
        "xHeight": 5,
        "capHeight": 7,
        "subscriptOffset": 2,
        "superscriptOffset": 3,
        "baselines": {
          "alphabetic": 8,
          "ideographic": 10,
          "central": 5,
          "mathematical": 5
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "width": 135,
        "height": 20
      },
      {
        "x": 0,
        "y": 0,
        "width": 45,
        "height": 20
      },
      { "height": 10 },
      {
        "x": 45,
        "y": 0,
        "width": 90,
        "height": 20
      },
      { "height": 10 }
    ]
  }
}
