{
  "name": "grid-intrinsic-nested-block-min-content",
  "kind": "spec",
  "features": [
    "grid",
    "intrinsic-tracks"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#intrinsic-sizes",
    "https://drafts.csswg.org/css-grid-2/#algo-content",
    "https://drafts.csswg.org/css-grid-2/#algo-grow-tracks"
  ],
  "derivation": "Grid intrinsic block sizes differ: the inner min-content height is 10px, although its max-content height is 100px. The outer min-content row uses the former rather than the ordinary block min/max equivalence.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 20,
          "height": "min-content",
          "gridTemplateColumns": [
            20
          ],
          "gridTemplateRows": [
            "auto"
          ]
        }
      },
      {
        "parent": 0,
        "style": {
          "display": "grid",
          "gridColumnStart": 1,
          "gridRowStart": 1,
          "gridTemplateColumns": [
            20
          ],
          "gridTemplateRows": [
            {
              "minmax": [
                10,
                100
              ]
            }
          ]
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "width": 20,
        "height": 10
      },
      {
        "x": 0,
        "y": 0,
        "width": 20,
        "height": 10
      }
    ]
  }
}
