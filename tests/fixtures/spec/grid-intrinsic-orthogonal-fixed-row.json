{
  "name": "grid-intrinsic-orthogonal-fixed-row",
  "kind": "spec",
  "features": [
    "grid",
    "intrinsic-tracks"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#algo-grid-sizing",
    "https://drafts.csswg.org/css-grid-2/#algo-content"
  ],
  "derivation": "The definite 40px row supplies the orthogonal item inline basis. Its block children resolve 50% and 75% heights to 20px and 30px. Vertical-rl block progression sums their 10px and 20px widths, so the grid column is 30px.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": "max-content",
          "gridTemplateColumns": [
            "auto"
          ],
          "gridTemplateRows": [
            40
          ]
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 1,
          "gridRowStart": 1,
          "writingMode": "vertical-rl"
        }
      },
      {
        "parent": 1,
        "style": {
          "width": 10,
          "height": {
            "percent": 0.5
          }
        }
      },
      {
        "parent": 1,
        "style": {
          "width": 20,
          "height": {
            "percent": 0.75
          }
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "width": 30,
        "height": 40
      },
      {
        "x": 0,
        "y": 0,
        "width": 30,
        "height": 40
      },
      {
        "x": 20,
        "y": 0,
        "width": 10,
        "height": 20
      },
      {
        "x": 0,
        "y": 0,
        "width": 20,
        "height": 30
      }
    ]
  }
}
