{
  "name": "grid-intrinsic-span-planned-increases",
  "kind": "spec",
  "features": [
    "grid",
    "intrinsic-tracks"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#algo-spanning-items",
    "https://drafts.csswg.org/css-grid-2/#extra-space",
    "https://drafts.csswg.org/css-grid-2/#intrinsic-sizes"
  ],
  "derivation": "The two span-2 items independently request [0,45,45] and [30,30,0]. Planned per-track maxima are [30,45,45], not sequential additions. The first area is 90px, the second 75px, and the container 120px.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": "max-content",
          "gridTemplateColumns": [
            "auto",
            "auto",
            "auto"
          ],
          "gridTemplateRows": [
            20,
            20
          ]
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 2,
          "gridColumnEnd": 4,
          "gridRowStart": 1
        }
      },
      {
        "parent": 1,
        "style": {
          "width": 90,
          "height": 10
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 1,
          "gridColumnEnd": 3,
          "gridRowStart": 2
        }
      },
      {
        "parent": 3,
        "style": {
          "width": 60,
          "height": 10
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "width": 120,
        "height": 40
      },
      {
        "x": 30,
        "y": 0,
        "width": 90,
        "height": 20
      },
      {
        "width": 90,
        "height": 10
      },
      {
        "x": 0,
        "y": 20,
        "width": 75,
        "height": 20
      },
      {
        "width": 60,
        "height": 10
      }
    ]
  }
}
