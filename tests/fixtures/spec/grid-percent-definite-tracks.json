{
  "name": "grid-percent-definite-tracks",
  "kind": "spec",
  "features": [
    "grid",
    "explicit-tracks"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#track-sizing",
    "https://drafts.csswg.org/css-grid-2/#gutters"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 200,
          "height": 100,
          "gridTemplateColumns": [
            {
              "percent": 0.25
            },
            {
              "percent": 0.5
            }
          ],
          "gridTemplateRows": [
            {
              "percent": 0.2
            },
            {
              "percent": 0.4
            }
          ],
          "columnGap": 10,
          "rowGap": 5
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 1,
          "gridRowStart": 1
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 2,
          "gridRowStart": 2
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 200,
        "height": 100
      },
      {
        "x": 0,
        "y": 0,
        "width": 50,
        "height": 20
      },
      {
        "x": 60,
        "y": 25,
        "width": 100,
        "height": 40
      }
    ]
  }
}
