{
  "name": "grid-placement-cyclic-auto-percentages",
  "kind": "spec",
  "features": [
    "grid",
    "auto-placement",
    "implicit-tracks"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#auto-placement-algo",
    "https://drafts.csswg.org/css-grid-2/#auto-tracks",
    "https://drafts.csswg.org/css-grid-2/#algo-terms"
  ],
  "derivation": "Cyclic percentages act as auto for intrinsic sizing: 20+30+10+0 yields 60 on both axes. For layout each implicit track becomes 50% of 60, or 30, without feeding its overflow back into container sizing.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": "max-content",
          "gridTemplateColumns": [
            20
          ],
          "gridTemplateRows": [
            20
          ],
          "gridAutoColumns": [
            {
              "percent": 0.5
            }
          ],
          "gridAutoRows": [
            {
              "percent": 0.5
            }
          ]
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 2,
          "gridRowStart": 2,
          "width": 30,
          "height": 30
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 3,
          "gridRowStart": 3,
          "width": 10,
          "height": 10
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 4,
          "gridRowStart": 4
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 60,
        "height": 60
      },
      {
        "x": 20,
        "y": 20,
        "width": 30,
        "height": 30
      },
      {
        "x": 50,
        "y": 50,
        "width": 10,
        "height": 10
      },
      {
        "x": 80,
        "y": 80,
        "width": 30,
        "height": 30
      }
    ]
  }
}
