{
  "name": "grid-placement-locked-before-auto",
  "kind": "spec",
  "features": [
    "grid",
    "auto-placement",
    "implicit-tracks"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#auto-placement-algo",
    "https://drafts.csswg.org/css-grid-2/#auto-tracks"
  ],
  "derivation": "Step two places row-locked items before step-four fully automatic items, regardless of document order.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 64,
          "gridTemplateColumns": [
            20,
            20,
            20
          ],
          "gridAutoRows": [
            10
          ],
          "columnGap": 2
        }
      },
      {
        "parent": 0,
        "style": {}
      },
      {
        "parent": 0,
        "style": {
          "gridRowStart": 1,
          "gridColumnEnd": {
            "span": 2
          }
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 64,
        "height": 10
      },
      {
        "x": 44,
        "y": 0,
        "width": 20,
        "height": 10
      },
      {
        "x": 0,
        "y": 0,
        "width": 42,
        "height": 10
      }
    ]
  }
}
