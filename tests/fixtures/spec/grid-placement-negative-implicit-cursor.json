{
  "name": "grid-placement-negative-implicit-cursor",
  "kind": "spec",
  "features": [
    "grid",
    "auto-placement",
    "implicit-tracks"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#auto-placement-algo",
    "https://drafts.csswg.org/css-grid-2/#auto-tracks"
  ],
  "derivation": "A definite column at -5 extends two tracks before the explicit grid. The automatic cursor starts at the start-most implicit column, not explicit line one.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": "max-content",
          "gridTemplateColumns": [
            20,
            20
          ],
          "gridAutoColumns": [
            10
          ],
          "gridAutoRows": [
            10
          ],
          "columnGap": 2
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": -5
        }
      },
      {
        "parent": 0,
        "style": {}
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 66,
        "height": 10
      },
      {
        "x": 0,
        "y": 0,
        "width": 10,
        "height": 10
      },
      {
        "x": 12,
        "y": 0,
        "width": 10,
        "height": 10
      }
    ]
  }
}
