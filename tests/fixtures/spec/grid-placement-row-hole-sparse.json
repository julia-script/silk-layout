{
  "name": "grid-placement-row-hole-sparse",
  "kind": "spec",
  "features": [
    "grid",
    "auto-placement",
    "implicit-tracks"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#auto-placement-algo",
    "https://drafts.csswg.org/css-grid-2/#auto-tracks"
  ],
  "derivation": "Two 2-column items cannot share a 3-column row. Dense resets the cursor and fills the first-row one-column hole; sparse continues on row two.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 64,
          "gridTemplateColumns": [
            20,
            20,
            20
          ],
          "gridAutoRows": [
            10
          ],
          "columnGap": 2,
          "rowGap": 1,
          "gridAutoFlow": "row"
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnEnd": {
            "span": 2
          }
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnEnd": {
            "span": 2
          }
        }
      },
      {
        "parent": 0,
        "style": {}
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 64,
        "height": 21
      },
      {
        "x": 0,
        "y": 0,
        "width": 42,
        "height": 10
      },
      {
        "x": 0,
        "y": 11,
        "width": 42,
        "height": 10
      },
      {
        "x": 44,
        "y": 11,
        "width": 20,
        "height": 10
      }
    ]
  }
}
