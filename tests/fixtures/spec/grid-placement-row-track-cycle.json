{
  "name": "grid-placement-row-track-cycle",
  "kind": "spec",
  "features": [
    "grid",
    "auto-placement",
    "implicit-tracks"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#auto-placement-algo",
    "https://drafts.csswg.org/css-grid-2/#auto-tracks"
  ],
  "derivation": "Row flow fills two columns before extending rows. The first and second implicit rows receive 15 and 25; two 3px gutters give height 66.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 100,
          "gridTemplateColumns": [
            30,
            40
          ],
          "gridTemplateRows": [
            20
          ],
          "gridAutoRows": [
            15,
            25
          ],
          "columnGap": 5,
          "rowGap": 3
        }
      },
      {
        "parent": 0,
        "style": {}
      },
      {
        "parent": 0,
        "style": {}
      },
      {
        "parent": 0,
        "style": {}
      },
      {
        "parent": 0,
        "style": {}
      },
      {
        "parent": 0,
        "style": {}
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 100,
        "height": 66
      },
      {
        "x": 0,
        "y": 0,
        "width": 30,
        "height": 20
      },
      {
        "x": 35,
        "y": 0,
        "width": 40,
        "height": 20
      },
      {
        "x": 0,
        "y": 23,
        "width": 30,
        "height": 15
      },
      {
        "x": 35,
        "y": 23,
        "width": 40,
        "height": 15
      },
      {
        "x": 0,
        "y": 41,
        "width": 30,
        "height": 25
      }
    ]
  }
}
