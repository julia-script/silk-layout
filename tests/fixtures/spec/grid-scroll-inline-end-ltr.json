{
  "name": "grid-scroll-inline-end-ltr",
  "kind": "spec",
  "features": [
    "grid",
    "alignment",
    "scroll-state"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#overflow",
    "https://drafts.csswg.org/css-grid-2/#abspos-items",
    "https://drafts.csswg.org/css-grid-2/#grid-align",
    "https://drafts.csswg.org/css-align-3/#overflow-scroll-position"
  ],
  "derivation": "End distribution shifts a 120px track by -70px in the logical inline axis of a 50px scrollport. Align §5.3 opens the origin only to the grid subject. Grid §10.1 makes the absolute auto boundary the scrollable padding start -70px: inset-left -100px gives normal x=-170px, then scroll -70px gives visual x=-100px. The farther absolute box does not enlarge the opened origin.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "position": "relative",
          "width": 50,
          "height": 20,
          "writingMode": "horizontal-tb",
          "direction": "ltr",
          "gridTemplateColumns": [
            120
          ],
          "gridTemplateRows": [
            20
          ],
          "justifyContent": "end",
          "overflowX": "auto",
          "overflowY": "auto"
        },
        "scrollOffset": {
          "x": -100,
          "y": 0
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 10,
          "height": 10
        }
      },
      {
        "parent": 0,
        "style": {
          "position": "absolute",
          "width": 10,
          "height": 10,
          "inset": {
            "left": -100,
            "top": 0
          }
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 50,
        "height": 20,
        "scrollableOverflowX": -70,
        "scrollableOverflowWidth": 120
      },
      {
        "x": 0,
        "y": 0,
        "width": 10,
        "height": 10
      },
      {
        "x": -100,
        "y": 0,
        "width": 10,
        "height": 10
      }
    ]
  }
}
