{
  "name": "grid-subgrid-edge-alternating-axis-boundaries",
  "kind": "spec",
  "features": ["grid", "subgrid", "intrinsic-tracks"],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#subgrid-size-contribution",
    "https://drafts.csswg.org/css-grid-2/#algo-grid-sizing"
  ],
  "derivation": "The three nested grids subgrid columns, then rows, then columns. The innermost 19px/29px leaves size the middle grid's standalone columns to max(19,13)=19 and max(29,23)=29; with its local 11px gap, that grid contributes one 59px item to the outer grid's second column, not two ancestor columns. The root columns are therefore max(31,17)=31 and 59, separated by 7px, totaling 97px. Middle-grid row contributions pass through its row-subgrid boundary: outer local rows become max(11,7)=11 and max(13,17)=17, separated by 3px, totaling 31px. Middle starts at outer-local x=38; inner starts at middle-local y=14, and its second leaf starts at x=30.",
  "input": {
    "viewport": {"width": 240, "height": 160},
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": "max-content",
          "gridTemplateColumns": ["auto", "auto"],
          "gridTemplateRows": ["auto"],
          "columnGap": 7
        }
      },
      {
        "parent": 0,
        "style": {
          "display": "grid",
          "gridTemplateColumns": "subgrid",
          "gridTemplateRows": ["auto", "auto"],
          "columnGap": "normal",
          "rowGap": 3,
          "gridColumnStart": 1,
          "gridColumnEnd": 3,
          "gridRowStart": 1
        }
      },
      {
        "parent": 1,
        "style": {
          "display": "grid",
          "gridTemplateColumns": ["auto", "auto"],
          "gridTemplateRows": "subgrid",
          "columnGap": 11,
          "rowGap": "normal",
          "gridColumnStart": 2,
          "gridRowStart": 1,
          "gridRowEnd": 3
        }
      },
      {
        "parent": 2,
        "style": {
          "display": "grid",
          "gridTemplateColumns": "subgrid",
          "gridTemplateRows": ["auto"],
          "columnGap": "normal",
          "gridColumnStart": 1,
          "gridColumnEnd": 3,
          "gridRowStart": 2
        }
      },
      {
        "parent": 3,
        "style": {"gridColumnStart": 1, "gridRowStart": 1, "width": 19, "height": 17}
      },
      {
        "parent": 3,
        "style": {"gridColumnStart": 2, "gridRowStart": 1, "width": 29, "height": 17}
      },
      {
        "parent": 2,
        "style": {"gridColumnStart": 1, "gridRowStart": 1, "width": 13, "height": 7}
      },
      {
        "parent": 2,
        "style": {"gridColumnStart": 2, "gridRowStart": 1, "width": 23, "height": 7}
      },
      {
        "parent": 1,
        "style": {"gridColumnStart": 1, "gridRowStart": 1, "width": 31, "height": 11}
      },
      {
        "parent": 1,
        "style": {"gridColumnStart": 1, "gridRowStart": 2, "width": 17, "height": 13}
      }
    ]
  },
  "expected": {
    "sources": [
      {"x": 0, "y": 0, "width": 97, "height": 31},
      {"x": 0, "y": 0, "width": 97, "height": 31},
      {"x": 38, "y": 0, "width": 59, "height": 31},
      {"x": 0, "y": 14, "width": 59, "height": 17},
      {"x": 0, "y": 0, "width": 19, "height": 17},
      {"x": 30, "y": 0, "width": 29, "height": 17},
      {"x": 0, "y": 0, "width": 13, "height": 7},
      {"x": 30, "y": 0, "width": 23, "height": 7},
      {"x": 0, "y": 0, "width": 31, "height": 11},
      {"x": 0, "y": 14, "width": 17, "height": 13}
    ]
  }
}
