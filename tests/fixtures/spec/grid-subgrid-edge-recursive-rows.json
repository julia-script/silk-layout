{
  "name": "grid-subgrid-edge-recursive-rows",
  "kind": "spec",
  "features": ["grid", "subgrid", "intrinsic-tracks"],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#subgrid-size-contribution",
    "https://drafts.csswg.org/css-grid-2/#algo-grid-sizing"
  ],
  "derivation": "Row introspection crosses both row-subgrid levels: max(19,7)=19 and max(29,11)=29, plus the inherited 9px gap gives 57px. The outer standalone columns stay 17px and 43px with a local 5px gap, totaling 65px; the inner grid occupies only the 17px column. The second inherited row begins at y=28 and the outer second column at x=22.",
  "input": {
    "viewport": {"width": 240, "height": 160},
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 65,
          "gridTemplateColumns": [65],
          "gridTemplateRows": ["auto", "auto"],
          "rowGap": 9
        }
      },
      {
        "parent": 0,
        "style": {
          "display": "grid",
          "gridTemplateColumns": [17, 43],
          "gridTemplateRows": "subgrid",
          "columnGap": 5,
          "rowGap": "normal",
          "gridColumnStart": 1,
          "gridRowStart": 1,
          "gridRowEnd": 3
        }
      },
      {
        "parent": 1,
        "style": {
          "display": "grid",
          "gridTemplateColumns": [17],
          "gridTemplateRows": "subgrid",
          "rowGap": "normal",
          "gridColumnStart": 1,
          "gridRowStart": 1,
          "gridRowEnd": 3
        }
      },
      {
        "parent": 2,
        "style": {"gridColumnStart": 1, "gridRowStart": 1, "width": 17, "height": 19}
      },
      {
        "parent": 2,
        "style": {"gridColumnStart": 1, "gridRowStart": 2, "width": 17, "height": 29}
      },
      {
        "parent": 1,
        "style": {"gridColumnStart": 2, "gridRowStart": 1, "width": 43, "height": 7}
      },
      {
        "parent": 1,
        "style": {"gridColumnStart": 2, "gridRowStart": 2, "width": 43, "height": 11}
      }
    ]
  },
  "expected": {
    "sources": [
      {"x": 0, "y": 0, "width": 65, "height": 57},
      {"x": 0, "y": 0, "width": 65, "height": 57},
      {"x": 0, "y": 0, "width": 17, "height": 57},
      {"x": 0, "y": 0, "width": 17, "height": 19},
      {"x": 0, "y": 28, "width": 17, "height": 29},
      {"x": 22, "y": 0, "width": 43, "height": 7},
      {"x": 22, "y": 28, "width": 43, "height": 11}
    ]
  }
}
