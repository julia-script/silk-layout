{
  "name": "grid-subgrid-fragment-descendant-baselines",
  "kind": "spec",
  "features": ["grid", "subgrid", "fragmentation", "baseline"],
  "spec": ["https://drafts.csswg.org/css-grid-2/#subgrid-items", "https://drafts.csswg.org/css-grid-2/#pagination"],
  "derivation": "Each50px row occupies its own frame. First-baseline sharing crosses the inherited row boundary, with synthesized bottom baselines30px and20px from each row start. The10px and7px descendant boxes therefore move20px and13px respectively. The second frame begins at y70, not at the continuous grid's row coordinate50.",
  "input": {
    "viewport": {"width": 80, "height": 120},
    "fragmentation": {"kind": "page", "frames": [{"x": 0, "y": 0, "width": 80, "height": 50}, {"x": 0, "y": 70, "width": 80, "height": 50}]},
    "nodes": [
      {"parent": null, "style": {"display": "grid", "gridTemplateColumns": [30, 40], "gridTemplateRows": [50, 50], "columnGap": 10}},
      {"parent": 0, "style": {"gridColumnStart": 1, "gridRowStart": 1, "height": 30, "alignSelf": "baseline"}},
      {"parent": 0, "style": {"display": "grid", "gridColumnStart": 2, "gridRowStart": 1, "gridTemplateColumns": "subgrid", "gridTemplateRows": "subgrid"}},
      {"parent": 2, "style": {"height": 10, "alignSelf": "baseline"}},
      {"parent": 0, "style": {"gridColumnStart": 1, "gridRowStart": 2, "height": 20, "alignSelf": "baseline"}},
      {"parent": 0, "style": {"display": "grid", "gridColumnStart": 2, "gridRowStart": 2, "gridTemplateColumns": "subgrid", "gridTemplateRows": "subgrid"}},
      {"parent": 5, "style": {"height": 7, "alignSelf": "baseline"}}
    ]
  },
  "expected": {"sources": [
    {"rects": [{"x": 0, "y": 0, "width": 80, "height": 50}, {"x": 0, "y": 70, "width": 80, "height": 50}]},
    {"rects": [{"x": 0, "y": 0, "width": 30, "height": 30}]},
    {"rects": [{"x": 40, "y": 0, "width": 40, "height": 50}]},
    {"rects": [{"x": 40, "y": 20, "width": 40, "height": 10}]},
    {"rects": [{"x": 0, "y": 70, "width": 30, "height": 20}]},
    {"rects": [{"x": 40, "y": 70, "width": 40, "height": 50}]},
    {"rects": [{"x": 40, "y": 83, "width": 40, "height": 7}]}
  ]}
}
