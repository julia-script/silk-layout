{
  "name": "grid-subgrid-name-repeat-auto-fill",
  "kind": "spec",
  "features": ["grid", "subgrid"],
  "spec": ["https://drafts.csswg.org/css-grid-2/#valdef-repeat-auto-fill", "https://drafts.csswg.org/css-grid-2/#subgrid"],
  "derivation": "Four inherited tracks have five lines. The begin/end groups leave three slots, filled by three repetitions of [slot]. The second and third slot occurrences delimit the47px third track, at23+5+37+5=70. The local end name is on the fifth line, so the final item is61px at122.",
  "input": {
    "viewport": {"width": 240, "height": 100},
    "nodes": [
      {"parent": null, "style": {"display": "grid", "width": 183, "gridTemplateColumns": [23, 37, 47, 61], "gridTemplateRows": [19], "columnGap": 5}},
      {"parent": 0, "style": {"display": "grid", "gridColumnStart": 1, "gridColumnEnd": 5, "gridTemplateColumns": {"subgrid": [{"names": ["begin"]}, {"repeat": {"count": "auto-fill", "tracks": [{"names": ["slot"]}]}}, {"names": ["end"]}]}, "gridTemplateRows": [19]}},
      {"parent": 1, "style": {"gridRowStart": 1, "gridColumnStart": {"line": 2, "name": "slot"}, "gridColumnEnd": {"line": 3, "name": "slot"}}},
      {"parent": 1, "style": {"gridRowStart": 1, "gridColumnStart": {"line": 3, "name": "slot"}, "gridColumnEnd": "end"}}
    ]
  },
  "expected": {"sources": [
    {"x": 0, "y": 0, "width": 183, "height": 19},
    {"x": 0, "y": 0, "width": 183, "height": 19},
    {"x": 70, "y": 0, "width": 47, "height": 19},
    {"x": 122, "y": 0, "width": 61, "height": 19}
  ]}
}
