{
  "name": "grid-subgrid-nested-edge-mbp",
  "kind": "spec",
  "features": ["grid", "subgrid", "intrinsic-sizing"],
  "spec": ["https://drafts.csswg.org/css-grid-2/#subgrid-margins", "https://drafts.csswg.org/css-grid-2/#subgrid-item-contribution", "https://drafts.csswg.org/css-grid-2/#algo-grid-sizing"],
  "derivation": "Outer start MBP is2+3+5=10 and inner start MBP is1+2+3=6; the17px first leaf therefore sizes column1 to33. Outer end MBP is3+2+4=9 and inner end MBP is2+1+5=8; the23px second leaf sizes column2 to40. The inherited7px gap makes the root80px. Outer border width is80-2-3=75, inner content allocation is80-10-9=61 and its border width61-1-2=58. Parent-relative x positions are outer2, inner(3+5)+1=9, leaves5 and5+17+7=29; leaf world positions16 and40.",
  "input": {
    "viewport": {"width": 200, "height": 100},
    "nodes": [
      {"parent": null, "style": {"display": "grid", "width": "max-content", "gridTemplateColumns": ["auto","auto"], "gridTemplateRows": [19], "columnGap": 7}},
      {"parent": 0, "style": {"display": "grid", "gridColumnStart": 1, "gridColumnEnd": 3, "gridTemplateColumns": "subgrid", "gridTemplateRows": [19], "margin": {"left":2,"right":3}, "border": {"left":3,"right":2}, "padding": {"left":5,"right":4}}},
      {"parent": 1, "style": {"display": "grid", "gridColumnStart": 1, "gridColumnEnd": 3, "gridTemplateColumns": "subgrid", "gridTemplateRows": [19], "margin": {"left":1,"right":2}, "border": {"left":2,"right":1}, "padding": {"left":3,"right":5}}},
      {"parent": 2, "style": {"width": 17}},
      {"parent": 2, "style": {"width": 23}}
    ]
  },
  "expected": {"sources": [
    {"x": 0, "y": 0, "width": 80, "height": 19},
    {"x": 2, "y": 0, "width": 75, "height": 19},
    {"x": 9, "y": 0, "width": 58, "height": 19},
    {"x": 5, "y": 0, "width": 17, "height": 19},
    {"x": 29, "y": 0, "width": 23, "height": 19}
  ]}
}
