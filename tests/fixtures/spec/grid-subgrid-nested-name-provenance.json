{
  "name": "grid-subgrid-nested-name-provenance",
  "kind": "spec",
  "features": ["grid", "subgrid", "named-lines", "areas"],
  "spec": ["https://drafts.csswg.org/css-grid-2/#subgrids", "https://drafts.csswg.org/css-grid-2/#implicit-named-lines"],
  "derivation": "Parent columns are 11,23,37,41,53; panel covers the first four. The outer subgrid starts at x=11 and the inner at x=34. Clipping panel at each subgrid regenerates panel-start at the inner's first line and panel-end at its third, giving width 37+41=78. Explicit fixed-start/fixed-end remain on the original lines x=71/112, giving width 41 rather than the clipped area's width. The outer's local mark on its third line also inherits unchanged to x=71 in the inner grid.",
  "input": {
    "viewport": {"width": 240, "height": 120},
    "nodes": [
      {"parent": null, "style": {"display": "grid", "width": 165, "gridTemplateColumns": [11, 23, 37, {"names": ["fixed-start"]}, 41, {"names": ["fixed-end"]}, 53], "gridTemplateRows": [10, 10, 10], "gridTemplateAreas": [["panel", "panel", "panel", "panel", "."], ["panel", "panel", "panel", "panel", "."], ["panel", "panel", "panel", "panel", "."]]}},
      {"parent": 0, "style": {"display": "grid", "gridTemplateColumns": {"subgrid": [{"names": []}, {"names": []}, {"names": ["outer-mark"]}]}, "gridTemplateRows": "subgrid", "gridColumnStart": 2, "gridColumnEnd": 6, "gridRowStart": 1, "gridRowEnd": 4}},
      {"parent": 1, "style": {"display": "grid", "gridTemplateColumns": "subgrid", "gridTemplateRows": "subgrid", "gridColumnStart": 2, "gridColumnEnd": 5, "gridRowStart": 1, "gridRowEnd": 4}},
      {"parent": 2, "style": {"gridColumnStart": "panel-start", "gridColumnEnd": "panel-end", "gridRowStart": 1}},
      {"parent": 2, "style": {"gridColumnStart": "fixed-start", "gridColumnEnd": "fixed-end", "gridRowStart": 2}},
      {"parent": 2, "style": {"gridColumnStart": "outer-mark", "gridColumnEnd": "fixed-end", "gridRowStart": 3}}
    ]
  },
  "expected": {
    "sources": [
      {"x": 0, "y": 0, "width": 165, "height": 30},
      {"x": 11, "y": 0, "width": 154, "height": 30},
      {"x": 23, "y": 0, "width": 131, "height": 30},
      {"x": 0, "y": 0, "width": 78, "height": 10},
      {"x": 37, "y": 10, "width": 41, "height": 10},
      {"x": 37, "y": 20, "width": 41, "height": 10}
    ]
  }
}
