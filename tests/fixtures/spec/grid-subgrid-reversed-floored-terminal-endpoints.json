          "direction": "rtl",
          "gridColumnStart": 1,
          "gridColumnEnd": 3,
          "gridRowStart": 1,
          "gridTemplateColumns": "subgrid",
          "gridTemplateRows": "subgrid"
        }
      },
      {
        "parent": 2,
        "style": {
          "gridColumnStart": 1,
          "gridRowStart": 1,
          "width": 20,
          "height": 10,
          "justifySelf": "start",
          "alignSelf": "start"
        }
      },
      {
        "parent": 2,
        "style": {
          "gridColumnStart": 1,
          "gridColumnEnd": 3,
          "gridRowStart": 1
        }
      }
    ]
  },
  "expected": {
