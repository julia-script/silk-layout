      "width": 200,
      "height": 160
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 50,
          "gridTemplateColumns": [
            40,
            0
          ],
          "gridTemplateRows": [
            20
          ],
          "columnGap": 10
        }
      },
      {
        "parent": 0,
        "style": {
          "display": "grid",
          "gridColumnStart": 1,
          "gridColumnEnd": 3,
          "gridTemplateColumns": "subgrid",
          "gridTemplateRows": "subgrid",
          "padding": {
            "left": 3,
            "right": 3
          }
        }
      },
      {
        "parent": 1,
        "style": {
