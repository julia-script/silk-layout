{
  "name": "grid-subgrid-reversed-rtl-indexing",
  "kind": "spec",
  "features": ["grid", "subgrid", "rtl"],
  "spec": ["https://drafts.csswg.org/css-grid-2/#subgrid-indexing", "https://drafts.csswg.org/css-grid-2/#subgrid-tracks"],
  "derivation": "The LTR parent columns are19,31,43. Its RTL subgrid occupies columns2-3 at parent x19 with width74. The subgrid numbers from its own right edge: local column1 is the parent's43px right column and local column2 is the31px left column. The children therefore have parent-relative x31 and0, not0 and43. Their world x positions are50 and19.",
  "input": {
    "viewport": {"width": 200, "height": 100},
    "nodes": [
      {"parent": null, "style": {"display": "grid", "width": 93, "gridTemplateColumns": [19,31,43], "gridTemplateRows": [17]}},
      {"parent": 0, "style": {"display": "grid", "direction": "rtl", "gridColumnStart": 2, "gridColumnEnd": 4, "gridTemplateColumns": "subgrid", "gridTemplateRows": [17]}},
      {"parent": 1, "style": {"gridColumnStart": 1, "gridRowStart": 1}},
      {"parent": 1, "style": {"gridColumnStart": 2, "gridRowStart": 1}}
    ]
  },
  "expected": {"sources": [
    {"x": 0, "y": 0, "width": 93, "height": 17},
    {"x": 19, "y": 0, "width": 74, "height": 17},
    {"x": 31, "y": 0, "width": 43, "height": 17},
    {"x": 0, "y": 0, "width": 31, "height": 17}
  ]}
}
