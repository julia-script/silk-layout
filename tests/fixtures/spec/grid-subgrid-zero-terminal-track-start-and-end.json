    "viewport": {
      "width": 200,
      "height": 160
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 30,
          "gridTemplateColumns": [
            30
          ],
          "gridTemplateRows": [
            40,
            0
          ],
          "rowGap": 10
        }
      },
      {
        "parent": 0,
        "style": {
          "display": "grid",
          "gridRowStart": 1,
          "gridRowEnd": 3,
          "gridTemplateColumns": [
            30
          ],
          "gridTemplateRows": "subgrid",
          "padding": {
            "top": 3,
            "bottom": 3
          }
        }
      },
      {
        "parent": 1,
        "style": {
          "gridColumnStart": 1,
          "gridRowStart": 2,
          "height": 20,
          "alignSelf": "start"
        }
      },
      {
        "parent": 1,
        "style": {
          "gridColumnStart": 1,
          "gridRowStart": 1,
          "gridRowEnd": 3
        }
      },
      {
        "parent": 1,
        "style": {
          "gridColumnStart": 1,
          "display": "grid",
          "gridRowStart": 1,
          "gridRowEnd": 3,
          "gridTemplateColumns": [
            30
          ],
          "gridTemplateRows": "subgrid",
          "padding": {
            "top": 2,
            "bottom": 2
          }
        }
      },
      {
        "parent": 4,
        "style": {
          "gridColumnStart": 1,
          "gridRowStart": 1,
          "gridRowEnd": 3
        }
      },
      {
        "parent": 4,
        "style": {
          "gridColumnStart": 1,
          "gridRowStart": 2,
          "height": 20,
          "alignSelf": "start"
        }
      }
    ]
  },
