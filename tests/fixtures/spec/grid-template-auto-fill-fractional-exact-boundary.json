{
  "name": "grid-template-auto-fill-fractional-exact-boundary",
  "kind": "spec",
  "features": [
    "grid",
    "named-lines",
    "areas",
    "repeat"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#named-lines",
    "https://drafts.csswg.org/css-grid-2/#repeat-notation",
    "https://drafts.csswg.org/css-grid-2/#line-placement"
  ],
  "derivation": "Ten 2.1px tracks exactly fill 21px. Repetition counting must not drop a track because the algebraic quotient rounds just below an integer.",
