{
  "name": "grid-template-auto-fill-indefinite-percentage-bounds",
  "kind": "spec",
  "features": [
    "grid",
    "named-lines",
    "areas",
    "repeat"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#auto-repeat",
    "https://drafts.csswg.org/css-grid-2/#algo-track-sizing",
    "https://github.com/w3c/csswg-drafts/issues/4480"
  ],
  "derivation": "Under only a definite maximum, percentage functions remain indefinite for counting. The first grid counts using its fixed 20px minimum; the second uses its fixed 20px maximum: both repeat five times. Intrinsic sizes are 100px. In final layout the second grid resolves its 50% minimum to 50px and overflows without enlarging the container.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "block",
          "width": 100
        }
      },
      {
        "parent": 0,
        "style": {
          "display": "grid",
          "width": "max-content",
          "maxWidth": 100,
          "gridTemplateColumns": [
            {
              "repeat": {
                "count": "auto-fill",
                "tracks": [
                  {
                    "minmax": [
                      20,
                      {
                        "percent": 0.5
                      }
                    ]
                  }
                ]
              }
            }
          ],
          "gridTemplateRows": [
            10
          ],
          "gridAutoRows": [
            10
          ]
        }
      },
      {
        "parent": 1,
        "style": {}
      },
