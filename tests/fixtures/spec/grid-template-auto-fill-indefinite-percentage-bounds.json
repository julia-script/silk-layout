      },
      {
        "parent": 0,
        "style": {
          "display": "grid",
          "width": "max-content",
          "maxWidth": 100,
          "gridTemplateColumns": [
            {
              "repeat": {
                "count": "auto-fill",
                "tracks": [
                  {
                    "minmax": [
                      {
                        "percent": 0.5
                      },
                      20
                    ]
                  }
                ]
              }
            }
          ],
          "gridTemplateRows": [
            10
          ],
          "gridAutoRows": [
            10
          ]
        }
      },
