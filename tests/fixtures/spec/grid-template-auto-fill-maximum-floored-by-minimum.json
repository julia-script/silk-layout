{
  "name": "grid-template-auto-fill-maximum-floored-by-minimum",
  "kind": "spec",
  "features": [
    "grid",
    "named-lines",
    "areas",
    "repeat"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#named-lines",
    "https://drafts.csswg.org/css-grid-2/#repeat-notation",
    "https://drafts.csswg.org/css-grid-2/#line-placement"
  ],
  "derivation": "For counting and sizing, the 20px maximum is floored by the 30px minimum. Three 30px tracks and two 5px gutters exactly fill 100px.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 100,
          "gridTemplateColumns": [
            {
              "repeat": {
                "count": "auto-fill",
                "tracks": [
                  {
                    "minmax": [
                      30,
                      20
                    ]
                  }
                ]
              }
            }
          ],
          "gridTemplateRows": [
            10
          ],
          "columnGap": 5
        }
      },
      {
        "parent": 0,
        "style": {}
      },
      {
        "parent": 0,
        "style": {}
      },
      {
        "parent": 0,
        "style": {}
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 100,
        "height": 10
      },
      {
        "x": 0,
        "y": 0,
        "width": 30,
        "height": 10
      },
      {
        "x": 35,
        "y": 0,
        "width": 30,
        "height": 10
      },
      {
        "x": 70,
        "y": 0,
        "width": 30,
        "height": 10
      }
    ]
  }
}
