{
  "name": "grid-template-auto-fit-fixed-siblings",
  "kind": "spec",
  "features": [
    "grid",
    "named-lines",
    "areas",
    "repeat"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#named-lines",
    "https://drafts.csswg.org/css-grid-2/#repeat-notation",
    "https://drafts.csswg.org/css-grid-2/#line-placement"
  ],
  "derivation": "Three repeated tracks fit between the fixed siblings. All three are empty and collapse; their gutters coincide into one 5px gutter. Negative line -2 still addresses the final explicit track.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 100,
          "gridTemplateColumns": [
            10,
            {
              "repeat": {
                "count": "auto-fit",
                "tracks": [
                  20
                ]
              }
            },
            10
          ],
          "gridTemplateRows": [
            10
          ],
          "columnGap": 5
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 1
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": -2
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 100,
        "height": 10
      },
      {
        "x": 0,
        "y": 0,
        "width": 10,
        "height": 10
      },
      {
        "x": 15,
        "y": 0,
        "width": 10,
        "height": 10
      }
    ]
  }
}
