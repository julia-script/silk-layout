{
  "name": "grid-template-auto-fit-minimum-relayout-keeps-count",
  "kind": "spec",
  "features": [
    "grid",
    "named-lines",
    "areas",
    "repeat"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#named-lines",
    "https://drafts.csswg.org/css-grid-2/#repeat-notation",
    "https://drafts.csswg.org/css-grid-2/#line-placement"
  ],
  "derivation": "Four repetitions are the smallest count meeting the 71px minimum before collapse. Only the fourth remains occupied. Clamping the collapsed content extent to 71px does not convert the minimum constraint into preferred-size floor counting.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": "max-content",
          "minWidth": 71,
          "gridTemplateColumns": [
            {
              "repeat": {
                "count": "auto-fit",
                "tracks": [
                  20
                ]
              }
            }
          ],
          "gridAutoColumns": [
            40
          ],
          "gridTemplateRows": [
            10
          ],
          "columnGap": 5
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 4
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 71,
        "height": 10
      },
      {
        "x": 0,
        "y": 0,
        "width": 20,
        "height": 10
      }
    ]
  }
}
