{
  "name": "grid-template-auto-fit-spanning-occupancy",
  "kind": "spec",
  "features": [
    "grid",
    "named-lines",
    "areas",
    "repeat"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#named-lines",
    "https://drafts.csswg.org/css-grid-2/#repeat-notation",
    "https://drafts.csswg.org/css-grid-2/#line-placement"
  ],
  "derivation": "The first item spans all three repeated tracks, so none is empty. Two gutters leave 80px for three equal fr tracks.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 100,
          "gridTemplateColumns": [
            {
              "repeat": {
                "count": "auto-fit",
                "tracks": [
                  {
                    "minmax": [
                      20,
                      {
                        "fr": 1
                      }
                    ]
                  }
                ]
              }
            }
          ],
          "gridTemplateRows": [
            10,
            10
          ],
          "columnGap": 10
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 1,
          "gridColumnEnd": 4,
          "gridRowStart": 1
        }
      },
      {
        "parent": 0,
        "style": {
          "gridColumnStart": 3,
          "gridRowStart": 2
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 100,
        "height": 20
      },
      {
        "x": 0,
        "y": 0,
        "width": 100,
        "height": 10
      },
      {
        "x": 73.33333333333333,
        "y": 10,
        "width": 26.666666666666668,
        "height": 10
      }
    ]
  }
}
