{
  "name": "grid-template-null-area-explicit-extent",
  "kind": "spec",
  "features": [
    "grid",
    "named-lines",
    "areas",
    "repeat"
  ],
  "spec": [
    "https://drafts.csswg.org/css-grid-2/#named-lines",
    "https://drafts.csswg.org/css-grid-2/#repeat-notation",
    "https://drafts.csswg.org/css-grid-2/#line-placement"
  ],
  "derivation": "Even null cells establish a three-column, two-row explicit grid. With no authored sizes, automatic patterns provide 10px columns and 7,9px rows.",
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "grid",
          "width": 30,
          "gridTemplateAreas": [
            [
              ".",
              ".",
              "."
            ],
            [
              ".",
              ".",
              "."
            ]
          ],
          "gridAutoColumns": [
            10
          ],
          "gridAutoRows": [
            7,
            9
          ]
        }
      },
      {
        "parent": 0,
        "style": {}
      },
      {
        "parent": 0,
        "style": {}
      },
      {
        "parent": 0,
        "style": {}
      },
      {
        "parent": 0,
        "style": {}
      },
      {
        "parent": 0,
        "style": {}
      },
      {
        "parent": 0,
        "style": {}
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 30,
        "height": 16
      },
      {
        "x": 0,
        "y": 0,
        "width": 10,
        "height": 7
      },
      {
        "x": 10,
        "y": 0,
        "width": 10,
        "height": 7
      },
      {
        "x": 20,
        "y": 0,
        "width": 10,
        "height": 7
      },
      {
        "x": 0,
        "y": 7,
        "width": 10,
        "height": 9
      },
      {
        "x": 10,
        "y": 7,
        "width": 10,
        "height": 9
      },
      {
        "x": 20,
        "y": 7,
        "width": 10,
        "height": 9
      }
    ]
  }
}
