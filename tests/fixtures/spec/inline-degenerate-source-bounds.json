{
  "name": "inline-degenerate-source-bounds",
  "kind": "spec",
  "features": [
    "inline-fragments",
    "floats"
  ],
  "spec": [
    "https://drafts.csswg.org/cssom-view/#dom-element-getboundingclientrect",
    "https://www.w3.org/TR/CSS22/visuren.html#floats"
  ],
  "input": {
    "viewport": {
      "width": 200,
      "height": 200
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 100
        }
      },
      {
        "parent": 0,
        "style": {
          "display": "inline"
        }
      },
      {
        "parent": 1,
        "style": {
          "float": "left",
          "width": 30,
          "height": 30
        }
      },
      {
        "parent": 1,
        "style": {
          "display": "inline-block",
          "width": 40,
          "height": 10
        }
      },
      {
        "parent": 1,
        "style": {
          "display": "inline-block",
          "width": 40,
          "height": 10
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "height": 30
      },
      {
        "x": 30,
        "y": 10,
        "width": 40,
        "height": 0,
        "rects": [
          {
            "x": 30,
            "y": 10,
            "width": 40,
            "height": 0
          },
          {
            "x": 30,
            "y": 20,
            "width": 40,
            "height": 0
          }
        ]
      },
      {
        "x": -30,
        "y": -10
      },
      {
        "x": 0,
        "y": -10
      },
      {
        "x": 0,
        "y": 0
      }
    ]
  }
}
