{
  "name": "inline-font-service",
  "kind": "spec",
  "features": [
    "inline-fragments",
    "font-metrics"
  ],
  "spec": [
    "https://drafts.csswg.org/css-inline-3/#line-height",
    "https://drafts.csswg.org/css-inline-3/#inline-height"
  ],
  "input": {
    "viewport": {
      "width": 100,
      "height": 100
    },
    "fonts": [
      {
        "fontSize": 10,
        "ascent": 8,
        "descent": 2,
        "lineGap": 0,
        "xHeight": 5,
        "capHeight": 7,
        "subscriptOffset": 2,
        "superscriptOffset": 3,
        "baselines": {
          "alphabetic": 8,
          "ideographic": 10,
          "central": 5,
          "mathematical": 5
        }
      }
    ],
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 100,
          "fontKey": 1,
          "lineHeight": 2
        }
      },
      {
        "parent": 0,
        "style": {
          "display": "inline",
          "fontKey": 1,
          "width": 99,
          "height": 88
        }
      },
      {
        "parent": 1,
        "style": {
          "display": "inline-block",
          "width": 12,
          "height": 6
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "height": 20,
        "firstBaseline": 13
      },
      {
        "y": 5,
        "height": 10
      },
      {
        "y": 2
      }
    ]
  }
}
