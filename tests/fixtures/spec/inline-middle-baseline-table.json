{
  "name": "inline-middle-baseline-table",
  "kind": "spec",
  "features": [
    "baselines",
    "font-metrics",
    "vertical-align"
  ],
  "spec": [
    "https://drafts.csswg.org/css-inline-3/#valdef-dominant-baseline-middle",
    "https://drafts.csswg.org/css-inline-3/#alignment-baseline-property",
    "https://drafts.csswg.org/css-inline-3/#baseline-set"
  ],
  "input": {
    "viewport": {
      "width": 100,
      "height": 100
    },
    "fonts": [
      {
        "fontSize": 10,
        "ascent": 8,
        "descent": 2,
        "lineGap": 0,
        "xHeight": 5,
        "capHeight": 7,
        "subscriptOffset": 2,
        "superscriptOffset": 3,
        "baselines": {
          "alphabetic": 8,
          "ideographic": 10,
          "central": 5,
          "mathematical": 5
        }
      },
      {
        "fontSize": 6,
        "ascent": 4,
        "descent": 2,
        "lineGap": 0,
        "xHeight": 4,
        "capHeight": 4,
        "subscriptOffset": 1,
        "superscriptOffset": 2,
        "baselines": {
          "alphabetic": 4,
          "ideographic": 6,
          "central": 3,
          "mathematical": 3
        }
      }
    ],
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 100,
          "fontKey": 1
        }
      },
      {
        "parent": 0,
        "style": {
          "display": "inline",
          "fontKey": 2,
          "padding": {
            "left": 1
          },
          "verticalAlign": "middle"
        }
      },
      {
        "parent": 0,
        "style": {
          "display": "inline-block",
          "fontKey": 2,
          "verticalAlign": "middle"
        }
      },
      {
        "parent": 2,
        "style": {
          "display": "inline",
          "fontKey": 2,
          "padding": {
            "left": 1
          }
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "height": 10,
        "firstBaseline": 8
      },
      {
        "y": 3.5,
        "height": 6
      },
      {
        "y": 3.5,
        "height": 6
      },
      {
        "y": 0,
        "height": 6
      }
    ]
  }
}
