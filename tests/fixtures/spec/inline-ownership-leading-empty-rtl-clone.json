{
  "name": "inline-ownership-leading-empty-rtl-clone",
  "kind": "spec",
  "features": ["inline-fragments", "bidi-ordering", "box-decoration-break"],
  "spec": [
    "https://drafts.csswg.org/css-text-3/#line-breaking-box-edges",
    "https://drafts.csswg.org/css-writing-modes-4/#bidi-fragment-boxes",
    "https://drafts.csswg.org/css-break-3/#valdef-box-decoration-break-clone"
  ],
  "input": {
    "viewport": {"width": 100, "height": 100},
    "nodes": [
      {"parent": null, "style": {"width": 30, "direction": "rtl"}},
      {"parent": 0, "style": {"display": "inline-block", "width": 20, "height": 10}},
      {"parent": 0, "style": {"display": "inline", "direction": "rtl", "unicodeBidi": "embed", "boxDecorationBreak": "clone", "padding": {"left": 3, "right": 4}}},
      {"parent": 2, "style": {"display": "inline", "direction": "rtl"}},
      {"parent": 2, "style": {"display": "inline-block", "width": 20, "height": 10}}
    ]
  },
  "expected": {
    "sources": [
      {"height": 20},
      {"rects": [{"x": 10, "y": 0, "width": 20, "height": 10}]},
      {"rects": [{"x": 3, "y": 20, "width": 27, "height": 0}]},
      {"rects": [{"x": 26, "y": 20, "width": 0, "height": 0}]},
      {"rects": [{"x": 6, "y": 10, "width": 20, "height": 10}]}
    ]
  }
}
