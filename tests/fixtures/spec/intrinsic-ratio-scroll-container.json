{
  "name": "intrinsic-ratio-scroll-container",
  "kind": "spec",
  "features": [
    "intrinsic",
    "aspect-ratio"
  ],
  "spec": [
    "https://drafts.csswg.org/css-sizing-4/#aspect-ratio",
    "https://drafts.csswg.org/css-sizing-4/#aspect-ratio-minimum"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": "max-content",
          "aspectRatio": 1,
          "overflowX": "hidden",
          "overflowY": "hidden"
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 100,
          "height": 110
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 100,
        "height": 100,
        "contentWidth": 100,
        "contentHeight": 100
      },
      {
        "x": 0,
        "y": 0,
        "width": 100,
        "height": 110
      }
    ]
  }
}
