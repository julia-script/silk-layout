{
  "name": "orthogonal-root-percentage-edges",
  "kind": "spec",
  "features": [
    "writing-mode",
    "percentage-padding",
    "percentage-margin",
    "root",
    "absolute-containing-block"
  ],
  "spec": [
    "https://drafts.csswg.org/css-writing-modes-4/#orthogonal-flows",
    "https://drafts.csswg.org/css-box-3/#padding-physical",
    "https://drafts.csswg.org/css-box-3/#margin-physical"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "writingMode": "vertical-rl",
          "width": 100,
          "height": 200,
          "padding": {
            "percent": 0.1
          },
          "margin": {
            "percent": 0.1
          },
          "position": "relative"
        }
      },
      {
        "parent": 0,
        "style": {
          "writingMode": "vertical-rl",
          "width": 20,
          "height": 30,
          "padding": {
            "percent": 0.1
          }
        }
      },
      {
        "parent": 0,
        "style": {
          "position": "absolute",
          "width": 10,
          "height": 10,
          "insetRight": 0,
          "insetTop": 0
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 80,
        "y": 80,
        "width": 260,
        "height": 360,
        "contentWidth": 100,
        "contentHeight": 200
      },
      {
        "x": 120,
        "y": 80,
        "width": 60,
        "height": 70,
        "contentWidth": 20,
        "contentHeight": 30
      },
      {
        "x": 250,
        "y": 0,
        "width": 10,
        "height": 10,
        "contentWidth": 10,
        "contentHeight": 10
      }
    ]
  }
}
