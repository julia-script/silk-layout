{
  "name": "overflow-block-margin-policy",
  "kind": "spec",
  "features": [
    "scrollable-overflow"
  ],
  "spec": [
    "https://drafts.csswg.org/css-overflow-3/#scrollable-overflow-calculation",
    "https://drafts.csswg.org/css-overflow-3/#scroll-origin",
    "https://drafts.csswg.org/css-position-3/#relative-position"
  ],
  "input": {
    "viewport": {
      "width": 100,
      "height": 100
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 100,
          "height": 100,
          "overflowX": "hidden",
          "overflowY": "hidden"
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 10,
          "height": 10,
          "marginLeft": 20,
          "marginRight": 200,
          "marginTop": 30,
          "marginBottom": 300
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "scrollableOverflowX": 0,
        "scrollableOverflowY": 0,
        "scrollableOverflowWidth": 230,
        "scrollableOverflowHeight": 340
      },
      {
        "x": 20,
        "y": 30,
        "scrollableOverflowX": 0,
        "scrollableOverflowY": 0,
        "scrollableOverflowWidth": 10,
        "scrollableOverflowHeight": 10
      }
    ],
    "viewportOverflow": {
      "x": 0,
      "y": 0,
      "width": 100,
      "height": 100
    }
  }
}
