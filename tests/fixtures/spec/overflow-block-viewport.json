{
  "name": "overflow-block-viewport",
  "kind": "spec",
  "features": [
    "scrollable-overflow"
  ],
  "spec": [
    "https://drafts.csswg.org/css-overflow-3/#scrollable-overflow-calculation",
    "https://drafts.csswg.org/css-overflow-3/#scroll-origin",
    "https://drafts.csswg.org/css-position-3/#relative-position"
  ],
  "input": {
    "viewport": {
      "width": 200,
      "height": 100
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 100,
          "height": 100
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 300,
          "height": 200
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "scrollableOverflowX": 0,
        "scrollableOverflowY": 0,
        "scrollableOverflowWidth": 300,
        "scrollableOverflowHeight": 200
      },
      {
        "scrollableOverflowX": 0,
        "scrollableOverflowY": 0,
        "scrollableOverflowWidth": 300,
        "scrollableOverflowHeight": 200
      }
    ],
    "viewportOverflow": {
      "x": 0,
      "y": 0,
      "width": 300,
      "height": 200
    }
  }
}
