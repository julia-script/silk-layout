{
  "name": "overflow-measured-float",
  "kind": "spec",
  "features": [
    "scrollable-overflow"
  ],
  "spec": [
    "https://drafts.csswg.org/css-overflow-3/#scrollable-overflow-calculation",
    "https://drafts.csswg.org/css-overflow-3/#scroll-origin",
    "https://drafts.csswg.org/css-position-3/#relative-position"
  ],
  "input": {
    "viewport": {
      "width": 100,
      "height": 100
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 100,
          "height": 20,
          "overflowX": "hidden",
          "overflowY": "hidden"
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 70,
          "height": 30,
          "float": "left"
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 50,
          "height": 10
        },
        "measure": {
          "minWidth": 50,
          "maxWidth": 50,
          "height": 10,
          "firstBaseline": 8
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "scrollableOverflowX": 0,
        "scrollableOverflowY": 0,
        "scrollableOverflowWidth": 100,
        "scrollableOverflowHeight": 40
      },
      {
        "scrollableOverflowX": 0,
        "scrollableOverflowY": 0,
        "scrollableOverflowWidth": 70,
        "scrollableOverflowHeight": 30
      },
      {
        "scrollableOverflowX": 0,
        "scrollableOverflowY": 0,
        "scrollableOverflowWidth": 50,
        "scrollableOverflowHeight": 40
      }
    ],
    "viewportOverflow": {
      "x": 0,
      "y": 0,
      "width": 100,
      "height": 100
    }
  }
}
