{
  "name": "overflow-measured-rtl",
  "kind": "spec",
  "features": [
    "scrollable-overflow"
  ],
  "spec": [
    "https://drafts.csswg.org/css-overflow-3/#scrollable-overflow-calculation",
    "https://drafts.csswg.org/css-overflow-3/#scroll-origin",
    "https://drafts.csswg.org/css-position-3/#relative-position"
  ],
  "input": {
    "viewport": {
      "width": 100,
      "height": 100
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 100,
          "height": 100,
          "direction": "rtl",
          "overflowX": "hidden",
          "overflowY": "hidden"
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 50,
          "height": 20,
          "direction": "rtl"
        },
        "measure": {
          "minWidth": 200,
          "maxWidth": 200,
          "height": 10,
          "firstBaseline": 8
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "scrollableOverflowX": -100,
        "scrollableOverflowY": 0,
        "scrollableOverflowWidth": 200,
        "scrollableOverflowHeight": 100
      },
      {
        "x": 50,
        "y": 0,
        "scrollableOverflowX": -150,
        "scrollableOverflowY": 0,
        "scrollableOverflowWidth": 200,
        "scrollableOverflowHeight": 20
      }
    ],
    "viewportOverflow": {
      "x": 0,
      "y": 0,
      "width": 100,
      "height": 100
    }
  }
}
