{
  "name": "overflow-zero-area-descendant",
  "kind": "spec",
  "features": [
    "scrollable-overflow"
  ],
  "spec": [
    "https://drafts.csswg.org/css-overflow-3/#scrollable-overflow-calculation",
    "https://drafts.csswg.org/css-overflow-3/#scroll-origin",
    "https://drafts.csswg.org/css-position-3/#relative-position"
  ],
  "input": {
    "viewport": {
      "width": 100,
      "height": 100
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 100,
          "height": 100,
          "overflowX": "hidden",
          "overflowY": "hidden"
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 0,
          "height": 0
        }
      },
      {
        "parent": 1,
        "style": {
          "width": 180,
          "height": 140
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "scrollableOverflowX": 0,
        "scrollableOverflowY": 0,
        "scrollableOverflowWidth": 180,
        "scrollableOverflowHeight": 140
      },
      {
        "scrollableOverflowX": 0,
        "scrollableOverflowY": 0,
        "scrollableOverflowWidth": 180,
        "scrollableOverflowHeight": 140
      },
      {
        "scrollableOverflowX": 0,
        "scrollableOverflowY": 0,
        "scrollableOverflowWidth": 180,
        "scrollableOverflowHeight": 140
      }
    ],
    "viewportOverflow": {
      "x": 0,
      "y": 0,
      "width": 100,
      "height": 100
    }
  }
}
