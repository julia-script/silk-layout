{
  "name": "overflow-zero-area",
  "kind": "spec",
  "features": [
    "scrollable-overflow"
  ],
  "spec": [
    "https://drafts.csswg.org/css-overflow-3/#scrollable-overflow-calculation",
    "https://drafts.csswg.org/css-overflow-3/#scroll-origin",
    "https://drafts.csswg.org/css-position-3/#relative-position"
  ],
  "input": {
    "viewport": {
      "width": 100,
      "height": 100
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 100,
          "height": 100,
          "overflowX": "hidden",
          "overflowY": "hidden"
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 0,
          "height": 0,
          "position": "relative",
          "insetLeft": 200,
          "insetTop": 300
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 0,
          "height": 20,
          "position": "relative",
          "insetLeft": 200,
          "insetTop": 300
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 20,
          "height": 0,
          "position": "relative",
          "insetLeft": 200,
          "insetTop": 300
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "scrollableOverflowX": 0,
        "scrollableOverflowY": 0,
        "scrollableOverflowWidth": 100,
        "scrollableOverflowHeight": 100
      },
      { "x": 200, "y": 300, "width": 0, "height": 0 },
      { "x": 200, "y": 300, "width": 0, "height": 20 },
      { "x": 200, "y": 320, "width": 20, "height": 0 }
    ],
    "viewportOverflow": {
      "x": 0,
      "y": 0,
      "width": 100,
      "height": 100
    }
  }
}
