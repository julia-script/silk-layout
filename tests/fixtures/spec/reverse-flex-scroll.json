{
  "name": "reverse-flex-scroll",
  "kind": "spec",
  "features": [
    "scroll-state",
    "position"
  ],
  "spec": [
    "https://drafts.csswg.org/css-overflow-3/#scrolling",
    "https://drafts.csswg.org/css-position-3/#stickypos-insets",
    "https://drafts.csswg.org/css-position-3/#static-position"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "flex",
          "flexDirection": "column-reverse",
          "direction": "rtl",
          "alignItems": "flex-start",
          "width": 100,
          "height": 100,
          "overflowX": "hidden",
          "overflowY": "hidden"
        },
        "scrollOffset": {
          "x": -30,
          "y": -40
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 200,
          "height": 200,
          "flexShrink": 0
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 100,
        "height": 100
      },
      {
        "x": -70,
        "y": -60,
        "width": 200,
        "height": 200
      }
    ]
  }
}
