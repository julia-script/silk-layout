{
  "name": "scroll-overlay-alias",
  "kind": "spec",
  "features": [
    "scroll-state",
    "position"
  ],
  "spec": [
    "https://drafts.csswg.org/css-overflow-3/#scrolling",
    "https://drafts.csswg.org/css-position-3/#stickypos-insets",
    "https://drafts.csswg.org/css-position-3/#static-position"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 100,
          "height": 100,
          "overflowX": "overlay",
          "overflowY": "hidden"
        },
        "scrollOffset": {
          "x": 20,
          "y": 0
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 200,
          "height": 100
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 100,
        "height": 100
      },
      {
        "x": -20,
        "y": 0,
        "width": 200,
        "height": 100
      }
    ]
  }
}
