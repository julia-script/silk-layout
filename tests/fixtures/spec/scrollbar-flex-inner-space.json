{
  "name": "scrollbar-flex-inner-space",
  "kind": "spec",
  "features": [
    "scrollbars",
    "scrollbar-gutter"
  ],
  "spec": [
    "https://drafts.csswg.org/css-overflow-3/#scrollbar-sizing",
    "https://drafts.csswg.org/css-overflow-3/#scrollbar-gutter-property",
    "https://drafts.csswg.org/css-scrollbars-1/#scrollbar-width"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "scrollbars": {
      "auto": {
        "horizontal": 12,
        "vertical": 15,
        "overlay": false,
        "horizontalOnTop": false,
        "verticalOnLeft": false
      },
      "thin": {
        "horizontal": 6,
        "vertical": 8,
        "overlay": false,
        "horizontalOnTop": false,
        "verticalOnLeft": false
      }
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "display": "flex",
          "width": 100,
          "height": 100,
          "overflowX": "scroll",
          "overflowY": "scroll"
        }
      },
      {
        "parent": 0,
        "style": {
          "flexGrow": 1,
          "flexBasis": 0,
          "minWidth": 0,
          "minHeight": 0
        }
      },
      {
        "parent": 0,
        "style": {
          "flexGrow": 1,
          "flexBasis": 0,
          "minWidth": 0,
          "minHeight": 0
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 100,
        "height": 100,
        "contentWidth": 85,
        "contentHeight": 88,
        "scrollbarGutterTop": 0,
        "scrollbarGutterRight": 15,
        "scrollbarGutterBottom": 12,
        "scrollbarGutterLeft": 0,
        "horizontalScrollbar": true,
        "verticalScrollbar": true
      },
      {
        "x": 0,
        "y": 0,
        "width": 42.5,
        "height": 88
      },
      {
        "x": 42.5,
        "y": 0,
        "width": 42.5,
        "height": 88
      }
    ]
  }
}
