{
  "name": "scrollbar-measured-rewrap",
  "kind": "spec",
  "features": [
    "scrollbars",
    "scrollbar-gutter"
  ],
  "spec": [
    "https://drafts.csswg.org/css-overflow-3/#scrollbar-sizing",
    "https://drafts.csswg.org/css-overflow-3/#scrollbar-gutter-property",
    "https://drafts.csswg.org/css-scrollbars-1/#scrollbar-width"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "scrollbars": {
      "auto": {
        "horizontal": 12,
        "vertical": 15,
        "overlay": false,
        "horizontalOnTop": false,
        "verticalOnLeft": false
      },
      "thin": {
        "horizontal": 6,
        "vertical": 8,
        "overlay": false,
        "horizontalOnTop": false,
        "verticalOnLeft": false
      }
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 100,
          "height": 15,
          "overflowX": "auto",
          "overflowY": "auto"
        },
        "measure": {
          "minWidth": 45,
          "maxWidth": 180,
          "height": 10,
          "firstBaseline": 8,
          "wrap": true
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 100,
        "height": 15,
        "contentWidth": 85,
        "contentHeight": 15,
        "scrollbarGutterTop": 0,
        "scrollbarGutterRight": 15,
        "scrollbarGutterBottom": 0,
        "scrollbarGutterLeft": 0,
        "horizontalScrollbar": false,
        "verticalScrollbar": true,
        "scrollableOverflowX": 0,
        "scrollableOverflowY": 0,
        "scrollableOverflowWidth": 85,
        "scrollableOverflowHeight": 30
      }
    ]
  }
}
