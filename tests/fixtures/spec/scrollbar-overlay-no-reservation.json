{
  "name": "scrollbar-overlay-no-reservation",
  "kind": "spec",
  "features": [
    "scrollbars",
    "scrollbar-gutter"
  ],
  "spec": [
    "https://drafts.csswg.org/css-overflow-3/#scrollbar-gutter-property"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "scrollbars": {
      "auto": {
        "horizontal": 12,
        "vertical": 15,
        "overlay": true,
        "horizontalOnTop": false,
        "verticalOnLeft": false
      },
      "thin": {
        "horizontal": 6,
        "vertical": 8,
        "overlay": false,
        "horizontalOnTop": false,
        "verticalOnLeft": false
      }
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 100,
          "height": 100,
          "scrollbarGutter": "stable both-edges",
          "overflowX": "scroll",
          "overflowY": "scroll"
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 200,
          "height": 200
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 100,
        "height": 100,
        "contentWidth": 100,
        "contentHeight": 100,
        "scrollbarGutterTop": 0,
        "scrollbarGutterRight": 0,
        "scrollbarGutterBottom": 0,
        "scrollbarGutterLeft": 0,
        "horizontalScrollbar": true,
        "verticalScrollbar": true
      },
      {
        "x": 0,
        "y": 0,
        "width": 200,
        "height": 200
      }
    ]
  }
}
