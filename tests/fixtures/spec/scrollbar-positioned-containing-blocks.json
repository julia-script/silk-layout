{
  "name": "scrollbar-positioned-containing-blocks",
  "kind": "spec",
  "features": [
    "scrollbars",
    "scrollbar-gutter"
  ],
  "spec": [
    "https://drafts.csswg.org/css-overflow-3/#scrollbar-sizing",
    "https://drafts.csswg.org/css-overflow-3/#scrollbar-gutter-property",
    "https://drafts.csswg.org/css-scrollbars-1/#scrollbar-width"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "scrollbars": {
      "auto": {
        "horizontal": 12,
        "vertical": 15,
        "overlay": false,
        "horizontalOnTop": false,
        "verticalOnLeft": false
      },
      "thin": {
        "horizontal": 6,
        "vertical": 8,
        "overlay": false,
        "horizontalOnTop": false,
        "verticalOnLeft": false
      }
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 100,
          "height": 100,
          "boxSizing": "border-box",
          "border": 2,
          "padding": 3,
          "position": "relative",
          "overflowX": "scroll",
          "overflowY": "scroll"
        }
      },
      {
        "parent": 0,
        "style": {
          "position": "absolute",
          "insetRight": 0,
          "insetBottom": 0,
          "width": {"percent": 0.5},
          "height": {"percent": 0.5}
        }
      },
      {
        "parent": 0,
        "style": {
          "position": "fixed",
          "insetRight": 0,
          "insetTop": 0,
          "width": {"percent": 0.5},
          "height": 10
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 100,
        "height": 100,
        "contentWidth": 75,
        "contentHeight": 78,
        "scrollbarGutterTop": 0,
        "scrollbarGutterRight": 15,
        "scrollbarGutterBottom": 12,
        "scrollbarGutterLeft": 0,
        "horizontalScrollbar": true,
        "verticalScrollbar": true
      },
      {
        "x": 42.5,
        "y": 44,
        "width": 40.5,
        "height": 42
      },
      {
        "x": 400,
        "y": 0,
        "width": 400,
        "height": 10
      }
    ]
  }
}
