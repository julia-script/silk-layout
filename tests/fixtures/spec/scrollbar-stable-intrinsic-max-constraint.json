{
  "name": "scrollbar-stable-intrinsic-max-constraint",
  "kind": "spec",
  "features": [
    "scrollbars",
    "scrollbar-gutter"
  ],
  "spec": [
    "https://drafts.csswg.org/css-overflow-3/#scrollbar-sizing",
    "https://drafts.csswg.org/css-overflow-3/#scrollbar-gutter-property",
    "https://drafts.csswg.org/css-scrollbars-1/#scrollbar-width"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "scrollbars": {
      "auto": {
        "horizontal": 12,
        "vertical": 15,
        "overlay": false,
        "horizontalOnTop": false,
        "verticalOnLeft": false
      },
      "thin": {
        "horizontal": 6,
        "vertical": 8,
        "overlay": false,
        "horizontalOnTop": false,
        "verticalOnLeft": false
      }
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": "max-content",
          "maxWidth": 60,
          "height": 100,
          "scrollbarGutter": "stable",
          "overflowX": "hidden",
          "overflowY": "hidden"
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 50,
          "height": 20
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 60,
        "height": 100,
        "contentWidth": 45,
        "contentHeight": 100,
        "scrollbarGutterTop": 0,
        "scrollbarGutterRight": 15,
        "scrollbarGutterBottom": 0,
        "scrollbarGutterLeft": 0,
        "horizontalScrollbar": false,
        "verticalScrollbar": false
      },
      {
        "x": 0,
        "y": 0,
        "width": 50,
        "height": 20
      }
    ]
  }
}
