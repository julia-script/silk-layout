{
  "name": "scrollbar-sticky-scrollport",
  "kind": "spec",
  "features": [
    "scrollbars",
    "sticky",
    "scroll-state"
  ],
  "spec": [
    "https://drafts.csswg.org/css-overflow-3/#scrollbar-sizing",
    "https://drafts.csswg.org/css-position-3/#stickypos-insets"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "scrollbars": {
      "auto": {
        "horizontal": 12,
        "vertical": 15,
        "overlay": false,
        "horizontalOnTop": false,
        "verticalOnLeft": false
      },
      "thin": {
        "horizontal": 6,
        "vertical": 8,
        "overlay": false,
        "horizontalOnTop": false,
        "verticalOnLeft": false
      }
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 100,
          "height": 100,
          "overflowX": "scroll",
          "overflowY": "scroll"
        },
        "scrollOffset": {
          "x": 50,
          "y": 40
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 300,
          "height": 300
        }
      },
      {
        "parent": 1,
        "style": {
          "position": "sticky",
          "insetLeft": {
            "percent": 0.1
          },
          "insetTop": {
            "percent": 0.1
          },
          "width": 20,
          "height": 20
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 100,
        "height": 100,
        "contentWidth": 85,
        "contentHeight": 88,
        "scrollbarGutterTop": 0,
        "scrollbarGutterRight": 15,
        "scrollbarGutterBottom": 12,
        "scrollbarGutterLeft": 0,
        "horizontalScrollbar": true,
        "verticalScrollbar": true
      },
      {
        "x": -50,
        "y": -40,
        "width": 300,
        "height": 300
      },
      {
        "x": 58.5,
        "y": 48.8,
        "width": 20,
        "height": 20
      }
    ]
  }
}
