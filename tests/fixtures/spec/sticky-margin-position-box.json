{
  "name": "sticky-margin-position-box",
  "kind": "spec",
  "features": [
    "scroll-state",
    "position"
  ],
  "spec": [
    "https://drafts.csswg.org/css-overflow-3/#scrolling",
    "https://drafts.csswg.org/css-position-3/#stickypos-insets",
    "https://drafts.csswg.org/css-position-3/#static-position"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 100,
          "height": 100
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 50,
          "height": 50,
          "position": "sticky",
          "insetTop": 40,
          "marginBottom": 50
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 100,
        "height": 100
      },
      {
        "x": 0,
        "y": 40,
        "width": 50,
        "height": 50
      }
    ]
  }
}
