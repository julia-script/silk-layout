{
  "name": "sticky-oversized-view",
  "kind": "spec",
  "features": [
    "scroll-state",
    "position"
  ],
  "spec": [
    "https://drafts.csswg.org/css-overflow-3/#scrolling",
    "https://drafts.csswg.org/css-position-3/#stickypos-insets",
    "https://drafts.csswg.org/css-position-3/#static-position"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 100,
          "height": 100,
          "overflowX": "hidden",
          "overflowY": "hidden"
        },
        "scrollOffset": {
          "x": 0,
          "y": 30
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 100,
          "height": 300
        }
      },
      {
        "parent": 1,
        "style": {
          "width": 100,
          "height": 120,
          "position": "sticky",
          "insetTop": 10,
          "insetBottom": 20
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 100,
        "height": 100
      },
      {
        "x": 0,
        "y": -30,
        "width": 100,
        "height": 300
      },
      {
        "x": 0,
        "y": 40,
        "width": 100,
        "height": 120
      }
    ]
  }
}
