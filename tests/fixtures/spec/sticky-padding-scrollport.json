{
  "name": "sticky-padding-scrollport",
  "kind": "spec",
  "features": [
    "scroll-state",
    "position"
  ],
  "spec": [
    "https://drafts.csswg.org/css-overflow-3/#scrolling",
    "https://drafts.csswg.org/css-position-3/#stickypos-insets",
    "https://drafts.csswg.org/css-position-3/#static-position"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 100,
          "height": 100,
          "boxSizing": "border-box",
          "border": 10,
          "padding": 10,
          "overflowX": "hidden",
          "overflowY": "hidden"
        },
        "scrollOffset": {
          "x": 30,
          "y": 40
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 300,
          "height": 300
        }
      },
      {
        "parent": 1,
        "style": {
          "width": 20,
          "height": 20,
          "position": "sticky",
          "insetTop": 10,
          "insetLeft": 10
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 100,
        "height": 100,
        "contentWidth": 60,
        "contentHeight": 60
      },
      {
        "x": -10,
        "y": -20,
        "width": 300,
        "height": 300
      },
      {
        "x": 30,
        "y": 40,
        "width": 20,
        "height": 20
      }
    ]
  }
}
