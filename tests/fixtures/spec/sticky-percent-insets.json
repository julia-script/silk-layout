{
  "name": "sticky-percent-insets",
  "kind": "spec",
  "features": [
    "scroll-state",
    "position"
  ],
  "spec": [
    "https://drafts.csswg.org/css-overflow-3/#scrolling",
    "https://drafts.csswg.org/css-position-3/#stickypos-insets",
    "https://drafts.csswg.org/css-position-3/#static-position"
  ],
  "input": {
    "viewport": {
      "width": 800,
      "height": 600
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 200,
          "height": 100,
          "overflowX": "hidden",
          "overflowY": "hidden"
        },
        "scrollOffset": {
          "x": 30,
          "y": 50
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 400,
          "height": 300
        }
      },
      {
        "parent": 1,
        "style": {
          "width": 100,
          "height": 20,
          "position": "sticky",
          "insetLeft": {
            "percent": 0.1
          },
          "insetTop": {
            "percent": 0.1
          }
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": 0,
        "y": 0,
        "width": 200,
        "height": 100
      },
      {
        "x": -30,
        "y": -50,
        "width": 400,
        "height": 300
      },
      {
        "x": 50,
        "y": 60,
        "width": 100,
        "height": 20
      }
    ]
  }
}
