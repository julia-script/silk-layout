{
  "name": "text-justify-last-line",
  "kind": "spec",
  "features": [
    "inline-fragments",
    "justification"
  ],
  "spec": [
    "https://drafts.csswg.org/css-text-3/#text-align-last-property",
    "https://drafts.csswg.org/css-text-3/#expanding-text",
    "https://drafts.csswg.org/css-text-3/#justify-limits"
  ],
  "input": {
    "viewport": {
      "width": 100,
      "height": 100
    },
    "fonts": [
      {
        "fontSize": 10,
        "ascent": 8,
        "descent": 2,
        "lineGap": 0,
        "xHeight": 5,
        "capHeight": 7,
        "subscriptOffset": 2,
        "superscriptOffset": 3,
        "baselines": {
          "alphabetic": 8,
          "ideographic": 10,
          "central": 5,
          "mathematical": 5
        }
      }
    ],
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 40,
          "fontKey": 1,
          "textAlignLast": "justify"
        }
      },
      {
        "parent": 0,
        "text": "a "
      },
      {
        "parent": 0,
        "text": "b"
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "height": 10
      },
      {
        "x": 0,
        "width": 35
      },
      {
        "x": 35,
        "width": 5
      }
    ]
  }
}
