{
  "name": "text-overfull-start-alignment",
  "kind": "spec",
  "features": [
    "source-text",
    "inline-fragments",
    "text-align",
    "direction"
  ],
  "spec": [
    "https://drafts.csswg.org/css-text-3/#text-align-property"
  ],
  "input": {
    "viewport": {
      "width": 100,
      "height": 100
    },
    "fonts": [
      {
        "fontSize": 10,
        "ascent": 8,
        "descent": 2,
        "lineGap": 0,
        "xHeight": 5,
        "capHeight": 7,
        "subscriptOffset": 2,
        "superscriptOffset": 3,
        "baselines": {
          "alphabetic": 8,
          "ideographic": 10,
          "central": 5,
          "mathematical": 5
        }
      }
    ],
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 30
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 30,
          "textAlign": "center"
        }
      },
      {
        "parent": 1,
        "style": {
          "display": "inline-block",
          "width": 40,
          "height": 10
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 10,
          "fontKey": 1,
          "direction": "rtl",
          "textAlign": "left"
        }
      },
      {
        "parent": 3,
        "text": "abcd"
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "height": 20
      },
      {
        "height": 10
      },
      {
        "rects": [
          {
            "x": 0,
            "y": 0,
            "width": 40,
            "height": 10
          }
        ]
      },
      {
        "height": 10
      },
      {
        "rects": [
          {
            "x": -10,
            "y": 10,
            "width": 20,
            "height": 10
          }
        ]
      }
    ]
  }
}
