{
  "name": "text-preserved-conditional-hanging",
  "kind": "spec",
  "features": [
    "source-text",
    "inline-fragments",
    "preserved-whitespace"
  ],
  "input": {
    "viewport": {
      "width": 100,
      "height": 100
    },
    "fonts": [
      {
        "fontSize": 10,
        "ascent": 8,
        "descent": 2,
        "lineGap": 0,
        "xHeight": 5,
        "capHeight": 7,
        "subscriptOffset": 2,
        "superscriptOffset": 3,
        "baselines": {
          "alphabetic": 8,
          "ideographic": 10,
          "central": 5,
          "mathematical": 5
        }
      }
    ],
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 40,
          "fontKey": 1,
          "whiteSpaceCollapse": "preserve",
          "textAlign": "end"
        }
      },
      {
        "parent": 0,
        "text": "aaaa"
      },
      {
        "parent": 0,
        "text": "            "
      }
    ]
  },
  "spec": [
    "https://drafts.csswg.org/css-text-3/#white-space-processing",
    "https://drafts.csswg.org/css-text-3/#white-space-phase-2",
    "https://drafts.csswg.org/css-text-3/#conditionally-hang"
  ],
  "expected": {
    "sources": [
      {
        "height": 10
      },
      {
        "rects": [
          {
            "x": 0,
            "y": 0,
            "width": 20,
            "height": 10
          }
        ]
      },
      {
        "rects": [
          {
            "x": 20,
            "y": 0,
            "width": 60,
            "height": 10
          }
        ]
      }
    ]
  }
}
