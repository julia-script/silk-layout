{
  "name": "text-rtl-tab-stops",
  "kind": "spec",
  "features": [
    "source-text",
    "inline-fragments",
    "preserved-whitespace"
  ],
  "input": {
    "viewport": {
      "width": 100,
      "height": 100
    },
    "fonts": [
      {
        "fontSize": 10,
        "ascent": 8,
        "descent": 2,
        "lineGap": 0,
        "xHeight": 5,
        "capHeight": 7,
        "subscriptOffset": 2,
        "superscriptOffset": 3,
        "baselines": {
          "alphabetic": 8,
          "ideographic": 10,
          "central": 5,
          "mathematical": 5
        }
      }
    ],
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 60,
          "fontKey": 1,
          "direction": "rtl",
          "whiteSpaceCollapse": "preserve",
          "textWrap": "nowrap",
          "tabSize": 4
        }
      },
      {
        "parent": 0,
        "text": "ab"
      },
      {
        "parent": 0,
        "text": "\t"
      },
      {
        "parent": 0,
        "text": "cd"
      }
    ]
  },
  "spec": [
    "https://drafts.csswg.org/css-text-3/#white-space-processing",
    "https://drafts.csswg.org/css-text-3/#white-space-phase-2",
    "https://drafts.csswg.org/css-text-3/#tab-size-property"
  ],
  "expected": {
    "sources": [
      {
        "height": 10
      },
      {
        "rects": [
          {
            "x": 50,
            "y": 0,
            "width": 10,
            "height": 10
          }
        ]
      },
      {
        "rects": [
          {
            "x": 40,
            "y": 0,
            "width": 10,
            "height": 10
          }
        ]
      },
      {
        "rects": [
          {
            "x": 30,
            "y": 0,
            "width": 10,
            "height": 10
          }
        ]
      }
    ]
  }
}
