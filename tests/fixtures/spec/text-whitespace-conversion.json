{
  "name": "text-whitespace-conversion",
  "kind": "spec",
  "features": [
    "source-text",
    "inline-fragments",
    "preserved-whitespace"
  ],
  "spec": [
    "https://drafts.csswg.org/css-text-4/#white-space-collapse"
  ],
  "input": {
    "viewport": {
      "width": 100,
      "height": 100
    },
    "fonts": [
      {
        "fontSize": 10,
        "ascent": 8,
        "descent": 2,
        "lineGap": 0,
        "xHeight": 5,
        "capHeight": 7,
        "subscriptOffset": 2,
        "superscriptOffset": 3,
        "baselines": {
          "alphabetic": 8,
          "ideographic": 10,
          "central": 5,
          "mathematical": 5
        }
      }
    ],
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 100,
          "fontKey": 1
        }
      },
      {
        "parent": 0,
        "style": {
          "fontKey": 1,
          "whiteSpaceCollapse": "preserve-spaces",
          "textWrap": "nowrap"
        }
      },
      {
        "parent": 1,
        "text": "\ta\n b\r "
      },
      {
        "parent": 0,
        "style": {
          "fontKey": 1,
          "whiteSpaceCollapse": "discard"
        }
      },
      {
        "parent": 3,
        "text": " a \t\nb "
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "height": 20
      },
      {
        "height": 10
      },
      {
        "rects": [
          {
            "x": 0,
            "y": 0,
            "width": 35,
            "height": 10
          }
        ]
      },
      {
        "height": 10
      },
      {
        "rects": [
          {
            "x": 0,
            "y": 10,
            "width": 10,
            "height": 10
          }
        ]
      }
    ]
  }
}
