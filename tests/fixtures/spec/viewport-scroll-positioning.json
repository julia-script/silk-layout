{
  "name": "viewport-scroll-positioning",
  "kind": "spec",
  "features": [
    "scroll-state",
    "position"
  ],
  "spec": [
    "https://drafts.csswg.org/css-overflow-3/#scrolling",
    "https://drafts.csswg.org/css-position-3/#stickypos-insets",
    "https://drafts.csswg.org/css-position-3/#static-position"
  ],
  "input": {
    "viewport": {
      "width": 200,
      "height": 100
    },
    "viewportScrollOffset": {
      "x": 20,
      "y": 30
    },
    "nodes": [
      {
        "parent": null,
        "style": {
          "width": 400,
          "height": 300,
          "position": "relative"
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 100,
          "height": 20,
          "position": "sticky",
          "insetLeft": 0,
          "insetTop": 10
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 100,
          "height": 100
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 20,
          "height": 20,
          "position": "fixed",
          "insetLeft": 10,
          "insetTop": 10
        }
      },
      {
        "parent": 0,
        "style": {
          "width": 20,
          "height": 20,
          "position": "absolute",
          "insetLeft": 40,
          "insetTop": 50
        }
      }
    ]
  },
  "expected": {
    "sources": [
      {
        "x": -20,
        "y": -30,
        "width": 400,
        "height": 300
      },
      {
        "x": 20,
        "y": 40,
        "width": 100,
        "height": 20
      },
      {
        "x": 0,
        "y": 20,
        "width": 100,
        "height": 100
      },
      {
        "x": 30,
        "y": 40,
        "width": 20,
        "height": 20
      },
      {
        "x": 40,
        "y": 50,
        "width": 20,
        "height": 20
      }
    ]
  }
}
